{
  "name": "routeflow",
  "version": "0.0.1",
  "private": true,
  "description": "RouteFlow monorepo — web dashboard, mobile apps, and API backend",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "check-types": "turbo run check-types",
    "verify": "node scripts/campaign-check.mjs --freshness-only && node scripts/check-git-hooks.mjs && node scripts/validate-lock-edges.mjs && node scripts/validate-lessons.mjs && node scripts/validate-code-map.mjs && node .claude/skills/bug-hunt/scripts/scan-signatures.mjs --self-test && node .claude/skills/bug-hunt/scripts/scan-signatures.mjs && node scripts/verify-turbo.self-test.mjs && node scripts/verify-turbo.mjs && node scripts/campaign/bugs.mjs self-test && node scripts/lib/google-signin-check.self-test.mjs && node scripts/campaign/plane-sync.self-test.mjs && node scripts/campaign/plane-intake.self-test.mjs && node scripts/campaign/plane-triage.self-test.mjs && node scripts/campaign/plane-apply.self-test.mjs && node scripts/campaign/plane-docs.self-test.mjs && node scripts/campaign/plane-learning.self-test.mjs && node scripts/campaign/plane-doctor.self-test.mjs && node scripts/validate-lessons.digest.self-test.mjs && node scripts/validate-code-map.stamp.self-test.mjs && node scripts/roadmap/render.self-test.mjs && node scripts/roadmap/from-git.self-test.mjs && node scripts/work/claim.self-test.mjs && node scripts/work/claude-hook.self-test.mjs && node scripts/work/plane-release-sync.self-test.mjs && node scripts/work/reconcile.self-test.mjs && node scripts/work/run.self-test.mjs && node scripts/lead-status.self-test.mjs && npm run plane:doctor -- --offline && node .claude/hooks/stop.gate5.spec.mjs && node scripts/check-git-hooks.self-test.mjs && node scripts/size-ratchet-gate.self-test.mjs && node scripts/campaign-check.mjs",
    "validate-lock": "node scripts/validate-lock-edges.mjs",
    "validate-lessons": "node scripts/validate-lessons.mjs",
    "lessons:digest": "node scripts/validate-lessons.mjs --digest",
    "code-map:stamp": "node scripts/validate-code-map.mjs --stamp",
    "lint:migrations": "node scripts/lint-migrations.mjs",
    "work:reconcile": "node scripts/work/reconcile.mjs",
    "work:reconcile:apply": "node scripts/work/reconcile.mjs --apply",
    "work:claim": "node scripts/work/claim.mjs",
    "smoke": "node scripts/smoke.mjs",
    "post-deploy-check": "node scripts/post-deploy-check.mjs",
    "release-health": "node scripts/release-health.mjs",
    "feature-smoke": "node scripts/feature-smoke.mjs",
    "smoke:google": "node scripts/google-signin-monitor.mjs",
    "regression": "npm run verify && npm run post-deploy-check && npm run feature-smoke",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "local:build": "node scripts/local-env.mjs --build-sha -- \"docker compose --profile app build\"",
    "parity:capture": "node scripts/native-parity/run.mjs",
    "local:up": "node scripts/local-env.mjs --build-sha -- \"docker compose --profile app up -d --build\"",
    "local:migrate": "docker compose --profile app run --rm migrate",
    "local:seed": "node scripts/local-env.mjs --db -- \"npm --prefix apps/api run db:seed && npm --prefix apps/api run db:publish:catalog:v11 && npm --prefix apps/api run db:publish:catalog:v12 && npm --prefix apps/api run db:publish:catalog:v13\"",
    "local:drift": "node scripts/local-env.mjs --db -- \"npm run db:drift -w apps/api -- --local\"",
    "local:test:db": "node scripts/local-db-specs.mjs -- \"npm run test:db -w apps/api\"",
    "local:validate": "node scripts/local-env.mjs --proof-stack --smoke --db -- \"npm run smoke && npm run post-deploy-check && npm run local:stock-gap && npm run local:drift\"",
    "local:stock-gap": "node scripts/local-env.mjs --db -- \"node apps/api/scripts/stock-ledger-gap.mjs\"",
    "local:test:smtp": "node scripts/local-env.mjs --smtp-specs -- \"npm run test:smtp -w apps/api\"",
    "local:validate:features": "node scripts/local-env.mjs --proof-stack --smoke --smtp-specs -- \"npm run feature-smoke && npm run test:smtp -w apps/api\"",
    "local:sa": "node scripts/local-env.mjs --db -- \"node scripts/local-super-admin.mjs\"",
    "local:e2e": "node scripts/local-env.mjs --proof-stack --e2e -- \"npm --prefix apps/web run test:e2e -- --project=setup --project=critical-paths --project=create-order-escape --project=boxed-order-entry --project=order-edit-pricing --project=payment-truth --project=destructive-guards --project=cancelled-edit-banner --project=lite-locked-route-ux --project=shell-skip-link-motion --project=create-order-customer-keyboard --project=customers-list-ux --project=dashboard-cls --project=scan-did-you-mean --project=counter-ship-handoff --project=counter-pos-stack --project=counter-register-look --workers=1\"",
    "local:e2e:all": "node scripts/local-env.mjs --proof-stack --e2e -- \"npm --prefix apps/web run test:e2e -- --workers=1\"",
    "local:proof-stack": "node scripts/local-env.mjs --proof-stack -- \"node -e 0\"",
    "local:logs": "docker compose --profile app logs -f api web",
    "local:down": "docker compose --profile app down",
    "local:reset": "docker compose --profile app down -v",
    "postinstall": "npm run build -w @routeflow/pricing && npm run build -w @routeflow/scanning && npm run build -w @routeflow/returns",
    "prepare": "husky",
    "bogo-check": "node scripts/bogo-live-check.mjs",
    "janitor": "node scripts/janitor.mjs",
    "janitor:apply": "node scripts/janitor.mjs --apply",
    "janitor:preflight": "node scripts/janitor.mjs --preflight",
    "janitor:stale-branches": "node scripts/janitor.mjs --stale-branches",
    "janitor:self-test": "node scripts/janitor.self-test.mjs",
    "scan": "node .claude/skills/bug-hunt/scripts/scan-signatures.mjs",
    "scan:all": "node .claude/skills/bug-hunt/scripts/scan-signatures.mjs --verbose",
    "scan:self-test": "node .claude/skills/bug-hunt/scripts/scan-signatures.mjs --self-test",
    "bugs": "node scripts/campaign/bugs.mjs",
    "bugs:self-test": "node scripts/campaign/bugs.mjs self-test",
    "bugs:plane": "node scripts/campaign/plane-sync.mjs",
    "plane:sync": "node scripts/campaign/plane-sync.mjs",
    "plane:check": "node scripts/campaign/plane-sync.mjs --check",
    "plane:triage": "node scripts/campaign/plane-triage.mjs",
    "plane:intake": "node scripts/campaign/plane-intake.mjs",
    "plane:apply": "node scripts/campaign/plane-apply.mjs",
    "plane:doctor": "node scripts/campaign/plane-doctor.mjs",
    "plane:retro": "node scripts/campaign/plane-retro.mjs",
    "work:plane-release": "node scripts/work/plane-release-sync.mjs",
    "control": "node apps/control/bin/ctl.mjs serve",
    "ctl": "node apps/control/bin/ctl.mjs"
  },
  "devDependencies": {
    "@bcoe/v8-coverage": "^0.2.3",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "execa": "^5.1.1",
    "husky": "^9.1.7",
    "istanbul-lib-report": "^3.0.0",
    "istanbul-lib-source-maps": "^5.0.0",
    "istanbul-reports": "^3.1.3",
    "lint-staged": "^15.2.10",
    "prettier": "^3.9.7",
    "squawk-cli": "2.65.0",
    "turbo": "^2.10.13",
    "typescript": "^5.9.3",
    "v8-to-istanbul": "^9.0.1"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "react-native-worklets": "0.7.4",
    "rxjs": "^7.8.2"
  },
  "overrides": {
    "jest": "30.2.0",
    "jest-runtime": "30.2.0",
    "jest-mock": "30.2.0",
    "jest-environment-node": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "@jest/core": "30.2.0",
    "@jest/types": "30.2.0",
    "@jest/transform": "30.2.0",
    "react-native": "0.83.10",
    "react-native-reanimated": "~4.2.2",
    "react-native-worklets": "0.7.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-screens": "~4.24.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-maps": "~1.27.1",
    "react-native-svg": "15.15.3",
    "sanitize-html": "2.17.5",
    "standardwebhooks": "1.0.0",
    "multer": "^2.3.0"
  }
}
