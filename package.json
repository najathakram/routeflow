{
  "name": "routeflow",
  "version": "0.0.1",
  "private": true,
  "description": "RouteFlow monorepo — web dashboard, mobile apps, and API backend",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "check-types": "turbo run check-types",
    "verify": "node scripts/campaign-check.mjs --freshness-only && node scripts/validate-lock-edges.mjs && node scripts/validate-lessons.mjs && node .claude/skills/bug-hunt/scripts/scan-signatures.mjs --self-test && node .claude/skills/bug-hunt/scripts/scan-signatures.mjs && turbo run check-types lint test test:repo-truth --concurrency=2 --continue=dependencies-successful && node scripts/campaign/bugs.mjs self-test && node scripts/lib/google-signin-check.self-test.mjs && node scripts/campaign-check.mjs",
    "validate-lock": "node scripts/validate-lock-edges.mjs",
    "validate-lessons": "node scripts/validate-lessons.mjs",
    "lint:migrations": "node scripts/lint-migrations.mjs",
    "smoke": "node scripts/smoke.mjs",
    "post-deploy-check": "node scripts/post-deploy-check.mjs",
    "feature-smoke": "node scripts/feature-smoke.mjs",
    "smoke:google": "node scripts/google-signin-monitor.mjs",
    "regression": "npm run verify && npm run post-deploy-check && npm run feature-smoke",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "local:build": "docker compose --profile app build",
    "local:up": "docker compose --profile app up -d --build",
    "local:migrate": "docker compose --profile app run --rm migrate",
    "local:seed": "node scripts/local-env.mjs --db -- \"npm --prefix apps/api run db:seed && npm --prefix apps/api run db:publish:catalog:v11\"",
    "local:drift": "node scripts/local-env.mjs --db -- \"npm run db:drift -w apps/api -- --local\"",
    "local:test:db": "node scripts/local-env.mjs --db --db-specs -- \"npm run test:db -w apps/api\"",
    "local:validate": "node scripts/local-env.mjs --smoke --db -- \"npm run smoke && npm run post-deploy-check && npm run local:drift\"",
    "local:validate:features": "node scripts/local-env.mjs --smoke -- \"npm run feature-smoke\"",
    "local:e2e": "node scripts/local-env.mjs --e2e -- \"npm --prefix apps/web run test:e2e -- --project=setup --project=critical-paths --project=create-order-escape --project=boxed-order-entry --project=order-edit-pricing --project=payment-truth --project=destructive-guards --project=cancelled-edit-banner --workers=1\"",
    "local:e2e:all": "node scripts/local-env.mjs --e2e -- \"npm --prefix apps/web run test:e2e -- --workers=1\"",
    "local:logs": "docker compose --profile app logs -f api web",
    "local:down": "docker compose --profile app down",
    "local:reset": "docker compose --profile app down -v",
    "postinstall": "npm run build -w @routeflow/pricing",
    "prepare": "husky",
    "bogo-check": "node scripts/bogo-live-check.mjs",
    "scan": "node .claude/skills/bug-hunt/scripts/scan-signatures.mjs",
    "scan:all": "node .claude/skills/bug-hunt/scripts/scan-signatures.mjs --verbose",
    "scan:self-test": "node .claude/skills/bug-hunt/scripts/scan-signatures.mjs --self-test",
    "bugs": "node scripts/campaign/bugs.mjs",
    "bugs:self-test": "node scripts/campaign/bugs.mjs self-test"
  },
  "devDependencies": {
    "@bcoe/v8-coverage": "^0.2.3",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "execa": "^5.1.1",
    "husky": "^9.1.7",
    "istanbul-lib-report": "^3.0.0",
    "istanbul-lib-source-maps": "^5.0.0",
    "istanbul-reports": "^3.1.3",
    "lint-staged": "^15.2.10",
    "prettier": "^3.9.6",
    "squawk-cli": "2.64.0",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "v8-to-istanbul": "^9.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "react-native-worklets": "0.7.4",
    "rxjs": "^7.8.2"
  },
  "overrides": {
    "jest": "30.2.0",
    "jest-runtime": "30.2.0",
    "jest-mock": "30.2.0",
    "jest-environment-node": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "@jest/core": "30.2.0",
    "@jest/types": "30.2.0",
    "@jest/transform": "30.2.0",
    "react-native": "0.83.10",
    "react-native-reanimated": "~4.2.2",
    "react-native-worklets": "0.7.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-screens": "~4.24.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-maps": "~1.27.1",
    "react-native-svg": "15.15.3",
    "sanitize-html": "2.17.5",
    "standardwebhooks": "1.0.0",
    "multer": "^2.3.0"
  }
}
