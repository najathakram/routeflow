{
  "name": "routeflow",
  "version": "0.0.1",
  "private": true,
  "description": "RouteFlow monorepo — web dashboard, mobile apps, and API backend",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "check-types": "turbo run check-types",
    "verify": "turbo run check-types lint test",
    "smoke": "node scripts/smoke.mjs",
    "post-deploy-check": "node scripts/post-deploy-check.mjs",
    "feature-smoke": "node scripts/feature-smoke.mjs",
    "regression": "npm run verify && npm run post-deploy-check && npm run feature-smoke",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "prepare": "husky",
    "bogo-check": "node scripts/bogo-live-check.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "react-native-worklets": "0.7.4",
    "rxjs": "^7.8.2"
  },
  "overrides": {
    "jest": "30.2.0",
    "jest-runtime": "30.2.0",
    "jest-mock": "30.2.0",
    "jest-environment-node": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "@jest/core": "30.2.0",
    "@jest/types": "30.2.0",
    "@jest/transform": "30.2.0",
    "react-native": "0.83.10",
    "react-native-reanimated": "~4.2.2",
    "react-native-worklets": "0.7.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-screens": "~4.24.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-maps": "~1.27.1",
    "react-native-svg": "15.15.3",
    "sanitize-html": "2.17.5",
    "standardwebhooks": "1.0.0"
  }
}
