# Last local gate before push.
#
# WHY THIS IS THE EXPENSIVE GATE AND CI IS THE CHEAP ONE (2026-08-30):
# Actions minutes are unlimited on PUBLIC repos and metered on PRIVATE ones
# (2,000/mo on Free, 3,000 on Pro). This repo used to flip public for a few
# minutes per merge purely to make CI free. Retiring that flip means every CI
# minute is now billed, so ci.yml was cut to a SINGLE consolidated job that runs
# this exact same `npm run verify` — CI confirms on Linux what this hook already
# proved locally, and nothing more. Every check that fails here is a check that
# never has to burn a paid runner.
#
# That inverts the old note in this file ("GitHub Actions does not run on this
# repo"): CI does run now, and it is deliberately thin. This hook is where the
# work happens.
#
# COST DISCIPLINE — a gate that takes minutes gets bypassed, and a bypassed gate
# enforces nothing. MEASURED warm on this box, 3 interleaved rounds on an idle
# machine: 39.4s median before, 30.0s median now. `npm run verify` invokes
# node/turbo DIRECTLY instead of nesting `npm run` calls, because each `npm run`
# costs ~7-9s of pure npm startup here (`npm run` with no args, which only lists
# scripts, takes 7-9s; `node -e ""` takes 0.7s) and the old chain paid it three
# times over.
#
# That gap widens exactly when it hurts. Under host saturation the same npm
# startup measured ~27s and the old chain took 94.5s — so the shape that is
# merely tidier on an idle box is what keeps the gate usable on a busy one.
# If this hook ever creeps past ~2 minutes, fix the gate; do not loosen it.
#
# COLD runs are a different animal: turbo's globalDependencies (correctly)
# include package-lock.json and every manifest, so ANY dependency change busts
# all 28 task caches and the next verify is a full cold build — measured 15m14s
# here, 12m15s by the session that landed globalDependencies. That is by design:
# a dep bump is exactly when you want everything re-checked. Do not "fix" a slow
# post-dep-bump run by narrowing globalDependencies; that is the false-green
# mechanism #495 shipped and 6c8f1401 closed.
#
# Emergency escape hatch:  SKIP_VERIFY=1 SKIP_VERIFY_REASON="why" git push ...
# It is loud, and it deliberately does NOT record a verification marker. It DOES record an
# audit line (branch, head, docs-only?, reason) to .git/skip-verify.log via
# scripts/skip-verify-audit.mjs — a push that touches code (apps/, packages/, scripts/,
# .github/) is refused without SKIP_VERIFY_REASON; a docs-only push needs no reason.

# Cheapest check first: refuse a trunk push before spending any time verifying.
branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo "Direct push to $branch is blocked — open a PR from a feat/* or fix/* branch."
  exit 1
fi

if [ "$SKIP_VERIFY" = "1" ]; then
  upstream="$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || echo origin/master)"
  changed="$(git diff --name-only "$upstream"...HEAD 2>/dev/null || git diff --name-only origin/master...HEAD)"
  export RF_BRANCH="$branch"
  export RF_HEAD="$(git rev-parse --short HEAD)"
  export RF_CHANGED_FILES="$changed"
  export RF_AUDIT_LOG="$(git rev-parse --git-dir)/skip-verify.log"
  node scripts/skip-verify-audit.mjs || exit 1
  echo "⚠ SKIP_VERIFY=1 — skipping 'npm run verify'."
  echo "⚠ CI runs ONE consolidated job on the PR; it will re-check this on Linux,"
  echo "⚠ and every failure there costs paid Actions minutes. Push knowingly."
  exit 0
fi

# ── Verified-tree fast path ───────────────────────────────────────────────────
# Re-pushing a tree that already passed (amend of a message, a rebase that
# changed no content, a force-push after a no-op) should not re-run the gate.
# The marker keys on the COMMIT TREE hash, not the commit sha, so it survives
# rebases and reword-only amends — the content is what verify actually checked.
#
# It is recorded ONLY when the working tree is clean. `npm run verify` inspects
# files on disk, so with uncommitted edits present a pass describes the working
# tree, not the commit being pushed — that is not something to cache.
#
# .git/ is deliberate: this is a local, per-clone fact. It is NOT pushed and CI
# does NOT trust it. A tree that passes on Windows is not proof it passes on
# ubuntu-latest (case-sensitive paths, separators, platform-gated deps), which
# is precisely the residual risk CI's single Linux job exists to cover.
marker="$(git rev-parse --git-dir)/rf-verified"
tree="$(git rev-parse HEAD^{tree} 2>/dev/null || echo none)"
dirty="$(git status --porcelain 2>/dev/null | head -1)"

if [ -z "$dirty" ] && [ -f "$marker" ] && [ "$(cat "$marker" 2>/dev/null)" = "$tree" ]; then
  echo "✓ tree $tree already passed 'npm run verify' locally — skipping (clean tree, unchanged content)."
  exit 0
fi

npm run verify || exit 1

if [ -z "$dirty" ] && [ "$tree" != "none" ]; then
  printf '%s' "$tree" > "$marker"
fi
