{
  "name": "@routeflow/control",
  "version": "0.0.1",
  "private": true,
  "description": "RouteFlow control system: delivery-program control service and ctl CLI (no runtime deps).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev:control": "node --watch dist/main.js",
    "test": "jest",
    "lint": "eslint \"src/**/*.ts\"",
    "check-types": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "30.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
