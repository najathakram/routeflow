{
  "name": "@routeflow/control",
  "version": "0.0.1",
  "private": true,
  "description": "RouteFlow control system: delivery-program control service and ctl CLI (no runtime deps).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --watch dist/main.js",
    "test": "jest",
    "lint": "eslint \"src/**/*.ts\"",
    "check-types": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.9.7",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "cacheDirectory": "<rootDir>/.jest-cache",
    "testEnvironment": "node",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    }
  }
}
