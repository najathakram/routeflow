// ─── Generator & Datasource ───────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  OPERATOR
  DRIVER
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum ItemStatus {
  PENDING
  CONFIRMED
  PARTIAL
  DELIVERED
  CANCELLED
}

enum RouteRunStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RouteRunStopStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum MutationType {
  DELIVERED
  PARTIAL
  REFUSED
  ADD_ON
  SUBSTITUTED
}

enum TxnStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  CHECK
  ACH
  OTHER
}

enum FulfillPath {
  ROUTE
  SHIP
}

enum OrderSource {
  APP
  PHONE
  ROUTE
}

enum Platform {
  IOS
  ANDROID
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  WRITE_OFF
}

// ─── New Enums (Zoho-parity) ──────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  CONVERTED
}

enum CreditNoteStatus {
  ISSUED
  APPLIED
  VOID
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CLOSED
}

enum VendorBillStatus {
  DRAFT
  RECEIVED
  PARTIAL
  PAID
  OVERDUE
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  CUSTOMER_REFUSED
  QUALITY_ISSUE
  EXCESS_ORDER
}

enum ReturnStatus {
  PENDING
  PROCESSED
  CANCELLED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  username            String     @unique
  password            String
  role                UserRole
  status              UserStatus @default(ACTIVE)
  forcePasswordChange Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  customer        Customer?
  driver          Driver?
  deviceTokens    DeviceToken[]
  refreshTokens   RefreshToken[]
  stockMovements  StockMovement[]
  expenses        Expense[]
  messages        Message[]

  @@index([role])
  @@index([status])
  @@index([deletedAt])
}

model Customer {
  id                  String      @id @default(uuid())
  userId              String      @unique
  businessName        String
  contactName         String
  phone               String?
  notes               String?
  zohoContactId       String?     @unique
  fulfillPath         FulfillPath @default(ROUTE)
  deliveryWindowStart String?
  deliveryWindowEnd   String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user           User              @relation(fields: [userId], references: [id])
  addresses      CustomerAddress[]
  routes         RouteCustomer[]
  routeStops     RouteStop[]
  orders         Order[]
  transactions   Transaction[]
  routeRunStops  RouteRunStop[]
  orderTemplates OrderTemplate[]
  invoices       Invoice[]
  estimates      Estimate[]
  creditNotes    CreditNote[]
  returns        Return[]

  @@index([zohoContactId])
  @@index([businessName])
}

model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String
  label      String   @default("default")
  line1      String
  line2      String?
  city       String
  state      String
  zip        String
  lat        Float?
  lng        Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id])
  routeStops    RouteStop[]
  routeRunStops RouteRunStop[]

  @@index([customerId])
}

model Driver {
  id            String       @id @default(uuid())
  userId        String       @unique
  contactName   String?
  phone         String?
  status        DriverStatus @default(ACTIVE)
  vehicleMake   String?
  vehicleModel  String?
  vehicleColour String?
  vehiclePlate  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user              User               @relation(fields: [userId], references: [id])
  routes            Route[]
  routeRuns         RouteRun[]
  deliveryMutations DeliveryMutation[]

  @@index([status])
}

model Product {
  id               String   @id @default(uuid())
  name             String
  description      String?
  sku              String?  @unique
  unit             String
  pricePerUnit     Decimal  @db.Decimal(10, 2)
  category         String?
  imageKey         String?
  isActive         Boolean  @default(true)
  barcode          String?  @unique
  currentStock     Decimal  @default(0) @db.Decimal(10, 3)
  averageCost      Decimal? @db.Decimal(10, 4)
  reorderPoint     Int?
  reorderQty       Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderItems         OrderItem[]
  deliveryMutations  DeliveryMutation[]
  templateItems      OrderTemplateItem[]
  stockMovements     StockMovement[]
  invoiceItems       InvoiceItem[]
  estimateItems      EstimateItem[]
  purchaseOrderItems PurchaseOrderItem[]
  returnItems        ReturnItem[]

  @@index([category])
  @@index([isActive])
  @@index([barcode])
}

model Route {
  id        String   @id @default(uuid())
  name      String
  driverId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver    Driver?         @relation(fields: [driverId], references: [id])
  stops     RouteStop[]
  customers RouteCustomer[]
  runs      RouteRun[]

  @@index([driverId])
  @@index([isActive])
}

model RouteStop {
  id                String   @id @default(uuid())
  routeId           String
  customerId        String?
  customerAddressId String?
  stopNumber        Int
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  route           Route            @relation(fields: [routeId], references: [id])
  customer        Customer?        @relation(fields: [customerId], references: [id])
  customerAddress CustomerAddress? @relation(fields: [customerAddressId], references: [id])
  routeRunStops   RouteRunStop[]

  @@unique([routeId, stopNumber])
  @@index([routeId])
  @@index([customerId])
  @@index([customerAddressId])
}

model RouteCustomer {
  id         String   @id @default(uuid())
  routeId    String
  customerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  route    Route    @relation(fields: [routeId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([routeId, customerId])
  @@index([routeId])
  @@index([customerId])
}

model RouteRun {
  id                String         @id @default(uuid())
  routeId           String
  driverId          String?
  status            RouteRunStatus @default(SCHEDULED)
  scheduledDate     DateTime
  startedAt         DateTime?
  completedAt       DateTime?
  manuallyReordered Boolean        @default(false)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  route  Route          @relation(fields: [routeId], references: [id])
  driver Driver?        @relation(fields: [driverId], references: [id])
  stops  RouteRunStop[]
  orders Order[]

  @@index([routeId])
  @@index([driverId])
  @@index([status])
  @@index([scheduledDate])
}

model RouteRunStop {
  id                String            @id @default(uuid())
  routeRunId        String
  routeStopId       String
  customerId        String?
  customerAddressId String?
  stopNumber        Int
  status            RouteRunStopStatus @default(PENDING)
  driverNote        String?
  arrivedAt         DateTime?
  completedAt       DateTime?
  notes             String?
  podPhotoUrls      String[]
  signatureUrl      String?
  safeDropEnabled   Boolean          @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  routeRun        RouteRun         @relation(fields: [routeRunId], references: [id])
  routeStop       RouteStop        @relation(fields: [routeStopId], references: [id])
  customer        Customer?        @relation(fields: [customerId], references: [id])
  customerAddress CustomerAddress? @relation(fields: [customerAddressId], references: [id])
  orders          Order[]
  deliveryMutations DeliveryMutation[]

  @@unique([routeRunId, stopNumber])
  @@index([routeRunId])
  @@index([routeStopId])
  @@index([customerId])
  @@index([customerAddressId])
}

model Order {
  id                    String      @id @default(uuid())
  customerId            String
  routeRunId            String?
  routeRunStopId        String?
  templateId            String?
  orderNumber           String?
  status                OrderStatus @default(PENDING)
  source                OrderSource @default(APP)
  urgent                Boolean     @default(false)
  notes                 String?
  driverNote            String?
  subtotal              Decimal     @default(0) @db.Decimal(10, 2)
  tax                   Decimal     @default(0) @db.Decimal(10, 2)
  total                 Decimal     @default(0) @db.Decimal(10, 2)
  requestedDeliveryDate DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  customer          Customer           @relation(fields: [customerId], references: [id])
  routeRun          RouteRun?          @relation(fields: [routeRunId], references: [id])
  routeRunStop      RouteRunStop?      @relation(fields: [routeRunStopId], references: [id])
  orderTemplate     OrderTemplate?     @relation(fields: [templateId], references: [id])
  lineItems         OrderItem[]
  deliveryMutations DeliveryMutation[]
  transaction       Transaction?
  returns           Return[]

  @@index([customerId])
  @@index([routeRunId])
  @@index([routeRunStopId])
  @@index([templateId])
  @@index([status])
  @@index([urgent])
  @@index([createdAt])
  @@index([requestedDeliveryDate])
}

model OrderItem {
  id        String     @id @default(uuid())
  orderId   String
  productId String
  status    ItemStatus @default(PENDING)
  qty       Decimal    @db.Decimal(10, 3)
  unitPrice Decimal    @db.Decimal(10, 2)
  subtotal  Decimal    @default(0) @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  order             Order              @relation(fields: [orderId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  deliveryMutations DeliveryMutation[]
  transactionItems  TransactionItem[]

  @@index([orderId])
  @@index([productId])
  @@index([status])
}

model DeliveryMutation {
  id                String       @id @default(uuid())
  orderId           String
  orderItemId       String?
  productId         String?
  routeRunStopId    String?
  driverId          String?
  type              MutationType
  qty               Decimal?     @db.Decimal(10, 3)
  quantityDelivered Decimal?     @db.Decimal(10, 3)
  unitPrice         Decimal?     @db.Decimal(10, 2)
  note              String?
  driverNote        String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  order        Order         @relation(fields: [orderId], references: [id])
  orderItem    OrderItem?    @relation(fields: [orderItemId], references: [id])
  product      Product?      @relation(fields: [productId], references: [id])
  routeRunStop RouteRunStop? @relation(fields: [routeRunStopId], references: [id])
  driver       Driver?       @relation(fields: [driverId], references: [id])

  @@index([orderId])
  @@index([orderItemId])
  @@index([productId])
  @@index([routeRunStopId])
  @@index([driverId])
  @@index([type])
}

model Transaction {
  id         String    @id @default(uuid())
  customerId String
  orderId    String?   @unique
  status     TxnStatus @default(UNPAID)
  totalOwed  Decimal   @db.Decimal(10, 2)
  totalPaid  Decimal   @default(0) @db.Decimal(10, 2)
  dueDate    DateTime?
  paidAt     DateTime?
  notes      String?
  pdfUrl     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer Customer          @relation(fields: [customerId], references: [id])
  order    Order?            @relation(fields: [orderId], references: [id])
  items    TransactionItem[]
  payments Payment[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

model TransactionItem {
  id            String   @id @default(uuid())
  transactionId String
  orderItemId   String?
  description   String
  qty           Decimal  @db.Decimal(10, 3)
  unitPrice     Decimal  @db.Decimal(10, 2)
  subtotal      Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id])
  orderItem   OrderItem?  @relation(fields: [orderItemId], references: [id])

  @@index([transactionId])
  @@index([orderItemId])
}

model Payment {
  id            String        @id @default(uuid())
  transactionId String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)
  reference     String?
  notes         String?
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
  @@index([method])
  @@index([paidAt])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  Platform
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model OrderTemplate {
  id         String   @id @default(uuid())
  customerId String
  name       String
  isActive   Boolean  @default(true)
  daysOfWeek Int[]
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer             @relation(fields: [customerId], references: [id])
  items    OrderTemplateItem[]
  orders   Order[]

  @@index([customerId])
  @@index([isActive])
}

model OrderTemplateItem {
  id         String   @id @default(uuid())
  templateId String
  productId  String
  qty        Int
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template OrderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@index([templateId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  contactName    String?
  phone          String?
  email          String?
  notes          String?
  isActive       Boolean         @default(true)
  leadTimeDays   Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  vendorBills    VendorBill[]
  expenses       Expense[]

  @@index([isActive])
}

model StockMovement {
  id            String       @id @default(uuid())
  productId     String
  type          MovementType
  quantity      Decimal      @db.Decimal(10, 3)
  unitCost      Decimal?     @db.Decimal(10, 4)
  supplierId    String?
  reference     String?
  notes         String?
  performedById String?
  createdAt     DateTime     @default(now())

  product     Product   @relation(fields: [productId], references: [id])
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  performedBy User?     @relation(fields: [performedById], references: [id])

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@index([supplierId])
}

// ─── Sprint 1: Standalone Invoicing ──────────────────────────────────────────

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  customerId    String
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(10, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  shippingFee   Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  dueDate       DateTime?
  sentAt        DateTime?
  viewedAt      DateTime?
  paidAt        DateTime?
  notes         String?
  terms         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer    Customer         @relation(fields: [customerId], references: [id])
  items       InvoiceItem[]
  payments    InvoicePayment[]
  creditNotes CreditNote[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  productId   String?
  qty         Decimal  @db.Decimal(10, 3)
  unitPrice   Decimal  @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  taxRate     Decimal  @default(0) @db.Decimal(5, 4)
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model InvoicePayment {
  id        String        @id @default(uuid())
  invoiceId String
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  reference String?
  notes     String?
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

// ─── Sprint 2: Expense Tracking ───────────────────────────────────────────────

model ExpenseCategory {
  id       String    @id @default(uuid())
  name     String    @unique
  code     String    @unique
  isCustom Boolean   @default(false)

  expenses Expense[]
}

model Expense {
  id            String   @id @default(uuid())
  categoryId    String
  supplierId    String?
  amount        Decimal  @db.Decimal(10, 2)
  date          DateTime
  description   String?
  paymentMethod String?
  receiptKey    String?
  notes         String?
  performedById String?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  supplier    Supplier?       @relation(fields: [supplierId], references: [id])
  performedBy User?           @relation(fields: [performedById], references: [id])

  @@index([categoryId])
  @@index([supplierId])
  @@index([date])
  @@index([deletedAt])
}

// ─── Sprint 4: Purchase Orders ────────────────────────────────────────────────

model PurchaseOrder {
  id           String              @id @default(uuid())
  poNumber     String              @unique
  supplierId   String
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?
  notes        String?
  totalAmount  Decimal             @db.Decimal(10, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id          String  @id @default(uuid())
  poId        String
  productId   String
  qtyOrdered  Decimal @db.Decimal(10, 3)
  qtyReceived Decimal @default(0) @db.Decimal(10, 3)
  unitCost    Decimal @db.Decimal(10, 4)
  totalCost   Decimal @db.Decimal(10, 2)

  po      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])

  @@index([poId])
  @@index([productId])
}

// ─── Sprint 6: Credit Notes & Estimates ──────────────────────────────────────

model CreditNote {
  id               String           @id @default(uuid())
  creditNoteNumber String           @unique
  customerId       String
  invoiceId        String?
  amount           Decimal          @db.Decimal(10, 2)
  reason           String?
  status           CreditNoteStatus @default(ISSUED)
  appliedToInvoiceId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  customer        Customer @relation(fields: [customerId], references: [id])
  invoice         Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([customerId])
  @@index([status])
}

model Estimate {
  id             String         @id @default(uuid())
  estimateNumber String         @unique
  customerId     String
  status         EstimateStatus @default(DRAFT)
  subtotal       Decimal        @db.Decimal(10, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(10, 2)
  discount       Decimal        @default(0) @db.Decimal(10, 2)
  total          Decimal        @db.Decimal(10, 2)
  expiresAt      DateTime?
  notes          String?
  terms          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  customer Customer      @relation(fields: [customerId], references: [id])
  items    EstimateItem[]

  @@index([customerId])
  @@index([status])
}

model EstimateItem {
  id          String   @id @default(uuid())
  estimateId  String
  description String
  productId   String?
  qty         Decimal  @db.Decimal(10, 3)
  unitPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id])

  @@index([estimateId])
  @@index([productId])
}

// ─── Sprint 7: Vendor Bills (Accounts Payable) ───────────────────────────────

model VendorBill {
  id           String           @id @default(uuid())
  billNumber   String           @unique
  supplierId   String
  status       VendorBillStatus @default(RECEIVED)
  totalOwed    Decimal          @db.Decimal(10, 2)
  totalPaid    Decimal          @default(0) @db.Decimal(10, 2)
  dueDate      DateTime?
  receivedDate DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  supplier Supplier      @relation(fields: [supplierId], references: [id])
  payments BillPayment[]

  @@index([supplierId])
  @@index([status])
  @@index([dueDate])
}

model BillPayment {
  id           String        @id @default(uuid())
  vendorBillId String
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  reference    String?
  notes        String?
  paidAt       DateTime      @default(now())
  createdAt    DateTime      @default(now())

  vendorBill VendorBill @relation(fields: [vendorBillId], references: [id])

  @@index([vendorBillId])
}

// ─── Sprint 8: Returns / RMA ──────────────────────────────────────────────────

model Return {
  id           String       @id @default(uuid())
  returnNumber String?      @unique
  orderId      String
  customerId   String
  reason       ReturnReason
  status       ReturnStatus @default(PENDING)
  notes        String?
  photoUrls    String[]
  creditNoteId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  order    Order        @relation(fields: [orderId], references: [id])
  customer Customer     @relation(fields: [customerId], references: [id])
  items    ReturnItem[]

  @@index([orderId])
  @@index([customerId])
  @@index([status])
}

model ReturnItem {
  id        String  @id @default(uuid())
  returnId  String
  productId String
  qty       Decimal @db.Decimal(10, 3)
  reason    String?
  restock   Boolean @default(true)

  return  Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
}

// ─── Driver-to-Dispatcher Messaging ──────────────────────────────────────────

model Message {
  id         String   @id @default(uuid())
  runId      String?
  text       String
  senderId   String
  senderRole String   // "DRIVER" | "OPERATOR"
  createdAt  DateTime @default(now())

  sender User @relation(fields: [senderId], references: [id])

  @@index([runId])
  @@index([senderId])
}
