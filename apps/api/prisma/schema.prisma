model StockLot {
  id           String   @id @default(uuid())
  productId    String
  purchaseDate DateTime @default(now())
  qty          Decimal  @db.Decimal(10, 3)
  remainingQty Decimal  @db.Decimal(10, 3)
  unitCost     Decimal  @db.Decimal(10, 4)
  reference    String?
  notes        String?
  createdAt    DateTime @default(now())
  tenantId     String?

  product Product @relation(fields: [productId], references: [id])
  tenant  Tenant? @relation(fields: [tenantId], references: [id])

  @@index([productId])
  @@index([purchaseDate])
  @@index([tenantId])
}

model StockMovement {
  id            String       @id @default(uuid())
  productId     String
  type          MovementType
  quantity      Decimal      @db.Decimal(10, 3)
  unitCost      Decimal?     @db.Decimal(10, 4)
  // Running snapshots: product state AFTER this movement was applied.
  // Point-in-time average cost = avgCostAfter of the latest movement <= T.
  avgCostAfter  Decimal?     @db.Decimal(10, 4)
  stockAfter    Decimal?     @db.Decimal(10, 3)
  supplierId    String?
  reference     String?
  notes         String?
  performedById String?
  createdAt     DateTime     @default(now())
  tenantId      String?

  product     Product   @relation(fields: [productId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  performedBy User?     @relation(fields: [performedById], references: [id])

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@index([supplierId])
  @@index([tenantId])
}

// ─── Sprint 1: Standalone Invoicing ──────────────────────────────────────────

model Invoice {
  id                     String        @id @default(uuid())
  invoiceNumber          String
  customerId             String
  status                 InvoiceStatus @default(DRAFT)
  subtotal               Decimal       @db.Decimal(10, 2)
  taxAmount              Decimal       @default(0) @db.Decimal(10, 2)
  discount               Decimal       @default(0) @db.Decimal(10, 2)
  shippingFee            Decimal       @default(0) @db.Decimal(10, 2)
  total                  Decimal       @db.Decimal(10, 2)
  dueDate                DateTime?
  sentAt                 DateTime?
  viewedAt               DateTime?
  paidAt                 DateTime?
  notes                  String?
  internalNotes          String?
  referenceNumber        String?
  subject                String?
  terms                  String?
  issueDate              DateTime      @default(now())
  pdfUrl                 String?
  // Carrier shipment tracking — copied from the linked order on invoice generation,
  // and editable on the invoice itself. Carrier is a label (UPS/FedEx/USPS/DHL/Other);
  // the clickable tracking URL is derived from carrier + number, never stored.
  shippingCarrier        String?
  shippingTrackingNumber String?
  shippedAt              DateTime?
  writeOffReason         String?
  writtenOffAt           DateTime?
  orderId                String?
  deliveryBatchId        String?
  recurringInvoiceId     String?
  // Phase 4: links the sibling invoices produced when a mixed order is split by
  // regulated category (INV-1919 / INV-1919-R1 …). Null for un-split invoices.
  invoiceGroupId         String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  tenantId               String?

  customer         Customer          @relation(fields: [customerId], references: [id])
  tenant           Tenant?           @relation(fields: [tenantId], references: [id])
  order            Order?            @relation(fields: [orderId], references: [id])
  deliveryBatch    DeliveryBatch?    @relation(fields: [deliveryBatchId], references: [id])
  items            InvoiceItem[]
  payments         InvoicePayment[]
  creditNotes      CreditNote[]
  recurringInvoice RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id])

  @@unique([tenantId, invoiceNumber])
  @@index([customerId])
  @@index([orderId])
  @@index([deliveryBatchId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
  @@index([tenantId])
  @@index([invoiceGroupId])
}

model InvoiceItem {
  id                   String    @id @default(uuid())
  invoiceId            String
  description          String
  productId            String?
  qty                  Decimal   @db.Decimal(10, 3)
  unitPrice            Decimal   @db.Decimal(10, 2)
  discount             Decimal   @default(0) @db.Decimal(10, 2)
  originalPrice        Decimal?  @db.Decimal(10, 2)
  priceType            PriceType @default(STANDARD)
  taxRate              Decimal   @default(0) @db.Decimal(5, 4)
  subtotal             Decimal   @db.Decimal(10, 2)
  boxes                Int?
  pieces               Int?
  // Sale-time snapshot of the product's box size, carried from the order line.
  // Any recompute of this invoice line (edit form, PDF) must use THIS value, not
  // the live product. Null for lines created before the snapshot shipped.
  unitsPerBox          Int?
  // Per-line note carried verbatim from OrderItem.notes (or entered on a manual
  // invoice line). Buyer-visible: renders under the description on the invoice
  // detail and the PDF.
  notes                String?
  // Provenance: the OrderItem this invoice line was billed from (null for manual
  // / freeform lines). Enables exact partial-billing bookkeeping and precise
  // invoicedQty release on void. SetNull so an order-line hard-delete (order edit
  // replaces line items) never blocks on this FK.
  orderItemId          String?
  // Phase 4: regulated-category snapshot carried from the order line onto the
  // (possibly split) invoice; `categoryTaxAmount` is this line's category tax.
  trackedCategoryId    String?
  trackedSubcategoryId String?
  categoryTaxAmount    Decimal   @default(0) @db.Decimal(10, 2)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  tenantId             String?

  invoice            Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant             Tenant?             @relation(fields: [tenantId], references: [id])
  product            Product?            @relation(fields: [productId], references: [id])
  orderItem          OrderItem?          @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  trackedCategory    TrackedCategory?    @relation(fields: [trackedCategoryId], references: [id], onDelete: SetNull)
  trackedSubcategory TrackedSubcategory? @relation(fields: [trackedSubcategoryId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
  @@index([orderItemId])
  @@index([tenantId])
  @@index([trackedCategoryId])
  @@index([trackedSubcategoryId])
}

model InvoicePayment {
  id               String        @id @default(uuid())
  invoiceId        String
  amount           Decimal       @db.Decimal(10, 2)
  method           PaymentMethod
  reference        String?
  notes            String?
  paidAt           DateTime      @default(now())
  createdAt        DateTime      @default(now())
  creditNoteId     String?
  advancePaymentId String?
  paymentNumber    String?       @unique
  bankCharges      Decimal?      @db.Decimal(10, 2)
  status           PaymentStatus @default(PAID)
  paymentGroupId   String?
  tenantId         String?

  invoice        Invoice         @relation(fields: [invoiceId], references: [id])
  tenant         Tenant?         @relation(fields: [tenantId], references: [id])
  creditNote     CreditNote?     @relation(fields: [creditNoteId], references: [id])
  advancePayment AdvancePayment? @relation(fields: [advancePaymentId], references: [id])

  @@index([invoiceId])
  @@index([paymentGroupId])
  @@index([status])
  @@index([tenantId])
}

model PaymentCounter {
  id       String  @id @default("singleton")
  next     Int     @default(1)
  tenantId String?

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// ─── Sprint 2: Expense Tracking ───────────────────────────────────────────────

model ExpenseCategory {
  id       String  @id @default(uuid())
  name     String
  code     String
  isCustom Boolean @default(false)
  tenantId String?

  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  expenses Expense[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
}

enum ExpenseStatus {
  PENDING
  RECEIVED
  PAID
  VOID
}

model Expense {
  id                  String        @id @default(uuid())
  categoryId          String?
  supplierId          String?
  customerId          String?
  amount              Decimal       @db.Decimal(10, 2)
  date                DateTime
  description         String?
  paymentMethod       String?
  receiptKey          String?
  receiptOriginalName String?
  receiptMimeType     String?
  vendorBillId        String?       @unique
  notes               String?
  referenceNumber     String?
  importBatchId       String? // UUID set for all rows in one CSV import; null for manually-created expenses
  performedById       String?
  isItemized          Boolean       @default(false)
  isMileage           Boolean       @default(false)
  isBillable          Boolean       @default(false)
  employeeName        String?
  mileageUnit         String?
  distance            Decimal?      @db.Decimal(10, 2)
  mileageRateSnapshot Decimal?      @db.Decimal(10, 4)
  status              ExpenseStatus @default(PENDING)
  receivedAt          DateTime?
  paidAt              DateTime?
  deletedAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  tenantId            String?

  category    ExpenseCategory?  @relation(fields: [categoryId], references: [id])
  tenant      Tenant?           @relation(fields: [tenantId], references: [id])
  supplier    Supplier?         @relation(fields: [supplierId], references: [id])
  customer    Customer?         @relation(fields: [customerId], references: [id])
  performedBy User?             @relation(fields: [performedById], references: [id])
  lineItems   ExpenseLineItem[]

  @@index([categoryId])
  @@index([supplierId])
  @@index([customerId])
  @@index([date])
  @@index([deletedAt])
  @@index([tenantId])
  @@index([importBatchId])
  @@index([tenantId, status])
}

model ExpenseLineItem {
  id        String   @id @default(uuid())
  expenseId String
  account   String
  notes     String?
  amount    Decimal  @db.Decimal(10, 2)
  productId String?
  unitCost  Decimal? @db.Decimal(10, 4)
  qty       Decimal? @db.Decimal(10, 3)
  createdAt DateTime @default(now())
  tenantId  String?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  tenant  Tenant? @relation(fields: [tenantId], references: [id])

  @@index([expenseId])
  @@index([tenantId])
}

model MileageRate {
  id          String   @id @default(uuid())
  startDate   DateTime
  ratePerUnit Decimal  @db.Decimal(10, 4)
  unit        String   @default("MILE")
  createdAt   DateTime @default(now())
  tenantId    String?

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([startDate])
  @@index([tenantId])
}

// ─── Customer Extensions (Zoho Parity) ──────────────────────────────────────

model ContactPerson {
  id         String   @id @default(uuid())
  customerId String
  salutation String?
  firstName  String
  lastName   String?
  email      String?
  phone      String?
  mobile     String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  tenantId   String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([customerId])
  @@index([tenantId])
}

model CustomerTag {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#3b82f6")
  createdAt DateTime @default(now())
  tenantId  String?

  tenant      Tenant?                 @relation(fields: [tenantId], references: [id])
  assignments CustomerTagAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model CustomerTagAssignment {
  id         String  @id @default(uuid())
  customerId String
  tagId      String
  tenantId   String?

  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant   Tenant?     @relation(fields: [tenantId], references: [id])
  tag      CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([customerId, tagId])
  @@index([customerId])
  @@index([tagId])
  @@index([tenantId])
}

model CustomerComment {
  id         String   @id @default(uuid())
  customerId String
  userId     String
  content    String
  createdAt  DateTime @default(now())
  tenantId   String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([customerId])
  @@index([tenantId])
}

// ─── Sprint 4: Purchase Orders ────────────────────────────────────────────────

model PurchaseOrder {
  id           String              @id @default(uuid())
  poNumber     String
  supplierId   String
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?
  notes        String?
  totalAmount  Decimal             @db.Decimal(10, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenantId     String?

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  tenant   Tenant?             @relation(fields: [tenantId], references: [id])
  items    PurchaseOrderItem[]

  @@unique([tenantId, poNumber])
  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId])
}

model PurchaseOrderItem {
  id          String  @id @default(uuid())
  poId        String
  productId   String
  qtyOrdered  Decimal @db.Decimal(10, 3)
  qtyReceived Decimal @default(0) @db.Decimal(10, 3)
  unitCost    Decimal @db.Decimal(10, 4)
  totalCost   Decimal @db.Decimal(10, 2)
  tenantId    String?

  po      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  tenant  Tenant?       @relation(fields: [tenantId], references: [id])
  product Product       @relation(fields: [productId], references: [id])

  @@index([poId])
  @@index([productId])
  @@index([tenantId])
}

// ─── Sprint 6: Credit Notes & Estimates ──────────────────────────────────────

model CreditNote {
  id                 String           @id @default(uuid())
  creditNoteNumber   String
  customerId         String
  invoiceId          String?
  amount             Decimal          @db.Decimal(10, 2)
  amountUsed         Decimal          @default(0) @db.Decimal(10, 2)
  reason             String?
  status             CreditNoteStatus @default(ISSUED)
  appliedToInvoiceId String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tenantId           String?

  customer        Customer         @relation(fields: [customerId], references: [id])
  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  invoice         Invoice?         @relation(fields: [invoiceId], references: [id])
  invoicePayments InvoicePayment[]
  items           CreditNoteItem[]

  @@unique([tenantId, creditNoteNumber])
  @@index([customerId])
  @@index([status])
  @@index([tenantId])
}

/// Phase 4 (W5c): per-line breakdown of a credit note, derived from the SOURCE
/// invoice's lines by allocating the credit `amount` proportionally. Carries each
/// line's regulated category snapshot so the credit can faithfully reverse the
/// regulated sales ledger per category (the credit note header is a single lump sum
/// and can't). Only lines with a `trackedCategoryId` drive a ledger reversal.
model CreditNoteItem {
  id                String   @id @default(uuid())
  tenantId          String
  creditNoteId      String
  invoiceItemId     String?
  trackedCategoryId String?
  amount            Decimal  @default(0) @db.Decimal(12, 2) // credited net (pre-tax) portion
  qty               Decimal  @default(0) @db.Decimal(12, 3)
  categoryTax       Decimal  @default(0) @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([creditNoteId])
}

model Estimate {
  id             String         @id @default(uuid())
  estimateNumber String
  customerId     String
  status         EstimateStatus @default(DRAFT)
  subtotal       Decimal        @db.Decimal(10, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(10, 2)
  discount       Decimal        @default(0) @db.Decimal(10, 2)
  total          Decimal        @db.Decimal(10, 2)
  expiresAt      DateTime?
  notes          String?
  terms          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenantId       String?

  customer Customer       @relation(fields: [customerId], references: [id])
  tenant   Tenant?        @relation(fields: [tenantId], references: [id])
  items    EstimateItem[]

  @@unique([tenantId, estimateNumber])
  @@index([customerId])
  @@index([status])
  @@index([tenantId])
}

model EstimateItem {
  id            String    @id @default(uuid())
  estimateId    String
  description   String
  productId     String?
  qty           Decimal   @db.Decimal(10, 3)
  unitPrice     Decimal   @db.Decimal(10, 2)
  subtotal      Decimal   @db.Decimal(10, 2)
  priceType     PriceType @default(STANDARD)
  originalPrice Decimal?  @db.Decimal(10, 2)
  boxes         Int?
  pieces        Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenantId      String?

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  product  Product? @relation(fields: [productId], references: [id])

  @@index([estimateId])
  @@index([productId])
  @@index([tenantId])
}

// ─── Sprint 7: Vendor Bills (Accounts Payable) ───────────────────────────────

model VendorBill {
  id           String           @id @default(uuid())
  billNumber   String
  supplierId   String?
  status       VendorBillStatus @default(RECEIVED)
  totalOwed    Decimal          @db.Decimal(10, 2)
  totalPaid    Decimal          @default(0) @db.Decimal(10, 2)
  billDate     DateTime?
  dueDate      DateTime?
  receivedDate DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tenantId     String?

  supplier Supplier?        @relation(fields: [supplierId], references: [id])
  tenant   Tenant?          @relation(fields: [tenantId], references: [id])
  payments BillPayment[]
  items    VendorBillItem[]

  @@unique([tenantId, billNumber])
  @@index([supplierId])
  @@index([status])
  @@index([dueDate])
  @@index([tenantId])
}

model VendorBillItem {
  id           String   @id @default(uuid())
  vendorBillId String
  productId    String?
  description  String
  qty          Decimal  @db.Decimal(10, 3)
  unitCost     Decimal  @db.Decimal(10, 4)
  createdAt    DateTime @default(now())
  tenantId     String?

  vendorBill VendorBill @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  tenant     Tenant?    @relation(fields: [tenantId], references: [id])
  product    Product?   @relation(fields: [productId], references: [id])

  @@index([vendorBillId])
  @@index([productId])
  @@index([tenantId])
}

model BillPayment {
  id           String        @id @default(uuid())
  vendorBillId String
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  reference    String?
  notes        String?
  paidAt       DateTime      @default(now())
  createdAt    DateTime      @default(now())
  tenantId     String?

  vendorBill VendorBill @relation(fields: [vendorBillId], references: [id])
  tenant     Tenant?    @relation(fields: [tenantId], references: [id])

  @@index([vendorBillId])
  @@index([tenantId])
}

// ─── AI Product Mapping Memory ────────────────────────────────────────────────

model ProductMapping {
  id             String   @id @default(uuid())
  supplierName   String
  rawDescription String
  productId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenantId       String?

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  tenant  Tenant?  @relation(fields: [tenantId], references: [id])

  @@unique([supplierName, rawDescription])
  @@index([supplierName])
  @@index([tenantId])
}

// ─── Sprint 8: Returns / RMA ──────────────────────────────────────────────────

model Return {
  id           String       @id @default(uuid())
  returnNumber String?
  orderId      String
  customerId   String
  reason       ReturnReason
  status       ReturnStatus @default(PENDING)
  notes        String?
  photoUrls    String[]
  creditNoteId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tenantId     String?

  order    Order        @relation(fields: [orderId], references: [id])
  tenant   Tenant?      @relation(fields: [tenantId], references: [id])
  customer Customer     @relation(fields: [customerId], references: [id])
  items    ReturnItem[]

  @@unique([tenantId, returnNumber])
  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([tenantId])
}

model ReturnItem {
  id        String  @id @default(uuid())
  returnId  String
  productId String
  qty       Decimal @db.Decimal(10, 3)
  reason    String?
  restock   Boolean @default(true)
  tenantId  String?

  return  Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  tenant  Tenant? @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
  @@index([tenantId])
}

// ─── Advance Payments ─────────────────────────────────────────────────────────

model AdvancePayment {
  id         String        @id @default(uuid())
  customerId String
  amount     Decimal       @db.Decimal(10, 2)
  balance    Decimal       @db.Decimal(10, 2)
  method     PaymentMethod
  reference  String?
  notes      String?
  receivedAt DateTime      @default(now())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  tenantId   String?

  customer     Customer         @relation(fields: [customerId], references: [id])
  tenant       Tenant?          @relation(fields: [tenantId], references: [id])
  applications InvoicePayment[]

  @@index([customerId])
  @@index([tenantId])
}

// ─── Recurring Invoices ───────────────────────────────────────────────────────

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model RecurringInvoice {
  id          String             @id @default(uuid())
  customerId  String
  frequency   RecurringFrequency
  dayOfWeek   Int?
  dayOfMonth  Int?
  isActive    Boolean            @default(true)
  autoSend    Boolean            @default(false)
  notes       String?
  terms       String?
  discount    Decimal            @default(0) @db.Decimal(10, 2)
  shippingFee Decimal            @default(0) @db.Decimal(10, 2)
  nextRunAt   DateTime
  lastRunAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenantId    String?

  customer Customer               @relation(fields: [customerId], references: [id])
  tenant   Tenant?                @relation(fields: [tenantId], references: [id])
  items    RecurringInvoiceItem[]
  invoices Invoice[]

  @@index([customerId])
  @@index([isActive, nextRunAt])
  @@index([tenantId])
}

model RecurringInvoiceItem {
  id                 String  @id @default(uuid())
  recurringInvoiceId String
  productId          String?
  description        String
  qty                Decimal @db.Decimal(10, 3)
  unitPrice          Decimal @db.Decimal(10, 2)
  discount           Decimal @default(0) @db.Decimal(10, 2)
  taxRate            Decimal @default(0) @db.Decimal(5, 4)
  tenantId           String?

  recurringInvoice RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  tenant           Tenant?          @relation(fields: [tenantId], references: [id])
  product          Product?         @relation(fields: [productId], references: [id])

  @@index([recurringInvoiceId])
  @@index([tenantId])
}

// ─── Driver-to-Dispatcher Messaging ──────────────────────────────────────────

model Message {
  id         String   @id @default(uuid())
  runId      String?
  text       String
  senderId   String
  senderRole String // "DRIVER" | "OPERATOR"
  createdAt  DateTime @default(now())
  tenantId   String?

  // P6-1 (F0): additively generalize the run-chat Message into a channel-aware,
  // thread-attachable message. Existing driver run-chat rows keep threadId=NULL
  // and channel=INTERNAL (both defaulted), so the create/read paths are unchanged.
  threadId String?
  channel  MessageChannel @default(INTERNAL)

  sender User           @relation(fields: [senderId], references: [id])
  tenant Tenant?        @relation(fields: [tenantId], references: [id])
  thread MessageThread? @relation(fields: [threadId], references: [id])

  @@index([runId])
  @@index([senderId])
  @@index([tenantId])
  @@index([threadId])
}

// ─── P6-1 (F0): Unified messaging — threads, templates, rules, consent ────────
// Additive foundation for the P6 messaging phase. NOTHING here is wired to a
// provider yet (StubProvider + real adapters land in P6-3/P6-4); this is the
// schema substrate the engine/inbox/settings build on. All tenant-scoped.

enum MessageChannel {
  INTERNAL // driver ↔ operator run-chat (default; never metered, never STOP-gated)
  WHATSAPP // metered (MSGS), STOP-gated, consent-gated
  SMS // metered (MSGS), STOP-gated, consent-gated
  EMAIL // never metered
  PORTAL // buyer-portal chat; never metered
}

enum ThreadStatus {
  OPEN
  SNOOZED
  CLOSED
}

enum WaApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum TriageStatus {
  PENDING
  LINKED
  DISMISSED
}

// Catalogue of notification triggers the rules matrix + templates key off.
enum NotificationEvent {
  ORDER_CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  ORDER_CHANGED_AT_DOOR
  INVOICE_SENT // email/portal only; WA/SMS cells render disabled
  PAYMENT_REMINDER
  LICENSE_EXPIRING
  URGENT_ORDER_PLACED // internal alert
  LOW_STOCK // internal alert
  FAILED_DELIVERY // internal alert
  PAYMENT_FAILED_NSF // internal alert
}

// One conversation with a customer across all channels (the inbox row).
model MessageThread {
  id                 String          @id @default(uuid())
  tenantId           String?
  customerId         String?
  lastChannel        MessageChannel?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  unreadCount        Int             @default(0)
  status             ThreadStatus    @default(OPEN)
  snoozedUntil       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  messages Message[]

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, status])
}

// Per-event/-channel message body with {{var}} placeholders (+ Meta WA template ref).
model MessageTemplate {
  id               String            @id @default(uuid())
  tenantId         String?
  eventKey         NotificationEvent
  channel          MessageChannel
  body             String
  variables        String[]          @default([])
  waTemplateName   String?
  waApprovalStatus WaApprovalStatus  @default(NONE)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, eventKey, channel])
  @@index([tenantId])
}

// The Settings → Notifications matrix cell state (event × channel → on/off).
model NotificationRule {
  id        String            @id @default(uuid())
  tenantId  String?
  eventKey  NotificationEvent
  channel   MessageChannel
  enabled   Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, eventKey, channel])
  @@index([tenantId])
}

// STOP-reply / manual opt-out state for the metered, STOP-capable channels.
model MessageOptOut {
  id         String         @id @default(uuid())
  tenantId   String?
  customerId String?
  phone      String?
  channel    MessageChannel
  optedOutAt DateTime       @default(now())
  reason     String?
  source     String? // e.g. "STOP"

  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@unique([tenantId, customerId, channel])
  @@index([tenantId])
  @@index([tenantId, phone])
}

// Per-tenant messaging config singleton. Provider credentials (Meta WA / Twilio)
// are deferred to P6-3 (encrypted via EncryptionService when the adapters land).
model MessagingSettings {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  quietHoursEnabled Boolean  @default(true)
  quietHoursStart   String   @default("21:00")
  quietHoursEnd     String   @default("07:00")
  timezone          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// Inbound message from an unknown number → operator triage queue (link/dismiss).
model InboundTriage {
  id                 String         @id @default(uuid())
  tenantId           String?
  channel            MessageChannel
  fromNumber         String
  body               String
  providerMsgId      String?
  status             TriageStatus   @default(PENDING)
  resolvedCustomerId String?
  resolvedById       String?
  resolvedAt         DateTime?
  receivedAt         DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
}

// ─── Customer Special Prices ──────────────────────────────────────────────────

model CustomerPrice {
  id          String   @id @default(uuid())
  customerId  String
  productId   String
  pricingTier Int
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([tenantId])
}

// ─── Buyer Portal ─────────────────────────────────────────────────────────────

model BuyerAccount {
  id                  String             @id @default(uuid())
  email               String             @unique
  passwordHash        String
  // false only for Google-auto-created accounts (random unguessable hash) —
  // gates the no-current-password "set password" flow. Accounts created via
  // Google before this column existed keep the default true and must use the
  // email reset flow instead (indistinguishable from password accounts).
  passwordSet         Boolean            @default(true)
  name                String
  phone               String?
  mobile              String?
  googleId            String?            @unique
  status              BuyerAccountStatus @default(ACTIVE)
  emailVerified       Boolean            @default(false)
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  mergedIntoId        String? // audit: set on the secondary after a completed merge

  customerLinks            CustomerLink[]
  refreshTokens            BuyerRefreshToken[]
  passwordResetTokens      BuyerPasswordResetToken[]
  mergeRequestsAsPrimary   BuyerMergeRequest[]       @relation("MergeAsPrimary")
  mergeRequestsAsSecondary BuyerMergeRequest[]       @relation("MergeAsSecondary")
  favorites                BuyerFavorite[]

  @@index([email])
  @@index([status])
  @@index([deletedAt])
}

model CustomerLink {
  id              String             @id @default(uuid())
  buyerAccountId  String? // null while invite is pending acceptance
  customerId      String             @unique
  tenantId        String
  status          CustomerLinkStatus @default(INVITED)
  inviteToken     String?            @unique
  inviteExpiresAt DateTime?
  inviteMethod    InviteMethod?
  linkedAt        DateTime?
  disconnectedAt  DateTime?
  disconnectedBy  DisconnectedBy?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  buyerAccount BuyerAccount? @relation(fields: [buyerAccountId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id])

  @@index([buyerAccountId])
  @@index([tenantId])
  @@index([inviteToken])
  @@index([status])
}

model BuyerRefreshToken {
  id             String    @id @default(uuid())
  buyerAccountId String
  tokenHash      String    @unique
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  userAgent      String?
  ipAddress      String?
  deviceName     String?
  lastUsedAt     DateTime?

  buyerAccount BuyerAccount @relation(fields: [buyerAccountId], references: [id], onDelete: Cascade)

  @@index([buyerAccountId])
  @@index([expiresAt])
}

// Mirrors PasswordResetToken for BuyerAccount — kept as a separate model (like
// RefreshToken/BuyerRefreshToken) so staff and buyer reset tokens can never be
// confused for one another.
model BuyerPasswordResetToken {
  id             String    @id @default(uuid())
  buyerAccountId String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  buyerAccount BuyerAccount @relation(fields: [buyerAccountId], references: [id], onDelete: Cascade)

  @@index([buyerAccountId])
  @@index([expiresAt])
}

// ─── Audit Logging ────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  ip         String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Buyer Account Merge Requests ─────────────────────────────────────────────

model BuyerMergeRequest {
  id                  String                  @id @default(uuid())
  primaryAccountId    String
  secondaryAccountId  String
  status              BuyerMergeRequestStatus @default(PENDING_VERIFICATION)
  initiatedBy         MergeInitiator
  initiatedByTenantId String?
  initiatorNotes      String?
  adminNotes          String?
  verificationToken   String?                 @unique
  verificationExpires DateTime?
  verifiedAt          DateTime?
  completedAt         DateTime?
  rejectedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  primaryAccount   BuyerAccount @relation("MergeAsPrimary", fields: [primaryAccountId], references: [id])
  secondaryAccount BuyerAccount @relation("MergeAsSecondary", fields: [secondaryAccountId], references: [id])
  initiatingTenant Tenant?      @relation(fields: [initiatedByTenantId], references: [id])

  @@index([primaryAccountId])
  @@index([secondaryAccountId])
  @@index([status])
  @@index([verificationToken])
}

enum BuyerMergeRequestStatus {
  PENDING_VERIFICATION
  PENDING_REVIEW
  COMPLETED
  REJECTED
}

enum MergeInitiator {
  BUYER
  TENANT
  SUPER_ADMIN
}

// ─── Buyer Favorites ──────────────────────────────────────────────────────────

model BuyerFavorite {
  id             String   @id @default(uuid())
  buyerAccountId String
  customerId     String
  productId      String
  tenantId       String
  createdAt      DateTime @default(now())

  buyerAccount BuyerAccount @relation(fields: [buyerAccountId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id])

  @@unique([buyerAccountId, customerId, productId])
  @@index([buyerAccountId, customerId])
  @@index([tenantId])
}

// ─── Replenishment Snooze (P5-06 Your Shelf) ──────────────────────────────────

/// Buyer-side "not this cycle" suppression of one replenishment estimate.
/// One row per (tenant, customer, product); snoozedUntil = now + one inferred
/// cadence (14d fallback). Rows past snoozedUntil are simply ignored on read.
model ReplenishmentSnooze {
  id           String   @id @default(uuid())
  tenantId     String?
  customerId   String
  productId    String
  snoozedUntil DateTime
  createdAt    DateTime @default(now())

  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, customerId, productId])
  @@index([customerId])
  @@index([tenantId])
}

// ─── Tobacco Compliance (tobacco_dealer addon) ────────────────────────────────

enum TobaccoReportStatus {
  GENERATED
  FAILED
}

/// Point-in-time monthly regulatory snapshot of tobacco purchases/sales.
/// `rows` is a JSON snapshot (never queried relationally); the CSV/PDF are
/// persisted at deterministic storage keys and regenerations are audited.
model TobaccoReport {
  id                 String              @id @default(uuid())
  tenantId           String
  periodYear         Int
  periodMonth        Int // 1-12
  periodStart        DateTime
  periodEnd          DateTime
  status             TobaccoReportStatus @default(GENERATED)
  // Denormalized totals for list views
  totalQtyPurchased  Decimal             @default(0) @db.Decimal(12, 3)
  totalPurchaseValue Decimal             @default(0) @db.Decimal(12, 2)
  totalQtySold       Decimal             @default(0) @db.Decimal(12, 3)
  totalSalesValue    Decimal             @default(0) @db.Decimal(12, 2)
  totalTaxCollected  Decimal             @default(0) @db.Decimal(12, 2)
  endingStockQty     Decimal             @default(0) @db.Decimal(12, 3)
  endingStockValue   Decimal             @default(0) @db.Decimal(12, 2)
  rows               Json
  csvKey             String?
  pdfKey             String?
  generatedAt        DateTime            @default(now())
  generatedById      String? // null = cron
  generationCount    Int                 @default(1)
  errorMessage       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodYear, periodMonth])
  @@index([tenantId])
}

/// Parked sale/order/invoice drafts (pos-cost-roles-spec §2 — Minimize & resume).
/// Per-user, tenant-scoped; `payload` is the full builder state so a draft
/// restores exactly. Additive/new — does not touch any existing table.
model SaleDraft {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String // owner — drafts are per-user
  kind         String   @default("ORDER") // ORDER | INVOICE
  customerId   String?
  customerName String? // denormalized label for the draft dock (no join needed)
  title        String?
  payload      Json // full builder state (line items, prices, delivery date, …)
  device       String? // originating device hint
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, updatedAt])
}

// ─── Regulated / Tracked Categories (Phase 4 — generalizes tobacco) ────────────
// Tobacco is seed row #1 of this generic system, never a special case in code.
// `Product.isTobacco` is kept as a shadow column for one release; the new
// `Product.trackedCategoryId` FK is the going-forward source of truth.

/// How a tracked category computes its category-specific tax at sale time.
/// NONE = tracked/reported but no auto tax added. Tobacco seeds as NONE so the
/// current warn-only behavior is preserved until the W3 tax calculator ships.
enum TrackedCategoryTaxType {
  EXCISE_PER_UNIT
  PERCENT_OF_SALE
  PER_VOLUME
  DEPOSIT_PER_CONTAINER
  NONE
}

/// How regulated lines are presented on invoices.
/// SEPARATE_INVOICE = one paired invoice per category (default); SEPARATE_SECTION
/// = a sectioned block on the main invoice; LINE_TAX = per-line tax (e.g. CRV).
enum InvoiceTreatment {
  SEPARATE_INVOICE
  SEPARATE_SECTION
  LINE_TAX
}

enum ReportCadence {
  MONTHLY
  QUARTERLY
  ANNUAL
}

/// Per-seller authorization (license) state for a customer buying a regulated
/// category. Verification is per seller relationship.
enum AuthorizationStatus {
  NONE
  PENDING_REVIEW
  VERIFIED
  EXPIRED
  REJECTED
}

enum AuthorizationSource {
  RETAILER_SUBMITTED
  WHOLESALER_ADDED
}

/// A regulated-sales-ledger row is either an original SALE or a REVERSAL
/// (credit note / return). Amounts on REVERSAL rows are stored negative so a
/// plain SUM() nets to the reportable figure.
enum LedgerEntryType {
  SALE
  REVERSAL
}

/// A regulated filing is either successfully GENERATED (artifacts stored) or a
/// FAILED attempt (recorded so the tenant still sees it in their filing list).
enum RegulatedFilingStatus {
  GENERATED
  FAILED
}

/// A tenant-defined class of items handled separately for sales/tax/reporting
/// (tobacco, alcohol, CRV deposits, city sugar taxes…). Deactivation
/// (active=false) keeps historic sales/ledger data intact.
model TrackedCategory {
  id               String                 @id @default(uuid())
  tenantId         String
  name             String
  taxType          TrackedCategoryTaxType @default(NONE)
  // Interpreted by taxType. PERCENT_OF_SALE stores a fraction (0.05 = 5%),
  // matching the existing InvoiceItem.taxRate convention; the per-unit/volume
  // variants store an absolute amount per `unitBasis`.
  rate             Decimal                @default(0) @db.Decimal(12, 4)
  unitBasis        String? // pack, oz, container… what `rate` multiplies
  priceIncludesTax Boolean                @default(false)
  invoiceTreatment InvoiceTreatment       @default(SEPARATE_INVOICE)
  appliesScope     Json? // optional geo/customer scoping, e.g. {cities:["Oakland"]}
  requiresLicense  Boolean                @default(false)
  // Phase 4 (W7b): per-category POD policy — when set, a delivery stop containing
  // a product in this category demands the driver capture an age check and/or an
  // identity check (with signature POD, no safe-drop) before the stop completes.
  requiresAgeCheck Boolean                @default(false)
  requiresIdCheck  Boolean                @default(false)
  reportTemplate   String                 @default("GENERIC") // CA_CDTFA | CA_ABC | CALRECYCLE | GENERIC
  reportCadence    ReportCadence          @default(MONTHLY)
  active           Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products       Product[]
  orderItems     OrderItem[]
  invoiceItems   InvoiceItem[]
  authorizations CustomerAuthorization[]
  overrides      AuthorizationOverride[]
  ledgerEntries  RegulatedSalesLedger[]
  filings        RegulatedFiling[]
  subcategories  TrackedSubcategory[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, active])
}

/// Phase 4 (subcategories): a classification child UNDER a TrackedCategory
/// (section) — e.g. Tobacco → {cigarettes, chewing-tobacco}, Liquor → {beer,
/// wine, spirits}. REPORTING/CLASSIFICATION ONLY: it carries no license/age/ID/
/// invoice/tax semantics (all of those stay on the parent section, which is what
/// keeps the regulated guards + money paths safe). A product may point to a
/// subcategory IN ADDITION to its section; the subcategory's parent must equal
/// the product's section (enforced app-side).
model TrackedSubcategory {
  id                String   @id @default(uuid())
  tenantId          String
  trackedCategoryId String // parent section
  name              String
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trackedCategory TrackedCategory @relation(fields: [trackedCategoryId], references: [id], onDelete: Cascade)
  products        Product[]
  orderItems      OrderItem[]
  invoiceItems    InvoiceItem[]

  @@unique([tenantId, trackedCategoryId, name])
  @@index([tenantId])
  @@index([trackedCategoryId])
}

/// Per-customer, per-category authorization state for one seller (the tenant).
/// One row per customer+category. Two paths to VERIFIED: retailer-submitted
/// (buyer adds → seller approves) or wholesaler-added (VERIFIED immediately).
model CustomerAuthorization {
  id                         String              @id @default(uuid())
  tenantId                   String
  customerId                 String
  trackedCategoryId          String
  status                     AuthorizationStatus @default(NONE)
  source                     AuthorizationSource @default(WHOLESALER_ADDED)
  licenseNumber              String?
  expiresAt                  DateTime?
  documentKey                String?
  // Actor identity is stored as an immutable point-in-time SNAPSHOT (FK-less id +
  // display name) so the compliance audit survives the operator being deleted.
  verifiedById               String?
  verifiedByName             String?
  verifiedAt                 DateTime?
  // W7 expiry-notification idempotency (no in-app notification store to dedupe
  // against): the EXPIRED-flip notice fires once; expiringSoonNotifiedBucket holds
  // the last-sent warning bucket (30/7/1) so each fires at most once. Both reset to
  // null on renew()/create() so a re-verified→re-expired row notifies again.
  expiryNotifiedAt           DateTime?
  expiringSoonNotifiedBucket Int?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  trackedCategory TrackedCategory @relation(fields: [trackedCategoryId], references: [id], onDelete: Cascade)

  @@unique([customerId, trackedCategoryId])
  @@index([tenantId])
  @@index([customerId])
  @@index([trackedCategoryId])
  @@index([status])
  @@index([expiresAt])
  @@index([status, expiresAt])
}

/// Seller-side "sold under my responsibility" record when an operator sells a
/// regulated item to a customer without a verified license on file (spec §8).
/// Append-only audit trail — never mutated after creation.
model AuthorizationOverride {
  id                 String   @id @default(uuid())
  tenantId           String
  customerId         String
  trackedCategoryId  String
  scope              String // "ORDER:<id>" | "UNTIL:<iso-date>"
  reason             String
  acknowledgedTenant String? // tenant name captured in the acknowledgment checkbox
  // Immutable actor snapshot (FK-less id + display name) — the §8 responsibility
  // record must survive the accepting operator being deleted.
  acceptedById       String?
  acceptedByName     String?
  acceptedAt         DateTime @default(now())
  createdAt          DateTime @default(now())

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  trackedCategory TrackedCategory @relation(fields: [trackedCategoryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@index([trackedCategoryId])
  @@index([customerId, trackedCategoryId])
}

/// Immutable per-line ledger of regulated sales — the source of truth for
/// filings. Written on invoice-line creation (SALE, positive) and reversed on
/// credit note / return (REVERSAL, negative) against the correct sibling
/// invoice. The order/invoice/creditNote pointers are denormalized scalars
/// (indexed, no FK) so the ledger stays append-only and self-contained.
model RegulatedSalesLedger {
  id                String          @id @default(uuid())
  tenantId          String
  trackedCategoryId String
  entryType         LedgerEntryType @default(SALE)
  orderId           String?
  orderItemId       String?
  invoiceId         String?
  invoiceItemId     String?
  creditNoteId      String?
  returnId          String? // W5c: set on return-driven REVERSAL rows (idempotency key)
  qty               Decimal         @db.Decimal(12, 3)
  unitBasisQty      Decimal         @default(0) @db.Decimal(12, 3) // qty expressed in the category's unitBasis
  netSales          Decimal         @default(0) @db.Decimal(12, 2)
  categoryTax       Decimal         @default(0) @db.Decimal(12, 2)
  soldAt            DateTime
  periodBucket      String // "YYYY-MM" denormalized bucket for fast monthly aggregation
  createdAt         DateTime        @default(now())

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trackedCategory TrackedCategory @relation(fields: [trackedCategoryId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([trackedCategoryId])
  @@index([tenantId, trackedCategoryId, periodBucket])
  @@index([invoiceId])
  @@index([invoiceItemId])
  @@index([orderItemId])
  @@index([creditNoteId])
  @@index([returnId])
}

/// A prepared regulatory filing for one category + period (the generic superset
/// of TobaccoReport). Computed from the RegulatedSalesLedger's pre-signed nets,
/// so a reversal-heavy period legitimately nets down. Keyed by a single
/// `periodKey` string so MONTHLY / QUARTERLY / ANNUAL cadences share one column.
model RegulatedFiling {
  id                String                @id @default(uuid())
  tenantId          String
  trackedCategoryId String
  reportTemplate    String // snapshot of category.reportTemplate at prepare time
  cadence           ReportCadence         @default(MONTHLY) // snapshot of category.reportCadence
  periodKey         String // "YYYY-MM" | "YYYY-Qn" | "YYYY"
  periodStart       DateTime // UTC inclusive start
  periodEnd         DateTime // UTC EXCLUSIVE end (half-open, matches period.ts)
  status            RegulatedFilingStatus @default(GENERATED)
  // Denormalized signed net totals (the pre-signed ledger already nets).
  totalQty          Decimal               @default(0) @db.Decimal(12, 3)
  totalUnitBasisQty Decimal               @default(0) @db.Decimal(12, 3)
  totalNetSales     Decimal               @default(0) @db.Decimal(12, 2)
  totalCategoryTax  Decimal               @default(0) @db.Decimal(12, 2)
  rows              Json // per-(category, periodBucket) snapshot, drives the CSV
  csvKey            String?
  pdfKey            String? // reserved; W5b ships CSV only
  generatedAt       DateTime              @default(now())
  generatedById     String? // null = cron/system
  generationCount   Int                   @default(1)
  errorMessage      String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trackedCategory TrackedCategory @relation(fields: [trackedCategoryId], references: [id], onDelete: Restrict)

  @@unique([tenantId, trackedCategoryId, periodKey])
  @@index([tenantId])
  @@index([tenantId, trackedCategoryId])
  @@index([trackedCategoryId])
}

// ─── Migration & Batch Import (Phase 1: numbering continuity) ─────────────────

/// Per-tenant, per-document-type numbering sequence. Set during migration from
/// the source's last number ("last Zoho invoice INV-08841 → RouteFlow starts at
/// INV-08842"); editable later in Settings → Invoicing. `NumberingService` owns
/// the collision-guarded `reserveNext(docType)` that formats `prefix +
/// nextNumber.padStart(padding)`. Wiring that into LIVE document minting is a
/// deferred cross-module change (invoices/orders own those call sites); this
/// table + service is the contract they consume. Imported documents keep their
/// ORIGINAL numbers and do NOT consume this sequence. `tenantId` is a plain
/// scalar (tenant-scoped via `forTenant()`), no FK — keeps this an append-only
/// addition that never edits the shared Tenant model.
model NumberingSequence {
  id         String             @id @default(uuid())
  tenantId   String
  docType    DocumentNumberType
  prefix     String             @default("")
  nextNumber Int                @default(1)
  padding    Int                @default(4)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([tenantId, docType])
  @@index([tenantId])
}

enum DocumentNumberType {
  INVOICE
  ESTIMATE
  CREDIT_NOTE
  PAYMENT
}

// ─── Migration & Batch Import (Phase 2: idempotency substrate) ────────────────

/// Generic external-source reference for migrated/imported records (spec §2). A
/// side table keyed by (source, externalId) so a re-run UPSERTS one local row and
/// never duplicates — WITHOUT adding columns to off-limits finance models
/// (Invoice/Payment/CreditNote/VendorBill). External value format: "zoho:inv_884412"
/// (stored split as externalSource="zoho", externalId="inv_884412"). Pointers are
/// plain scalars (no FK) so this stays an append-only addition.
model ImportExternalRef {
  id             String           @id @default(uuid())
  tenantId       String
  entityType     ImportEntityType
  entityId       String
  externalSource String
  externalId     String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([tenantId, externalSource, externalId, entityType])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, entityType])
}

enum ImportEntityType {
  CUSTOMER
  INVOICE
  PAYMENT
  PRODUCT
  SUPPLIER
  CREDIT_NOTE
  VENDOR_BILL
}

/// Learned mapping from a supplier's raw line text to a local product/variant or
/// expense category (spec §5.3), so the next scan/import auto-matches. Tenant-scoped
/// unique key fixes the cross-tenant collision in the older global ProductMapping.
/// `supplierId=""` is the sentinel for "any supplier" (empty string, not NULL, so
/// the unique constraint actually dedupes any-supplier aliases). Target pointers are
/// plain scalars (no FK); resolve() verifies the target still exists.
model ProductAlias {
  id                String   @id @default(uuid())
  tenantId          String
  supplierId        String   @default("")
  rawText           String
  productId         String?
  expenseCategoryId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, supplierId, rawText])
  @@index([tenantId, rawText])
  @@index([tenantId, supplierId])
}

// ─── Migration & Batch Import (Phase 4: migration staging + jobs + 24h undo) ──

enum MigrationSource {
  ZOHO
  QUICKBOOKS
  CSV
  PAPER
}

enum MigrationJobStatus {
  FETCHING
  STAGED
  CONFIRMED
  UNDONE
  FAILED
}

enum StagingRecordStatus {
  PENDING // staged, awaiting confirm
  DUPLICATE // matched an existing record; skipped on confirm, linked
  COMMITTED // written live on confirm
  SKIPPED // committer not wired for this type yet, or user-skipped
  REVERSED // removed by a 24h undo
}

/// A migration run: fetch a source into a staging area, review, then confirm to
/// live with a 24h undo window (spec §3). NOTHING is live until CONFIRMED.
model MigrationJob {
  id           String             @id @default(uuid())
  tenantId     String
  source       MigrationSource
  status       MigrationJobStatus @default(FETCHING)
  scopeCounts  Json               @default("{}") // {customers, products, invoices, ...}
  createdById  String?
  confirmedAt  DateTime?
  undoDeadline DateTime? // confirmedAt + 24h
  undoneAt     DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  records MigrationStagingRecord[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

/// One staged record (not live) of a MigrationJob. Carries the raw source payload,
/// a dedup verdict, and — after confirm — the id of the live row it created (so a
/// 24h undo reverses exactly what it added, and re-runs upsert by external id).
model MigrationStagingRecord {
  id              String              @id @default(uuid())
  tenantId        String
  jobId           String
  entityType      ImportEntityType
  externalId      String?
  rawPayload      Json
  status          StagingRecordStatus @default(PENDING)
  flags           Json                @default("[]") // ["duplicate","unmatched-tax",...]
  matchedEntityId String? // existing row this duplicates (for linking)
  createdEntityId String? // live row created on confirm
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  job MigrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([tenantId, jobId])
  @@index([jobId, status])
}

// ─── Migration & Batch Import (Phase 5: batch invoice import queue) ───────────

enum ImportFileStatus {
  QUEUED
  PROCESSING
  CLEAN // all lines matched, no dup — auto-ready to post
  NEEDS_REVIEW // an unmatched line or low-confidence totals
  DUPLICATE // matched an existing bill/invoice — skipped, linked
  FAILED // extraction error; queue keeps the file
  POSTED
}

enum ImportBatchStatus {
  PROCESSING
  READY
  POSTED
  PARTIALLY_POSTED
}

/// A batch of scanned invoices/bills processed in the background (spec §4):
/// upload many, review later, "Finish: post N bills". Posting reuses the
/// vendor-bill receive path (stock + costing). meteredScans feeds the AI-scan
/// meter; the cap check integrates with billing (off-limits) as a follow-up.
model ImportBatch {
  id           String            @id @default(uuid())
  tenantId     String
  kind         String            @default("BATCH_BILLS")
  status       ImportBatchStatus @default(PROCESSING)
  totalFiles   Int               @default(0)
  cleanCount   Int               @default(0)
  reviewCount  Int               @default(0)
  dupeCount    Int               @default(0)
  postedCount  Int               @default(0)
  meteredScans Int               @default(0)
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  postedAt     DateTime?

  items ImportQueueItem[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

/// One file in a batch, with its per-file status + extracted payload. The
/// duplicate pointer is a denormalized scalar (indexed, no FK) so this never
/// edits the off-limits Invoice/VendorBill models.
model ImportQueueItem {
  id                   String           @id @default(uuid())
  tenantId             String
  batchId              String
  filename             String?
  mimeType             String?
  status               ImportFileStatus @default(QUEUED)
  extractedPayload     Json?
  supplierMatchId      String?
  supplierName         String?
  invoiceNumber        String?
  total                Decimal?         @db.Decimal(12, 2)
  duplicateOfInvoiceId String?
  confidence           Decimal?         @db.Decimal(5, 4)
  unmatchedLines       Int              @default(0)
  errorMessage         String?
  vendorBillId         String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([tenantId, batchId])
  @@index([batchId, status])
  @@index([duplicateOfInvoiceId])
}
