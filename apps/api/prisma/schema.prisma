// ─── Generator & Datasource ───────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  OPERATOR
  DRIVER
  CUSTOMER
}

enum TenantStatus {
  TRIAL
  ACTIVE
  READ_ONLY
  SUSPENDED
  CANCELLED
}

enum TenantPlan {
  STARTER
  TEAM
  BUSINESS
  PROFESSIONAL
  ENTERPRISE
}

// ─── Billing / plans-as-data (Phase: Plans & Billing) ─────────────────────────
// Plans are versioned reference data (PlanVersion → PlanDefinition + AddonSku);
// entitlement logic is driven off the string `planKey`, NOT the TenantPlan enum
// (kept as a legacy shadow). See docs/design-package/project/specs/pricing-plans.md.

enum PlanVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum MeterKey {
  SEATS
  ROUTES
  SCANS
  MSGS
  CUSTOMERS
}

enum AddonUnit {
  FLAT
  PER_USER
  PER_ROUTE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  OUT_FOR_DELIVERY
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

enum ItemStatus {
  PENDING
  CONFIRMED
  PARTIAL
  DELIVERED
  CANCELLED
}

enum RouteRunStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RouteRunStopStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum MutationType {
  DELIVERED
  PARTIAL
  REFUSED
  ADD_ON
  SUBSTITUTED
}

enum ChangeRequestType {
  ADD_ITEM
  CHANGE_QTY
  REMOVE_ITEM
  NOTE
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum TxnStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  CHECK
  ACH
  OTHER
  CREDIT_NOTE
  ADVANCE
  CREDIT_CARD
  ZELLE
}

enum PaymentStatus {
  DRAFT
  PAID
  VOID
}

// P5-12: lifecycle of a CHECK InvoicePayment. Always null on non-check payments.
enum CheckStatus {
  RECORDED
  DEPOSITED
  CLEARED
  BOUNCED
}

enum FulfillPath {
  ROUTE
  SHIP
}

enum RouteKind {
  SCHEDULED
  ADHOC
}

enum OrderSource {
  APP
  PHONE
  ROUTE
}

enum Platform {
  IOS
  ANDROID
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  WRITE_OFF
  COST_BASIS
}

enum CostingMethod {
  FIFO
  LIFO
  AVCO
  STANDARD
  // Last cost — every sale is costed at the most recent purchase lot's unit
  // cost (pos-cost-roles-spec §1). Additive value; see migration
  // 20260706040000_add_costing_last_cost.
  LAST_COST
}

// ─── New Enums (Zoho-parity) ──────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIAL
  PAID
  OVERDUE
  VOID
  WRITTEN_OFF
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  CONVERTED
}

enum CreditNoteStatus {
  ISSUED
  APPLIED
  VOID
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CLOSED
}

enum VendorBillStatus {
  DRAFT
  RECEIVED
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum InvoiceScanStatus {
  SCANNED // extracted, not yet turned into a bill (an abandoned review stops here)
  POSTED // became `vendorBillId`
  DISCARDED // operator threw it away on purpose
  DUPLICATE // repeats `duplicateOfId`; never posted
}

enum SupplierStatementScanStatus {
  SCANNED
  APPLIED
  DISCARDED
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  CUSTOMER_REFUSED
  QUALITY_ISSUE
  EXCESS_ORDER
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  REFUNDED
  PROCESSED
  CANCELLED
}

enum PriceType {
  STANDARD
  SPECIAL
  DISCOUNTED
  MANUAL
  PROMO // P5-04: line priced by an active buyer promotion (net unitPrice + originalPrice strikethrough)
}

// ─── Buyer Portal Enums ───────────────────────────────────────────────────────

enum BuyerAccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CustomerLinkStatus {
  INVITED
  PENDING_SELLER_APPROVAL
  ACTIVE
  DISCONNECTED
}

enum InviteMethod {
  EMAIL
  SMS
}

enum DisconnectedBy {
  BUYER
  SELLER
}

// ─── Tenant Models ────────────────────────────────────────────────────────────

model Tenant {
  id             String       @id @default(uuid())
  slug           String       @unique
  name           String
  status         TenantStatus @default(TRIAL)
  plan           TenantPlan   @default(STARTER)
  trialEndsAt    DateTime?
  // Billing plans-as-data: the published PlanVersion this tenant is pinned to
  // (the source of truth for entitlements; the `plan` enum stays a legacy shadow).
  planVersionId  String?
  readOnlyReason String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  users         User[]
  config        TenantConfig?
  googleOAuth   TenantGoogleOAuth?
  subscription  TenantSubscription?
  addons        TenantAddon[]
  planVersion   PlanVersion?        @relation(fields: [planVersionId], references: [id])
  meterUsages   MeterUsage[]
  billingEvents BillingEvent[]
  rfInvoices    RfInvoice[]

  userPreferences          UserPreference[]
  customers                Customer[]
  customerAddresses        CustomerAddress[]
  customerDocuments        CustomerDocument[]
  drivers                  Driver[]
  products                 Product[]
  routes                   Route[]
  routeStops               RouteStop[]
  routeCustomers           RouteCustomer[]
  routeRuns                RouteRun[]
  routeRunStops            RouteRunStop[]
  orders                   Order[]
  orderItems               OrderItem[]
  deliveryMutations        DeliveryMutation[]
  transactions             Transaction[]
  transactionItems         TransactionItem[]
  payments                 Payment[]
  deviceTokens             DeviceToken[]
  orderTemplates           OrderTemplate[]
  orderTemplateItems       OrderTemplateItem[]
  refreshTokens            RefreshToken[]
  suppliers                Supplier[]
  stockLots                StockLot[]
  stockMovements           StockMovement[]
  invoices                 Invoice[]
  invoiceItems             InvoiceItem[]
  invoicePayments          InvoicePayment[]
  paymentCounters          PaymentCounter[]
  expenseCategories        ExpenseCategory[]
  expenses                 Expense[]
  expenseLineItems         ExpenseLineItem[]
  mileageRates             MileageRate[]
  contactPersons           ContactPerson[]
  customerTags             CustomerTag[]
  customerTagAssignments   CustomerTagAssignment[]
  customerComments         CustomerComment[]
  purchaseOrders           PurchaseOrder[]
  purchaseOrderItems       PurchaseOrderItem[]
  creditNotes              CreditNote[]
  creditNoteItems          CreditNoteItem[]
  orderCreditNotes         OrderCreditNote[]
  estimates                Estimate[]
  estimateItems            EstimateItem[]
  vendorBills              VendorBill[]
  invoiceScans             InvoiceScan[]
  vendorBillItems          VendorBillItem[]
  billPayments             BillPayment[]
  productMappings          ProductMapping[]
  returns                  Return[]
  returnItems              ReturnItem[]
  advancePayments          AdvancePayment[]
  supplierCredits          SupplierCredit[]
  recurringInvoices        RecurringInvoice[]
  recurringInvoiceItems    RecurringInvoiceItem[]
  messages                 Message[]
  messageThreads           MessageThread[]
  messageTemplates         MessageTemplate[]
  notificationRules        NotificationRule[]
  messageOptOuts           MessageOptOut[]
  messagingSettings        MessagingSettings?
  inboundTriages           InboundTriage[]
  customerPrices           CustomerPrice[]
  systemConfigs            SystemConfig[]
  customerLinks            CustomerLink[]
  stripeConnect            TenantStripeConnect?
  buyerPaymentRequests     BuyerPaymentRequest[]
  buyerMergeRequests       BuyerMergeRequest[]
  buyerFavorites           BuyerFavorite[]
  deliveryBatches          DeliveryBatch[]
  driverLocations          DriverLocation[]
  tobaccoReports           TobaccoReport[]
  saleDrafts               SaleDraft[]
  trackedCategories        TrackedCategory[]
  trackedSubcategories     TrackedSubcategory[]
  customerAuthorizations   CustomerAuthorization[]
  authorizationOverrides   AuthorizationOverride[]
  regulatedSalesLedger     RegulatedSalesLedger[]
  regulatedFilings         RegulatedFiling[]
  promotions               Promotion[]
  orderRevisions           OrderRevision[]
  changeRequests           ChangeRequest[]
  replenishmentSnoozes     ReplenishmentSnooze[]
  stockAlerts              StockAlert[]
  stockCountSessions       StockCountSession[]
  stockCountLines          StockCountLine[]
  supplierStatementScans   SupplierStatementScan[]
  // ─── Sales agents & commissions (flag.sales_agents) ───
  salesAgents              SalesAgent[]
  salesAgentRates          SalesAgentRate[]
  customerCommissionRates  CustomerCommissionRate[]
  agentAssignments         AgentAssignment[]
  commissionAccruals       CommissionAccrual[]
  commissionAdjustments    CommissionAdjustment[]
  commissionStatements     CommissionStatement[]
  commissionStatementLines CommissionStatementLine[]
  commissionPayouts        CommissionPayout[]

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@index([planVersionId])
}

model TenantConfig {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  businessName  String?
  logoKey       String?
  primaryColor  String?
  timezone      String   @default("America/New_York")
  currency      String   @default("USD")
  taxRate       Decimal? @db.Decimal(5, 4)
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  zip           String?
  country       String?
  phone         String?
  website       String?
  smtpHost      String?
  smtpPort      Int?
  smtpSecure    Boolean  @default(true)
  smtpUser      String?
  smtpPassword  String?
  smtpFromName  String?
  smtpFromEmail String?
  customerEmail String?
  ownerName     String?
  invoiceNotes  String?
  invoiceTerms  String?
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantGoogleOAuth {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  clientId     String
  clientSecret String
  callbackUrl  String
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantSubscription {
  id                    String       @id @default(uuid())
  tenantId              String       @unique
  stripeCustomerId      String?
  stripeSubId           String?
  currentPlan           TenantPlan   @default(STARTER)
  periodStart           DateTime?
  periodEnd             DateTime?
  cancelAtPeriodEnd     Boolean      @default(false)
  // Plans-as-data + lifecycle (Plans & Billing). All nullable/defaulted so
  // existing rows are untouched; `planKey`/`planVersionId` are the new source of truth.
  planVersionId         String?
  planKey               String? // STARTER | TEAM | BUSINESS | ENTERPRISE
  cycle                 BillingCycle @default(MONTHLY)
  basePriceSnapshot     Decimal?     @db.Decimal(10, 2)
  discount              Decimal      @default(0) @db.Decimal(10, 2)
  downgradeToPlanKey    String?
  downgradeEffectiveAt  DateTime?
  retainedUserIds       String[]
  graceStartedAt        DateTime?
  graceMeter            MeterKey?
  trialConvertedAt      DateTime?
  nextChargeAt          DateTime?
  failedPaymentCount    Int          @default(0)
  // External (non-Stripe) payment tracking
  externalPayment       Boolean      @default(false)
  externalPaymentMethod String? // ZELLE | BANK_TRANSFER | CHECK | CASH | WIRE | OTHER
  externalPaymentRef    String? // transaction ID or confirmation number
  externalPaymentNotes  String?
  // Platform billing — catalog-driven Stripe prices (Plans & Billing pricing batch).
  // Per-tenant custom fee overrides; null = fall back to the catalog (PlanDefinition).
  priceOverrideMonthly  Decimal?     @db.Decimal(10, 2)
  priceOverrideAnnual   Decimal?     @db.Decimal(10, 2)
  billingInterval       String? // "month" | "year", stamped at checkout completion
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planVersion PlanVersion? @relation(fields: [planVersionId], references: [id])

  @@index([planVersionId])
  @@index([downgradeEffectiveAt])
}

model TenantAddon {
  id            String   @id @default(uuid())
  tenantId      String
  addonKey      String // e.g. "ai_scanning", "advanced_routes", "api_access"
  // Plans-as-data bridge: canonical SKU code (SEAT_EXTRA, BUYER_PORTAL, …). The
  // legacy free-text `addonKey` stays authoritative for existing consumers
  // (e.g. "tobacco_dealer") and is mapped to `sku="REGULATED_ITEMS"` additively.
  sku           String?
  quantity      Int      @default(1) // SEAT_EXTRA per-user, OCR_PACK_250 stacks
  priceSnapshot Decimal? @db.Decimal(10, 2)
  stripePriceId String? // Stripe price for this add-on
  stripeItemId  String? // Stripe subscription item ID
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, addonKey])
  @@index([tenantId])
  @@index([tenantId, sku])
}

// ─── Billing plan catalog (GLOBAL reference data — not tenant-scoped) ─────────

model PlanVersion {
  id          String            @id @default(uuid())
  version     Int               @unique
  status      PlanVersionStatus @default(DRAFT)
  effectiveAt DateTime?
  publishedAt DateTime?
  publishedBy String?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  definitions   PlanDefinition[]
  addonSkus     AddonSku[]
  tenants       Tenant[]
  subscriptions TenantSubscription[]

  @@index([status])
}

model PlanDefinition {
  id                String   @id @default(uuid())
  planVersionId     String
  planKey           String // STARTER | TEAM | BUSINESS | ENTERPRISE
  name              String
  monthlyPrice      Decimal? @db.Decimal(10, 2) // null = custom (Enterprise)
  annualPrice       Decimal? @db.Decimal(10, 2) // = monthlyPrice * 10
  isCustom          Boolean  @default(false)
  seatsIncluded     Int? // null = unlimited
  routesConcurrent  Int? // null = unlimited
  scansIncluded     Int? // null = unlimited (Enterprise)
  msgsIncluded      Int      @default(200)
  customersIncluded Int? // null = unlimited (Enterprise)
  featureFlags      String[] // subset of the 16 flag keys granted at this plan
  sortOrder         Int      @default(0)

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, planKey])
  @@index([planVersionId])
}

model AddonSku {
  id              String    @id @default(uuid())
  planVersionId   String
  sku             String // SEAT_EXTRA | BUYER_PORTAL | REGULATED_ITEMS | OCR_PACK_250 | FORECASTING | ROUTE_EXTRA | MSG_BUNDLE_500
  name            String
  monthlyPrice    Decimal   @db.Decimal(10, 2)
  unit            AddonUnit @default(FLAT)
  includedAtPlan  String? // planKey at/above which this addon is bundled free
  meteredKey      MeterKey? // capacity-adding: OCR_PACK→SCANS, MSG_BUNDLE→MSGS, SEAT_EXTRA→SEATS, ROUTE_EXTRA→ROUTES
  capacityPerUnit Int? // meter capacity added per active quantity
  stackable       Boolean   @default(false)
  grantsFlags     String[] // flag keys this addon grants while active
  sortOrder       Int       @default(0)

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, sku])
  @@index([planVersionId])
}

// ─── Per-tenant metering (tenant-scoped) ──────────────────────────────────────

model MeterUsage {
  id          String   @id @default(uuid())
  tenantId    String
  meter       MeterKey
  periodStart DateTime // billing-cycle bucket start
  periodEnd   DateTime
  used        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, meter, periodStart])
  @@index([tenantId, meter])
}

// ─── Billing audit / MRR source of truth (tenant-scoped) ──────────────────────

model BillingEvent {
  id          String   @id @default(uuid())
  tenantId    String
  type        String // plan.changed | addon.enabled/disabled | seat.added/freed | grace.started/expired | trial.converted/expired
  payload     Json
  amountDelta Decimal? @db.Decimal(10, 2) // MRR run-rate delta for reconciliation
  actorId     String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([type])
}

// ─── RouteFlow's own invoices to the tenant (platform billing) ────────────────

model RfInvoice {
  id       String       @id @default(uuid())
  tenantId String
  number   String       @unique // RF-YYYY-NNNN
  amount   Decimal      @db.Decimal(10, 2)
  status   String // PAID | OPEN | FAILED
  cycle    BillingCycle @default(MONTHLY)
  pdfKey   String?
  issuedAt DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, issuedAt])
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                  String     @id @default(uuid())
  email               String
  username            String
  password            String?
  googleId            String?
  role                UserRole
  status              UserStatus @default(ACTIVE)
  forcePasswordChange Boolean    @default(false)
  isAdmin             Boolean    @default(false)
  canActAsDriver      Boolean    @default(false)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?
  tenantId            String?

  tenant               Tenant?              @relation(fields: [tenantId], references: [id])
  customer             Customer?
  driver               Driver?
  deviceTokens         DeviceToken[]
  refreshTokens        RefreshToken[]
  stockMovements       StockMovement[]
  stockCountsStarted   StockCountSession[]  @relation("StockCountStarted")
  stockCountsCommitted StockCountSession[]  @relation("StockCountCommitted")
  stockCountLines      StockCountLine[]
  expenses             Expense[]
  messages             Message[]
  preferences          UserPreference[]
  passwordResetTokens  PasswordResetToken[]
  // Future AGENT-role login seat (records-only v1 — see SalesAgent.userId).
  salesAgentSeat       SalesAgent?

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@unique([tenantId, googleId])
  @@index([tenantId])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String
  updatedAt DateTime @updatedAt
  tenantId  String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([userId, key])
  @@index([userId])
  @@index([tenantId])
}

model Customer {
  id                    String      @id @default(uuid())
  userId                String      @unique
  businessName          String
  contactName           String
  phone                 String?
  notes                 String?
  zohoContactId         String?     @unique
  fulfillPath           FulfillPath @default(ROUTE)
  deliveryWindowStart   String?
  deliveryWindowEnd     String?
  email                 String?
  mobile                String?
  customerType          String      @default("BUSINESS")
  supplierOnly          Boolean     @default(false) // true = this contact is a vendor/supplier; hide from Customers list
  displayName           String?
  salutation            String?
  firstName             String?
  lastName              String?
  taxId                 String?
  isTaxExempt           Boolean     @default(false)
  taxExemptDocumentKeys String[]    @default([])
  // Retail tobacco license of the buying customer — surfaced (warn-only in
  // v1) when invoicing tobacco items to unlicensed/expired customers
  tobaccoLicenseNo      String?
  tobaccoLicenseExpiry  DateTime?
  creditLimit           Decimal?    @db.Decimal(10, 2)
  currency              String      @default("USD")
  pricingTier           Int         @default(1)
  // Per-customer default payment terms label ("this customer is always Net 60").
  // Empty string clears an override; null means "use the tenant default". Wins
  // over the tenant SystemConfig default in resolveDefaultTerms().
  defaultPaymentTerms   String?
  // P6-1 (F0): per-channel messaging consent (only the STOP-gated SMS/WA channels
  // carry consent; EMAIL/PORTAL don't). Additive — existing rows backfill to false.
  smsConsent            Boolean     @default(false)
  waConsent             Boolean     @default(false)
  consentUpdatedAt      DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  // RF-197: soft-delete timestamp; set instead of physically deleting when
  // the customer has financial records (orders / invoices / returns).
  deletedAt             DateTime?
  tenantId              String?

  user                 User                     @relation(fields: [userId], references: [id])
  tenant               Tenant?                  @relation(fields: [tenantId], references: [id])
  messageThreads       MessageThread[]
  messageOptOuts       MessageOptOut[]
  addresses            CustomerAddress[]
  routes               RouteCustomer[]
  routeStops           RouteStop[]
  orders               Order[]
  transactions         Transaction[]
  routeRunStops        RouteRunStop[]
  orderTemplates       OrderTemplate[]
  invoices             Invoice[]
  estimates            Estimate[]
  creditNotes          CreditNote[]
  returns              Return[]
  advancePayments      AdvancePayment[]
  recurringInvoices    RecurringInvoice[]
  prices               CustomerPrice[]
  expenses             Expense[]
  contactPersons       ContactPerson[]
  tagAssignments       CustomerTagAssignment[]
  comments             CustomerComment[]
  customerLink         CustomerLink?
  buyerPaymentRequests BuyerPaymentRequest[]
  buyerFavorites       BuyerFavorite[]
  deliveryBatches      DeliveryBatch[]
  documents            CustomerDocument[]
  authorizations       CustomerAuthorization[]
  authOverrides        AuthorizationOverride[]
  replenishmentSnoozes ReplenishmentSnooze[]
  stockAlerts          StockAlert[]
  agentAssignments     AgentAssignment[]
  commissionRates      CustomerCommissionRate[]
  commissionAccruals   CommissionAccrual[]

  @@index([zohoContactId])
  @@index([businessName])
  @@index([customerType])
  @@index([tenantId])
  // Present in production but absent from this model, so Prisma treated it as
  // drift and a generated migration would have DROPped it.
  @@index([deletedAt])
}

model CustomerDocument {
  id           String   @id @default(uuid())
  customerId   String
  storageKey   String
  originalName String
  mimeType     String
  sizeBytes    Int
  docType      String
  uploadedById String?
  createdAt    DateTime @default(now())
  tenantId     String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([customerId])
  @@index([tenantId])
}

model CustomerAddress {
  id          String   @id @default(uuid())
  customerId  String
  label       String   @default("default")
  line1       String
  line2       String?
  city        String
  state       String
  zip         String
  lat         Float?
  lng         Float?
  isDefault   Boolean  @default(false)
  addressType String   @default("BILLING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String?

  customer      Customer       @relation(fields: [customerId], references: [id])
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  routeStops    RouteStop[]
  routeRunStops RouteRunStop[]

  @@index([customerId])
  @@index([tenantId])
}

model Driver {
  id            String       @id @default(uuid())
  userId        String       @unique
  contactName   String?
  phone         String?
  status        DriverStatus @default(ACTIVE)
  vehicleMake   String?
  vehicleModel  String?
  vehicleColour String?
  vehiclePlate  String?
  homeLat       Float?
  homeLng       Float?
  homeAddress   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  tenantId      String?

  user              User               @relation(fields: [userId], references: [id])
  tenant            Tenant?            @relation(fields: [tenantId], references: [id])
  routes            Route[]
  routeRuns         RouteRun[]
  deliveryMutations DeliveryMutation[]
  deliveryBatches   DeliveryBatch[]
  locations         DriverLocation[]

  @@index([status])
  @@index([tenantId])
}

model DriverLocation {
  id         String   @id @default(uuid())
  tenantId   String?
  driverId   String
  runId      String?
  lat        Decimal  @db.Decimal(10, 7)
  lng        Decimal  @db.Decimal(10, 7)
  heading    Decimal? @db.Decimal(6, 2)
  speedKph   Decimal? @db.Decimal(6, 2)
  batteryPct Int?
  recordedAt DateTime
  createdAt  DateTime @default(now())

  driver Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  run    RouteRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  tenant Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, driverId, recordedAt])
  @@index([tenantId, runId, recordedAt])
}

model Product {
  id                   String        @id @default(uuid())
  name                 String
  description          String?
  sku                  String?
  // Optional retail-unit (inner piece) code; NULL ⇒ unit shares the case `sku`.
  // Read sites use `unitSku ?? sku`.
  unitSku              String?
  unit                 String
  pricePerUnit         Decimal       @db.Decimal(10, 2)
  priceTier2           Decimal       @default(0) @db.Decimal(10, 2)
  priceTier3           Decimal       @default(0) @db.Decimal(10, 2)
  priceTier4           Decimal       @default(0) @db.Decimal(10, 2)
  priceTier5           Decimal       @default(0) @db.Decimal(10, 2)
  // Suggested retail price (MSRP), per PIECE — the retail selling unit — even when this
  // product is sold wholesale by the box. Display-only: NEVER feed into money math
  // (computeLineSubtotal, totals, tax, margin, promotions). Null = no MSRP set, renders
  // blank, never $0.00. Universal default; CustomerPrice.msrp overrides it per customer.
  msrp                 Decimal?      @db.Decimal(10, 2)
  category             String?
  imageKeys            String[]      @default([])
  isActive             Boolean       @default(true)
  isFeatured           Boolean       @default(false)
  // Buyer merchandising flags (P5-01): drive catalogue tiles + smart collections.
  isNew                Boolean       @default(false)
  isDeal               Boolean       @default(false)
  // Regulated tobacco product — only settable when the tenant has the
  // "tobacco_dealer" addon; drives separate tracking + monthly tax reports
  isTobacco            Boolean       @default(false)
  barcode              String?
  currentStock         Decimal       @default(0) @db.Decimal(10, 3)
  averageCost          Decimal?      @db.Decimal(10, 4)
  // AVCO because every write path maintains `averageCost` via nextAverageCost and
  // valuation reads it back; the FIFO/LIFO lot-consumption path exists but has no
  // caller, so labelling products FIFO promised a costing basis nothing computed.
  costingMethod        CostingMethod @default(AVCO)
  standardCost         Decimal?      @db.Decimal(10, 4)
  reorderPoint         Int?
  reorderQty           Int?
  unitsPerBox          Int?
  parentProductId      String?
  variantName          String?
  // Phase 4: going-forward regulated-category pointer (one max per product);
  // supersedes `isTobacco`, which is kept as a shadow column for one release.
  trackedCategoryId    String?
  // Phase 4 (subcategories): optional finer classification WITHIN the section
  // above (reporting only, no compliance semantics). Parent must equal
  // trackedCategoryId (enforced app-side; Prisma can't express the composite FK).
  trackedSubcategoryId String?
  /// Regulatory reporting config (template-agnostic; the vocabulary is defined by
  /// the section's reportTemplate — see regulated/template-registry.ts).
  /// regUomUnit = UoM code for loose/unit quantities. regUomCase is OPTIONAL and
  /// opts the product into case-level bucketing when sold by the box; leaving it
  /// NULL makes the report pass quantities through unconverted (back-compat).
  regItemType          String?
  regUomCase           String?
  regUomUnit           String?
  // Migration & Batch Import (Phase 3): a brand-new product created from a scanned
  // invoice line with only name+SKU+cost is flagged incomplete until price/units
  // are confirmed. Surfaced under a "Finish setup" filter on the import surface.
  detailsIncomplete    Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  tenantId             String?

  tenant                Tenant?                @relation(fields: [tenantId], references: [id])
  orderItems            OrderItem[]
  deliveryMutations     DeliveryMutation[]
  changeRequests        ChangeRequest[]
  templateItems         OrderTemplateItem[]
  stockMovements        StockMovement[]
  stockLots             StockLot[]
  stockCountLines       StockCountLine[]
  invoiceItems          InvoiceItem[]
  estimateItems         EstimateItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  returnItems           ReturnItem[]
  recurringInvoiceItems RecurringInvoiceItem[]
  vendorBillItems       VendorBillItem[]
  customerPrices        CustomerPrice[]
  productMappings       ProductMapping[]
  buyerFavorites        BuyerFavorite[]
  promotionProducts     PromotionProduct[]
  replenishmentSnoozes  ReplenishmentSnooze[]
  stockAlerts           StockAlert[]
  parent                Product?               @relation("ProductVariants", fields: [parentProductId], references: [id])
  variants              Product[]              @relation("ProductVariants")
  trackedCategory       TrackedCategory?       @relation(fields: [trackedCategoryId], references: [id], onDelete: SetNull)
  trackedSubcategory    TrackedSubcategory?    @relation(fields: [trackedSubcategoryId], references: [id], onDelete: SetNull)

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@unique([tenantId, unitSku])
  // Name uniqueness is enforced via two raw-SQL PARTIAL unique indexes
  // (see migrations/20260504000000_variant_name_per_parent/migration.sql):
  //   - (tenantId, name)                    WHERE parentProductId IS NULL
  //       → standalone catalog stays flat-unique (no two parents named "X")
  //   - (tenantId, parentProductId, name)   WHERE parentProductId IS NOT NULL
  //       → variant names unique WITHIN their parent only
  //         ("Strawberry" can be a flavor under both Geek Next 50K and Geek Bar)
  // Prisma can't declare partial unique indexes; left here as a plain index
  // for name-search query speed only.
  @@index([tenantId, name])
  @@index([category])
  @@index([isActive])
  @@index([isFeatured])
  @@index([barcode])
  @@index([unitSku])
  @@index([parentProductId])
  @@index([tenantId])
  @@index([tenantId, isTobacco])
  @@index([tenantId, trackedCategoryId])
  @@index([trackedSubcategoryId])
  @@index([tenantId, detailsIncomplete])
}

/// Seller merchandising promotion (P5-01): evaluated at cart time (in pricing.ts) and
/// shown on tiles + a checkout savings line. Tenant-managed. Typed rules — no JSON DSL:
/// PERCENT / FIXED / QTY_BREAK / BUY_N_GET_M, scoped to all products, one category, or an
/// explicit product set, within a time window. Money math lives in pricing.ts, never here.
/// BUY_N_GET_M ("buy 5, get the 6th free") reuses minQty/value — NO dedicated columns:
/// minQty = N (buy quantity), value = M (free quantity), both required positive integers
/// for this type (PromotionsService.validateRule). Applies to whole SELLING units of the
/// line (boxes for a boxed product; loose pieces never count) — see OrderItem.promoFreeUnits.
model Promotion {
  id         String         @id @default(uuid())
  tenantId   String
  name       String
  bannerText String?
  type       PromotionType  @default(PERCENT)
  value      Decimal        @default(0) @db.Decimal(10, 2) // PERCENT/QTY_BREAK: % off. FIXED: $ off/selling unit. BUY_N_GET_M: M (free qty, integer >= 1).
  minQty     Int? // QTY_BREAK: threshold in pieces. BUY_N_GET_M: N (buy qty, integer >= 1, selling units).
  scope      PromotionScope @default(ALL)
  category   String? // when scope = CATEGORY
  startsAt   DateTime
  endsAt     DateTime
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products PromotionProduct[]

  @@index([tenantId])
  @@index([tenantId, isActive, startsAt, endsAt])
}

/// Join row when a Promotion scopes to an explicit product set (scope = PRODUCTS).
model PromotionProduct {
  id          String @id @default(uuid())
  tenantId    String
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([tenantId])
  @@index([productId])
}

enum PromotionType {
  PERCENT
  FIXED
  QTY_BREAK
  BUY_N_GET_M
}

enum PromotionScope {
  ALL
  CATEGORY
  PRODUCTS
}

model Route {
  id           String    @id @default(uuid())
  name         String
  driverId     String?
  isActive     Boolean   @default(true)
  depotLat     Float?
  depotLng     Float?
  depotAddress String?
  kind         RouteKind @default(SCHEDULED)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenantId     String?

  driver    Driver?         @relation(fields: [driverId], references: [id])
  tenant    Tenant?         @relation(fields: [tenantId], references: [id])
  stops     RouteStop[]
  customers RouteCustomer[]
  runs      RouteRun[]

  @@index([driverId])
  @@index([isActive])
  @@index([tenantId])
  @@index([tenantId, kind])
}

model RouteStop {
  id                String   @id @default(uuid())
  routeId           String
  customerId        String?
  customerAddressId String?
  stopNumber        Int
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenantId          String?

  route           Route            @relation(fields: [routeId], references: [id])
  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  customer        Customer?        @relation(fields: [customerId], references: [id])
  customerAddress CustomerAddress? @relation(fields: [customerAddressId], references: [id])
  routeRunStops   RouteRunStop[]

  @@unique([routeId, stopNumber])
  @@index([routeId])
  @@index([customerId])
  @@index([customerAddressId])
  @@index([tenantId])
}

model RouteCustomer {
  id         String   @id @default(uuid())
  routeId    String
  customerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenantId   String?

  route    Route    @relation(fields: [routeId], references: [id])
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([routeId, customerId])
  @@index([routeId])
  @@index([customerId])
  @@index([tenantId])
}

model RouteRun {
  id                String         @id @default(uuid())
  routeId           String
  driverId          String?
  status            RouteRunStatus @default(SCHEDULED)
  scheduledDate     DateTime
  startTime         String?
  depotLat          Float?
  depotLng          Float?
  depotAddress      String?
  startedAt         DateTime?
  completedAt       DateTime?
  manuallyReordered Boolean        @default(false)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  tenantId          String?

  route     Route            @relation(fields: [routeId], references: [id])
  tenant    Tenant?          @relation(fields: [tenantId], references: [id])
  driver    Driver?          @relation(fields: [driverId], references: [id])
  stops     RouteRunStop[]
  orders    Order[]
  locations DriverLocation[]

  @@index([routeId])
  @@index([driverId])
  @@index([status])
  @@index([scheduledDate])
  @@index([tenantId])
}

model RouteRunStop {
  id                    String             @id @default(uuid())
  routeRunId            String
  routeStopId           String
  customerId            String?
  customerAddressId     String?
  stopNumber            Int
  status                RouteRunStopStatus @default(PENDING)
  driverNote            String?
  arrivedAt             DateTime?
  completedAt           DateTime?
  notes                 String?
  podPhotoUrls          String[]
  signatureUrl          String?
  safeDropEnabled       Boolean            @default(false)
  // Phase 4: per-stop regulated-delivery flags surfaced on the driver stop card
  // (set when the stop contains a category demanding age / identity verification).
  ageCheckRequired      Boolean            @default(false)
  identityCheckRequired Boolean            @default(false)
  // Phase 4 (W7b): what the driver actually captured at a regulated delivery.
  // ageVerified/identityVerified are the affirmative check-offs; identityType is
  // the kind of ID inspected (DRIVERS_LICENSE, PASSPORT, STATE_ID, MILITARY_ID,
  // OTHER); identityVerifiedAt is stamped server-side when identity is confirmed.
  ageVerified           Boolean            @default(false)
  identityVerified      Boolean            @default(false)
  identityType          String?
  identityVerifiedAt    DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  tenantId              String?

  routeRun          RouteRun           @relation(fields: [routeRunId], references: [id])
  tenant            Tenant?            @relation(fields: [tenantId], references: [id])
  routeStop         RouteStop          @relation(fields: [routeStopId], references: [id])
  customer          Customer?          @relation(fields: [customerId], references: [id])
  customerAddress   CustomerAddress?   @relation(fields: [customerAddressId], references: [id])
  orders            Order[]
  deliveryMutations DeliveryMutation[]
  deliveryBatches   DeliveryBatch[]
  changeRequests    ChangeRequest[]

  @@unique([routeRunId, stopNumber])
  @@index([routeRunId])
  @@index([routeStopId])
  @@index([customerId])
  @@index([customerAddressId])
  @@index([tenantId])
}

model Order {
  id                     String      @id @default(uuid())
  customerId             String
  routeRunId             String?
  routeRunStopId         String?
  templateId             String?
  orderNumber            String?
  status                 OrderStatus @default(PENDING)
  source                 OrderSource @default(APP)
  urgent                 Boolean     @default(false)
  notes                  String?
  driverNote             String?
  subtotal               Decimal     @default(0) @db.Decimal(10, 2)
  tax                    Decimal     @default(0) @db.Decimal(10, 2)
  total                  Decimal     @default(0) @db.Decimal(10, 2)
  discountAmount         Decimal     @default(0) @db.Decimal(10, 2)
  // Optional per-order shipping fee (never taxed; added after tax like the
  // invoice-side shippingFee). Invariant: equals Σ shippingFee of this order's
  // non-VOID invoices — recomputeOrderFromInvoices maintains the back-sync.
  shippingFee            Decimal     @default(0) @db.Decimal(10, 2)
  requestedDeliveryDate  DateTime?
  // BUSINESS date of the order — the day it actually happened, which is NOT
  // `createdAt` (the entry timestamp) when an operator enters a forgotten order
  // days later. Staff-settable only (OPERATOR/TENANT_ADMIN). When set it drives
  // `deliveredAt` on the already-delivered sale path and the issueDate/dueDate of
  // every invoice generated from this order — which in turn moves the regulated
  // ledger's period bucket into that past month.
  orderDate              DateTime?
  deliveredAt            DateTime?
  // Carrier shipment tracking — set when goods ship via a carrier instead of being
  // delivered on our own route. Copied onto the Invoice(s) generated from this order.
  shippingCarrier        String?
  shippingTrackingNumber String?
  shippedAt              DateTime?
  // When true, the auto-merge cron + on-create merge will skip this order entirely.
  // Set when an operator explicitly chose "Create as separate order" despite an active draft existing.
  skipAutoMerge          Boolean     @default(false)
  // Phase 4: denormalized flag — true when any line's product is in a tracked
  // (regulated) category. Drives the split preview + signature-POD requirement.
  hasRegulated           Boolean     @default(false)
  // Sales agents & commissions (flag.sales_agents): staff-set per-order override of
  // the commission rate, resolved ahead of any customer/agent default. `0` is a valid
  // value meaning "exempt"; `null` means no override (fall through to rate resolution).
  commissionRatePct      Decimal?    @db.Decimal(5, 2)
  fulfillPath            FulfillPath @default(ROUTE)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  tenantId               String?

  customer          Customer           @relation(fields: [customerId], references: [id])
  tenant            Tenant?            @relation(fields: [tenantId], references: [id])
  routeRun          RouteRun?          @relation(fields: [routeRunId], references: [id])
  routeRunStop      RouteRunStop?      @relation(fields: [routeRunStopId], references: [id])
  orderTemplate     OrderTemplate?     @relation(fields: [templateId], references: [id])
  lineItems         OrderItem[]
  deliveryMutations DeliveryMutation[]
  transaction       Transaction?
  invoices          Invoice[]
  returns           Return[]
  revisions         OrderRevision[]
  changeRequests    ChangeRequest[]
  orderCreditNotes  OrderCreditNote[]

  // RF-014: prevent duplicate order numbers within the same tenant.
  // NULL values are treated as distinct by PostgreSQL, so rows with
  // orderNumber=null remain unrestricted (legacy/draft orders).
  @@unique([tenantId, orderNumber])
  @@index([customerId])
  @@index([routeRunId])
  @@index([routeRunStopId])
  @@index([templateId])
  @@index([status])
  @@index([urgent])
  @@index([createdAt])
  @@index([requestedDeliveryDate])
  @@index([orderDate])
  @@index([tenantId])
}

/// Append-only version history of an order's editable state (P5-08). One row is
/// APPENDED on every autosaved pre-dispatch edit of a PLACED/CONFIRMED order —
/// never mutated. `snapshot` is the point-in-time line set + money totals AFTER
/// the edit; the web timeline renders vN and diffs consecutive rows client-side.
/// Actor is an immutable FK-less snapshot (mirrors CustomerAuthorization.verifiedById/Name).
model OrderRevision {
  id             String   @id @default(uuid())
  tenantId       String?
  orderId        String
  revisionNumber Int
  editedById     String?
  editedByName   String?
  editedByRole   String?
  source         String   @default("EDIT")
  reason         String?
  snapshot       Json
  createdAt      DateTime @default(now())

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([orderId, revisionNumber])
  @@index([tenantId])
  @@index([orderId])
  @@index([createdAt])
}

/// P5-09: post-dispatch change request. Created when the G7 edit window is
/// closed (order's RouteRun dispatched) and a buyer/driver wants a change.
/// Resolution authority (G6): driver-at-stop primary; office only while
/// PENDING; FIRST resolution wins and locks (atomic conditional update).
/// `payload` is the typed delta:
///   ADD_ITEM   { productId, qty, boxes?, pieces?, productName }
///   CHANGE_QTY { orderItemId, newQty, productName }
///   REMOVE_ITEM{ orderItemId, productName }
///   NOTE       { text }
/// Actor fields are immutable FK-less snapshots (mirror OrderRevision).
/// `resolution` = MERGED_AT_STOP | NEXT_DELIVERY | DECLINED;
/// `nextOrderId` = plain pointer (no FK) to the next-delivery draft order.
model ChangeRequest {
  id               String              @id @default(uuid())
  tenantId         String?
  orderId          String
  orderItemId      String?
  productId        String?
  routeRunStopId   String?
  type             ChangeRequestType
  status           ChangeRequestStatus @default(PENDING)
  payload          Json
  note             String?
  requestedById    String?
  requestedByName  String?
  requestedByRole  String?
  resolvedById     String?
  resolvedByName   String?
  resolvedByRole   String?
  resolution       String?
  resolutionReason String?
  nextOrderId      String?
  resolvedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
  orderItem    OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  routeRunStop RouteRunStop? @relation(fields: [routeRunStopId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([orderId])
  @@index([status])
  @@index([routeRunStopId])
  @@index([createdAt])
}

model OrderItem {
  id                   String     @id @default(uuid())
  orderId              String
  // Nullable so an order can carry "unlisted" ad-hoc lines that are not in the
  // product catalog. When null, `name` holds the free-text item label.
  productId            String?
  // Free-text label for unlisted items (productId == null). Catalog lines leave
  // this null and read the name from the related product.
  name                 String?
  status               ItemStatus @default(PENDING)
  qty                  Decimal    @db.Decimal(10, 3)
  deliveredQty         Decimal    @default(0) @db.Decimal(10, 3)
  // Cumulative qty already covered by issued invoices (full or partial). Capped at qty.
  invoicedQty          Decimal    @default(0) @db.Decimal(10, 3)
  unitPrice            Decimal    @db.Decimal(10, 2)
  subtotal             Decimal    @default(0) @db.Decimal(10, 2)
  priceType            PriceType  @default(STANDARD)
  originalPrice        Decimal?   @db.Decimal(10, 2)
  overrideReason       String?
  overriddenBy         String?
  boxes                Int?
  pieces               Int?
  // Sale-time snapshot of the product's box size (Product.unitsPerBox). Boxed
  // line math (price proration, box/piece split) must use THIS value, never the
  // live product — a later packaging change must not re-interpret past lines.
  // Null for lines created before the snapshot shipped (fall back to live upb).
  unitsPerBox          Int?
  // BUY_N_GET_M sale-time snapshot: whole free selling units this line received,
  // floor(qtyUnits / (N+M)) * M (N=Promotion.minQty, M=Promotion.value). 0/null for
  // every non-BOGO line (PERCENT/FIXED/QTY_BREAK/no promo — unaffected). Recomputed
  // whenever the line is re-priced via applyBestPromotion (create, buyer edit, at-door
  // add) AND whenever the QUANTITY changes under a kept (agreed) price — a pending
  // merge or a stored-price qty edit re-derives it for the new whole-unit count, so
  // the column can never contradict the subtotal. Feeds computeLineSubtotal's freeUnits param —
  // the SUBTOTAL is exact, never a rounded net-unit-price. Nullable, no backfill.
  promoFreeUnits       Int?
  notes                String?
  // Phase 4: regulated-category snapshot at sale time; `categoryTaxAmount` is the
  // computed category tax for this line (0 until the W3 calculator populates it).
  // Snapshots are never rewritten by later category edits.
  trackedCategoryId    String?
  trackedSubcategoryId String?
  categoryTaxAmount    Decimal    @default(0) @db.Decimal(10, 2)
  // Scan/insertion order within the order (0-based). Set from the client's item
  // array index at create and preserved/appended on edit, so line display matches
  // the order items were scanned/added (the invoice already reads in insertion
  // order). Nullable: legacy rows (pre-migration) and merge/change-request appends
  // leave it null and sort LAST (Postgres NULLS LAST for ASC).
  position             Int?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  tenantId             String?

  order              Order               @relation(fields: [orderId], references: [id])
  tenant             Tenant?             @relation(fields: [tenantId], references: [id])
  // Restrict, stated explicitly: production has always enforced RESTRICT here, while
  // an un-annotated optional relation means SetNull to Prisma — so the schema quietly
  // disagreed with the database. Nothing relies on SetNull: remove() soft-deletes,
  // bulkDelete() clears dependants first, and clearAll() delegates to bulkDelete, so
  // no path reaches this FK. Keeping RESTRICT preserves the backstop that stops a
  // stray hard-delete silently orphaning order history.
  product            Product?            @relation(fields: [productId], references: [id], onDelete: Restrict)
  trackedCategory    TrackedCategory?    @relation(fields: [trackedCategoryId], references: [id], onDelete: SetNull)
  trackedSubcategory TrackedSubcategory? @relation(fields: [trackedSubcategoryId], references: [id], onDelete: SetNull)
  deliveryMutations  DeliveryMutation[]
  transactionItems   TransactionItem[]
  invoiceItems       InvoiceItem[]
  changeRequests     ChangeRequest[]

  @@index([orderId])
  @@index([productId])
  @@index([status])
  @@index([tenantId])
  @@index([trackedCategoryId])
  @@index([trackedSubcategoryId])
}

model DeliveryMutation {
  id                String       @id @default(uuid())
  orderId           String
  orderItemId       String?
  productId         String?
  routeRunStopId    String?
  driverId          String?
  deliveryBatchId   String?
  type              MutationType
  qty               Decimal?     @db.Decimal(10, 3)
  quantityDelivered Decimal?     @db.Decimal(10, 3)
  unitPrice         Decimal?     @db.Decimal(10, 2)
  note              String?
  driverNote        String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  tenantId          String?

  order         Order          @relation(fields: [orderId], references: [id])
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  orderItem     OrderItem?     @relation(fields: [orderItemId], references: [id])
  product       Product?       @relation(fields: [productId], references: [id])
  routeRunStop  RouteRunStop?  @relation(fields: [routeRunStopId], references: [id])
  driver        Driver?        @relation(fields: [driverId], references: [id])
  deliveryBatch DeliveryBatch? @relation(fields: [deliveryBatchId], references: [id])

  @@index([orderId])
  @@index([orderItemId])
  @@index([productId])
  @@index([routeRunStopId])
