// ─── Generator & Datasource ───────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  OPERATOR
  DRIVER
  CUSTOMER
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum TenantPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  OUT_FOR_DELIVERY
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

enum ItemStatus {
  PENDING
  CONFIRMED
  PARTIAL
  DELIVERED
  CANCELLED
}

enum RouteRunStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RouteRunStopStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum MutationType {
  DELIVERED
  PARTIAL
  REFUSED
  ADD_ON
  SUBSTITUTED
}

enum TxnStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  CHECK
  ACH
  OTHER
  CREDIT_NOTE
  ADVANCE
  CREDIT_CARD
}

enum PaymentStatus {
  DRAFT
  PAID
  VOID
}

enum FulfillPath {
  ROUTE
  SHIP
}

enum OrderSource {
  APP
  PHONE
  ROUTE
}

enum Platform {
  IOS
  ANDROID
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  WRITE_OFF
}

enum CostingMethod {
  FIFO
  LIFO
  AVCO
  STANDARD
}

// ─── New Enums (Zoho-parity) ──────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIAL
  PAID
  OVERDUE
  VOID
  WRITTEN_OFF
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  CONVERTED
}

enum CreditNoteStatus {
  ISSUED
  APPLIED
  VOID
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CLOSED
}

enum VendorBillStatus {
  DRAFT
  RECEIVED
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  CUSTOMER_REFUSED
  QUALITY_ISSUE
  EXCESS_ORDER
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  REFUNDED
  PROCESSED
  CANCELLED
}

enum PriceType {
  STANDARD
  SPECIAL
  DISCOUNTED
}

// ─── Buyer Portal Enums ───────────────────────────────────────────────────────

enum BuyerAccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CustomerLinkStatus {
  INVITED
  PENDING_SELLER_APPROVAL
  ACTIVE
  DISCONNECTED
}

enum InviteMethod {
  EMAIL
  SMS
}

enum DisconnectedBy {
  BUYER
  SELLER
}

// ─── Tenant Models ────────────────────────────────────────────────────────────

model Tenant {
  id          String       @id @default(uuid())
  slug        String       @unique
  name        String
  status      TenantStatus @default(TRIAL)
  plan        TenantPlan   @default(STARTER)
  trialEndsAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  users        User[]
  config       TenantConfig?
  googleOAuth  TenantGoogleOAuth?
  subscription TenantSubscription?
  addons       TenantAddon[]

  userPreferences      UserPreference[]
  customers            Customer[]
  customerAddresses    CustomerAddress[]
  drivers              Driver[]
  products             Product[]
  routes               Route[]
  routeStops           RouteStop[]
  routeCustomers       RouteCustomer[]
  routeRuns            RouteRun[]
  routeRunStops        RouteRunStop[]
  orders               Order[]
  orderItems           OrderItem[]
  deliveryMutations    DeliveryMutation[]
  transactions         Transaction[]
  transactionItems     TransactionItem[]
  payments             Payment[]
  deviceTokens         DeviceToken[]
  orderTemplates       OrderTemplate[]
  orderTemplateItems   OrderTemplateItem[]
  refreshTokens        RefreshToken[]
  suppliers            Supplier[]
  stockLots            StockLot[]
  stockMovements       StockMovement[]
  invoices             Invoice[]
  invoiceItems         InvoiceItem[]
  invoicePayments      InvoicePayment[]
  paymentCounters      PaymentCounter[]
  expenseCategories    ExpenseCategory[]
  expenses             Expense[]
  expenseLineItems     ExpenseLineItem[]
  mileageRates         MileageRate[]
  contactPersons       ContactPerson[]
  customerTags         CustomerTag[]
  customerTagAssignments CustomerTagAssignment[]
  customerComments     CustomerComment[]
  purchaseOrders       PurchaseOrder[]
  purchaseOrderItems   PurchaseOrderItem[]
  creditNotes          CreditNote[]
  estimates            Estimate[]
  estimateItems        EstimateItem[]
  vendorBills          VendorBill[]
  vendorBillItems      VendorBillItem[]
  billPayments         BillPayment[]
  productMappings      ProductMapping[]
  returns              Return[]
  returnItems          ReturnItem[]
  advancePayments      AdvancePayment[]
  recurringInvoices    RecurringInvoice[]
  recurringInvoiceItems RecurringInvoiceItem[]
  messages             Message[]
  customerPrices       CustomerPrice[]
  systemConfigs        SystemConfig[]
  customerLinks        CustomerLink[]
  buyerMergeRequests   BuyerMergeRequest[]
  buyerFavorites       BuyerFavorite[]
  deliveryBatches      DeliveryBatch[]

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
}

model TenantConfig {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  businessName  String?
  logoKey       String?
  primaryColor  String?
  timezone      String   @default("America/New_York")
  currency      String   @default("USD")
  taxRate       Decimal? @db.Decimal(5, 4)
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  zip           String?
  country       String?
  phone         String?
  website       String?
  smtpHost      String?
  smtpPort      Int?
  smtpSecure    Boolean  @default(true)
  smtpUser      String?
  smtpPassword  String?
  smtpFromName   String?
  smtpFromEmail  String?
  customerEmail  String?
  ownerName      String?
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantGoogleOAuth {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  clientId     String
  clientSecret String
  callbackUrl  String
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantSubscription {
  id                    String     @id @default(uuid())
  tenantId              String     @unique
  stripeCustomerId      String?
  stripeSubId           String?
  currentPlan           TenantPlan @default(STARTER)
  periodStart           DateTime?
  periodEnd             DateTime?
  cancelAtPeriodEnd     Boolean    @default(false)
  // External (non-Stripe) payment tracking
  externalPayment       Boolean    @default(false)
  externalPaymentMethod String?    // ZELLE | BANK_TRANSFER | CHECK | CASH | WIRE | OTHER
  externalPaymentRef    String?    // transaction ID or confirmation number
  externalPaymentNotes  String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantAddon {
  id            String   @id @default(uuid())
  tenantId      String
  addonKey      String   // e.g. "ai_scanning", "advanced_routes", "api_access"
  stripePriceId String?  // Stripe price for this add-on
  stripeItemId  String?  // Stripe subscription item ID
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, addonKey])
  @@index([tenantId])
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                  String     @id @default(uuid())
  email               String
  username            String
  password            String?
  googleId            String?
  role                UserRole
  status              UserStatus @default(ACTIVE)
  forcePasswordChange Boolean    @default(false)
  isAdmin             Boolean    @default(false)
  canActAsDriver      Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?
  tenantId            String?

  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  customer        Customer?
  driver          Driver?
  deviceTokens    DeviceToken[]
  refreshTokens   RefreshToken[]
  stockMovements  StockMovement[]
  expenses        Expense[]
  messages        Message[]
  preferences     UserPreference[]

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@unique([tenantId, googleId])
  @@index([tenantId])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String
  updatedAt DateTime @updatedAt
  tenantId  String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([userId, key])
  @@index([userId])
  @@index([tenantId])
}

model Customer {
  id                  String      @id @default(uuid())
  userId              String      @unique
  businessName        String
  contactName         String
  phone               String?
  notes               String?
  zohoContactId       String?     @unique
  fulfillPath         FulfillPath @default(ROUTE)
  deliveryWindowStart String?
  deliveryWindowEnd   String?
  email               String?
  mobile              String?
  customerType        String      @default("BUSINESS")
  displayName         String?
  salutation          String?
  firstName           String?
  lastName            String?
  taxId               String?
  isTaxExempt         Boolean     @default(false)
  creditLimit         Decimal?    @db.Decimal(10, 2)
  currency            String      @default("USD")
  pricingTier         Int         @default(1)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  tenantId            String?

  user           User              @relation(fields: [userId], references: [id])
  tenant         Tenant?           @relation(fields: [tenantId], references: [id])
  addresses      CustomerAddress[]
  routes         RouteCustomer[]
  routeStops     RouteStop[]
  orders         Order[]
  transactions   Transaction[]
  routeRunStops  RouteRunStop[]
  orderTemplates OrderTemplate[]
  invoices       Invoice[]
  estimates      Estimate[]
  creditNotes    CreditNote[]
  returns        Return[]
  advancePayments    AdvancePayment[]
  recurringInvoices  RecurringInvoice[]
  prices             CustomerPrice[]
  expenses           Expense[]
  contactPersons     ContactPerson[]
  tagAssignments     CustomerTagAssignment[]
  comments           CustomerComment[]
  customerLink       CustomerLink?
  buyerFavorites     BuyerFavorite[]
  deliveryBatches    DeliveryBatch[]

  @@index([zohoContactId])
  @@index([businessName])
  @@index([customerType])
  @@index([tenantId])
}

model CustomerAddress {
  id          String   @id @default(uuid())
  customerId  String
  label       String   @default("default")
  line1       String
  line2       String?
  city        String
  state       String
  zip         String
  lat         Float?
  lng         Float?
  isDefault   Boolean  @default(false)
  addressType String   @default("BILLING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String?

  customer      Customer       @relation(fields: [customerId], references: [id])
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  routeStops    RouteStop[]
  routeRunStops RouteRunStop[]

  @@index([customerId])
  @@index([tenantId])
}

model Driver {
  id            String       @id @default(uuid())
  userId        String       @unique
  contactName   String?
  phone         String?
  status        DriverStatus @default(ACTIVE)
  vehicleMake   String?
  vehicleModel  String?
  vehicleColour String?
  vehiclePlate  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  tenantId      String?

  user              User               @relation(fields: [userId], references: [id])
  tenant            Tenant?            @relation(fields: [tenantId], references: [id])
  routes            Route[]
  routeRuns         RouteRun[]
  deliveryMutations DeliveryMutation[]
  deliveryBatches   DeliveryBatch[]

  @@index([status])
  @@index([tenantId])
}

model Product {
  id               String   @id @default(uuid())
  name             String
  description      String?
  sku              String?
  unit             String
  pricePerUnit     Decimal  @db.Decimal(10, 2)
  priceTier2       Decimal  @default(0) @db.Decimal(10, 2)
  priceTier3       Decimal  @default(0) @db.Decimal(10, 2)
  priceTier4       Decimal  @default(0) @db.Decimal(10, 2)
  priceTier5       Decimal  @default(0) @db.Decimal(10, 2)
  category         String?
  imageKeys        String[] @default([])
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  barcode          String?
  currentStock     Decimal  @default(0) @db.Decimal(10, 3)
  averageCost      Decimal? @db.Decimal(10, 4)
  costingMethod    CostingMethod @default(FIFO)
  standardCost     Decimal?      @db.Decimal(10, 4)
  reorderPoint     Int?
  reorderQty       Int?
  unitsPerBox      Int?
  parentProductId  String?
  variantName      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenantId         String?

  tenant                  Tenant?   @relation(fields: [tenantId], references: [id])
  orderItems              OrderItem[]
  deliveryMutations       DeliveryMutation[]
  templateItems           OrderTemplateItem[]
  stockMovements          StockMovement[]
  stockLots               StockLot[]
  invoiceItems            InvoiceItem[]
  estimateItems           EstimateItem[]
  purchaseOrderItems      PurchaseOrderItem[]
  returnItems             ReturnItem[]
  recurringInvoiceItems   RecurringInvoiceItem[]
  vendorBillItems         VendorBillItem[]
  customerPrices          CustomerPrice[]
  productMappings         ProductMapping[]
  buyerFavorites          BuyerFavorite[]
  parent                  Product?  @relation("ProductVariants", fields: [parentProductId], references: [id])
  variants                Product[] @relation("ProductVariants")

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([category])
  @@index([isActive])
  @@index([isFeatured])
  @@index([barcode])
  @@index([parentProductId])
  @@index([tenantId])
}

model Route {
  id        String   @id @default(uuid())
  name      String
  driverId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String?

  driver    Driver?         @relation(fields: [driverId], references: [id])
  tenant    Tenant?         @relation(fields: [tenantId], references: [id])
  stops     RouteStop[]
  customers RouteCustomer[]
  runs      RouteRun[]

  @@index([driverId])
  @@index([isActive])
  @@index([tenantId])
}

model RouteStop {
  id                String   @id @default(uuid())
  routeId           String
  customerId        String?
  customerAddressId String?
  stopNumber        Int
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenantId          String?

  route           Route            @relation(fields: [routeId], references: [id])
  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  customer        Customer?        @relation(fields: [customerId], references: [id])
  customerAddress CustomerAddress? @relation(fields: [customerAddressId], references: [id])
  routeRunStops   RouteRunStop[]

  @@unique([routeId, stopNumber])
  @@index([routeId])
  @@index([customerId])
  @@index([customerAddressId])
  @@index([tenantId])
}

model RouteCustomer {
  id         String   @id @default(uuid())
  routeId    String
  customerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenantId   String?

  route    Route    @relation(fields: [routeId], references: [id])
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([routeId, customerId])
  @@index([routeId])
  @@index([customerId])
  @@index([tenantId])
}

model RouteRun {
  id                String         @id @default(uuid())
  routeId           String
  driverId          String?
  status            RouteRunStatus @default(SCHEDULED)
  scheduledDate     DateTime
  startedAt         DateTime?
  completedAt       DateTime?
  manuallyReordered Boolean        @default(false)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  tenantId          String?

  route  Route          @relation(fields: [routeId], references: [id])
  tenant Tenant?        @relation(fields: [tenantId], references: [id])
  driver Driver?        @relation(fields: [driverId], references: [id])
  stops  RouteRunStop[]
  orders Order[]

  @@index([routeId])
  @@index([driverId])
  @@index([status])
  @@index([scheduledDate])
  @@index([tenantId])
}

model RouteRunStop {
  id                String            @id @default(uuid())
  routeRunId        String
  routeStopId       String
  customerId        String?
  customerAddressId String?
  stopNumber        Int
  status            RouteRunStopStatus @default(PENDING)
  driverNote        String?
  arrivedAt         DateTime?
  completedAt       DateTime?
  notes             String?
  podPhotoUrls      String[]
  signatureUrl      String?
  safeDropEnabled   Boolean          @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tenantId          String?

  routeRun        RouteRun         @relation(fields: [routeRunId], references: [id])
  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  routeStop       RouteStop        @relation(fields: [routeStopId], references: [id])
  customer        Customer?        @relation(fields: [customerId], references: [id])
  customerAddress CustomerAddress? @relation(fields: [customerAddressId], references: [id])
  orders            Order[]
  deliveryMutations DeliveryMutation[]
  deliveryBatches   DeliveryBatch[]

  @@unique([routeRunId, stopNumber])
  @@index([routeRunId])
  @@index([routeStopId])
  @@index([customerId])
  @@index([customerAddressId])
  @@index([tenantId])
}

model Order {
  id                    String      @id @default(uuid())
  customerId            String
  routeRunId            String?
  routeRunStopId        String?
  templateId            String?
  orderNumber           String?
  status                OrderStatus @default(PENDING)
  source                OrderSource @default(APP)
  urgent                Boolean     @default(false)
  notes                 String?
  driverNote            String?
  subtotal              Decimal     @default(0) @db.Decimal(10, 2)
  tax                   Decimal     @default(0) @db.Decimal(10, 2)
  total                 Decimal     @default(0) @db.Decimal(10, 2)
  discountAmount        Decimal     @default(0) @db.Decimal(10, 2)
  requestedDeliveryDate DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  tenantId              String?

  customer          Customer           @relation(fields: [customerId], references: [id])
  tenant            Tenant?            @relation(fields: [tenantId], references: [id])
  routeRun          RouteRun?          @relation(fields: [routeRunId], references: [id])
  routeRunStop      RouteRunStop?      @relation(fields: [routeRunStopId], references: [id])
  orderTemplate     OrderTemplate?     @relation(fields: [templateId], references: [id])
  lineItems         OrderItem[]
  deliveryMutations DeliveryMutation[]
  transaction       Transaction?
  invoices          Invoice[]
  returns           Return[]

  @@index([customerId])
  @@index([routeRunId])
  @@index([routeRunStopId])
  @@index([templateId])
  @@index([status])
  @@index([urgent])
  @@index([createdAt])
  @@index([requestedDeliveryDate])
  @@index([tenantId])
}

model OrderItem {
  id        String     @id @default(uuid())
  orderId   String
  productId String
  status    ItemStatus @default(PENDING)
  qty           Decimal    @db.Decimal(10, 3)
  deliveredQty  Decimal    @default(0) @db.Decimal(10, 3)
  unitPrice     Decimal    @db.Decimal(10, 2)
  subtotal      Decimal    @default(0) @db.Decimal(10, 2)
  priceType     PriceType  @default(STANDARD)
  originalPrice Decimal?   @db.Decimal(10, 2)
  boxes         Int?
  pieces        Int?
  notes         String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenantId  String?

  order             Order              @relation(fields: [orderId], references: [id])
  tenant            Tenant?            @relation(fields: [tenantId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  deliveryMutations DeliveryMutation[]
  transactionItems  TransactionItem[]

  @@index([orderId])
  @@index([productId])
  @@index([status])
  @@index([tenantId])
}

model DeliveryMutation {
  id                String       @id @default(uuid())
  orderId           String
  orderItemId       String?
  productId         String?
  routeRunStopId    String?
  driverId          String?
  deliveryBatchId   String?
  type              MutationType
  qty               Decimal?     @db.Decimal(10, 3)
  quantityDelivered Decimal?     @db.Decimal(10, 3)
  unitPrice         Decimal?     @db.Decimal(10, 2)
  note              String?
  driverNote        String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  tenantId          String?

  order         Order          @relation(fields: [orderId], references: [id])
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  orderItem     OrderItem?     @relation(fields: [orderItemId], references: [id])
  product       Product?       @relation(fields: [productId], references: [id])
  routeRunStop  RouteRunStop?  @relation(fields: [routeRunStopId], references: [id])
  driver        Driver?        @relation(fields: [driverId], references: [id])
  deliveryBatch DeliveryBatch? @relation(fields: [deliveryBatchId], references: [id])

  @@index([orderId])
  @@index([orderItemId])
  @@index([productId])
  @@index([routeRunStopId])
  @@index([driverId])
  @@index([deliveryBatchId])
  @@index([type])
  @@index([tenantId])
}

model DeliveryBatch {
  id             String   @id @default(uuid())
  customerId     String
  routeRunStopId String?
  driverId       String?
  deliveredAt    DateTime @default(now())
  notes          String?
  createdAt      DateTime @default(now())
  tenantId       String?

  customer     Customer      @relation(fields: [customerId], references: [id])
  routeRunStop RouteRunStop? @relation(fields: [routeRunStopId], references: [id])
  driver       Driver?       @relation(fields: [driverId], references: [id])
  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
  mutations    DeliveryMutation[]
  invoices     Invoice[]

  @@index([customerId])
  @@index([routeRunStopId])
  @@index([tenantId])
}

model Transaction {
  id         String    @id @default(uuid())
  customerId String
  orderId    String?   @unique
  status     TxnStatus @default(UNPAID)
  totalOwed  Decimal   @db.Decimal(10, 2)
  totalPaid  Decimal   @default(0) @db.Decimal(10, 2)
  dueDate    DateTime?
  paidAt     DateTime?
  notes      String?
  pdfUrl     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenantId   String?

  customer Customer          @relation(fields: [customerId], references: [id])
  tenant   Tenant?           @relation(fields: [tenantId], references: [id])
  order    Order?            @relation(fields: [orderId], references: [id])
  items    TransactionItem[]
  payments Payment[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([tenantId])
}

model TransactionItem {
  id            String   @id @default(uuid())
  transactionId String
  orderItemId   String?
  description   String
  qty           Decimal  @db.Decimal(10, 3)
  unitPrice     Decimal  @db.Decimal(10, 2)
  subtotal      Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenantId      String?

  transaction Transaction @relation(fields: [transactionId], references: [id])
  tenant      Tenant?     @relation(fields: [tenantId], references: [id])
  orderItem   OrderItem?  @relation(fields: [orderItemId], references: [id])

  @@index([transactionId])
  @@index([orderItemId])
  @@index([tenantId])
}

model Payment {
  id            String        @id @default(uuid())
  transactionId String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)
  reference     String?
  notes         String?
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenantId      String?

  transaction Transaction @relation(fields: [transactionId], references: [id])
  tenant      Tenant?     @relation(fields: [tenantId], references: [id])

  @@index([transactionId])
  @@index([method])
  @@index([paidAt])
  @@index([tenantId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  Platform
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String?

  user   User    @relation(fields: [userId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([tenantId])
}

model SystemConfig {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

/// Platform-wide key/value config — not scoped to any tenant.
/// Used for global settings such as the platform Anthropic API key.
model PlatformConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model OrderTemplate {
  id         String   @id @default(uuid())
  customerId String
  name       String
  isActive   Boolean  @default(true)
  daysOfWeek Int[]
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenantId   String?

  customer Customer             @relation(fields: [customerId], references: [id])
  tenant   Tenant?              @relation(fields: [tenantId], references: [id])
  items    OrderTemplateItem[]
  orders   Order[]

  @@index([customerId])
  @@index([isActive])
  @@index([tenantId])
}

model OrderTemplateItem {
  id         String   @id @default(uuid())
  templateId String
  productId  String
  qty        Int
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenantId   String?

  template OrderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tenant   Tenant?       @relation(fields: [tenantId], references: [id])
  product  Product       @relation(fields: [productId], references: [id])

  @@index([templateId])
  @@index([tenantId])
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  tenantId    String?
  userAgent   String?
  ipAddress   String?
  deviceName  String?
  lastUsedAt  DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([tenantId])
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  contactName    String?
  phone          String?
  mobile         String?
  email          String?
  website        String?
  notes          String?
  isActive       Boolean         @default(true)
  leadTimeDays   Int?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  zip            String?
  country        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenantId       String?

  tenant         Tenant?         @relation(fields: [tenantId], references: [id])
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  vendorBills    VendorBill[]
  expenses       Expense[]

  @@index([isActive])
  @@index([tenantId])
}

model StockLot {
  id           String   @id @default(uuid())
  productId    String
  purchaseDate DateTime @default(now())
  qty          Decimal  @db.Decimal(10, 3)
  remainingQty Decimal  @db.Decimal(10, 3)
  unitCost     Decimal  @db.Decimal(10, 4)
  reference    String?
  notes        String?
  createdAt    DateTime @default(now())
  tenantId     String?

  product Product @relation(fields: [productId], references: [id])
  tenant  Tenant? @relation(fields: [tenantId], references: [id])

  @@index([productId])
  @@index([purchaseDate])
  @@index([tenantId])
}

model StockMovement {
  id            String       @id @default(uuid())
  productId     String
  type          MovementType
  quantity      Decimal      @db.Decimal(10, 3)
  unitCost      Decimal?     @db.Decimal(10, 4)
  supplierId    String?
  reference     String?
  notes         String?
  performedById String?
  createdAt     DateTime     @default(now())
  tenantId      String?

  product     Product   @relation(fields: [productId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  performedBy User?     @relation(fields: [performedById], references: [id])

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@index([supplierId])
  @@index([tenantId])
}

// ─── Sprint 1: Standalone Invoicing ──────────────────────────────────────────

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String
  customerId    String
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(10, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  shippingFee   Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  dueDate       DateTime?
  sentAt        DateTime?
  viewedAt      DateTime?
  paidAt        DateTime?
  notes              String?
  terms              String?
  issueDate          DateTime  @default(now())
  pdfUrl             String?
  writeOffReason     String?
  writtenOffAt       DateTime?
  orderId            String?
  deliveryBatchId    String?
  recurringInvoiceId String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  tenantId           String?

  customer         Customer          @relation(fields: [customerId], references: [id])
  tenant           Tenant?           @relation(fields: [tenantId], references: [id])
  order            Order?            @relation(fields: [orderId], references: [id])
  deliveryBatch    DeliveryBatch?    @relation(fields: [deliveryBatchId], references: [id])
  items            InvoiceItem[]
  payments         InvoicePayment[]
  creditNotes      CreditNote[]
  recurringInvoice RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id])

  @@unique([tenantId, invoiceNumber])
  @@index([customerId])
  @@index([orderId])
  @@index([deliveryBatchId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
  @@index([tenantId])
}

model InvoiceItem {
  id            String    @id @default(uuid())
  invoiceId     String
  description   String
  productId     String?
  qty           Decimal   @db.Decimal(10, 3)
  unitPrice     Decimal   @db.Decimal(10, 2)
  discount      Decimal   @default(0) @db.Decimal(10, 2)
  originalPrice Decimal?  @db.Decimal(10, 2)
  priceType     PriceType @default(STANDARD)
  taxRate       Decimal   @default(0) @db.Decimal(5, 4)
  subtotal      Decimal   @db.Decimal(10, 2)
  boxes         Int?
  pieces        Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String?

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant  Tenant?  @relation(fields: [tenantId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@index([tenantId])
}

model InvoicePayment {
  id               String        @id @default(uuid())
  invoiceId        String
  amount           Decimal       @db.Decimal(10, 2)
  method           PaymentMethod
  reference        String?
  notes            String?
  paidAt           DateTime      @default(now())
  createdAt        DateTime      @default(now())
  creditNoteId     String?
  advancePaymentId String?
  paymentNumber    String?         @unique
  bankCharges      Decimal?        @db.Decimal(10, 2)
  status           PaymentStatus   @default(PAID)
  paymentGroupId   String?
  tenantId         String?

  invoice       Invoice        @relation(fields: [invoiceId], references: [id])
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  creditNote    CreditNote?    @relation(fields: [creditNoteId], references: [id])
  advancePayment AdvancePayment? @relation(fields: [advancePaymentId], references: [id])

  @@index([invoiceId])
  @@index([paymentGroupId])
  @@index([status])
  @@index([tenantId])
}

model PaymentCounter {
  id       String  @id @default("singleton")
  next     Int     @default(1)
  tenantId String?

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// ─── Sprint 2: Expense Tracking ───────────────────────────────────────────────

model ExpenseCategory {
  id       String    @id @default(uuid())
  name     String
  code     String
  isCustom Boolean   @default(false)
  tenantId String?

  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  expenses Expense[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
}

model Expense {
  id                  String    @id @default(uuid())
  categoryId          String?
  supplierId          String?
  customerId          String?
  amount              Decimal   @db.Decimal(10, 2)
  date                DateTime
  description         String?
  paymentMethod       String?
  receiptKey          String?
  receiptOriginalName String?
  receiptMimeType     String?
  vendorBillId        String?   @unique
  notes               String?
  referenceNumber     String?
  performedById       String?
  isItemized          Boolean   @default(false)
  isMileage           Boolean   @default(false)
  isBillable          Boolean   @default(false)
  employeeName        String?
  mileageUnit         String?
  distance            Decimal?  @db.Decimal(10, 2)
  mileageRateSnapshot Decimal?  @db.Decimal(10, 4)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  tenantId            String?

  category    ExpenseCategory? @relation(fields: [categoryId], references: [id])
  tenant      Tenant?          @relation(fields: [tenantId], references: [id])
  supplier    Supplier?        @relation(fields: [supplierId], references: [id])
  customer    Customer?        @relation(fields: [customerId], references: [id])
  performedBy User?            @relation(fields: [performedById], references: [id])
  lineItems   ExpenseLineItem[]

  @@index([categoryId])
  @@index([supplierId])
  @@index([customerId])
  @@index([date])
  @@index([deletedAt])
  @@index([tenantId])
}

model ExpenseLineItem {
  id        String   @id @default(uuid())
  expenseId String
  account   String
  notes     String?
  amount    Decimal  @db.Decimal(10, 2)
  productId String?
  unitCost  Decimal? @db.Decimal(10, 4)
  qty       Decimal? @db.Decimal(10, 3)
  createdAt DateTime @default(now())
  tenantId  String?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  tenant  Tenant? @relation(fields: [tenantId], references: [id])

  @@index([expenseId])
  @@index([tenantId])
}

model MileageRate {
  id          String   @id @default(uuid())
  startDate   DateTime
  ratePerUnit Decimal  @db.Decimal(10, 4)
  unit        String   @default("MILE")
  createdAt   DateTime @default(now())
  tenantId    String?

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([startDate])
  @@index([tenantId])
}

// ─── Customer Extensions (Zoho Parity) ──────────────────────────────────────

model ContactPerson {
  id         String   @id @default(uuid())
  customerId String
  salutation String?
  firstName  String
  lastName   String?
  email      String?
  phone      String?
  mobile     String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  tenantId   String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([customerId])
  @@index([tenantId])
}

model CustomerTag {
  id        String                  @id @default(uuid())
  name      String
  color     String                  @default("#3b82f6")
  createdAt DateTime                @default(now())
  tenantId  String?

  tenant      Tenant?                 @relation(fields: [tenantId], references: [id])
  assignments CustomerTagAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model CustomerTagAssignment {
  id         String  @id @default(uuid())
  customerId String
  tagId      String
  tenantId   String?

  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant   Tenant?     @relation(fields: [tenantId], references: [id])
  tag      CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([customerId, tagId])
  @@index([customerId])
  @@index([tagId])
  @@index([tenantId])
}

model CustomerComment {
  id         String   @id @default(uuid())
  customerId String
  userId     String
  content    String
  createdAt  DateTime @default(now())
  tenantId   String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([customerId])
  @@index([tenantId])
}

// ─── Sprint 4: Purchase Orders ────────────────────────────────────────────────

model PurchaseOrder {
  id           String              @id @default(uuid())
  poNumber     String
  supplierId   String
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?
  notes        String?
  totalAmount  Decimal             @db.Decimal(10, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenantId     String?

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  tenant   Tenant?             @relation(fields: [tenantId], references: [id])
  items    PurchaseOrderItem[]

  @@unique([tenantId, poNumber])
  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId])
}

model PurchaseOrderItem {
  id          String  @id @default(uuid())
  poId        String
  productId   String
  qtyOrdered  Decimal @db.Decimal(10, 3)
  qtyReceived Decimal @default(0) @db.Decimal(10, 3)
  unitCost    Decimal @db.Decimal(10, 4)
  totalCost   Decimal @db.Decimal(10, 2)
  tenantId    String?

  po      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  tenant  Tenant?       @relation(fields: [tenantId], references: [id])
  product Product       @relation(fields: [productId], references: [id])

  @@index([poId])
  @@index([productId])
  @@index([tenantId])
}

// ─── Sprint 6: Credit Notes & Estimates ──────────────────────────────────────

model CreditNote {
  id               String           @id @default(uuid())
  creditNoteNumber String
  customerId       String
  invoiceId        String?
  amount           Decimal          @db.Decimal(10, 2)
  amountUsed       Decimal          @default(0) @db.Decimal(10, 2)
  reason           String?
  status           CreditNoteStatus @default(ISSUED)
  appliedToInvoiceId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenantId         String?

  customer        Customer         @relation(fields: [customerId], references: [id])
  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  invoice         Invoice?         @relation(fields: [invoiceId], references: [id])
  invoicePayments InvoicePayment[]

  @@unique([tenantId, creditNoteNumber])
  @@index([customerId])
  @@index([status])
  @@index([tenantId])
}

model Estimate {
  id             String         @id @default(uuid())
  estimateNumber String
  customerId     String
  status         EstimateStatus @default(DRAFT)
  subtotal       Decimal        @db.Decimal(10, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(10, 2)
  discount       Decimal        @default(0) @db.Decimal(10, 2)
  total          Decimal        @db.Decimal(10, 2)
  expiresAt      DateTime?
  notes          String?
  terms          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenantId       String?

  customer Customer      @relation(fields: [customerId], references: [id])
  tenant   Tenant?       @relation(fields: [tenantId], references: [id])
  items    EstimateItem[]

  @@unique([tenantId, estimateNumber])
  @@index([customerId])
  @@index([status])
  @@index([tenantId])
}

model EstimateItem {
  id            String    @id @default(uuid())
  estimateId    String
  description   String
  productId     String?
  qty           Decimal   @db.Decimal(10, 3)
  unitPrice     Decimal   @db.Decimal(10, 2)
  subtotal      Decimal   @db.Decimal(10, 2)
  priceType     PriceType @default(STANDARD)
  originalPrice Decimal?  @db.Decimal(10, 2)
  boxes         Int?
  pieces        Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenantId      String?

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  product  Product? @relation(fields: [productId], references: [id])

  @@index([estimateId])
  @@index([productId])
  @@index([tenantId])
}

// ─── Sprint 7: Vendor Bills (Accounts Payable) ───────────────────────────────

model VendorBill {
  id           String           @id @default(uuid())
  billNumber   String
  supplierId   String
  status       VendorBillStatus @default(RECEIVED)
  totalOwed    Decimal          @db.Decimal(10, 2)
  totalPaid    Decimal          @default(0) @db.Decimal(10, 2)
  billDate     DateTime?
  dueDate      DateTime?
  receivedDate DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tenantId     String?

  supplier Supplier        @relation(fields: [supplierId], references: [id])
  tenant   Tenant?         @relation(fields: [tenantId], references: [id])
  payments BillPayment[]
  items    VendorBillItem[]

  @@unique([tenantId, billNumber])
  @@index([supplierId])
  @@index([status])
  @@index([dueDate])
  @@index([tenantId])
}

model VendorBillItem {
  id           String     @id @default(uuid())
  vendorBillId String
  productId    String?
  description  String
  qty          Decimal    @db.Decimal(10, 3)
  unitCost     Decimal    @db.Decimal(10, 4)
  createdAt    DateTime   @default(now())
  tenantId     String?

  vendorBill VendorBill @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  tenant     Tenant?    @relation(fields: [tenantId], references: [id])
  product    Product?   @relation(fields: [productId], references: [id])

  @@index([vendorBillId])
  @@index([productId])
  @@index([tenantId])
}

model BillPayment {
  id           String        @id @default(uuid())
  vendorBillId String
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  reference    String?
  notes        String?
  paidAt       DateTime      @default(now())
  createdAt    DateTime      @default(now())
  tenantId     String?

  vendorBill VendorBill @relation(fields: [vendorBillId], references: [id])
  tenant     Tenant?    @relation(fields: [tenantId], references: [id])

  @@index([vendorBillId])
  @@index([tenantId])
}

// ─── AI Product Mapping Memory ────────────────────────────────────────────────

model ProductMapping {
  id             String   @id @default(uuid())
  supplierName   String
  rawDescription String
  productId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenantId       String?

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  tenant  Tenant?  @relation(fields: [tenantId], references: [id])

  @@unique([supplierName, rawDescription])
  @@index([supplierName])
  @@index([tenantId])
}

// ─── Sprint 8: Returns / RMA ──────────────────────────────────────────────────

model Return {
  id           String       @id @default(uuid())
  returnNumber String?
  orderId      String
  customerId   String
  reason       ReturnReason
  status       ReturnStatus @default(PENDING)
  notes        String?
  photoUrls    String[]
  creditNoteId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tenantId     String?

  order    Order        @relation(fields: [orderId], references: [id])
  tenant   Tenant?      @relation(fields: [tenantId], references: [id])
  customer Customer     @relation(fields: [customerId], references: [id])
  items    ReturnItem[]

  @@unique([tenantId, returnNumber])
  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([tenantId])
}

model ReturnItem {
  id        String  @id @default(uuid())
  returnId  String
  productId String
  qty       Decimal @db.Decimal(10, 3)
  reason    String?
  restock   Boolean @default(true)
  tenantId  String?

  return  Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  tenant  Tenant? @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
  @@index([tenantId])
}

// ─── Advance Payments ─────────────────────────────────────────────────────────

model AdvancePayment {
  id           String        @id @default(uuid())
  customerId   String
  amount       Decimal       @db.Decimal(10, 2)
  balance      Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  reference    String?
  notes        String?
  receivedAt   DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenantId     String?

  customer      Customer         @relation(fields: [customerId], references: [id])
  tenant        Tenant?          @relation(fields: [tenantId], references: [id])
  applications  InvoicePayment[]

  @@index([customerId])
  @@index([tenantId])
}

// ─── Recurring Invoices ───────────────────────────────────────────────────────

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model RecurringInvoice {
  id          String             @id @default(uuid())
  customerId  String
  frequency   RecurringFrequency
  dayOfWeek   Int?
  dayOfMonth  Int?
  isActive    Boolean            @default(true)
  autoSend    Boolean            @default(false)
  notes       String?
  terms       String?
  discount    Decimal            @db.Decimal(10, 2) @default(0)
  shippingFee Decimal            @db.Decimal(10, 2) @default(0)
  nextRunAt   DateTime
  lastRunAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenantId    String?

  customer    Customer              @relation(fields: [customerId], references: [id])
  tenant      Tenant?               @relation(fields: [tenantId], references: [id])
  items       RecurringInvoiceItem[]
  invoices    Invoice[]

  @@index([customerId])
  @@index([isActive, nextRunAt])
  @@index([tenantId])
}

model RecurringInvoiceItem {
  id                 String           @id @default(uuid())
  recurringInvoiceId String
  productId          String?
  description        String
  qty                Decimal          @db.Decimal(10, 3)
  unitPrice          Decimal          @db.Decimal(10, 2)
  discount           Decimal          @db.Decimal(10, 2) @default(0)
  taxRate            Decimal          @db.Decimal(5, 4)  @default(0)
  tenantId           String?

  recurringInvoice   RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  tenant             Tenant?          @relation(fields: [tenantId], references: [id])
  product            Product?         @relation(fields: [productId], references: [id])

  @@index([recurringInvoiceId])
  @@index([tenantId])
}

// ─── Driver-to-Dispatcher Messaging ──────────────────────────────────────────

model Message {
  id         String   @id @default(uuid())
  runId      String?
  text       String
  senderId   String
  senderRole String   // "DRIVER" | "OPERATOR"
  createdAt  DateTime @default(now())
  tenantId   String?

  sender User    @relation(fields: [senderId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([runId])
  @@index([senderId])
  @@index([tenantId])
}

// ─── Customer Special Prices ──────────────────────────────────────────────────

model CustomerPrice {
  id           String   @id @default(uuid())
  customerId   String
  productId    String
  pricingTier  Int
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenantId     String?

  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([tenantId])
}

// ─── Buyer Portal ─────────────────────────────────────────────────────────────

model BuyerAccount {
  id            String             @id @default(uuid())
  email         String             @unique
  passwordHash  String
  name          String
  phone         String?
  mobile        String?
  googleId      String?            @unique
  status        BuyerAccountStatus @default(ACTIVE)
  emailVerified Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  mergedIntoId  String?            // audit: set on the secondary after a completed merge

  customerLinks            CustomerLink[]
  refreshTokens            BuyerRefreshToken[]
  mergeRequestsAsPrimary   BuyerMergeRequest[] @relation("MergeAsPrimary")
  mergeRequestsAsSecondary BuyerMergeRequest[] @relation("MergeAsSecondary")
  favorites                BuyerFavorite[]

  @@index([email])
  @@index([status])
  @@index([deletedAt])
}

model CustomerLink {
  id              String             @id @default(uuid())
  buyerAccountId  String?            // null while invite is pending acceptance
  customerId      String             @unique
  tenantId        String
  status          CustomerLinkStatus @default(INVITED)
  inviteToken     String?            @unique
  inviteExpiresAt DateTime?
  inviteMethod    InviteMethod?
  linkedAt        DateTime?
  disconnectedAt  DateTime?
  disconnectedBy  DisconnectedBy?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  buyerAccount BuyerAccount? @relation(fields: [buyerAccountId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id])

  @@index([buyerAccountId])
  @@index([tenantId])
  @@index([inviteToken])
  @@index([status])
}

model BuyerRefreshToken {
  id             String    @id @default(uuid())
  buyerAccountId String
  tokenHash      String    @unique
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  userAgent      String?
  ipAddress      String?
  deviceName     String?
  lastUsedAt     DateTime?

  buyerAccount BuyerAccount @relation(fields: [buyerAccountId], references: [id], onDelete: Cascade)

  @@index([buyerAccountId])
  @@index([expiresAt])
}

// ─── Audit Logging ────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  ip         String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Buyer Account Merge Requests ─────────────────────────────────────────────

model BuyerMergeRequest {
  id                  String                  @id @default(uuid())
  primaryAccountId    String
  secondaryAccountId  String
  status              BuyerMergeRequestStatus @default(PENDING_VERIFICATION)
  initiatedBy         MergeInitiator
  initiatedByTenantId String?
  initiatorNotes      String?
  adminNotes          String?
  verificationToken   String?                 @unique
  verificationExpires DateTime?
  verifiedAt          DateTime?
  completedAt         DateTime?
  rejectedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  primaryAccount   BuyerAccount @relation("MergeAsPrimary",   fields: [primaryAccountId],   references: [id])
  secondaryAccount BuyerAccount @relation("MergeAsSecondary", fields: [secondaryAccountId], references: [id])
  initiatingTenant Tenant?      @relation(fields: [initiatedByTenantId], references: [id])

  @@index([primaryAccountId])
  @@index([secondaryAccountId])
  @@index([status])
  @@index([verificationToken])
}

enum BuyerMergeRequestStatus {
  PENDING_VERIFICATION
  PENDING_REVIEW
  COMPLETED
  REJECTED
}

enum MergeInitiator {
  BUYER
  TENANT
  SUPER_ADMIN
}

// ─── Buyer Favorites ──────────────────────────────────────────────────────────

model BuyerFavorite {
  id             String   @id @default(uuid())
  buyerAccountId String
  customerId     String
  productId      String
  tenantId       String
  createdAt      DateTime @default(now())

  buyerAccount   BuyerAccount @relation(fields: [buyerAccountId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id])

  @@unique([buyerAccountId, customerId, productId])
  @@index([buyerAccountId, customerId])
  @@index([tenantId])
}
