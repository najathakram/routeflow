// ─── Sprint 6: Credit Notes & Estimates ──────────────────────────────────────

model CreditNote {
  id                 String           @id @default(uuid())
  creditNoteNumber   String
  customerId         String
  invoiceId          String?
  amount             Decimal          @db.Decimal(10, 2)
  amountUsed         Decimal          @default(0) @db.Decimal(10, 2)
  reason             String?
  status             CreditNoteStatus @default(ISSUED)
  appliedToInvoiceId String?

  // P5-13 credits wallet: optional expiry, first-application stamp, and whether any
  // application was automatic. "Expired" is a COMPUTED FILTER in code (excluded from
  // the wallet, never auto-applies) — NEVER a status flip; an expired note keeps its
  // amountUsed / already-issued InvoicePayments untouched.
  expiresAt   DateTime?
  appliedAt   DateTime?
  autoApplied Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenantId    String?

  customer        Customer          @relation(fields: [customerId], references: [id])
  tenant          Tenant?           @relation(fields: [tenantId], references: [id])
  invoice         Invoice?          @relation(fields: [invoiceId], references: [id])
  invoicePayments InvoicePayment[]
  items           CreditNoteItem[]
  orderLinks      OrderCreditNote[]

  @@unique([tenantId, creditNoteNumber])
  @@index([customerId])
  @@index([status])
  @@index([tenantId])
}

/// Phase 4 (W5c): per-line breakdown of a credit note, derived from the SOURCE
/// invoice's lines by allocating the credit `amount` proportionally. Carries each
/// line's regulated category snapshot so the credit can faithfully reverse the
/// regulated sales ledger per category (the credit note header is a single lump sum
/// and can't). Only lines with a `trackedCategoryId` drive a ledger reversal.
model CreditNoteItem {
  id                String   @id @default(uuid())
  tenantId          String
  creditNoteId      String
  invoiceItemId     String?
  trackedCategoryId String?
  amount            Decimal  @default(0) @db.Decimal(12, 2) // credited net (pre-tax) portion
  qty               Decimal  @default(0) @db.Decimal(12, 3)
  categoryTax       Decimal  @default(0) @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([creditNoteId])
}

/// Order↔credit-note INTENT: "apply this credit (up to `amount`, or its remaining
/// balance when null) to this order's invoice(s)". Pure selection state — the MONEY
/// only ever moves through CreditNotesService.applyCreditInTx (an InvoicePayment with
/// method CREDIT_NOTE), and settleOrderCreditsInTx re-applies intents idempotently
/// whenever the order's invoice picture changes. Survives every destructive invoice
/// line rebuild because it never references invoice rows. `amount` is a REQUEST,
/// never a balance — CreditNote.amountUsed stays the single wallet truth.
model OrderCreditNote {
  id           String   @id @default(uuid())
  tenantId     String?
  orderId      String
  creditNoteId String
  amount       Decimal? @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  creditNote CreditNote @relation(fields: [creditNoteId], references: [id])
  tenant     Tenant?    @relation(fields: [tenantId], references: [id])

  @@unique([orderId, creditNoteId])
  @@index([creditNoteId])
  @@index([tenantId])
}

model Estimate {
  id             String         @id @default(uuid())
  estimateNumber String
  customerId     String
  status         EstimateStatus @default(DRAFT)
  subtotal       Decimal        @db.Decimal(10, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(10, 2)
  discount       Decimal        @default(0) @db.Decimal(10, 2)
  total          Decimal        @db.Decimal(10, 2)
  expiresAt      DateTime?
  notes          String?
  terms          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenantId       String?

  customer Customer       @relation(fields: [customerId], references: [id])
  tenant   Tenant?        @relation(fields: [tenantId], references: [id])
  items    EstimateItem[]

  @@unique([tenantId, estimateNumber])
  @@index([customerId])
  @@index([status])
  @@index([tenantId])
}

model EstimateItem {
  id            String    @id @default(uuid())
  estimateId    String
  description   String
  productId     String?
  qty           Decimal   @db.Decimal(10, 3)
  unitPrice     Decimal   @db.Decimal(10, 2)
  subtotal      Decimal   @db.Decimal(10, 2)
  priceType     PriceType @default(STANDARD)
  originalPrice Decimal?  @db.Decimal(10, 2)
  boxes         Int?
  pieces        Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenantId      String?

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  product  Product? @relation(fields: [productId], references: [id])

  @@index([estimateId])
  @@index([productId])
  @@index([tenantId])
}

// ─── Sprint 7: Vendor Bills (Accounts Payable) ───────────────────────────────

model VendorBill {
  id                    String           @id @default(uuid())
  billNumber            String
  supplierId            String?
  status                VendorBillStatus @default(RECEIVED)
  totalOwed             Decimal          @db.Decimal(10, 2)
  totalPaid             Decimal          @default(0) @db.Decimal(10, 2)
  billDate              DateTime?
  dueDate               DateTime?
  receivedDate          DateTime?
  notes                 String?
  // The SUPPLIER's own invoice number, stored NORMALIZED (uppercase, whitespace
  // stripped — see DuplicateMatchService.normalizeNumber). `billNumber` above is
  // OUR generated BILL-YYYY-NNNN, so this is the only field that identifies the
  // vendor's document. Deliberately NOT unique: prod predates the column, the
  // same number legitimately recurs across suppliers, and VOID bills must never
  // block a re-scan — dedup is an app-level guard (VendorBillsService.create).
  // Null on legacy rows the backfill could not parse and on old mobile builds.
  supplierInvoiceNumber String?
  // Net-terms label as entered on the bill ("Net 30", "Due on Receipt", …),
  // prefillable from Supplier.defaultTerms. Persisted verbatim; the server does
  // NOT compute dueDate from it — the client derives Due Date = Bill Date + days.
  termsLabel            String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  tenantId              String?

  // Sales tax as printed on the supplier's invoice. `totalOwed` already includes
  // it, but without its own column an edit recomputes totalOwed from line items
  // and silently drops the tax.
  taxAmount Decimal? @db.Decimal(12, 2)
  subtotal  Decimal? @db.Decimal(12, 2)

  supplier Supplier?        @relation(fields: [supplierId], references: [id])
  tenant   Tenant?          @relation(fields: [tenantId], references: [id])
  payments BillPayment[]
  items    VendorBillItem[]
  scans    InvoiceScan[]

  @@unique([tenantId, billNumber])
  @@index([supplierId])
  @@index([status])
  @@index([dueDate])
  @@index([tenantId])
  @@index([tenantId, supplierInvoiceNumber])
}

/// Durable record of every purchase-invoice scan, written when the document is
/// read rather than when a bill is created — so an abandoned review still leaves
/// the extraction (and the AI spend) recoverable, and so a document can be
/// recognised on sight the next time someone uploads it.
///
/// Carries three duplicate keys, strongest first:
///   1. `fileHash`        — same bytes. Checked BEFORE the AI call, so a re-run of
///                          the same PDF costs nothing and answers instantly.
///   2. `lineFingerprint` — same numbers (sorted qty@unitCost + total). Survives
///                          re-photographing and OCR wording drift, which is what
///                          defeated text comparison on the 2026-08 duplicates.
///   3. `supplierInvoiceNumber` + supplier — the printed identity, when readable.
/// `extractedPayload` keeps the FULL model output (per-line sku, packSize,
/// lineTotal, confidence, candidates) that the VendorBill columns cannot hold.
model InvoiceScan {
  id       String  @id @default(uuid())
  tenantId String?

  // The document exactly as received.
  fileKey   String? // storage key; null once the file is pruned
  fileName  String?
  mimeType  String?
  byteSize  Int?
  pageCount Int?
  fileHash  String

  // What the model read, verbatim and lossless.
  extractedPayload Json
  model            String?
  scanDurationMs   Int?

  // Key parameters promoted out of the payload so they can be queried and indexed.
  supplierNameRaw       String?
  supplierId            String?
  supplierInvoiceNumber String? // NORMALIZED, same rule as VendorBill
  invoiceDate           DateTime?
  subtotal              Decimal?  @db.Decimal(12, 2)
  tax                   Decimal?  @db.Decimal(12, 2)
  total                 Decimal?  @db.Decimal(12, 2)
  lineCount             Int?
  lineFingerprint       String?

  status        InvoiceScanStatus @default(SCANNED)
  vendorBillId  String?
  duplicateOfId String?
  scannedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant?       @relation(fields: [tenantId], references: [id])
  supplier    Supplier?     @relation(fields: [supplierId], references: [id])
  vendorBill  VendorBill?   @relation(fields: [vendorBillId], references: [id])
  duplicateOf InvoiceScan?  @relation("ScanDuplicate", fields: [duplicateOfId], references: [id])
  duplicates  InvoiceScan[] @relation("ScanDuplicate")

  @@index([tenantId, fileHash])
  @@index([tenantId, lineFingerprint])
  @@index([tenantId, supplierInvoiceNumber])
  @@index([tenantId, status])
  @@index([vendorBillId])
  @@index([supplierId])
}

/// A parsed supplier statement awaiting reconciliation. Mirrors InvoiceScan:
/// fileHash dedups a re-upload without re-calling the model, extractedPayload
/// keeps the model's verbatim output for audit, and status records whether the
/// operator applied it.
model SupplierStatementScan {
  id       String  @id @default(uuid())
  tenantId String?

  // The document exactly as received.
  fileKey   String? // storage key; null once the file is pruned
  fileName  String?
  mimeType  String?
  byteSize  Int?
  pageCount Int?
  fileHash  String

  // What the model read, verbatim and lossless.
  extractedPayload Json
  model            String?
  scanDurationMs   Int?

  // Key parameters promoted out of the payload so they can be queried and indexed.
  supplierNameRaw String?
  supplierId      String?
  periodStart     DateTime?
  periodEnd       DateTime?
  openingBalance  Decimal?  @db.Decimal(12, 2)
  closingBalance  Decimal?  @db.Decimal(12, 2)
  lineCount       Int?

  status SupplierStatementScanStatus @default(SCANNED)

  /// Set once applied — the paymentGroupId of the payments this scan wrote,
  /// so the whole apply can be traced (and undone by voiding that group).
  appliedPaymentGroupId String?
  appliedAt             DateTime?
  appliedById           String?
  scannedById           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([tenantId, fileHash])
  @@index([tenantId, supplierId])
  @@index([tenantId, status])
}

model VendorBillItem {
  id           String   @id @default(uuid())
  vendorBillId String
  productId    String?
  description  String
  qty          Decimal  @db.Decimal(10, 3)
  unitCost     Decimal  @db.Decimal(10, 4)
  // Read off the invoice line and previously discarded at the create boundary.
  // `sku` is the supplier's own item code — the strongest signal for matching a
  // line to a catalog product on the NEXT scan from the same supplier.
  sku          String?
  packSize     Int?
  lineTotal    Decimal? @db.Decimal(12, 2)
  // Cumulative quantity actually received on this line, in BILL denomination
  // (cases when packSize > 1). Null = receipt predates per-line tracking; a
  // bill whose receivedDate is set while EVERY line is null was fully received.
  qtyReceived  Decimal? @db.Decimal(10, 3)
  createdAt    DateTime @default(now())
  tenantId     String?

  vendorBill VendorBill @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  tenant     Tenant?    @relation(fields: [tenantId], references: [id])
  product    Product?   @relation(fields: [productId], references: [id])

  @@index([vendorBillId])
  @@index([productId])
  @@index([tenantId])
}

model BillPayment {
  id               String        @id @default(uuid())
  vendorBillId     String
  amount           Decimal       @db.Decimal(10, 2)
  method           PaymentMethod
  reference        String?
  notes            String?
  paidAt           DateTime      @default(now())
  createdAt        DateTime      @default(now())
  // Stamped once per supplier-level allocation event, so N BillPayment rows created
  // from one lump-sum supplier payment (recordSupplierPayment) are recognisable as
  // one group. Mirrors InvoicePayment.paymentGroupId on the AR side. Null on every
  // pre-existing row and on payments made through the single-bill recordPayment route.
  paymentGroupId   String?
  // Set ONLY when this row is a draw-down of on-account SupplierCredit
  // (auto-applied when a bill is created). This link — not the free-text
  // `reference`, which any caller can type — is what identifies a draw, so a
  // statement can exclude it and a void/delete can hand the money back.
  // Mirrors InvoicePayment.advancePaymentId on the AR side.
  supplierCreditId String?
  tenantId         String?

  vendorBill     VendorBill      @relation(fields: [vendorBillId], references: [id])
  tenant         Tenant?         @relation(fields: [tenantId], references: [id])
  supplierCredit SupplierCredit? @relation(fields: [supplierCreditId], references: [id])

  @@index([vendorBillId])
  @@index([paymentGroupId])
  @@index([supplierCreditId])
  @@index([tenantId])
}

// ─── AI Product Mapping Memory ────────────────────────────────────────────────

model ProductMapping {
  id             String   @id @default(uuid())
  supplierName   String
  rawDescription String
  productId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenantId       String?

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  tenant  Tenant?  @relation(fields: [tenantId], references: [id])

  @@unique([supplierName, rawDescription])
  @@index([supplierName])
  @@index([tenantId])
}

// ─── Sprint 8: Returns / RMA ──────────────────────────────────────────────────

model Return {
  id           String       @id @default(uuid())
  returnNumber String?
  orderId      String
  customerId   String
  reason       ReturnReason
  status       ReturnStatus @default(PENDING)
  notes        String?
  photoUrls    String[]
  creditNoteId String?
  // Return resolution snapshot (2026-07-30). refundMethod is "CREDIT_NOTE" (store credit was
  // minted; see creditNoteId) or "EXTERNAL_REFUND" (money returned outside RouteFlow — nothing
  // is minted, this is the audit trail). Kept as String? rather than an enum to avoid a
  // CREATE TYPE migration; validated at the DTO edge.
  refundMethod String?
  refundAmount Decimal?     @db.Decimal(10, 2)
  refundedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tenantId     String?

  order    Order        @relation(fields: [orderId], references: [id])
  tenant   Tenant?      @relation(fields: [tenantId], references: [id])
  customer Customer     @relation(fields: [customerId], references: [id])
  items    ReturnItem[]

  @@unique([tenantId, returnNumber])
  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([tenantId])
}

model ReturnItem {
  id        String  @id @default(uuid())
  returnId  String
  productId String
  qty       Decimal @db.Decimal(10, 3)
  reason    String?
  restock   Boolean @default(true)
  tenantId  String?

  return  Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  tenant  Tenant? @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
  @@index([tenantId])
}

// ─── Advance Payments ─────────────────────────────────────────────────────────

model AdvancePayment {
  id         String        @id @default(uuid())
  customerId String
  amount     Decimal       @db.Decimal(10, 2)
  balance    Decimal       @db.Decimal(10, 2)
  method     PaymentMethod
  reference  String?
  notes      String?
  receivedAt DateTime      @default(now())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  tenantId   String?

  customer     Customer         @relation(fields: [customerId], references: [id])
  tenant       Tenant?          @relation(fields: [tenantId], references: [id])
  applications InvoicePayment[]

  @@index([customerId])
  @@index([tenantId])
}

// ─── Supplier Credits ─────────────────────────────────────────────────────────

/// On-account credit held for a supplier — the AP mirror of AdvancePayment.
/// Created when a supplier payment exceeds everything currently owed; drawn
/// down automatically against the next bill. No status machine: fully drawn
/// is simply balance = 0.
model SupplierCredit {
  id         String        @id @default(uuid())
  supplierId String
  amount     Decimal       @db.Decimal(10, 2) // original, immutable
  balance    Decimal       @db.Decimal(10, 2) // remaining drawable
  method     PaymentMethod
  reference  String?
  notes      String?
  receivedAt DateTime      @default(now())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  tenantId   String?

  supplier     Supplier      @relation(fields: [supplierId], references: [id])
  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
  applications BillPayment[]

  @@index([supplierId])
  @@index([tenantId])
}

// ─── Recurring Invoices ───────────────────────────────────────────────────────

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model RecurringInvoice {
  id          String             @id @default(uuid())
  customerId  String
  frequency   RecurringFrequency
  dayOfWeek   Int?
  dayOfMonth  Int?
  isActive    Boolean            @default(true)
  autoSend    Boolean            @default(false)
  notes       String?
  terms       String?
  discount    Decimal            @default(0) @db.Decimal(10, 2)
  shippingFee Decimal            @default(0) @db.Decimal(10, 2)
  nextRunAt   DateTime
  lastRunAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenantId    String?

  customer Customer               @relation(fields: [customerId], references: [id])
  tenant   Tenant?                @relation(fields: [tenantId], references: [id])
  items    RecurringInvoiceItem[]
  invoices Invoice[]

  @@index([customerId])
  @@index([isActive, nextRunAt])
  @@index([tenantId])
}

model RecurringInvoiceItem {
  id                 String  @id @default(uuid())
  recurringInvoiceId String
  productId          String?
  description        String
  qty                Decimal @db.Decimal(10, 3)
  unitPrice          Decimal @db.Decimal(10, 2)
  discount           Decimal @default(0) @db.Decimal(10, 2)
  taxRate            Decimal @default(0) @db.Decimal(5, 4)
  tenantId           String?

  recurringInvoice RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  tenant           Tenant?          @relation(fields: [tenantId], references: [id])
  product          Product?         @relation(fields: [productId], references: [id])

  @@index([recurringInvoiceId])
  @@index([tenantId])
}

// ─── Driver-to-Dispatcher Messaging ──────────────────────────────────────────

model Message {
  id         String   @id @default(uuid())
  runId      String?
  text       String
  senderId   String
  senderRole String // "DRIVER" | "OPERATOR"
  createdAt  DateTime @default(now())
  tenantId   String?

  // P6-1 (F0): additively generalize the run-chat Message into a channel-aware,
  // thread-attachable message. Existing driver run-chat rows keep threadId=NULL
  // and channel=INTERNAL (both defaulted), so the create/read paths are unchanged.
  threadId String?
  channel  MessageChannel @default(INTERNAL)

  sender User           @relation(fields: [senderId], references: [id])
  tenant Tenant?        @relation(fields: [tenantId], references: [id])
  thread MessageThread? @relation(fields: [threadId], references: [id])

  @@index([runId])
  @@index([senderId])
  @@index([tenantId])
  @@index([threadId])
}

// ─── P6-1 (F0): Unified messaging — threads, templates, rules, consent ────────
// Additive foundation for the P6 messaging phase. NOTHING here is wired to a
// provider yet (StubProvider + real adapters land in P6-3/P6-4); this is the
// schema substrate the engine/inbox/settings build on. All tenant-scoped.

enum MessageChannel {
  INTERNAL // driver ↔ operator run-chat (default; never metered, never STOP-gated)
  WHATSAPP // metered (MSGS), STOP-gated, consent-gated
  SMS // metered (MSGS), STOP-gated, consent-gated
  EMAIL // never metered
  PORTAL // buyer-portal chat; never metered
}

enum ThreadStatus {
  OPEN
  SNOOZED
  CLOSED
}

enum WaApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum TriageStatus {
  PENDING
  LINKED
  DISMISSED
}

// Catalogue of notification triggers the rules matrix + templates key off.
enum NotificationEvent {
  ORDER_CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  ORDER_CHANGED_AT_DOOR
  INVOICE_SENT // email/portal only; WA/SMS cells render disabled
  PAYMENT_REMINDER
  LICENSE_EXPIRING
  URGENT_ORDER_PLACED // internal alert
  LOW_STOCK // internal alert
  FAILED_DELIVERY // internal alert
  PAYMENT_FAILED_NSF // internal alert
}

// One conversation with a customer across all channels (the inbox row).
model MessageThread {
  id                 String          @id @default(uuid())
  tenantId           String?
  customerId         String?
  lastChannel        MessageChannel?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  unreadCount        Int             @default(0)
  status             ThreadStatus    @default(OPEN)
  snoozedUntil       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  messages Message[]

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, status])
}

// Per-event/-channel message body with {{var}} placeholders (+ Meta WA template ref).
model MessageTemplate {
  id               String            @id @default(uuid())
  tenantId         String?
  eventKey         NotificationEvent
  channel          MessageChannel
  body             String
  variables        String[]          @default([])
  waTemplateName   String?
  waApprovalStatus WaApprovalStatus  @default(NONE)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, eventKey, channel])
  @@index([tenantId])
}

// The Settings → Notifications matrix cell state (event × channel → on/off).
model NotificationRule {
  id        String            @id @default(uuid())
  tenantId  String?
  eventKey  NotificationEvent
  channel   MessageChannel
  enabled   Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, eventKey, channel])
  @@index([tenantId])
}

// STOP-reply / manual opt-out state for the metered, STOP-capable channels.
model MessageOptOut {
  id         String         @id @default(uuid())
  tenantId   String?
  customerId String?
  phone      String?
  channel    MessageChannel
  optedOutAt DateTime       @default(now())
  reason     String?
  source     String? // e.g. "STOP"

  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@unique([tenantId, customerId, channel])
  @@index([tenantId])
  @@index([tenantId, phone])
}

// Per-tenant messaging config singleton. Provider credentials (Meta WA / Twilio)
// are deferred to P6-3 (encrypted via EncryptionService when the adapters land).
model MessagingSettings {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  quietHoursEnabled Boolean  @default(true)
  quietHoursStart   String   @default("21:00")
  quietHoursEnd     String   @default("07:00")
  timezone          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// Inbound message from an unknown number → operator triage queue (link/dismiss).
model InboundTriage {
  id                 String         @id @default(uuid())
  tenantId           String?
  channel            MessageChannel
  fromNumber         String
  body               String
  providerMsgId      String?
  status             TriageStatus   @default(PENDING)
  resolvedCustomerId String?
  resolvedById       String?
  resolvedAt         DateTime?
  receivedAt         DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
}

// ─── Customer Special Prices ──────────────────────────────────────────────────

model CustomerPrice {
  id          String   @id @default(uuid())
  customerId  String
  productId   String
  // Nullable: a row may now carry an MSRP override only, with no tier override. Every
  // reader already falls back (`?? customer default tier`), so null here is safe — see
  // common/msrp.ts and the plan at .claude/pipeline/plans/2026-08-22-msrp-on-invoices.md.
  pricingTier Int?
  // Per-customer MSRP override — highest precedence in resolveMsrp. Display-only, never
  // money math. Null = no override, falls back to Product.msrp.
  msrp        Decimal? @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([tenantId])
}

// ─── Buyer Portal ─────────────────────────────────────────────────────────────

model BuyerAccount {
  id                  String             @id @default(uuid())
  email               String             @unique
  passwordHash        String
  // false only for Google-auto-created accounts (random unguessable hash) —
  // gates the no-current-password "set password" flow. Accounts created via
  // Google before this column existed keep the default true and must use the
  // email reset flow instead (indistinguishable from password accounts).
  passwordSet         Boolean            @default(true)
  name                String
  phone               String?
  mobile              String?
  googleId            String?            @unique
  status              BuyerAccountStatus @default(ACTIVE)
  emailVerified       Boolean            @default(false)
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  mergedIntoId        String? // audit: set on the secondary after a completed merge

  customerLinks            CustomerLink[]
  refreshTokens            BuyerRefreshToken[]
  passwordResetTokens      BuyerPasswordResetToken[]
  emailVerificationTokens  BuyerEmailVerificationToken[]
  mergeRequestsAsPrimary   BuyerMergeRequest[]           @relation("MergeAsPrimary")
  mergeRequestsAsSecondary BuyerMergeRequest[]           @relation("MergeAsSecondary")
  favorites                BuyerFavorite[]
  paymentRequests          BuyerPaymentRequest[]

  @@index([email])
  @@index([status])
  @@index([deletedAt])
}

model CustomerLink {
  id              String             @id @default(uuid())
  buyerAccountId  String? // null while invite is pending acceptance
  customerId      String             @unique
  tenantId        String
  status          CustomerLinkStatus @default(INVITED)
  inviteToken     String?            @unique
  inviteExpiresAt DateTime?
  inviteMethod    InviteMethod?
  linkedAt        DateTime?
  disconnectedAt  DateTime?
  disconnectedBy  DisconnectedBy?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  buyerAccount BuyerAccount? @relation(fields: [buyerAccountId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id])

  @@index([buyerAccountId])
  @@index([tenantId])
  @@index([inviteToken])
  @@index([status])
}

/// A tenant's own Stripe account, linked via Connect OAuth (Standard account,
/// direct charges, no platform fee). Kept off Tenant so the link can be revoked
/// and re-established without touching the tenant row, and so `account.updated`
/// webhooks have an obvious landing place. `chargesEnabled` gates the buyer's
/// card button — a linked-but-unverified account must not accept payments.
/// `stripeAccountId` is nullable because the row now exists BEFORE the OAuth
/// callback completes: `buildAuthorizeUrl` upserts a "link started" shell to
/// stash `pendingJti` (invariant 12's single-use OAuth state) — reads that
/// treat the row as "connected" (`getStatus`, `chargeableAccount`) require
/// `stripeAccountId` to be set, not just row-existence.
model TenantStripeConnect {
  id                 String    @id @default(uuid())
  tenantId           String    @unique
  stripeAccountId    String?
  livemode           Boolean   @default(false)
  chargesEnabled     Boolean   @default(false)
  detailsSubmitted   Boolean   @default(false)
  connectedAt        DateTime  @default(now())
  disconnectedAt     DateTime?
  connectedByName    String?
  /// Single-use OAuth `state` jti (invariant 12): set when the authorize URL
  /// is built, cleared atomically the moment `completeOAuth` consumes it. A
  /// second exchange of the same `state` token finds no match and is
  /// rejected — closes the OAuth-state replay window.
  pendingJti         String?
  pendingJtiIssuedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Non-unique on purpose: one business may run two tenants off one Stripe
  // account. Payment webhooks resolve by session id, never by account id.
  @@index([stripeAccountId])
}

/// Insert-first ledger for every Stripe Connect webhook delivery (invariant
/// 3). The controller writes this row — raw client, before any tenant
/// resolution or anti-spoof check — BEFORE doing anything else with the
/// event; `id` is the Stripe event id, so a redelivery collides on the unique
/// constraint and is a no-op ack. `accountRef` + `type` + `createdAt` (Stripe's
/// `event.created`, NOT when we received it) let `account.updated` handling
/// find the last-APPLIED delivery for an account and ignore a stale one that
/// arrives out of order. `outcome` is filled in after routing (e.g. "settled",
/// "duplicate", "account_mismatch", "stale", "ignored:<type>").
model StripeConnectEvent {
  id          String   @id
  accountRef  String
  type        String
  createdAt   DateTime
  processedAt DateTime @default(now())
  outcome     String?

  @@index([accountRef, type, createdAt])
}

enum BuyerPaymentRequestKind {
  CARD
  CASH
}

enum BuyerPaymentRequestStatus {
  PENDING
  /// Claimed by a webhook delivery that is writing the InvoicePayment right
  /// now (invariant 7) — the non-reopening intermediate state between PENDING
  /// and SETTLED that makes a crash-then-redeliver safe.
  SETTLING
  /// Card payment settled (money written). Cash approvals stay on APPROVED —
  /// SETTLED is specific to the webhook-driven card lifecycle.
  SETTLED
  APPROVED
  REJECTED
  FAILED
  EXPIRED
  CANCELLED
}

/// A buyer-initiated payment BEFORE it becomes money. Deliberately a separate
/// table rather than a PaymentStatus member: `recomputeStatus` sums
/// InvoicePayment rows, so a pending declaration inside that table would mark
/// invoices paid on the buyer's say-so (the DRAFT-payment trap). InvoicePayment
/// rows are written only on approval (cash) or a verified webhook (card), via
/// recordStandalonePayment with an oldest-first allocation; `paymentGroupId`
/// then joins this request to the rows it produced.
///
/// RACE-PROOF OPEN-REQUEST RULE (invariant 8): migration
/// `20260826000000_stripe_connect_event_ledger` adds a PARTIAL unique index
/// — `CREATE UNIQUE INDEX ... ON "BuyerPaymentRequest"("tenantId","customerId")
/// WHERE status IN ('PENDING','SETTLING')` — that Prisma's schema language
/// cannot express (no `WHERE` on `@@index`/`@@unique`), so it exists ONLY in
/// that migration file; `prisma migrate dev` will not see it as drift because
/// nothing here declares a conflicting full unique constraint on the same
/// columns. EXPIRED is deliberately excluded so an abandoned request doesn't
/// block the buyer from starting a new one.
model BuyerPaymentRequest {
  id                    String                    @id @default(uuid())
  tenantId              String
  customerId            String
  buyerAccountId        String?
  /// Provenance only — the invoice screen the buyer started from. Allocation
  /// is strictly oldest-first across the account and ignores this field.
  invoiceId             String?
  kind                  BuyerPaymentRequestKind
  status                BuyerPaymentRequestStatus @default(PENDING)
  amount                Decimal                   @db.Decimal(10, 2)
  note                  String?
  reference             String?
  stripeSessionId       String?                   @unique
  /// DEPRECATED (2026-08-22) — read `providerPaymentId` instead. Written only
  /// by the pre-#399 settle path; rows from that era were backfilled into
  /// providerPaymentId by 20260828000000_unify_provider_payment_id, so this
  /// column is now redundant and NOTHING should read or write it. Kept only
  /// until a cleanup migration drops it. Same concept in two columns split by
  /// deploy date = silent NULLs for whichever a reader picks wrong.
  stripePaymentIntentId String?
  /// The settled PaymentIntent id (invariant 7/9) — provider-agnostic name,
  /// set once `settleByPaymentIntent` claims/completes the row. The ONE
  /// column for "which processor payment settled this request".
  providerPaymentId     String?
  /// Free-text note for an anomalous settle (e.g. money arrived for a row
  /// that was CANCELLED/REJECTED/FAILED/EXPIRED, or the charged amount
  /// disagreed with the requested amount) — never blocks the write, just
  /// flags it for operator review.
  outcome               String?
  paymentGroupId        String?
  failureReason         String?
  decidedById           String?
  decidedByName         String?
  decidedAt             DateTime?
  expiresAt             DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  buyerAccount BuyerAccount? @relation(fields: [buyerAccountId], references: [id])

  @@index([tenantId, status])
  @@index([customerId])
  @@index([tenantId, createdAt])
  @@index([paymentGroupId])
}

model BuyerRefreshToken {
  id             String    @id @default(uuid())
  buyerAccountId String
  tokenHash      String    @unique
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  userAgent      String?
  ipAddress      String?
  deviceName     String?
  lastUsedAt     DateTime?

  buyerAccount BuyerAccount @relation(fields: [buyerAccountId], references: [id], onDelete: Cascade)

  @@index([buyerAccountId])
  @@index([expiresAt])
}

// Mirrors PasswordResetToken for BuyerAccount — kept as a separate model (like
// RefreshToken/BuyerRefreshToken) so staff and buyer reset tokens can never be
// confused for one another.
model BuyerPasswordResetToken {
  id             String    @id @default(uuid())
  buyerAccountId String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  buyerAccount BuyerAccount @relation(fields: [buyerAccountId], references: [id], onDelete: Cascade)

  @@index([buyerAccountId])
  @@index([expiresAt])
}

// Registration email-verification token — proves the registrant controls the
// mailbox before `emailVerified` unlocks auto-connect in requestSeller. Kept as
// a separate model from BuyerPasswordResetToken so a verification token can
// never be replayed to change a password (and vice versa).
model BuyerEmailVerificationToken {
  id             String    @id @default(uuid())
  buyerAccountId String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  buyerAccount BuyerAccount @relation(fields: [buyerAccountId], references: [id], onDelete: Cascade)

  @@index([buyerAccountId])
  @@index([expiresAt])
}

// ─── Audit Logging ────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  ip         String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Buyer Account Merge Requests ─────────────────────────────────────────────

model BuyerMergeRequest {
  id                  String                  @id @default(uuid())
  primaryAccountId    String
  secondaryAccountId  String
  status              BuyerMergeRequestStatus @default(PENDING_VERIFICATION)
  initiatedBy         MergeInitiator
  initiatedByTenantId String?
  initiatorNotes      String?
  adminNotes          String?
  verificationToken   String?                 @unique
  verificationExpires DateTime?
  verifiedAt          DateTime?
  completedAt         DateTime?
  rejectedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  primaryAccount   BuyerAccount @relation("MergeAsPrimary", fields: [primaryAccountId], references: [id])
  secondaryAccount BuyerAccount @relation("MergeAsSecondary", fields: [secondaryAccountId], references: [id])
  initiatingTenant Tenant?      @relation(fields: [initiatedByTenantId], references: [id])

  @@index([primaryAccountId])
  @@index([secondaryAccountId])
  @@index([status])
  @@index([verificationToken])
}

enum BuyerMergeRequestStatus {
  PENDING_VERIFICATION
  PENDING_REVIEW
  COMPLETED
  REJECTED
}

enum MergeInitiator {
  BUYER
  TENANT
  SUPER_ADMIN
}

// ─── Buyer Favorites ──────────────────────────────────────────────────────────

model BuyerFavorite {
  id             String   @id @default(uuid())
  buyerAccountId String
  customerId     String
  productId      String
  tenantId       String
  createdAt      DateTime @default(now())

  buyerAccount BuyerAccount @relation(fields: [buyerAccountId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id])

  @@unique([buyerAccountId, customerId, productId])
  @@index([buyerAccountId, customerId])
  @@index([tenantId])
}

// ─── Replenishment Snooze (P5-06 Your Shelf) ──────────────────────────────────

/// Buyer-side "not this cycle" suppression of one replenishment estimate.
/// One row per (tenant, customer, product); snoozedUntil = now + one inferred
/// cadence (14d fallback). Rows past snoozedUntil are simply ignored on read.
model ReplenishmentSnooze {
  id           String   @id @default(uuid())
  tenantId     String?
  customerId   String
  productId    String
  snoozedUntil DateTime
  createdAt    DateTime @default(now())

  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, customerId, productId])
  @@index([customerId])
  @@index([tenantId])
}

// ─── Stock Alerts (P5-03 Notify-me) ───────────────────────────────────────────

/// Buyer "notify me when back in stock" subscription. One row per
/// (tenant, customer, product). A restock flips PENDING → NOTIFIED exactly once
/// (StockAlertService.fireForProducts only ever transitions PENDING rows, so
/// re-firing from multiple stock-increase paths is idempotent) and stamps
/// notifiedAt. Re-subscribing upserts the row back to PENDING.
model StockAlert {
  id         String           @id @default(uuid())
  tenantId   String?
  customerId String
  productId  String
  status     StockAlertStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  notifiedAt DateTime?

  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, customerId, productId])
  @@index([productId])
  @@index([tenantId])
}

enum StockAlertStatus {
  PENDING
  NOTIFIED
}

// ─── Tobacco Compliance (tobacco_dealer addon) ────────────────────────────────

enum TobaccoReportStatus {
  GENERATED
  FAILED
}

/// Point-in-time monthly regulatory snapshot of tobacco purchases/sales.
/// `rows` is a JSON snapshot (never queried relationally); the CSV/PDF are
/// persisted at deterministic storage keys and regenerations are audited.
model TobaccoReport {
  id                 String              @id @default(uuid())
  tenantId           String
  periodYear         Int
  periodMonth        Int // 1-12
  periodStart        DateTime
  periodEnd          DateTime
  status             TobaccoReportStatus @default(GENERATED)
  // Denormalized totals for list views
  totalQtyPurchased  Decimal             @default(0) @db.Decimal(12, 3)
  totalPurchaseValue Decimal             @default(0) @db.Decimal(12, 2)
  totalQtySold       Decimal             @default(0) @db.Decimal(12, 3)
  totalSalesValue    Decimal             @default(0) @db.Decimal(12, 2)
  totalTaxCollected  Decimal             @default(0) @db.Decimal(12, 2)
  endingStockQty     Decimal             @default(0) @db.Decimal(12, 3)
  endingStockValue   Decimal             @default(0) @db.Decimal(12, 2)
  rows               Json
  csvKey             String?
  pdfKey             String?
  generatedAt        DateTime            @default(now())
  generatedById      String? // null = cron
  generationCount    Int                 @default(1)
  errorMessage       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodYear, periodMonth])
  @@index([tenantId])
}

/// Parked sale/order/invoice drafts (pos-cost-roles-spec §2 — Minimize & resume).
/// Per-user, tenant-scoped; `payload` is the full builder state so a draft
/// restores exactly. Additive/new — does not touch any existing table.
model SaleDraft {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String // owner — drafts are per-user
  kind         String   @default("ORDER") // ORDER | INVOICE
  customerId   String?
  customerName String? // denormalized label for the draft dock (no join needed)
  title        String?
  payload      Json // full builder state (line items, prices, delivery date, …)
  device       String? // originating device hint
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, updatedAt])
}

// ─── Regulated / Tracked Categories (Phase 4 — generalizes tobacco) ────────────
// Tobacco is seed row #1 of this generic system, never a special case in code.
// `Product.isTobacco` is kept as a shadow column for one release; the new
// `Product.trackedCategoryId` FK is the going-forward source of truth.

/// How a tracked category computes its category-specific tax at sale time.
/// NONE = tracked/reported but no auto tax added. Tobacco seeds as NONE so the
/// current warn-only behavior is preserved until the W3 tax calculator ships.
enum TrackedCategoryTaxType {
  EXCISE_PER_UNIT
  PERCENT_OF_SALE
  PER_VOLUME
  DEPOSIT_PER_CONTAINER
  NONE
}

/// How regulated lines are presented on invoices.
/// SEPARATE_INVOICE = one paired invoice per category (default); SEPARATE_SECTION
/// = a sectioned block on the main invoice; LINE_TAX = per-line tax (e.g. CRV).
enum InvoiceTreatment {
  SEPARATE_INVOICE
  SEPARATE_SECTION
  LINE_TAX
}

enum ReportCadence {
  MONTHLY
  QUARTERLY
  ANNUAL
}

/// Per-seller authorization (license) state for a customer buying a regulated
/// category. Verification is per seller relationship.
enum AuthorizationStatus {
  NONE
  PENDING_REVIEW
  VERIFIED
  EXPIRED
  REJECTED
}

enum AuthorizationSource {
  RETAILER_SUBMITTED
  WHOLESALER_ADDED
}

/// A regulated-sales-ledger row is either an original SALE or a REVERSAL
/// (credit note / return). Amounts on REVERSAL rows are stored negative so a
/// plain SUM() nets to the reportable figure.
enum LedgerEntryType {
  SALE
  REVERSAL
}

/// A regulated filing is either successfully GENERATED (artifacts stored) or a
/// FAILED attempt (recorded so the tenant still sees it in their filing list).
enum RegulatedFilingStatus {
  GENERATED
  FAILED
}

/// A tenant-defined class of items handled separately for sales/tax/reporting
/// (tobacco, alcohol, CRV deposits, city sugar taxes…). Deactivation
/// (active=false) keeps historic sales/ledger data intact.
model TrackedCategory {
  id                  String                 @id @default(uuid())
  tenantId            String
  name                String
  taxType             TrackedCategoryTaxType @default(NONE)
  // Interpreted by taxType. PERCENT_OF_SALE stores a fraction (0.05 = 5%),
  // matching the existing InvoiceItem.taxRate convention; the per-unit/volume
  // variants store an absolute amount per `unitBasis`.
  rate                Decimal                @default(0) @db.Decimal(12, 4)
  unitBasis           String? // pack, oz, container… what `rate` multiplies
  priceIncludesTax    Boolean                @default(false)
  invoiceTreatment    InvoiceTreatment       @default(SEPARATE_INVOICE)
  appliesScope        Json? // optional geo/customer scoping, e.g. {cities:["Oakland"]}
  requiresLicense     Boolean                @default(false)
  // Phase 4 (W7b): per-category POD policy — when set, a delivery stop containing
  // a product in this category demands the driver capture an age check and/or an
  // identity check (with signature POD, no safe-drop) before the stop completes.
  requiresAgeCheck    Boolean                @default(false)
  requiresIdCheck     Boolean                @default(false)
  reportTemplate      String                 @default("GENERIC") // CA_CDTFA | CA_ABC | CALRECYCLE | GENERIC
  reportCadence       ReportCadence          @default(MONTHLY)
  // TX Comptroller (TX_COMPTROLLER report template) config — all optional, per-program because
  // a TX cigarette permit differs from a cigar/tobacco permit.
  wholesalerLicenseNo String? // THIS tenant's own TX license/permit number (8 digits)
  /// DEPRECATED — txItemType/txUom are superseded by Product.regItemType/regUomUnit. Kept one release as a shadow; no reader.
  txItemType          Int? // 1 = Cigarettes, 2 = Cigars, 3 = Tobacco
  /// DEPRECATED — txItemType/txUom are superseded by Product.regItemType/regUomUnit. Kept one release as a shadow; no reader.
  txUom               String? // CP|CS|CC (cigarettes) SB|SC|SD|SF (cigars) WO|WN (tobacco)
  /// Saved custom report column layout, keyed by template:
  /// { "TX_COMPTROLLER": ["wholesalerPermit", "retailerName", ...] }
  reportColumnPrefs   Json?
  active              Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products       Product[]
  orderItems     OrderItem[]
  invoiceItems   InvoiceItem[]
  authorizations CustomerAuthorization[]
  overrides      AuthorizationOverride[]
  ledgerEntries  RegulatedSalesLedger[]
  filings        RegulatedFiling[]
  subcategories  TrackedSubcategory[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, active])
}

/// Phase 4 (subcategories): a classification child UNDER a TrackedCategory
/// (section) — e.g. Tobacco → {cigarettes, chewing-tobacco}, Liquor → {beer,
/// wine, spirits}. REPORTING/CLASSIFICATION ONLY: it carries no license/age/ID/
/// invoice/tax semantics (all of those stay on the parent section, which is what
/// keeps the regulated guards + money paths safe). A product may point to a
/// subcategory IN ADDITION to its section; the subcategory's parent must equal
/// the product's section (enforced app-side).
model TrackedSubcategory {
  id                String   @id @default(uuid())
  tenantId          String
  trackedCategoryId String // parent section
  name              String
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trackedCategory TrackedCategory        @relation(fields: [trackedCategoryId], references: [id], onDelete: Cascade)
  products        Product[]
  orderItems      OrderItem[]
  invoiceItems    InvoiceItem[]
  ledgerEntries   RegulatedSalesLedger[]

  @@unique([tenantId, trackedCategoryId, name])
  @@index([tenantId])
  @@index([trackedCategoryId])
}

/// Per-customer, per-category authorization state for one seller (the tenant).
/// One row per customer+category. Two paths to VERIFIED: retailer-submitted
/// (buyer adds → seller approves) or wholesaler-added (VERIFIED immediately).
model CustomerAuthorization {
  id                         String              @id @default(uuid())
  tenantId                   String
  customerId                 String
  trackedCategoryId          String
  status                     AuthorizationStatus @default(NONE)
  source                     AuthorizationSource @default(WHOLESALER_ADDED)
  licenseNumber              String?
  expiresAt                  DateTime?
  documentKey                String?
  // Actor identity is stored as an immutable point-in-time SNAPSHOT (FK-less id +
  // display name) so the compliance audit survives the operator being deleted.
  verifiedById               String?
  verifiedByName             String?
  verifiedAt                 DateTime?
  // W7 expiry-notification idempotency (no in-app notification store to dedupe
  // against): the EXPIRED-flip notice fires once; expiringSoonNotifiedBucket holds
  // the last-sent warning bucket (30/7/1) so each fires at most once. Both reset to
  // null on renew()/create() so a re-verified→re-expired row notifies again.
  expiryNotifiedAt           DateTime?
  expiringSoonNotifiedBucket Int?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  trackedCategory TrackedCategory @relation(fields: [trackedCategoryId], references: [id], onDelete: Cascade)

  @@unique([customerId, trackedCategoryId])
  @@index([tenantId])
  @@index([customerId])
  @@index([trackedCategoryId])
  @@index([status])
  @@index([expiresAt])
  @@index([status, expiresAt])
}

/// Seller-side "sold under my responsibility" record when an operator sells a
/// regulated item to a customer without a verified license on file (spec §8).
/// Append-only audit trail — never mutated after creation.
model AuthorizationOverride {
  id                 String   @id @default(uuid())
  tenantId           String
  customerId         String
  trackedCategoryId  String
  scope              String // "ORDER:<id>" | "UNTIL:<iso-date>"
  reason             String
  acknowledgedTenant String? // tenant name captured in the acknowledgment checkbox
  // Immutable actor snapshot (FK-less id + display name) — the §8 responsibility
  // record must survive the accepting operator being deleted.
  acceptedById       String?
  acceptedByName     String?
  acceptedAt         DateTime @default(now())
  createdAt          DateTime @default(now())

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  trackedCategory TrackedCategory @relation(fields: [trackedCategoryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@index([trackedCategoryId])
  @@index([customerId, trackedCategoryId])
}

/// Immutable per-line ledger of regulated sales — the source of truth for
/// filings. Written on invoice-line creation (SALE, positive) and reversed on
/// credit note / return (REVERSAL, negative) against the correct sibling
/// invoice. The order/invoice/creditNote pointers are denormalized scalars
/// (indexed, no FK) so the ledger stays append-only and self-contained.
model RegulatedSalesLedger {
  id                   String          @id @default(uuid())
  tenantId             String
  trackedCategoryId    String
  // RF-3: additive classification child under the section (trackedCategoryId), for
  // the reporting/filing breakdown ONLY. Never read by the regulated guards or any
  // money math — a null is the pre-RF-3 (section-only) case.
  trackedSubcategoryId String?
  entryType            LedgerEntryType @default(SALE)
  orderId              String?
  orderItemId          String?
  invoiceId            String?
  invoiceItemId        String?
  creditNoteId         String?
  returnId             String? // W5c: set on return-driven REVERSAL rows (idempotency key)
  qty                  Decimal         @db.Decimal(12, 3)
  unitBasisQty         Decimal         @default(0) @db.Decimal(12, 3) // qty expressed in the category's unitBasis
  netSales             Decimal         @default(0) @db.Decimal(12, 2)
  categoryTax          Decimal         @default(0) @db.Decimal(12, 2)
  soldAt               DateTime
  periodBucket         String // "YYYY-MM" denormalized bucket for fast monthly aggregation
  createdAt            DateTime        @default(now())

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trackedCategory    TrackedCategory     @relation(fields: [trackedCategoryId], references: [id], onDelete: Restrict)
  // SetNull (not Restrict): a subcategory delete must never block the append-only
  // ledger — the row keeps its section attribution, only losing the finer breakdown.
  trackedSubcategory TrackedSubcategory? @relation(fields: [trackedSubcategoryId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([trackedCategoryId])
  @@index([trackedSubcategoryId])
  @@index([tenantId, trackedCategoryId, periodBucket])
  @@index([invoiceId])
  @@index([invoiceItemId])
  @@index([orderItemId])
  @@index([creditNoteId])
  @@index([returnId])
}

/// A prepared regulatory filing for one category + period (the generic superset
/// of TobaccoReport). Computed from the RegulatedSalesLedger's pre-signed nets,
/// so a reversal-heavy period legitimately nets down. Keyed by a single
/// `periodKey` string so MONTHLY / QUARTERLY / ANNUAL cadences share one column.
model RegulatedFiling {
  id                String                @id @default(uuid())
  tenantId          String
  trackedCategoryId String
  reportTemplate    String // snapshot of category.reportTemplate at prepare time
  cadence           ReportCadence         @default(MONTHLY) // snapshot of category.reportCadence
  periodKey         String // "YYYY-MM" | "YYYY-Qn" | "YYYY"
  periodStart       DateTime // UTC inclusive start
  periodEnd         DateTime // UTC EXCLUSIVE end (half-open, matches period.ts)
  status            RegulatedFilingStatus @default(GENERATED)
  // Denormalized signed net totals (the pre-signed ledger already nets).
  totalQty          Decimal               @default(0) @db.Decimal(12, 3)
  totalUnitBasisQty Decimal               @default(0) @db.Decimal(12, 3)
  totalNetSales     Decimal               @default(0) @db.Decimal(12, 2)
  totalCategoryTax  Decimal               @default(0) @db.Decimal(12, 2)
  rows              Json // per-(category, periodBucket) snapshot, drives the CSV
  csvKey            String?
  pdfKey            String? // reserved; W5b ships CSV only
  generatedAt       DateTime              @default(now())
  generatedById     String? // null = cron/system
  generationCount   Int                   @default(1)
  errorMessage      String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trackedCategory TrackedCategory @relation(fields: [trackedCategoryId], references: [id], onDelete: Restrict)

  @@unique([tenantId, trackedCategoryId, periodKey])
  @@index([tenantId])
  @@index([tenantId, trackedCategoryId])
  @@index([trackedCategoryId])
}

// ─── Migration & Batch Import (Phase 1: numbering continuity) ─────────────────

/// Per-tenant, per-document-type numbering sequence. Set during migration from
/// the source's last number ("last Zoho invoice INV-08841 → RouteFlow starts at
/// INV-08842"); editable later in Settings → Invoicing. `NumberingService` owns
/// the collision-guarded `reserveNext(docType)` that formats `prefix +
/// nextNumber.padStart(padding)`. Wiring that into LIVE document minting is a
/// deferred cross-module change (invoices/orders own those call sites); this
/// table + service is the contract they consume. Imported documents keep their
/// ORIGINAL numbers and do NOT consume this sequence. `tenantId` is a plain
/// scalar (tenant-scoped via `forTenant()`), no FK — keeps this an append-only
/// addition that never edits the shared Tenant model.
model NumberingSequence {
  id         String             @id @default(uuid())
  tenantId   String
  docType    DocumentNumberType
  prefix     String             @default("")
  nextNumber Int                @default(1)
  padding    Int                @default(4)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([tenantId, docType])
  @@index([tenantId])
}

enum DocumentNumberType {
  INVOICE
  ESTIMATE
  CREDIT_NOTE
  PAYMENT
}

// ─── Migration & Batch Import (Phase 2: idempotency substrate) ────────────────

/// Generic external-source reference for migrated/imported records (spec §2). A
/// side table keyed by (source, externalId) so a re-run UPSERTS one local row and
/// never duplicates — WITHOUT adding columns to off-limits finance models
/// (Invoice/Payment/CreditNote/VendorBill). External value format: "zoho:inv_884412"
/// (stored split as externalSource="zoho", externalId="inv_884412"). Pointers are
/// plain scalars (no FK) so this stays an append-only addition.
model ImportExternalRef {
  id             String           @id @default(uuid())
  tenantId       String
  entityType     ImportEntityType
  entityId       String
  externalSource String
  externalId     String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([tenantId, externalSource, externalId, entityType])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, entityType])
}

enum ImportEntityType {
  CUSTOMER
  INVOICE
  PAYMENT
  PRODUCT
  SUPPLIER
  CREDIT_NOTE
  VENDOR_BILL
}

/// Learned mapping from a supplier's raw line text to a local product/variant or
/// expense category (spec §5.3), so the next scan/import auto-matches. Tenant-scoped
/// unique key fixes the cross-tenant collision in the older global ProductMapping.
/// `supplierId=""` is the sentinel for "any supplier" (empty string, not NULL, so
/// the unique constraint actually dedupes any-supplier aliases). Target pointers are
/// plain scalars (no FK); resolve() verifies the target still exists.
model ProductAlias {
  id                String   @id @default(uuid())
  tenantId          String
  supplierId        String   @default("")
  rawText           String
  productId         String?
  expenseCategoryId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, supplierId, rawText])
  @@index([tenantId, rawText])
  @@index([tenantId, supplierId])
}

// ─── Migration & Batch Import (Phase 4: migration staging + jobs + 24h undo) ──

enum MigrationSource {
  ZOHO
  QUICKBOOKS
  CSV
  PAPER
}

enum MigrationJobStatus {
  FETCHING
  STAGED
  CONFIRMED
  UNDONE
  FAILED
}

enum StagingRecordStatus {
  PENDING // staged, awaiting confirm
  DUPLICATE // matched an existing record; skipped on confirm, linked
  COMMITTED // written live on confirm
  SKIPPED // committer not wired for this type yet, or user-skipped
  REVERSED // removed by a 24h undo
}

/// A migration run: fetch a source into a staging area, review, then confirm to
/// live with a 24h undo window (spec §3). NOTHING is live until CONFIRMED.
model MigrationJob {
  id           String             @id @default(uuid())
  tenantId     String
  source       MigrationSource
  status       MigrationJobStatus @default(FETCHING)
  scopeCounts  Json               @default("{}") // {customers, products, invoices, ...}
  createdById  String?
  confirmedAt  DateTime?
  undoDeadline DateTime? // confirmedAt + 24h
  undoneAt     DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  records MigrationStagingRecord[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

/// One staged record (not live) of a MigrationJob. Carries the raw source payload,
/// a dedup verdict, and — after confirm — the id of the live row it created (so a
/// 24h undo reverses exactly what it added, and re-runs upsert by external id).
model MigrationStagingRecord {
  id              String              @id @default(uuid())
  tenantId        String
  jobId           String
  entityType      ImportEntityType
  externalId      String?
  rawPayload      Json
  status          StagingRecordStatus @default(PENDING)
  flags           Json                @default("[]") // ["duplicate","unmatched-tax",...]
  matchedEntityId String? // existing row this duplicates (for linking)
  createdEntityId String? // live row created on confirm
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  job MigrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([tenantId, jobId])
  @@index([jobId, status])
}

// ─── Migration & Batch Import (Phase 5: batch invoice import queue) ───────────

enum ImportFileStatus {
  QUEUED
  PROCESSING
  CLEAN // all lines matched, no dup — auto-ready to post
  NEEDS_REVIEW // an unmatched line or low-confidence totals
  DUPLICATE // matched an existing bill/invoice — skipped, linked
  FAILED // extraction error; queue keeps the file
  POSTED
}

enum ImportBatchStatus {
  PROCESSING
  READY
  POSTED
  PARTIALLY_POSTED
}

/// A batch of scanned invoices/bills processed in the background (spec §4):
/// upload many, review later, "Finish: post N bills". Posting reuses the
/// vendor-bill receive path (stock + costing). meteredScans feeds the AI-scan
/// meter; the cap check integrates with billing (off-limits) as a follow-up.
model ImportBatch {
  id           String            @id @default(uuid())
  tenantId     String
  kind         String            @default("BATCH_BILLS")
  status       ImportBatchStatus @default(PROCESSING)
  totalFiles   Int               @default(0)
  cleanCount   Int               @default(0)
  reviewCount  Int               @default(0)
  dupeCount    Int               @default(0)
  postedCount  Int               @default(0)
  meteredScans Int               @default(0)
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  postedAt     DateTime?

  items ImportQueueItem[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

/// One file in a batch, with its per-file status + extracted payload. The
/// duplicate pointer is a denormalized scalar (indexed, no FK) so this never
/// edits the off-limits Invoice/VendorBill models.
model ImportQueueItem {
  id                   String           @id @default(uuid())
  tenantId             String
  batchId              String
  filename             String?
  mimeType             String?
  status               ImportFileStatus @default(QUEUED)
  extractedPayload     Json?
  supplierMatchId      String?
  supplierName         String?
  invoiceNumber        String?
  total                Decimal?         @db.Decimal(12, 2)
  duplicateOfInvoiceId String?
  confidence           Decimal?         @db.Decimal(5, 4)
  unmatchedLines       Int              @default(0)
  errorMessage         String?
  vendorBillId         String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([tenantId, batchId])
  @@index([batchId, status])
  @@index([duplicateOfInvoiceId])
}

// ─── Runtime-provisioned tables ───────────────────────────────────────────────
// Both tables are created at boot by the application itself, via raw
// `CREATE TABLE IF NOT EXISTS` (PlatformConfigService and RoutesService), a pattern
// chosen so those features could ship without a Prisma migration. The cost is that
// Prisma had no idea they existed and treated them as drift — meaning any generated
// migration would have emitted `DROP TABLE` for both, destroying the AI metering log
// and every in-flight idempotency key.
//
// Declaring them here is what stops that. The shapes below mirror the raw DDL
// exactly, including the database-side defaults, so `migrate diff` sees no change.

/// AI usage / metering log — written by PlatformConfigService.recordAiUsage.
model AiUsageEvent {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenantId     String?
  feature      String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  success      Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// Replay guard for order submission — written by RoutesService's idempotency
/// helpers, which read and write it with raw SQL and degrade silently if absent.
model IdempotencyKey {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  keyHash   String   @unique
  response  String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
}

/// PR-C: a durable stock-count (audit) session. Before this, a count lived only
/// in the client's localStorage, so it could not be paused and resumed from
/// another device, carried no attribution, and left no history. The session is
/// the unit of work; committing it writes ADJUSTMENT movements referencing
/// `movementReference` (the same `STOCK_COUNT-<id>` grouping the pre-existing
/// commit endpoint already used, so its idempotency guard still applies).
///
/// Single-counter now, multi-ready later: every LINE carries `countedById`, so
/// simultaneous multi-person counting can be turned on without a migration. The
/// OPEN-session guard is a WARNING, not a lock — two people counting different
/// aisles must never be blocked by each other.
model StockCountSession {
  id                String           @id @default(uuid())
  tenantId          String?
  name              String?
  status            StockCountStatus @default(OPEN)
  startedById       String
  startedAt         DateTime         @default(now())
  committedAt       DateTime?
  committedById     String?
  discardedAt       DateTime?
  notes             String?
  /// "STOCK_COUNT-<id>", set once committed — the movements' `reference`.
  movementReference String?
  /// Set when this session was opened as an amendment of an earlier committed
  /// one. Corrections never rewrite history: amending opens a NEW pre-filled
  /// session whose commit writes fresh adjustments referencing both.
  amendsSessionId   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tenant        Tenant?             @relation(fields: [tenantId], references: [id])
  startedBy     User                @relation("StockCountStarted", fields: [startedById], references: [id])
  committedBy   User?               @relation("StockCountCommitted", fields: [committedById], references: [id])
  amendsSession StockCountSession?  @relation("StockCountAmends", fields: [amendsSessionId], references: [id])
  amendedBy     StockCountSession[] @relation("StockCountAmends")
  lines         StockCountLine[]

  @@index([tenantId, status])
  @@index([tenantId, startedAt])
}

/// One counted product within a session. `@@unique([sessionId, productId])` makes
/// the autosave an idempotent upsert — a retried scan can never double-count.
///
/// ⚠️ Rows MUST be written directly (`stockCountLine.create/upsert`), never as a
/// nested create under the session: nested writes bypass the tenant extension's
/// `tenantId` injection and would land with `tenantId = null`, which `forTenant()`
/// then filters out (the invoiced-sales lesson).
model StockCountLine {
  id               String             @id @default(uuid())
  tenantId         String?
  sessionId        String
  productId        String
  /// REPLACE = "on-hand IS this"; ADD = "add this to on-hand". Mirrors the
  /// pre-existing commit DTO so the durable session cannot regress the
  /// quick-adjust flow that already shipped.
  mode             StockCountLineMode @default(REPLACE)
  /// The number the counter entered, in base units.
  countedQty       Decimal            @db.Decimal(10, 3)
  /// The denomination they entered it in, purely for faithful re-display.
  boxes            Int?
  pieces           Int?
  /// On-hand snapshotted when this line was FIRST counted — the "expected" the
  /// review screen compares against. Snapshotting (rather than reading live
  /// stock at commit) is what makes the variance mean "what changed since you
  /// started counting" instead of silently moving under the counter.
  expectedQty      Decimal            @db.Decimal(10, 3)
  /// Optional per-line cost correction, 4dp (COST_DP). Set ⇒ commit ALSO writes
  /// the audited COST_BASIS path for this product, not just the quantity.
  unitCostOverride Decimal?           @db.Decimal(10, 4)
  countedById      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  session   StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  countedBy User              @relation(fields: [countedById], references: [id])
  tenant    Tenant?           @relation(fields: [tenantId], references: [id])

  @@unique([sessionId, productId])
  @@index([tenantId])
  @@index([productId])
}

enum StockCountStatus {
  OPEN
  REVIEW
  COMMITTED
  DISCARDED
}

enum StockCountLineMode {
  REPLACE
  ADD
}

// ─── Sales agents & commissions (flag.sales_agents, PR-C) ─────────────────────
// Agents bring customers in and earn a commission % on those customers' invoices.
// Hybrid trigger: commission ACCRUES on invoice issue, becomes PAYABLE pro-rata as
// the invoice is paid (no commission on bad debt). Agents are records-only v1 — no
// login, no new UserRole; `SalesAgent.userId` is a nullable seat for a future AGENT
// role. Entitlement-gated end to end; when the flag is off the engine no-ops.

enum SalesAgentStatus {
  ACTIVE
  PAUSED
  STOPPED_FOR_NEW
}

enum CommissionRateSource {
  ORDER_OVERRIDE
  CUSTOMER_RATE
  AGENT_DEFAULT
  NONE
}

enum CommissionAccrualStatus {
  PENDING // issued, nothing collected yet
  PARTIAL // some cash landed, ratio < 1
  PAYABLE // ratio = 1, not fully claimed
  SETTLED // fully claimed and converged
  VOID // invoice un-issued / reassigned away — target 0
}

enum CommissionAdjustmentKind {
  CLAWBACK
  RATE_CHANGE
  REASSIGNMENT
  MANUAL
}

enum CommissionStatementStatus {
  PENDING
  APPROVED
  PAID
  VOID
}

enum CommissionStatementLineKind {
  CLAIM // positive: unclaimed payable on one accrual
  ADJUSTMENT // signed: sweeps one CommissionAdjustment exactly once
  CARRYFORWARD // negative: absorbs a prior statement's negative residual
}

model SalesAgent {
  id                String           @id @default(uuid())
  name              String
  email             String?
  phone             String?
  notes             String?
  status            SalesAgentStatus @default(ACTIVE)
  // Set when status -> STOPPED_FOR_NEW; the grandfathering pivot (see engine rules).
  stopNewBusinessAt DateTime?
  // Future AGENT-role login seat (owner decision: records-only v1, seat designed now).
  userId            String?          @unique
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tenantId          String?

  tenant        Tenant?                  @relation(fields: [tenantId], references: [id])
  user          User?                    @relation(fields: [userId], references: [id])
  rates         SalesAgentRate[]
  assignments   AgentAssignment[]
  customerRates CustomerCommissionRate[]
  accruals      CommissionAccrual[]
  adjustments   CommissionAdjustment[]
  statements    CommissionStatement[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model SalesAgentRate {
  id            String   @id @default(uuid())
  agentId       String
  ratePct       Decimal  @db.Decimal(5, 2)
  // Rate rows are INSERT-ONLY history: newest effectiveFrom <= basisDate wins.
  effectiveFrom DateTime
  createdAt     DateTime @default(now())
  tenantId      String?

  tenant Tenant?    @relation(fields: [tenantId], references: [id])
  agent  SalesAgent @relation(fields: [agentId], references: [id])

  @@unique([tenantId, agentId, effectiveFrom])
  @@index([agentId, effectiveFrom])
  @@index([tenantId])
}

model CustomerCommissionRate {
  id            String   @id @default(uuid())
  customerId    String
  agentId       String // who negotiated it, for display; resolution is per-customer
  ratePct       Decimal  @db.Decimal(5, 2)
  effectiveFrom DateTime
  createdAt     DateTime @default(now())
  tenantId      String?

  tenant   Tenant?    @relation(fields: [tenantId], references: [id])
  customer Customer   @relation(fields: [customerId], references: [id])
  agent    SalesAgent @relation(fields: [agentId], references: [id])

  @@unique([tenantId, customerId, effectiveFrom])
  @@index([customerId, effectiveFrom])
  @@index([tenantId])
}

model AgentAssignment {
  id            String    @id @default(uuid())
  customerId    String
  agentId       String
  effectiveFrom DateTime
  // null = current holder. History is never rewritten: reassignment closes the open
  // row (sets effectiveTo) and inserts a new one. Partial unique index (raw SQL in
  // the migration): one open row per (tenantId, customerId).
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  tenantId      String?

  tenant   Tenant?    @relation(fields: [tenantId], references: [id])
  customer Customer   @relation(fields: [customerId], references: [id])
  agent    SalesAgent @relation(fields: [agentId], references: [id])

  @@index([customerId, effectiveFrom])
  @@index([agentId])
  @@index([tenantId])
}

model CommissionAccrual {
  id            String                  @id @default(uuid())
  invoiceId     String
  agentId       String
  customerId    String
  // order.orderDate ?? invoice.issueDate — the attribution + rate anchor.
  basisDate     DateTime
  baseAmount    Decimal                 @db.Decimal(10, 2)
  ratePct       Decimal                 @db.Decimal(5, 2)
  rateSource    CommissionRateSource
  accruedAmount Decimal                 @db.Decimal(10, 2)
  payableAmount Decimal                 @db.Decimal(10, 2)
  // Denormalized Σ of CLAIM lines on non-VOID statements. Source of truth is the lines.
  claimedAmount Decimal                 @default(0) @db.Decimal(10, 2)
  status        CommissionAccrualStatus @default(PENDING)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  tenantId      String?

  tenant      Tenant?                   @relation(fields: [tenantId], references: [id])
  invoice     Invoice                   @relation(fields: [invoiceId], references: [id])
  agent       SalesAgent                @relation(fields: [agentId], references: [id])
  customer    Customer                  @relation(fields: [customerId], references: [id])
  adjustments CommissionAdjustment[]
  lines       CommissionStatementLine[]

  @@unique([tenantId, invoiceId, agentId]) // the double-accrual lock
  @@index([agentId, status])
  @@index([customerId])
  @@index([tenantId, basisDate])
}

model CommissionAdjustment {
  id        String                   @id @default(uuid())
  accrualId String
  agentId   String
  kind      CommissionAdjustmentKind
  // Signed; in practice negative (drift < -epsilon emission rule). Append-only.
  amount    Decimal                  @db.Decimal(10, 2)
  reason    String?
  createdAt DateTime                 @default(now())
  tenantId  String?

  tenant  Tenant?                  @relation(fields: [tenantId], references: [id])
  accrual CommissionAccrual        @relation(fields: [accrualId], references: [id])
  agent   SalesAgent               @relation(fields: [agentId], references: [id])
  line    CommissionStatementLine?

  @@index([agentId])
  @@index([accrualId])
  @@index([tenantId])
}

model CommissionStatement {
  id              String                    @id @default(uuid())
  statementNumber String
  agentId         String
  periodFrom      DateTime?
  periodTo        DateTime?
  status          CommissionStatementStatus @default(PENDING)
  totalAmount     Decimal                   @db.Decimal(10, 2)
  paidAmount      Decimal                   @default(0) @db.Decimal(10, 2)
  approvedAt      DateTime?
  notes           String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  tenantId        String?

  tenant      Tenant?                   @relation(fields: [tenantId], references: [id])
  agent       SalesAgent                @relation(fields: [agentId], references: [id])
  lines       CommissionStatementLine[]
  payouts     CommissionPayout[]
  carriedInto CommissionStatementLine[] @relation("CarryForwardSource")

  @@unique([tenantId, statementNumber])
  @@index([agentId, status])
  @@index([tenantId])
}

model CommissionStatementLine {
  id                     String                      @id @default(uuid())
  statementId            String
  kind                   CommissionStatementLineKind
  // Exactly ONE of the three refs is set, matching kind.
  accrualId              String?
  adjustmentId           String?                     @unique
  carriedFromStatementId String?                     @unique
  amount                 Decimal                     @db.Decimal(10, 2)
  description            String?
  tenantId               String?

  tenant      Tenant?               @relation(fields: [tenantId], references: [id])
  statement   CommissionStatement   @relation(fields: [statementId], references: [id])
  accrual     CommissionAccrual?    @relation(fields: [accrualId], references: [id])
  adjustment  CommissionAdjustment? @relation(fields: [adjustmentId], references: [id])
  carriedFrom CommissionStatement?  @relation("CarryForwardSource", fields: [carriedFromStatementId], references: [id])

  @@index([statementId])
  @@index([accrualId])
  @@index([tenantId])
}

model CommissionPayout {
  id          String        @id @default(uuid())
  statementId String
  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod
  reference   String?
  notes       String?
  paidAt      DateTime      @default(now())
  // The linked COMMISSIONS_AND_FEES Expense — how payouts reach P&L/cash reports
  // with zero bookkeeping.service changes.
  expenseId   String        @unique
  createdAt   DateTime      @default(now())
  tenantId    String?

  tenant    Tenant?             @relation(fields: [tenantId], references: [id])
  statement CommissionStatement @relation(fields: [statementId], references: [id])
  expense   Expense             @relation(fields: [expenseId], references: [id])

  @@index([statementId])
  @@index([tenantId])
}
