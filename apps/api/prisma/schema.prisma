  website          String?
  notes            String?
  isActive         Boolean  @default(true)
  leadTimeDays     Int?
  // Tobacco wholesale license of the supplier — shown on purchase records
  // and the monthly tobacco report so filings are audit-ready
  tobaccoLicenseNo String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  zip              String?
  lat              Float?
  lng              Float?
  country          String?
  // Net-terms label seeded onto a new vendor bill for this supplier ("Net 30",
  // "Due on Receipt", …). Bills have no due-date-computation machinery server
  // side; the client computes Due Date = Bill Date + days from this label.
  defaultTerms     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenantId         String?

  tenant                 Tenant?                 @relation(fields: [tenantId], references: [id])
