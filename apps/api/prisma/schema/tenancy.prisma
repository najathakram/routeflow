// RouteFlow Prisma schema — domain file: tenancy (tenants, users, staff + buyer identity, auth tokens, platform-admin config).
// Generated by apps/api/scripts/split-prisma-schema.mjs — run it with --check to prove the split is lossless.

// ─── Enums (tenancy) ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  OPERATOR
  DRIVER
  CUSTOMER
}

enum TenantStatus {
  TRIAL
  ACTIVE
  READ_ONLY
  SUSPENDED
  CANCELLED
}

enum TenantPlan {
  STARTER
  TEAM
  BUSINESS
  PROFESSIONAL
  ENTERPRISE
  GROWTH
  SCALE
  LITE
}

// Phase 0 truth: classifies a Tenant row for KPI/MRR scoping (production revenue vs.
// demo/test/house-internal noise). Default PRODUCTION; backfilled by
// scripts/backfill-tenant-class.mjs, set explicitly by bootstrap-house-tenant.mjs for
// routeflow-hq, and changeable via PlatformAdminService.updateTenantClass().
enum TenantClass {
  PRODUCTION
  DEMO
  TEST
  INTERNAL
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Platform {
  IOS
  ANDROID
}

// ─── Buyer Portal Enums ───────────────────────────────────────────────────────

enum BuyerAccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CustomerLinkStatus {
  INVITED
  PENDING_SELLER_APPROVAL
  ACTIVE
  DISCONNECTED
}

enum InviteMethod {
  EMAIL
  SMS
}

enum DisconnectedBy {
  BUYER
  SELLER
}

// ─── Tenant Models ────────────────────────────────────────────────────────────

model Tenant {
  id             String       @id @default(uuid())
  slug           String       @unique
  name           String
  status         TenantStatus @default(TRIAL)
  plan           TenantPlan   @default(STARTER)
  class          TenantClass  @default(PRODUCTION)
  trialEndsAt    DateTime?
  // Billing plans-as-data: the published PlanVersion this tenant is pinned to
  // (the source of truth for entitlements; the `plan` enum stays a legacy shadow).
  planVersionId  String?
  readOnlyReason String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  users         User[]
  config        TenantConfig?
  googleOAuth   TenantGoogleOAuth?
  subscription  TenantSubscription?
  addons        TenantAddon[]
  featureOverrides TenantFeatureOverride[]
  planVersion   PlanVersion?        @relation(fields: [planVersionId], references: [id])
  meterUsages   MeterUsage[]
  billingEvents BillingEvent[]
  rfInvoices    RfInvoice[]

  userPreferences          UserPreference[]
  customers                Customer[]
  customerAddresses        CustomerAddress[]
  customerDocuments        CustomerDocument[]
  drivers                  Driver[]
  products                 Product[]
  routes                   Route[]
  routeStops               RouteStop[]
  routeCustomers           RouteCustomer[]
  routeRuns                RouteRun[]
  routeRunStops            RouteRunStop[]
  orders                   Order[]
  orderItems               OrderItem[]
  deliveryMutations        DeliveryMutation[]
  transactions             Transaction[]
  transactionItems         TransactionItem[]
  payments                 Payment[]
  deviceTokens             DeviceToken[]
  orderTemplates           OrderTemplate[]
  orderTemplateItems       OrderTemplateItem[]
  refreshTokens            RefreshToken[]
  suppliers                Supplier[]
  stockLots                StockLot[]
  stockMovements           StockMovement[]
  invoices                 Invoice[]
  invoiceItems             InvoiceItem[]
  invoicePayments          InvoicePayment[]
  paymentCounters          PaymentCounter[]
  expenseCategories        ExpenseCategory[]
  expenses                 Expense[]
  expenseLineItems         ExpenseLineItem[]
  mileageRates             MileageRate[]
  contactPersons           ContactPerson[]
  customerTags             CustomerTag[]
  customerTagAssignments   CustomerTagAssignment[]
  customerComments         CustomerComment[]
  purchaseOrders           PurchaseOrder[]
  purchaseOrderItems       PurchaseOrderItem[]
  creditNotes              CreditNote[]
  creditNoteItems          CreditNoteItem[]
  orderCreditNotes         OrderCreditNote[]
  estimates                Estimate[]
  estimateItems            EstimateItem[]
  vendorBills              VendorBill[]
  invoiceScans             InvoiceScan[]
  vendorBillItems          VendorBillItem[]
  billPayments             BillPayment[]
  productMappings          ProductMapping[]
  returns                  Return[]
  returnItems              ReturnItem[]
  advancePayments          AdvancePayment[]
  supplierCredits          SupplierCredit[]
  recurringInvoices        RecurringInvoice[]
  recurringInvoiceItems    RecurringInvoiceItem[]
  messages                 Message[]
  messageThreads           MessageThread[]
  messageTemplates         MessageTemplate[]
  notificationRules        NotificationRule[]
  messageOptOuts           MessageOptOut[]
  messagingSettings        MessagingSettings?
  inboundTriages           InboundTriage[]
  customerPrices           CustomerPrice[]
  systemConfigs            SystemConfig[]
  customerLinks            CustomerLink[]
  stripeConnect            TenantStripeConnect?
  buyerPaymentRequests     BuyerPaymentRequest[]
  buyerMergeRequests       BuyerMergeRequest[]
  buyerFavorites           BuyerFavorite[]
  deliveryBatches          DeliveryBatch[]
  driverLocations          DriverLocation[]
  tobaccoReports           TobaccoReport[]
  saleDrafts               SaleDraft[]
  trackedCategories        TrackedCategory[]
  trackedSubcategories     TrackedSubcategory[]
  customerAuthorizations   CustomerAuthorization[]
  authorizationOverrides   AuthorizationOverride[]
  regulatedSalesLedger     RegulatedSalesLedger[]
  regulatedFilings         RegulatedFiling[]
  promotions               Promotion[]
  orderRevisions           OrderRevision[]
  changeRequests           ChangeRequest[]
  replenishmentSnoozes     ReplenishmentSnooze[]
  stockAlerts              StockAlert[]
  stockCountSessions       StockCountSession[]
  stockCountLines          StockCountLine[]
  supplierStatementScans   SupplierStatementScan[]
  // ─── Sales agents & commissions (flag.sales_agents) ───
  salesAgents              SalesAgent[]
  salesAgentRates          SalesAgentRate[]
  customerCommissionRates  CustomerCommissionRate[]
  agentAssignments         AgentAssignment[]
  commissionAccruals       CommissionAccrual[]
  commissionAdjustments    CommissionAdjustment[]
  commissionStatements     CommissionStatement[]
  commissionStatementLines CommissionStatementLine[]
  commissionPayouts        CommissionPayout[]
  crmConnection            CrmConnection?

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@index([planVersionId])
  @@index([class])
}

model TenantConfig {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  businessName  String?
  logoKey       String?
  primaryColor  String?
  timezone      String   @default("America/New_York")
  currency      String   @default("USD")
  taxRate       Decimal? @db.Decimal(5, 4)
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  zip           String?
  country       String?
  phone         String?
  website       String?
  smtpHost      String?
  smtpPort      Int?
  smtpSecure    Boolean  @default(true)
  smtpUser      String?
  smtpPassword  String?
  smtpFromName  String?
  smtpFromEmail String?
  customerEmail String?
  ownerName     String?
  invoiceNotes  String?
  invoiceTerms  String?
  // Post-dated check payments PR-1 (additive-only): the day (date-only, tenant
  // local calendar day) a later PR's daily "checks due to clear" digest job
  // last sent for this tenant — an idempotency mark so a retried/duplicate
  // cron tick doesn't re-send the same day's digest. No job writes or reads
  // this field yet.
  checksDigestSentForDay DateTime? @db.Date
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantGoogleOAuth {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  clientId     String
  clientSecret String
  callbackUrl  String
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─── Models (tenancy) ───────────────────────────────────────────────────────────────────

model User {
  id                  String     @id @default(uuid())
  email               String
  username            String
  password            String?
  googleId            String?
  role                UserRole
  status              UserStatus @default(ACTIVE)
  forcePasswordChange Boolean    @default(false)
  isAdmin             Boolean    @default(false)
  canActAsDriver      Boolean    @default(false)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?
  tenantId            String?

  tenant               Tenant?              @relation(fields: [tenantId], references: [id])
  customer             Customer?
  driver               Driver?
  deviceTokens         DeviceToken[]
  refreshTokens        RefreshToken[]
  stockMovements       StockMovement[]
  stockCountsStarted   StockCountSession[]  @relation("StockCountStarted")
  stockCountsCommitted StockCountSession[]  @relation("StockCountCommitted")
  stockCountLines      StockCountLine[]
  expenses             Expense[]
  messages             Message[]
  preferences          UserPreference[]
  passwordResetTokens  PasswordResetToken[]
  // Future AGENT-role login seat (records-only v1 — see SalesAgent.userId).
  salesAgentSeat       SalesAgent?

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@unique([tenantId, googleId])
  @@index([tenantId])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String
  updatedAt DateTime @updatedAt
  tenantId  String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([userId, key])
  @@index([userId])
  @@index([tenantId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  Platform
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String?

  user   User    @relation(fields: [userId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([tenantId])
}

/// Platform-wide key/value config — not scoped to any tenant.
/// Used for global settings such as the platform Anthropic API key.
model PlatformConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  tenantId   String?
  userAgent  String?
  ipAddress  String?
  deviceName String?
  lastUsedAt DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([tenantId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Buyer Portal ─────────────────────────────────────────────────────────────

model BuyerAccount {
  id                  String             @id @default(uuid())
  email               String             @unique
  passwordHash        String
  // false only for Google-auto-created accounts (random unguessable hash) —
  // gates the no-current-password "set password" flow. Accounts created via
  // Google before this column existed keep the default true and must use the
  // email reset flow instead (indistinguishable from password accounts).
  passwordSet         Boolean            @default(true)
  name                String
  phone               String?
  mobile              String?
  googleId            String?            @unique
  status              BuyerAccountStatus @default(ACTIVE)
  emailVerified       Boolean            @default(false)
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  mergedIntoId        String? // audit: set on the secondary after a completed merge

  customerLinks            CustomerLink[]
  refreshTokens            BuyerRefreshToken[]
  passwordResetTokens      BuyerPasswordResetToken[]
  emailVerificationTokens  BuyerEmailVerificationToken[]
  mergeRequestsAsPrimary   BuyerMergeRequest[]           @relation("MergeAsPrimary")
  mergeRequestsAsSecondary BuyerMergeRequest[]           @relation("MergeAsSecondary")
  favorites                BuyerFavorite[]
  paymentRequests          BuyerPaymentRequest[]

  @@index([email])
  @@index([status])
  @@index([deletedAt])
}

model CustomerLink {
  id              String             @id @default(uuid())
  buyerAccountId  String? // null while invite is pending acceptance
  customerId      String             @unique
  tenantId        String
  status          CustomerLinkStatus @default(INVITED)
  inviteToken     String?            @unique
  inviteExpiresAt DateTime?
  inviteMethod    InviteMethod?
  linkedAt        DateTime?
  disconnectedAt  DateTime?
  disconnectedBy  DisconnectedBy?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  buyerAccount BuyerAccount? @relation(fields: [buyerAccountId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id])

  @@index([buyerAccountId])
  @@index([tenantId])
  @@index([inviteToken])
  @@index([status])
}

model BuyerRefreshToken {
  id             String    @id @default(uuid())
  buyerAccountId String
  tokenHash      String    @unique
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  userAgent      String?
  ipAddress      String?
  deviceName     String?
  lastUsedAt     DateTime?

  buyerAccount BuyerAccount @relation(fields: [buyerAccountId], references: [id], onDelete: Cascade)

  @@index([buyerAccountId])
  @@index([expiresAt])
}

// Mirrors PasswordResetToken for BuyerAccount — kept as a separate model (like
// RefreshToken/BuyerRefreshToken) so staff and buyer reset tokens can never be
// confused for one another.
model BuyerPasswordResetToken {
  id             String    @id @default(uuid())
  buyerAccountId String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  buyerAccount BuyerAccount @relation(fields: [buyerAccountId], references: [id], onDelete: Cascade)

  @@index([buyerAccountId])
  @@index([expiresAt])
}

// Registration email-verification token — proves the registrant controls the
// mailbox before `emailVerified` unlocks auto-connect in requestSeller. Kept as
// a separate model from BuyerPasswordResetToken so a verification token can
// never be replayed to change a password (and vice versa).
model BuyerEmailVerificationToken {
  id             String    @id @default(uuid())
  buyerAccountId String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  buyerAccount BuyerAccount @relation(fields: [buyerAccountId], references: [id], onDelete: Cascade)

  @@index([buyerAccountId])
  @@index([expiresAt])
}

// ─── Buyer Account Merge Requests ─────────────────────────────────────────────

model BuyerMergeRequest {
  id                  String                  @id @default(uuid())
  primaryAccountId    String
  secondaryAccountId  String
  status              BuyerMergeRequestStatus @default(PENDING_VERIFICATION)
  initiatedBy         MergeInitiator
  initiatedByTenantId String?
  initiatorNotes      String?
  adminNotes          String?
  verificationToken   String?                 @unique
  verificationExpires DateTime?
  verifiedAt          DateTime?
  completedAt         DateTime?
  rejectedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  primaryAccount   BuyerAccount @relation("MergeAsPrimary", fields: [primaryAccountId], references: [id])
  secondaryAccount BuyerAccount @relation("MergeAsSecondary", fields: [secondaryAccountId], references: [id])
  initiatingTenant Tenant?      @relation(fields: [initiatedByTenantId], references: [id])

  @@index([primaryAccountId])
  @@index([secondaryAccountId])
  @@index([status])
  @@index([verificationToken])
}

enum BuyerMergeRequestStatus {
  PENDING_VERIFICATION
  PENDING_REVIEW
  COMPLETED
  REJECTED
}

enum MergeInitiator {
  BUYER
  TENANT
  SUPER_ADMIN
}
