// RouteFlow Prisma schema — domain file: catalog (products, suppliers, stock/lots/movements, counts, purchase orders, product matching).
// Generated by apps/api/scripts/split-prisma-schema.mjs — run it with --check to prove the split is lossless.

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  WRITE_OFF
  COST_BASIS
}

enum CostingMethod {
  FIFO
  LIFO
  AVCO
  STANDARD
  // Last cost — every sale is costed at the most recent purchase lot's unit
  // cost (pos-cost-roles-spec §1). Additive value; see migration
  // 20260706040000_add_costing_last_cost.
  LAST_COST
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CLOSED
}

// Multi-category labels (2026-09-19): a product-category ASSIGNMENT's polarity.
// INCLUDE = the product/variant carries this label. EXCLUDE = a variant's signed
// opt-out of a label its parent carries (never valid on a standalone product —
// enforced app-side in ProductLabelsService). See ProductCategoryLabel below.
enum LabelMode {
  INCLUDE
  EXCLUDE
}

model Product {
  id                   String        @id @default(uuid())
  name                 String
  description          String?
  sku                  String?
  // Optional retail-unit (inner piece) code; NULL ⇒ unit shares the case `sku`.
  // Read sites use `unitSku ?? sku`.
  unitSku              String?
  unit                 String
  pricePerUnit         Decimal       @db.Decimal(10, 2)
  priceTier2           Decimal       @default(0) @db.Decimal(10, 2)
  priceTier3           Decimal       @default(0) @db.Decimal(10, 2)
  priceTier4           Decimal       @default(0) @db.Decimal(10, 2)
  priceTier5           Decimal       @default(0) @db.Decimal(10, 2)
  // Suggested retail price (MSRP), per PIECE — the retail selling unit — even when this
  // product is sold wholesale by the box. Display-only: NEVER feed into money math
  // (computeLineSubtotal, totals, tax, margin, promotions). Null = no MSRP set, renders
  // blank, never $0.00. Universal default; CustomerPrice.msrp overrides it per customer.
  msrp                 Decimal?      @db.Decimal(10, 2)
  category             String?
  imageKeys            String[]      @default([])
  isActive             Boolean       @default(true)
  isFeatured           Boolean       @default(false)
  // Buyer merchandising flags (P5-01): drive catalogue tiles + smart collections.
  isNew                Boolean       @default(false)
  isDeal               Boolean       @default(false)
  // Regulated tobacco product — only settable when the tenant has the
  // "tobacco_dealer" addon; drives separate tracking + monthly tax reports
  isTobacco            Boolean       @default(false)
  barcode              String?
  currentStock         Decimal       @default(0) @db.Decimal(10, 3)
  averageCost          Decimal?      @db.Decimal(10, 4)
  // AVCO because every write path maintains `averageCost` via nextAverageCost and
  // valuation reads it back; the FIFO/LIFO lot-consumption path exists but has no
  // caller, so labelling products FIFO promised a costing basis nothing computed.
  costingMethod        CostingMethod @default(AVCO)
  standardCost         Decimal?      @db.Decimal(10, 4)
  reorderPoint         Int?
  reorderQty           Int?
  unitsPerBox          Int?
  parentProductId      String?
  variantName          String?
  // Phase 4: going-forward regulated-category pointer (one max per product);
  // supersedes `isTobacco`, which is kept as a shadow column for one release.
  trackedCategoryId    String?
  // Phase 4 (subcategories): optional finer classification WITHIN the section
  // above (reporting only, no compliance semantics). Parent must equal
  // trackedCategoryId (enforced app-side; Prisma can't express the composite FK).
  trackedSubcategoryId String?
  /// Regulatory reporting config (template-agnostic; the vocabulary is defined by
  /// the section's reportTemplate — see regulated/template-registry.ts).
  /// regUomUnit = UoM code for loose/unit quantities. regUomCase is OPTIONAL and
  /// opts the product into case-level bucketing when sold by the box; leaving it
  /// NULL makes the report pass quantities through unconverted (back-compat).
  regItemType          String?
  regUomCase           String?
  regUomUnit           String?
  // Migration & Batch Import (Phase 3): a brand-new product created from a scanned
  // invoice line with only name+SKU+cost is flagged incomplete until price/units
  // are confirmed. Surfaced under a "Finish setup" filter on the import surface.
  detailsIncomplete    Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  tenantId             String?

  tenant                Tenant?                @relation(fields: [tenantId], references: [id])
  orderItems            OrderItem[]
  deliveryMutations     DeliveryMutation[]
  changeRequests        ChangeRequest[]
  templateItems         OrderTemplateItem[]
  stockMovements        StockMovement[]
  stockLots             StockLot[]
  stockCountLines       StockCountLine[]
  invoiceItems          InvoiceItem[]
  estimateItems         EstimateItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  returnItems           ReturnItem[]
  recurringInvoiceItems RecurringInvoiceItem[]
  vendorBillItems       VendorBillItem[]
  customerPrices        CustomerPrice[]
  productMappings       ProductMapping[]
  buyerFavorites        BuyerFavorite[]
  promotionProducts     PromotionProduct[]
  replenishmentSnoozes  ReplenishmentSnooze[]
  stockAlerts           StockAlert[]
  parent                Product?               @relation("ProductVariants", fields: [parentProductId], references: [id])
  variants              Product[]              @relation("ProductVariants")
  trackedCategory       TrackedCategory?       @relation(fields: [trackedCategoryId], references: [id], onDelete: SetNull)
  trackedSubcategory    TrackedSubcategory?    @relation(fields: [trackedSubcategoryId], references: [id], onDelete: SetNull)
  units                 ProductUnit[]
  supplierProducts      SupplierProduct[]
  categoryLabels        ProductCategoryLabel[]
  sellingRestrictions   SellingRestriction[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@unique([tenantId, unitSku])
  // Name uniqueness is enforced via two raw-SQL PARTIAL unique indexes
  // (see migrations/20260504000000_variant_name_per_parent/migration.sql):
  //   - (tenantId, name)                    WHERE parentProductId IS NULL
  //       → standalone catalog stays flat-unique (no two parents named "X")
  //   - (tenantId, parentProductId, name)   WHERE parentProductId IS NOT NULL
  //       → variant names unique WITHIN their parent only
  //         ("Strawberry" can be a flavor under both Geek Next 50K and Geek Bar)
  // Prisma can't declare partial unique indexes; left here as a plain index
  // for name-search query speed only.
  @@index([tenantId, name])
  @@index([category])
  @@index([isActive])
  @@index([isFeatured])
  @@index([barcode])
  @@index([unitSku])
  @@index([parentProductId])
  @@index([tenantId])
  @@index([tenantId, isTobacco])
  @@index([tenantId, trackedCategoryId])
  @@index([trackedSubcategoryId])
  @@index([tenantId, detailsIncomplete])
}

model Supplier {
  id               String   @id @default(uuid())
  name             String
  contactName      String?
  phone            String?
  mobile           String?
  email            String?
  website          String?
  notes            String?
  isActive         Boolean  @default(true)
  leadTimeDays     Int?
  // Tobacco wholesale license of the supplier — shown on purchase records
  // and the monthly tobacco report so filings are audit-ready
  tobaccoLicenseNo String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  zip              String?
  lat              Float?
  lng              Float?
  country          String?
  // Net-terms label seeded onto a new vendor bill for this supplier ("Net 30",
  // "Due on Receipt", …). Bills have no due-date-computation machinery server
  // side; the client computes Due Date = Bill Date + days from this label.
  defaultTerms     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenantId         String?

  tenant                 Tenant?                 @relation(fields: [tenantId], references: [id])
  stockMovements         StockMovement[]
  purchaseOrders         PurchaseOrder[]
  vendorBills            VendorBill[]
  invoiceScans           InvoiceScan[]
  expenses               Expense[]
  supplierCredits        SupplierCredit[]
  supplierStatementScans SupplierStatementScan[]
  supplierProducts       SupplierProduct[]

  @@index([isActive])
  @@index([tenantId])
}

model StockLot {
  id           String   @id @default(uuid())
  productId    String
  purchaseDate DateTime @default(now())
  qty          Decimal  @db.Decimal(10, 3)
  remainingQty Decimal  @db.Decimal(10, 3)
  unitCost     Decimal  @db.Decimal(10, 4)
  reference    String?
  notes        String?
  createdAt    DateTime @default(now())
  tenantId     String?

  product Product @relation(fields: [productId], references: [id])
  tenant  Tenant? @relation(fields: [tenantId], references: [id])

  @@index([productId])
  @@index([purchaseDate])
  @@index([tenantId])
}

model StockMovement {
  id            String       @id @default(uuid())
  productId     String
  type          MovementType
  quantity      Decimal      @db.Decimal(10, 3)
  unitCost      Decimal?     @db.Decimal(10, 4)
  // Running snapshots: product state AFTER this movement was applied.
  // Point-in-time average cost = avgCostAfter of the latest movement <= T.
  avgCostAfter  Decimal?     @db.Decimal(10, 4)
  stockAfter    Decimal?     @db.Decimal(10, 3)
  supplierId    String?
  reference     String?
  notes         String?
  performedById String?
  createdAt     DateTime     @default(now())
  tenantId      String?

  product     Product   @relation(fields: [productId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  performedBy User?     @relation(fields: [performedById], references: [id])

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@index([supplierId])
  @@index([tenantId])
}

// ─── Purchase orders ────────────────────────────────────────────────

model PurchaseOrder {
  id           String              @id @default(uuid())
  poNumber     String
  supplierId   String
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?
  notes        String?
  totalAmount  Decimal             @db.Decimal(10, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenantId     String?

  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  tenant     Tenant?             @relation(fields: [tenantId], references: [id])
  items      PurchaseOrderItem[]
  vendorBill VendorBill?

  @@unique([tenantId, poNumber])
  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId])
}

model PurchaseOrderItem {
  id          String  @id @default(uuid())
  poId        String
  productId   String
  qtyOrdered  Decimal @db.Decimal(10, 3)
  qtyReceived Decimal @default(0) @db.Decimal(10, 3)
  unitCost    Decimal @db.Decimal(10, 4)
  totalCost   Decimal @db.Decimal(10, 2)
  // Units/PO minimal (2026-09-19): the supplier's own SKU for this line and the
  // pieces-per-supplier-unit pack size, mirroring VendorBillItem so a scan's
  // reviewed lines copy across unchanged. Null on every line created before this
  // shipped and on any line the supplier's document didn't carry a SKU for.
  // qtyOrdered/unitCost stay per PIECE (receive is untouched); supplier-unit
  // display is derived (qtyOrdered ÷ packSize, unitCost × packSize).
  sku         String?
  packSize    Int?
  tenantId    String?

  po      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  tenant  Tenant?       @relation(fields: [tenantId], references: [id])
  product Product       @relation(fields: [productId], references: [id])

  @@index([poId])
  @@index([productId])
  @@index([tenantId])
}

// ─── Multi-level units + purchase-order supplier mapping (2026-09-19) ─────────
// See local-assets/handoff/2026-09-18/PLAN-units-po-MINIMAL.md §1. Additive only:
// a product with no ProductUnit rows behaves exactly as it does today
// (Product.unitsPerBox/pricePerUnit + tiers remain the pack). Rows exist only
// for levels OTHER than the pack (Case, Pallet, Container, … and an optional
// explicit "Piece" price row with factorToBase = 1).
model ProductUnit {
  id               String   @id @default(uuid())
  tenantId         String
  productId        String
  // Free-text level name ("Case", "Pallet", "Piece", …); unique per product only
  // — "Case" vs "case" across products is cosmetic, not deduplicated tenant-wide.
  label            String
  // Pieces per one of this unit (the server's ladder — a line's price/stock math
  // always resolves the factor from here, never from client-supplied input).
  factorToBase     Int
  // Explicit price at this level (tier 1). NULL = derived — see
  // @routeflow/pricing resolveUnitPrice.
  price            Decimal? @db.Decimal(10, 2)
  priceTier2       Decimal? @db.Decimal(10, 2)
  priceTier3       Decimal? @db.Decimal(10, 2)
  priceTier4       Decimal? @db.Decimal(10, 2)
  priceTier5       Decimal? @db.Decimal(10, 2)
  isDefaultSelling Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant  Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([productId, label])
  @@unique([productId, factorToBase])
  @@index([tenantId])
}

// Learned (supplier, product) purchasing facts — their SKU, their pack size,
// and the last unit cost paid at that pack. Upserted on scan confirm, consulted
// first on the next scan from that supplier (units/PO plan §1, ask 5).
model SupplierProduct {
  id           String   @id @default(uuid())
  tenantId     String
  supplierId   String
  productId    String
  supplierSku  String?
  // Pieces per one supplier unit (e.g. a case of 24).
  packSize     Int?
  // Per supplier unit, 4dp — the twin of StockLot.unitCost's precision.
  lastUnitCost Decimal? @db.Decimal(10, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])

  // Partial unique index (tenantId, supplierId, supplierSku) WHERE supplierSku
  // IS NOT NULL is added via raw SQL in the migration — Prisma can't express a
  // partial unique index (same precedent as the product-name partial indexes,
  // catalog.prisma Product model comment above).
  @@unique([tenantId, supplierId, productId])
  @@index([tenantId])
  @@index([supplierId])
}

// ─── Multi-category product labels (2026-09-19) ───────────────────────────────
// See local-assets/handoff/2026-09-18/PLAN-categories-jurisdiction-bans.md §1.
// Deliberately separate from TrackedCategory (tax/licence/report semantics,
// one-per-product FK) — a label carries no semantics of its own; a
// SellingRestriction rule (compliance.prisma) gives it force. `Product.category`
// (free text) is untouched.
model ProductCategory {
  id         String    @id @default(uuid())
  tenantId   String
  name       String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant              Tenant?                @relation(fields: [tenantId], references: [id])
  labels              ProductCategoryLabel[]
  sellingRestrictions SellingRestriction[]

  @@unique([tenantId, name])
}

// The product↔label assignment. EXCLUDE is a variant's opt-out of a label its
// PARENT carries — rejected at write when the product has no parentProductId,
// and `reason` is REQUIRED for EXCLUDE (an opt-out is a ban-bypass vector).
// The effective label set is computed dynamically at read time
// (ProductLabelsService.effectiveLabels) — never snapshotted, so nothing here
// goes stale when a parent's labels change later.
model ProductCategoryLabel {
  id            String    @id @default(uuid())
  tenantId      String
  productId     String
  categoryId    String
  mode          LabelMode
  reason        String?
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())

  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tenant   Tenant?         @relation(fields: [tenantId], references: [id])

  @@unique([productId, categoryId])
  @@index([tenantId, categoryId])
}

// ─── AI Product Mapping Memory ────────────────────────────────────────────────

model ProductMapping {
  id             String   @id @default(uuid())
  supplierName   String
  rawDescription String
  productId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenantId       String?

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  tenant  Tenant?  @relation(fields: [tenantId], references: [id])

  @@unique([supplierName, rawDescription])
  @@index([supplierName])
  @@index([tenantId])
}

// ─── Stock Alerts (P5-03 Notify-me) ───────────────────────────────────────────

/// Buyer "notify me when back in stock" subscription. One row per
/// (tenant, customer, product). A restock flips PENDING → NOTIFIED exactly once
/// (StockAlertService.fireForProducts only ever transitions PENDING rows, so
/// re-firing from multiple stock-increase paths is idempotent) and stamps
/// notifiedAt. Re-subscribing upserts the row back to PENDING.
model StockAlert {
  id         String           @id @default(uuid())
  tenantId   String?
  customerId String
  productId  String
  status     StockAlertStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  notifiedAt DateTime?

  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, customerId, productId])
  @@index([productId])
  @@index([tenantId])
}

enum StockAlertStatus {
  PENDING
  NOTIFIED
}

/// Learned mapping from a supplier's raw line text to a local product/variant or
/// expense category (spec §5.3), so the next scan/import auto-matches. Tenant-scoped
/// unique key fixes the cross-tenant collision in the older global ProductMapping.
/// `supplierId=""` is the sentinel for "any supplier" (empty string, not NULL, so
/// the unique constraint actually dedupes any-supplier aliases). Target pointers are
/// plain scalars (no FK); resolve() verifies the target still exists.
model ProductAlias {
  id                String   @id @default(uuid())
  tenantId          String
  supplierId        String   @default("")
  rawText           String
  productId         String?
  expenseCategoryId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, supplierId, rawText])
  @@index([tenantId, rawText])
  @@index([tenantId, supplierId])
}

/// PR-C: a durable stock-count (audit) session. Before this, a count lived only
/// in the client's localStorage, so it could not be paused and resumed from
/// another device, carried no attribution, and left no history. The session is
/// the unit of work; committing it writes ADJUSTMENT movements referencing
/// `movementReference` (the same `STOCK_COUNT-<id>` grouping the pre-existing
/// commit endpoint already used, so its idempotency guard still applies).
///
/// Single-counter now, multi-ready later: every LINE carries `countedById`, so
/// simultaneous multi-person counting can be turned on without a migration. The
/// OPEN-session guard is a WARNING, not a lock — two people counting different
/// aisles must never be blocked by each other.
model StockCountSession {
  id                String           @id @default(uuid())
  tenantId          String?
  name              String?
  status            StockCountStatus @default(OPEN)
  startedById       String
  startedAt         DateTime         @default(now())
  committedAt       DateTime?
  committedById     String?
  discardedAt       DateTime?
  notes             String?
  /// "STOCK_COUNT-<id>", set once committed — the movements' `reference`.
  movementReference String?
  /// Set when this session was opened as an amendment of an earlier committed
  /// one. Corrections never rewrite history: amending opens a NEW pre-filled
  /// session whose commit writes fresh adjustments referencing both.
  amendsSessionId   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tenant        Tenant?             @relation(fields: [tenantId], references: [id])
  startedBy     User                @relation("StockCountStarted", fields: [startedById], references: [id])
  committedBy   User?               @relation("StockCountCommitted", fields: [committedById], references: [id])
  amendsSession StockCountSession?  @relation("StockCountAmends", fields: [amendsSessionId], references: [id])
  amendedBy     StockCountSession[] @relation("StockCountAmends")
  lines         StockCountLine[]

  @@index([tenantId, status])
  @@index([tenantId, startedAt])
}

/// One counted product within a session. `@@unique([sessionId, productId])` makes
/// the autosave an idempotent upsert — a retried scan can never double-count.
///
/// ⚠️ Rows MUST be written directly (`stockCountLine.create/upsert`), never as a
/// nested create under the session: nested writes bypass the tenant extension's
/// `tenantId` injection and would land with `tenantId = null`, which `forTenant()`
/// then filters out (the invoiced-sales lesson).
model StockCountLine {
  id               String             @id @default(uuid())
  tenantId         String?
  sessionId        String
  productId        String
  /// REPLACE = "on-hand IS this"; ADD = "add this to on-hand". Mirrors the
  /// pre-existing commit DTO so the durable session cannot regress the
  /// quick-adjust flow that already shipped.
  mode             StockCountLineMode @default(REPLACE)
  /// The number the counter entered, in base units.
  countedQty       Decimal            @db.Decimal(10, 3)
  /// The denomination they entered it in, purely for faithful re-display.
  boxes            Int?
  pieces           Int?
  /// On-hand snapshotted when this line was FIRST counted — the "expected" the
  /// review screen compares against. Snapshotting (rather than reading live
  /// stock at commit) is what makes the variance mean "what changed since you
  /// started counting" instead of silently moving under the counter.
  expectedQty      Decimal            @db.Decimal(10, 3)
  /// Optional per-line cost correction, 4dp (COST_DP). Set ⇒ commit ALSO writes
  /// the audited COST_BASIS path for this product, not just the quantity.
  unitCostOverride Decimal?           @db.Decimal(10, 4)
  countedById      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  session   StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  countedBy User              @relation(fields: [countedById], references: [id])
  tenant    Tenant?           @relation(fields: [tenantId], references: [id])

  @@unique([sessionId, productId])
  @@index([tenantId])
  @@index([productId])
}

enum StockCountStatus {
  OPEN
  REVIEW
  COMMITTED
  DISCARDED
}

enum StockCountLineMode {
  REPLACE
  ADD
}
