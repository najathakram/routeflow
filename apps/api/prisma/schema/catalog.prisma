// RouteFlow Prisma schema — domain file: catalog (products, suppliers, stock/lots/movements, counts, purchase orders, product matching).
// Generated by apps/api/scripts/split-prisma-schema.mjs — run it with --check to prove the split is lossless.

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  WRITE_OFF
  COST_BASIS
}

/// SA-804(3): why a stock ADJUSTMENT was made. NULL on history and on every other movement type.
/// A write-off is derived (`isWriteOff` in @routeflow/pricing), never stored.
enum AdjustmentReason {
  DAMAGED
  EXPIRED
  THEFT
  SAMPLE
  COUNT_CORRECTION
  OTHER
}

enum CostingMethod {
  FIFO
  LIFO
  AVCO
  STANDARD
  // Last cost — every sale is costed at the most recent purchase lot's unit
  // cost (pos-cost-roles-spec §1). Additive value; see migration
  // 20260706040000_add_costing_last_cost.
  LAST_COST
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CLOSED
}

// Multi-category labels (2026-09-19): a product-category ASSIGNMENT's polarity.
// INCLUDE = the product/variant carries this label. EXCLUDE = a variant's signed
// opt-out of a label its parent carries (never valid on a standalone product —
// enforced app-side in ProductLabelsService). See ProductCategoryLabel below.
enum LabelMode {
  INCLUDE
  EXCLUDE
}

/// #2717 M1 (SA-572a): the catalog role of a Product row. Constant default; NOT backfilled in M1 and read by nothing in
/// M1 (variant-ness stays parentProductId != null). Values beyond STANDARD are M2+.
enum ProductKind {
  STANDARD
  FAMILY
  VARIANT
  RECIPE
}

/// #2717 M1: the packaging level a barcode or a ProductUnit sits at (unit → inner → box → case → display → pallet).
enum PackagingLevel {
  UNIT
  INNER
  BOX
  CASE
  DISPLAY
  PALLET
}

/// #2717 M1: the barcode symbology, inferred from the code (apps/api/src/common/barcode-symbology.ts).
enum BarcodeSymbology {
  UPC_A
  UPC_E
  EAN_8
  EAN_13
  GTIN_14
  CODE128
  OTHER
}

/// #2717 M1 (SA-572a): ENTERED = a code someone entered or scanned for this level; COPIED = the owner's rule "one
/// barcode ⇒ the units share it": the unit row copied from the box row (copiedFromLevel says from which).
enum BarcodeOrigin {
  ENTERED
  COPIED
}

model Product {
  id                   String        @id @default(uuid())
  name                 String
  description          String?
  sku                  String?
  // Optional retail-unit (inner piece) code; NULL ⇒ unit shares the case `sku`.
  // Read sites use `unitSku ?? sku`.
  unitSku              String?
  // Spec 06: hide a product from the buyer portal; independent of selling restrictions.
  portalVisible        Boolean       @default(true)
  // SA-603: the codes released on deactivate (legacy column -> retired*); the full uniques are unchanged.
  retiredSku           String?
  retiredBarcode       String?
  retiredUnitSku       String?
  // Units rebuild P0a: null baseUnitLabel = "Piece"; null packLabel = legacy (unit text, else "Box");
  // null invoiceLineCode = follow the tenant policy (see INVOICE_LINE_CODE_MODES).
  baseUnitLabel        String?
  packLabel            String?
  invoiceLineCode      String?
  unit                 String
  pricePerUnit         Decimal       @db.Decimal(10, 2)
  priceTier2           Decimal       @default(0) @db.Decimal(10, 2)
  priceTier3           Decimal       @default(0) @db.Decimal(10, 2)
  priceTier4           Decimal       @default(0) @db.Decimal(10, 2)
  priceTier5           Decimal       @default(0) @db.Decimal(10, 2)
  // Suggested retail price (MSRP), per PIECE — the retail selling unit — even when this
  // product is sold wholesale by the box. Display-only: NEVER feed into money math
  // (computeLineSubtotal, totals, tax, margin, promotions). Null = no MSRP set, renders
  // blank, never $0.00. Universal default; CustomerPrice.msrp overrides it per customer.
  msrp                 Decimal?      @db.Decimal(10, 2)
  category             String?
  imageKeys            String[]      @default([])
  isActive             Boolean       @default(true)
  isFeatured           Boolean       @default(false)
  // Buyer merchandising flags (P5-01): drive catalogue tiles + smart collections.
  isNew                Boolean       @default(false)
  isDeal               Boolean       @default(false)
  // Regulated tobacco product — only settable when the tenant has the
  // "tobacco_dealer" addon; drives separate tracking + monthly tax reports
  isTobacco            Boolean       @default(false)
  barcode              String?
  currentStock         Decimal       @default(0) @db.Decimal(10, 3)
  averageCost          Decimal?      @db.Decimal(10, 4)
  // AVCO because every write path maintains `averageCost` via nextAverageCost and
  // valuation reads it back; the FIFO/LIFO lot-consumption path exists but has no
  // caller, so labelling products FIFO promised a costing basis nothing computed.
  costingMethod        CostingMethod @default(AVCO)
  standardCost         Decimal?      @db.Decimal(10, 4)
  reorderPoint         Int?
  reorderQty           Int?
  unitsPerBox          Int?
  parentProductId      String?
  variantName          String?
  // Phase 4: going-forward regulated-category pointer (one max per product);
  // supersedes `isTobacco`, which is kept as a shadow column for one release.
  trackedCategoryId    String?
  // Phase 4 (subcategories): optional finer classification WITHIN the section
  // above (reporting only, no compliance semantics). Parent must equal
  // trackedCategoryId (enforced app-side; Prisma can't express the composite FK).
  trackedSubcategoryId String?
  /// Regulatory reporting config (template-agnostic; the vocabulary is defined by
  /// the section's reportTemplate — see regulated/template-registry.ts).
  /// regUomUnit = UoM code for loose/unit quantities. regUomCase is OPTIONAL and
  /// opts the product into case-level bucketing when sold by the box; leaving it
  /// NULL makes the report pass quantities through unconverted (back-compat).
  regItemType          String?
  regUomCase           String?
  regUomUnit           String?
  // Migration & Batch Import (Phase 3): a brand-new product created from a scanned
  // invoice line with only name+SKU+cost is flagged incomplete until price/units
  // are confirmed. Surfaced under a "Finish setup" filter on the import surface.
  detailsIncomplete    Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  tenantId             String?

  // #2717 M1 (SA-572a): additive, constant defaults, nothing reads them in M1.
  kind        ProductKind @default(STANDARD)
  flexEnabled Boolean     @default(false)
  flexStep    Int?

  // #2717 M2 (Q3): FIXED-recipe products may keep their own tiers while the family propagates.
  familyPriceOverride Boolean @default(false)

  // Units program S6 (SA-795 (b)): which pack price cells are Auto. Bitmask, DB CHECK 0..31 (raw SQL):
  // bit 0 = Retail (pricePerUnit), bits 1-4 = priceTier2-5 (@routeflow/pricing PACK_AUTO_BITS).
  // 0 = every cell set, today. priceSource() is the only reader.
  packAuto       Int     @default(0)
  // SA-796 R-1: bumped in the same UPDATE by every units price write (never by stock). S9's precondition is
  // this PLUS a value compare-and-set of the prices it read (legacy writers do not bump it), else 409.
  priceRevision  Int     @default(0)
  // S6 (PLAN §1.2/§1.6): the order unit, which is also the price anchor: "pack" | "base" | a ProductUnit.id.
  // Stored on every product; the constant default IS the backfill (every product orders by its pack today).
  orderUnitRef   String  @default("pack")
  // S6: the product-scope invoice unit (same refs); null = the business setting. Display only (SA-795 (g)).
  invoiceUnitRef String?

  tenant                Tenant?                @relation(fields: [tenantId], references: [id])
  orderItems            OrderItem[]
  deliveryMutations     DeliveryMutation[]
  changeRequests        ChangeRequest[]
  templateItems         OrderTemplateItem[]
  stockMovements        StockMovement[]
  stockLots             StockLot[]
  stockCountLines       StockCountLine[]
  invoiceItems          InvoiceItem[]
  estimateItems         EstimateItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  returnItems           ReturnItem[]
  recurringInvoiceItems RecurringInvoiceItem[]
  vendorBillItems       VendorBillItem[]
  customerPrices        CustomerPrice[]
  productMappings       ProductMapping[]
  buyerFavorites        BuyerFavorite[]
  promotionProducts     PromotionProduct[]
  replenishmentSnoozes  ReplenishmentSnooze[]
  stockAlerts           StockAlert[]
  parent                Product?               @relation("ProductVariants", fields: [parentProductId], references: [id])
  variants              Product[]              @relation("ProductVariants")
  trackedCategory       TrackedCategory?       @relation(fields: [trackedCategoryId], references: [id], onDelete: SetNull)
  trackedSubcategory    TrackedSubcategory?    @relation(fields: [trackedSubcategoryId], references: [id], onDelete: SetNull)
  units                 ProductUnit[]
  supplierProducts      SupplierProduct[]
  categoryLabels        ProductCategoryLabel[]
  sellingRestrictions   SellingRestriction[]
  sellingRestrictionTargets SellingRestrictionTarget[]
  barcodes              ProductBarcode[]
  images                ProductImage[]
  recipesAsProduct      Recipe[]               @relation("RecipeProduct")
  recipesAsFamily       Recipe[]               @relation("RecipeFamily")
  recipeComponents      RecipeComponent[]
  orderItemComponents   OrderItemComponent[]
  invoiceItemComponents InvoiceItemComponent[]
  // Units program S6: tier/customer unit settings and the family provenance of split supplier lines.
  tierUnits                ProductTierUnit[]
  customerUnitPrices       CustomerUnitPrice[]
  familyPurchaseOrderItems PurchaseOrderItem[]    @relation("PurchaseOrderItemFamily")
  familyVendorBillItems    VendorBillItem[]       @relation("VendorBillItemFamily")

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@unique([tenantId, unitSku])
  // Name uniqueness among ACTIVE products is enforced by two raw-SQL PARTIAL unique indexes, created
  // in migrations/20260929220000_sitting_b_bundle/migration.sql (SA-603b):
  //   - Product_tenant_root_name_active_key:   (tenantId, name)
  //       WHERE parentProductId IS NULL AND isActive
  //       -> the standalone catalog stays flat-unique (no two active parents named "Acme Parent A")
  //   - Product_tenant_parent_name_active_key: (tenantId, parentProductId, name)
  //       WHERE parentProductId IS NOT NULL AND isActive
  //       -> variant names unique WITHIN their parent only
  //          ("Acme Flavor" can be a flavor under both "Acme Parent A" and "Acme Parent B")
  // Prisma can't declare partial unique indexes; the plain index below is for name-search speed only.
  @@index([tenantId, name])
  @@index([category])
  @@index([isActive])
  @@index([isFeatured])
  @@index([barcode])
  @@index([unitSku])
  @@index([parentProductId])
  @@index([tenantId])
  @@index([tenantId, isTobacco])
  @@index([tenantId, trackedCategoryId])
  @@index([trackedSubcategoryId])
  @@index([tenantId, detailsIncomplete])
}

model Supplier {
  id               String   @id @default(uuid())
  name             String
  contactName      String?
  phone            String?
  mobile           String?
  email            String?
  website          String?
  notes            String?
  isActive         Boolean  @default(true)
  leadTimeDays     Int?
  // Tobacco wholesale license of the supplier — shown on purchase records
  // and the monthly tobacco report so filings are audit-ready
  tobaccoLicenseNo String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  zip              String?
  lat              Float?
  lng              Float?
  country          String?
  // Net-terms label seeded onto a new vendor bill for this supplier ("Net 30",
  // "Due on Receipt", …). Bills have no due-date-computation machinery server
  // side; the client computes Due Date = Bill Date + days from this label.
  defaultTerms     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenantId         String?

  tenant                 Tenant?                 @relation(fields: [tenantId], references: [id])
  stockMovements         StockMovement[]
  purchaseOrders         PurchaseOrder[]
  vendorBills            VendorBill[]
  invoiceScans           InvoiceScan[]
  expenses               Expense[]
  supplierCredits        SupplierCredit[]
  supplierStatementScans SupplierStatementScan[]
  supplierProducts       SupplierProduct[]

  @@index([isActive])
  @@index([tenantId])
}

model StockLot {
  id           String   @id @default(uuid())
  productId    String
  purchaseDate DateTime @default(now())
  qty          Decimal  @db.Decimal(10, 3)
  remainingQty Decimal  @db.Decimal(10, 3)
  unitCost     Decimal  @db.Decimal(10, 4)
  reference    String?
  notes        String?
  createdAt    DateTime @default(now())
  tenantId     String?

  product Product @relation(fields: [productId], references: [id])
  tenant  Tenant? @relation(fields: [tenantId], references: [id])

  @@index([productId])
  @@index([purchaseDate])
  @@index([tenantId])
}

model StockMovement {
  id            String       @id @default(uuid())
  productId     String
  type          MovementType
  quantity      Decimal      @db.Decimal(10, 3)
  unitCost      Decimal?     @db.Decimal(10, 4)
  // Running snapshots: product state AFTER this movement was applied.
  // Point-in-time average cost = avgCostAfter of the latest movement with effectiveAt <= T.
  avgCostAfter  Decimal?     @db.Decimal(10, 4)
  stockAfter    Decimal?     @db.Decimal(10, 3)
  supplierId    String?
  reference     String?
  notes         String?
  performedById String?
  // SA-804(3): set on ADJUSTMENT rows only (manual adjust, product count, count commits); OTHER carries a note.
  reason        AdjustmentReason?
  reasonNote    String?
  // B562 (SA-136 §3): the ACCOUNTING date of the movement — a backdated purchase/adjustment/bill
  // receive carries its effective date here. `createdAt` is write-once insertion time and is only
  // a tiebreaker. Replay, point-in-time cost and every "when did this happen" read order/filter by
  // (effectiveAt, createdAt, id).
  effectiveAt   DateTime     @default(now())
  createdAt     DateTime     @default(now())
  tenantId      String?

  product     Product   @relation(fields: [productId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  performedBy User?     @relation(fields: [performedById], references: [id])

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@index([effectiveAt])
  @@index([supplierId])
  @@index([tenantId])
}

// ─── Purchase orders ────────────────────────────────────────────────

model PurchaseOrder {
  id           String              @id @default(uuid())
  poNumber     String
  supplierId   String
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?
  notes        String?
  totalAmount  Decimal             @db.Decimal(10, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenantId     String?

  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  tenant     Tenant?             @relation(fields: [tenantId], references: [id])
  items      PurchaseOrderItem[]
  vendorBill VendorBill?

  @@unique([tenantId, poNumber])
  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId])
}

model PurchaseOrderItem {
  id          String  @id @default(uuid())
  poId        String
  productId   String
  qtyOrdered  Decimal @db.Decimal(10, 3)
  qtyReceived Decimal @default(0) @db.Decimal(10, 3)
  unitCost    Decimal @db.Decimal(10, 4)
  totalCost   Decimal @db.Decimal(10, 2)
  // Units/PO minimal (2026-09-19): the supplier's own SKU for this line and the
  // pieces-per-supplier-unit pack size, mirroring VendorBillItem so a scan's
  // reviewed lines copy across unchanged. Null on every line created before this
  // shipped and on any line the supplier's document didn't carry a SKU for.
  // qtyOrdered/unitCost stay per PIECE (receive is untouched); supplier-unit
  // display is derived (qtyOrdered ÷ packSize, unitCost × packSize).
  sku         String?
  packSize    Int?
  tenantId    String?

  po      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  tenant  Tenant?       @relation(fields: [tenantId], references: [id])
  product Product       @relation(fields: [productId], references: [id])

  @@index([poId])
  @@index([productId])
  @@index([tenantId])
  // Units rebuild P0a: sale-time unit-name snapshots (null = legacy line).
  baseLabel String?

  // Units program S6 (PLAN §1.8): the family purchase split. unitLabel = the line's own unit name;
  // familyProductId = the FAMILY a split child line came from (SetNull: provenance only, never blocks a
  // product delete); familyGroupId groups the child lines of one supplier line. Null on every line today.
  unitLabel       String?
  familyProductId String?
  familyGroupId   String?
  familyProduct   Product? @relation("PurchaseOrderItemFamily", fields: [familyProductId], references: [id], onDelete: SetNull)

  @@index([familyGroupId])
  @@index([familyProductId])
}

// ─── Multi-level units + purchase-order supplier mapping (2026-09-19) ─────────
// See local-assets/handoff/2026-09-18/PLAN-units-po-MINIMAL.md §1. Additive only:
// a product with no ProductUnit rows behaves exactly as it does today
// (Product.unitsPerBox/pricePerUnit + tiers remain the pack). Rows exist only
// for levels OTHER than the pack (Case, Pallet, Container, … and an optional
// explicit "Piece" price row with factorToBase = 1).
model ProductUnit {
  id               String   @id @default(uuid())
  tenantId         String
  productId        String
  // Free-text level name ("Case", "Pallet", "Piece", …); unique per product only
  // — "Case" vs "case" across products is cosmetic, not deduplicated tenant-wide.
  label            String
  // Pieces per one of this unit (the server's ladder — a line's price/stock math
  // always resolves the factor from here, never from client-supplied input).
  factorToBase     Int
  // Explicit price at this level (tier 1). NULL = derived — see
  // @routeflow/pricing resolveUnitPrice.
  price            Decimal? @db.Decimal(10, 2)
  priceTier2       Decimal? @db.Decimal(10, 2)
  priceTier3       Decimal? @db.Decimal(10, 2)
  priceTier4       Decimal? @db.Decimal(10, 2)
  priceTier5       Decimal? @db.Decimal(10, 2)
  isDefaultSelling Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // #2717 M1: the packaging level this unit sits at, and its optional parent in the ladder.
  level        PackagingLevel?
  parentUnitId String?

  // Units rebuild P0a: the tenant-wide unit name this level uses, the entered chain count
  // (parentUnitId already exists), and this level's own sku (retiredSku = released on deactivate).
  tenantUnitId String?
  perParent    Int?
  sku          String?
  retiredSku   String?

  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant     Tenant?          @relation(fields: [tenantId], references: [id])
  tenantUnit TenantUnit?      @relation(fields: [tenantUnitId], references: [id], onDelete: SetNull)
  barcodes   ProductBarcode[]
  parent   ProductUnit?  @relation("ProductUnitParent", fields: [parentUnitId], references: [id], onDelete: SetNull)
  children ProductUnit[] @relation("ProductUnitParent")

  @@unique([productId, label])
  @@unique([productId, factorToBase])
  @@index([tenantId])
  @@index([tenantUnitId])
  @@index([tenantId, sku])
}

/// Units program S6 (PLAN §1.2/§1.6): a pricing tier's own order and invoice unit for one product (the
/// "product x tier" scope; customer > tier > product > business). Refs: "pack" | "base" | a ProductUnit.id
/// (DB CHECK, SA-796 R-3: never a `label:` ref), null = fall through to the product. `tier` 2..5 (DB CHECK,
/// raw SQL; SA-796 R-2): Retail customers (tier 1) use the product scope itself, and one retail customer's own
/// unit is `CustomerPrice.orderUnitRef`.
/// A row with BOTH refs null means nothing (no CHECK on purpose): S20's writer deletes the row instead.
model ProductTierUnit {
  id             String   @id @default(uuid())
  tenantId       String
  productId      String
  tier           Int
  orderUnitRef   String?
  invoiceUnitRef String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, tier])
  @@index([tenantId])
}

/// Units rebuild P0a: a tenant-wide unit name ("Case", "Pack", ...). `nameKey` = unitNameKey(name): NFC, then trim, then case-fold (set by the service; `sqlKeyOf` is its SQL twin).
model TenantUnit {
  id         String    @id @default(uuid())
  tenantId   String
  name       String
  nameKey    String
  plural     String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  productUnits ProductUnit[]

  @@unique([tenantId, nameKey])
  @@index([tenantId])
}

/// #2717 M1 (SA-572a/b): a product's barcodes BY PACKAGING LEVEL. The same code may be BOTH the BOX and the UNIT row of
/// the SAME product (two rows). Cross-product uniqueness is a SERVICE invariant (409 BARCODE_TAKEN under an xact advisory
/// lock), not a constraint. One primary per (product, level) via the nullable `primaryFor` + @@unique (no partial
/// indexes, SA-572 A4). M1 mirrors Product.barcode (dual write); readers fall back to the legacy column.
model ProductBarcode {
  id              String           @id @default(uuid())
  tenantId        String
  productId       String
  // NULL = released on deactivate/reuse; NULLs are distinct under @@unique([tenantId, code, level]).
  code            String?
  retiredCode     String?
  symbology       BarcodeSymbology
  level           PackagingLevel
  origin          BarcodeOrigin    @default(ENTERED)
  copiedFromLevel PackagingLevel?
  primaryFor      PackagingLevel?
  // Units rebuild P0a: the ladder level this barcode belongs to (nullable; legacy rows use `level`).
  productUnitId   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productUnit ProductUnit? @relation(fields: [productUnitId], references: [id], onDelete: SetNull)

  @@unique([tenantId, code, level])
  @@unique([productId, primaryFor])
  @@index([productId, level])
  @@index([productUnitId])
  @@index([tenantId, code])
}

/// #2717 M1: product photos as rows (M1 mirrors Product.imageKeys; focal parsed from the key's `-fp{x}x{y}` suffix).
/// productId NULL = the "Unassigned" tray (no M1 writer uses it).
model ProductImage {
  id           String   @id @default(uuid())
  tenantId     String
  productId    String?
  storageKey   String
  originalName String?
  mimeType     String?
  focalX       Int?
  focalY       Int?
  sortOrder    Int      @default(0)
  isPrimary    Boolean  @default(false)
  altText      String?
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, storageKey])
  @@index([productId, sortOrder])
}

enum RecipeStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// #2717 M2 (SA-572 A4): a versioned fixed mix of a family's variants sold as one RECIPE product.
/// One ACTIVE recipe per recipe product = nullable-unique activeFor (set to productId while ACTIVE,
/// NULL otherwise) — no partial index. Documents never JOIN this table (I11).
model Recipe {
  id              String       @id @default(uuid())
  tenantId        String
  productId       String
  familyProductId String
  version         Int
  unitsPerPack    Int
  status          RecipeStatus @default(DRAFT)
  activeFor       String?
  effectiveFrom   DateTime?
  retiredAt       DateTime?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  product    Product           @relation("RecipeProduct", fields: [productId], references: [id], onDelete: Restrict)
  family     Product           @relation("RecipeFamily", fields: [familyProductId], references: [id], onDelete: Restrict)
  components RecipeComponent[]

  @@unique([productId, version])
  @@unique([activeFor])
  @@index([tenantId])
  @@index([familyProductId])
}

model RecipeComponent {
  id                 String   @id @default(uuid())
  tenantId           String
  recipeId           String
  componentProductId String
  qty                Int
  position           Int      @default(0)
  createdAt          DateTime @default(now())

  recipe           Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  componentProduct Product @relation(fields: [componentProductId], references: [id], onDelete: Restrict)

  @@unique([recipeId, componentProductId])
  @@index([componentProductId])
  @@index([tenantId])
}

// Learned (supplier, product) purchasing facts — their SKU, their pack size,
// and the last unit cost paid at that pack. Upserted on scan confirm, consulted
// first on the next scan from that supplier (units/PO plan §1, ask 5).
model SupplierProduct {
  id           String   @id @default(uuid())
  tenantId     String
  supplierId   String
  productId    String
  supplierSku  String?
  // Pieces per one supplier unit (e.g. a case of 24).
  packSize     Int?
  // Per supplier unit, 4dp — the twin of StockLot.unitCost's precision.
  lastUnitCost Decimal? @db.Decimal(10, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])

  // Partial unique index (tenantId, supplierId, supplierSku) WHERE supplierSku
  // IS NOT NULL is added via raw SQL in the migration — Prisma can't express a
  // partial unique index (same precedent as the product-name partial indexes,
  // catalog.prisma Product model comment above).
  @@unique([tenantId, supplierId, productId])
  @@index([tenantId])
  @@index([supplierId])
}

// ─── Multi-category product labels (2026-09-19) ───────────────────────────────
// See local-assets/handoff/2026-09-18/PLAN-categories-jurisdiction-bans.md §1.
// Deliberately separate from TrackedCategory (tax/licence/report semantics,
// one-per-product FK) — a label carries no semantics of its own; a
// SellingRestriction rule (compliance.prisma) gives it force. `Product.category`
// (free text) is untouched.
model ProductCategory {
  id         String    @id @default(uuid())
  tenantId   String
  name       String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant              Tenant?                @relation(fields: [tenantId], references: [id])
  labels              ProductCategoryLabel[]
  sellingRestrictions SellingRestriction[]
  sellingRestrictionTargets SellingRestrictionTarget[]

  @@unique([tenantId, name])
}

// The product↔label assignment. EXCLUDE is a variant's opt-out of a label its
// PARENT carries — rejected at write when the product has no parentProductId,
// and `reason` is REQUIRED for EXCLUDE (an opt-out is a ban-bypass vector).
// The effective label set is computed dynamically at read time
// (ProductLabelsService.effectiveLabels) — never snapshotted, so nothing here
// goes stale when a parent's labels change later.
model ProductCategoryLabel {
  id                     String    @id @default(uuid())
  tenantId               String
  productId              String
  categoryId             String
  mode                   LabelMode
  reason                 String?
  // The variant's CURRENT parent at the moment an EXCLUDE (opt-out) was written — set by the write
  // side on EVERY EXCLUDE write and never touched by reparenting, so an opt-out approved against one
  // parent can never ride along to another. The engine treats an EXCLUDE whose pin is null or is not
  // the variant's current parent as INERT (fail closed). Always null on INCLUDE rows and on legacy rows.
  parentProductIdAtWrite String?
  createdById            String?
  createdByName          String?
  createdAt              DateTime  @default(now())

  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tenant   Tenant?         @relation(fields: [tenantId], references: [id])

  @@unique([productId, categoryId])
  @@index([tenantId, categoryId])
}

// ─── AI Product Mapping Memory ────────────────────────────────────────────────

model ProductMapping {
  id             String   @id @default(uuid())
  supplierName   String
  rawDescription String
  productId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenantId       String?

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  tenant  Tenant?  @relation(fields: [tenantId], references: [id])

  @@unique([supplierName, rawDescription])
  @@index([supplierName])
  @@index([tenantId])
}

// ─── Stock Alerts (P5-03 Notify-me) ───────────────────────────────────────────

/// Buyer "notify me when back in stock" subscription. One row per
/// (tenant, customer, product). A restock flips PENDING → NOTIFIED exactly once
/// (StockAlertService.fireForProducts only ever transitions PENDING rows, so
/// re-firing from multiple stock-increase paths is idempotent) and stamps
/// notifiedAt. Re-subscribing upserts the row back to PENDING.
model StockAlert {
  id         String           @id @default(uuid())
  tenantId   String?
  customerId String
  productId  String
  status     StockAlertStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  notifiedAt DateTime?

  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, customerId, productId])
  @@index([productId])
  @@index([tenantId])
}

enum StockAlertStatus {
  PENDING
  NOTIFIED
}

/// Learned mapping from a supplier's raw line text to a local product/variant or
/// expense category (spec §5.3), so the next scan/import auto-matches. Tenant-scoped
/// unique key fixes the cross-tenant collision in the older global ProductMapping.
/// `supplierId=""` is the sentinel for "any supplier" (empty string, not NULL, so
/// the unique constraint actually dedupes any-supplier aliases). Target pointers are
/// plain scalars (no FK); resolve() verifies the target still exists.
model ProductAlias {
  id                String   @id @default(uuid())
  tenantId          String
  supplierId        String   @default("")
  rawText           String
  productId         String?
  expenseCategoryId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, supplierId, rawText])
  @@index([tenantId, rawText])
  @@index([tenantId, supplierId])
}

/// PR-C: a durable stock-count (audit) session. Before this, a count lived only
/// in the client's localStorage, so it could not be paused and resumed from
/// another device, carried no attribution, and left no history. The session is
/// the unit of work; committing it writes ADJUSTMENT movements referencing
/// `movementReference` (the same `STOCK_COUNT-<id>` grouping the pre-existing
/// commit endpoint already used, so its idempotency guard still applies).
///
/// Single-counter now, multi-ready later: every LINE carries `countedById`, so
/// simultaneous multi-person counting can be turned on without a migration. The
/// OPEN-session guard is a WARNING, not a lock — two people counting different
/// aisles must never be blocked by each other.
model StockCountSession {
  id                String           @id @default(uuid())
  tenantId          String?
  name              String?
  status            StockCountStatus @default(OPEN)
  startedById       String
  startedAt         DateTime         @default(now())
  committedAt       DateTime?
  committedById     String?
  discardedAt       DateTime?
  notes             String?
  /// "STOCK_COUNT-<id>", set once committed — the movements' `reference`.
  movementReference String?
  /// Set when this session was opened as an amendment of an earlier committed
  /// one. Corrections never rewrite history: amending opens a NEW pre-filled
  /// session whose commit writes fresh adjustments referencing both.
  amendsSessionId   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tenant        Tenant?             @relation(fields: [tenantId], references: [id])
  startedBy     User                @relation("StockCountStarted", fields: [startedById], references: [id])
  committedBy   User?               @relation("StockCountCommitted", fields: [committedById], references: [id])
  amendsSession StockCountSession?  @relation("StockCountAmends", fields: [amendsSessionId], references: [id])
  amendedBy     StockCountSession[] @relation("StockCountAmends")
  lines         StockCountLine[]

  @@index([tenantId, status])
  @@index([tenantId, startedAt])
}

/// One counted product within a session. `@@unique([sessionId, productId])` makes
/// the autosave an idempotent upsert — a retried scan can never double-count.
///
/// ⚠️ Rows MUST be written directly (`stockCountLine.create/upsert`), never as a
/// nested create under the session: nested writes bypass the tenant extension's
/// `tenantId` injection and would land with `tenantId = null`, which `forTenant()`
/// then filters out (the invoiced-sales lesson).
model StockCountLine {
  id               String             @id @default(uuid())
  tenantId         String?
  sessionId        String
  productId        String
  /// REPLACE = "on-hand IS this"; ADD = "add this to on-hand". Mirrors the
  /// pre-existing commit DTO so the durable session cannot regress the
  /// quick-adjust flow that already shipped.
  mode             StockCountLineMode @default(REPLACE)
  /// The number the counter entered, in base units.
  countedQty       Decimal            @db.Decimal(10, 3)
  /// The denomination they entered it in, purely for faithful re-display.
  boxes            Int?
  pieces           Int?
  /// The on-hand baseline the REPLACE delta is measured from (delta = countedQty -
  /// expectedQty). Stamped from the live stock when the line is created and on every
  /// ABSOLUTE write that changes the count (a typed / set total or a recount); an
  /// increment scan, a cost-only edit, a mode toggle and a same-value resend keep it.
  /// Snapshotting (rather than reading live stock at commit) is what makes the
  /// variance mean "what changed since you started counting", so a sale that lands
  /// after the baseline is kept instead of being counted away.
  expectedQty      Decimal            @db.Decimal(10, 3)
  /// Optional per-line cost correction, 4dp (COST_DP). Set ⇒ commit ALSO writes
  /// the audited COST_BASIS path for this product, not just the quantity.
  unitCostOverride Decimal?           @db.Decimal(10, 4)
  countedById      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  session   StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  countedBy User              @relation(fields: [countedById], references: [id])
  tenant    Tenant?           @relation(fields: [tenantId], references: [id])

  @@unique([sessionId, productId])
  @@index([tenantId])
  @@index([productId])
}

enum StockCountStatus {
  OPEN
  REVIEW
  COMMITTED
  DISCARDED
}

enum StockCountLineMode {
  REPLACE
  ADD
}
