// RouteFlow Prisma schema — domain file: platform (SaaS billing/plans, messaging, audit, import/migration, config, AI usage, numbering).
// Generated by apps/api/scripts/split-prisma-schema.mjs — run it with --check to prove the split is lossless.

// ─── Billing / plans-as-data (Phase: Plans & Billing) ─────────────────────────
// Plans are versioned reference data (PlanVersion → PlanDefinition + AddonSku);
// entitlement logic is driven off the string `planKey`, NOT the TenantPlan enum
// (kept as a legacy shadow). See docs/design-package/project/specs/pricing-plans.md.

enum PlanVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum MeterKey {
  SEATS
  ROUTES
  SCANS
  MSGS
  CUSTOMERS
}

enum AddonUnit {
  FLAT
  PER_USER
  PER_ROUTE
}

model TenantSubscription {
  id                    String       @id @default(uuid())
  tenantId              String       @unique
  stripeCustomerId      String?
  stripeSubId           String?
  currentPlan           TenantPlan   @default(STARTER)
  periodStart           DateTime?
  periodEnd             DateTime?
  cancelAtPeriodEnd     Boolean      @default(false)
  // Plans-as-data + lifecycle (Plans & Billing). All nullable/defaulted so
  // existing rows are untouched; `planKey`/`planVersionId` are the new source of truth.
  planVersionId         String?
  planKey               String? // STARTER | TEAM | BUSINESS | ENTERPRISE
  cycle                 BillingCycle @default(MONTHLY)
  basePriceSnapshot     Decimal?     @db.Decimal(10, 2)
  discount              Decimal      @default(0) @db.Decimal(10, 2)
  downgradeToPlanKey    String?
  downgradeEffectiveAt  DateTime?
  retainedUserIds       String[]
  graceStartedAt        DateTime?
  graceMeter            MeterKey?
  trialConvertedAt      DateTime?
  nextChargeAt          DateTime?
  failedPaymentCount    Int          @default(0)
  // External (non-Stripe) payment tracking
  externalPayment       Boolean      @default(false)
  externalPaymentMethod String? // ZELLE | BANK_TRANSFER | CHECK | CASH | WIRE | OTHER
  externalPaymentRef    String? // transaction ID or confirmation number
  externalPaymentNotes  String?
  // Platform billing — catalog-driven Stripe prices (Plans & Billing pricing batch).
  // Per-tenant custom fee overrides; null = fall back to the catalog (PlanDefinition).
  priceOverrideMonthly  Decimal?     @db.Decimal(10, 2)
  priceOverrideAnnual   Decimal?     @db.Decimal(10, 2)
  billingInterval       String? // "month" | "year", stamped at checkout completion
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planVersion PlanVersion? @relation(fields: [planVersionId], references: [id])

  @@index([planVersionId])
  @@index([downgradeEffectiveAt])
}

model TenantAddon {
  id            String   @id @default(uuid())
  tenantId      String
  addonKey      String // e.g. "ai_scanning", "advanced_routes", "api_access"
  // Plans-as-data bridge: canonical SKU code (SEAT_EXTRA, BUYER_PORTAL, …). The
  // legacy free-text `addonKey` stays authoritative for existing consumers
  // (e.g. "tobacco_dealer") and is mapped to `sku="REGULATED_ITEMS"` additively.
  sku           String?
  quantity      Int      @default(1) // SEAT_EXTRA per-user, OCR_PACK_250 stacks
  priceSnapshot Decimal? @db.Decimal(10, 2)
  stripePriceId String? // Stripe price for this add-on
  stripeItemId  String? // Stripe subscription item ID
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, addonKey])
  @@index([tenantId])
  @@index([tenantId, sku])
}

// ─── Billing plan catalog (GLOBAL reference data — not tenant-scoped) ─────────

model PlanVersion {
  id          String            @id @default(uuid())
  version     Int               @unique
  status      PlanVersionStatus @default(DRAFT)
  effectiveAt DateTime?
  publishedAt DateTime?
  publishedBy String?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  definitions   PlanDefinition[]
  addonSkus     AddonSku[]
  tenants       Tenant[]
  subscriptions TenantSubscription[]

  @@index([status])
}

model PlanDefinition {
  id                String   @id @default(uuid())
  planVersionId     String
  planKey           String // STARTER | TEAM | BUSINESS | ENTERPRISE
  name              String
  monthlyPrice      Decimal? @db.Decimal(10, 2) // null = custom (Enterprise)
  annualPrice       Decimal? @db.Decimal(10, 2) // = monthlyPrice * 10
  isCustom          Boolean  @default(false)
  seatsIncluded     Int? // null = unlimited
  routesConcurrent  Int? // null = unlimited
  scansIncluded     Int? // null = unlimited (Enterprise)
  msgsIncluded      Int      @default(200)
  customersIncluded Int? // null = unlimited (Enterprise)
  featureFlags      String[] // subset of the 16 flag keys granted at this plan
  sortOrder         Int      @default(0)

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, planKey])
  @@index([planVersionId])
}

model AddonSku {
  id              String    @id @default(uuid())
  planVersionId   String
  sku             String // SEAT_EXTRA | BUYER_PORTAL | REGULATED_ITEMS | OCR_PACK_250 | FORECASTING | ROUTE_EXTRA | MSG_BUNDLE_500
  name            String
  monthlyPrice    Decimal   @db.Decimal(10, 2)
  unit            AddonUnit @default(FLAT)
  includedAtPlan  String? // planKey at/above which this addon is bundled free
  meteredKey      MeterKey? // capacity-adding: OCR_PACK→SCANS, MSG_BUNDLE→MSGS, SEAT_EXTRA→SEATS, ROUTE_EXTRA→ROUTES
  capacityPerUnit Int? // meter capacity added per active quantity
  stackable       Boolean   @default(false)
  grantsFlags     String[] // flag keys this addon grants while active
  sortOrder       Int       @default(0)

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, sku])
  @@index([planVersionId])
}

// ─── Per-tenant metering (tenant-scoped) ──────────────────────────────────────

model MeterUsage {
  id          String   @id @default(uuid())
  tenantId    String
  meter       MeterKey
  periodStart DateTime // billing-cycle bucket start
  periodEnd   DateTime
  used        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, meter, periodStart])
  @@index([tenantId, meter])
}

// ─── Billing audit / MRR source of truth (tenant-scoped) ──────────────────────

model BillingEvent {
  id          String   @id @default(uuid())
  tenantId    String
  type        String // plan.changed | addon.enabled/disabled | seat.added/freed | grace.started/expired | trial.converted/expired
  payload     Json
  amountDelta Decimal? @db.Decimal(10, 2) // MRR run-rate delta for reconciliation
  actorId     String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([type])
}

// ─── RouteFlow's own invoices to the tenant (platform billing) ────────────────

model RfInvoice {
  id       String       @id @default(uuid())
  tenantId String
  number   String       @unique // RF-YYYY-NNNN
  amount   Decimal      @db.Decimal(10, 2)
  status   String // PAID | OPEN | FAILED
  cycle    BillingCycle @default(MONTHLY)
  pdfKey   String?
  issuedAt DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, issuedAt])
}

model SystemConfig {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

// ─── Driver-to-Dispatcher Messaging ──────────────────────────────────────────

model Message {
  id         String   @id @default(uuid())
  runId      String?
  text       String
  senderId   String
  senderRole String // "DRIVER" | "OPERATOR"
  createdAt  DateTime @default(now())
  tenantId   String?

  // P6-1 (F0): additively generalize the run-chat Message into a channel-aware,
  // thread-attachable message. Existing driver run-chat rows keep threadId=NULL
  // and channel=INTERNAL (both defaulted), so the create/read paths are unchanged.
  threadId String?
  channel  MessageChannel @default(INTERNAL)

  sender User           @relation(fields: [senderId], references: [id])
  tenant Tenant?        @relation(fields: [tenantId], references: [id])
  thread MessageThread? @relation(fields: [threadId], references: [id])

  @@index([runId])
  @@index([senderId])
  @@index([tenantId])
  @@index([threadId])
}

// ─── P6-1 (F0): Unified messaging — threads, templates, rules, consent ────────
// Additive foundation for the P6 messaging phase. NOTHING here is wired to a
// provider yet (StubProvider + real adapters land in P6-3/P6-4); this is the
// schema substrate the engine/inbox/settings build on. All tenant-scoped.

enum MessageChannel {
  INTERNAL // driver ↔ operator run-chat (default; never metered, never STOP-gated)
  WHATSAPP // metered (MSGS), STOP-gated, consent-gated
  SMS // metered (MSGS), STOP-gated, consent-gated
  EMAIL // never metered
  PORTAL // buyer-portal chat; never metered
}

enum ThreadStatus {
  OPEN
  SNOOZED
  CLOSED
}

enum WaApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum TriageStatus {
  PENDING
  LINKED
  DISMISSED
}

// Catalogue of notification triggers the rules matrix + templates key off.
enum NotificationEvent {
  ORDER_CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  ORDER_CHANGED_AT_DOOR
  INVOICE_SENT // email/portal only; WA/SMS cells render disabled
  PAYMENT_REMINDER
  LICENSE_EXPIRING
  URGENT_ORDER_PLACED // internal alert
  LOW_STOCK // internal alert
  FAILED_DELIVERY // internal alert
  PAYMENT_FAILED_NSF // internal alert
}

// One conversation with a customer across all channels (the inbox row).
model MessageThread {
  id                 String          @id @default(uuid())
  tenantId           String?
  customerId         String?
  lastChannel        MessageChannel?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  unreadCount        Int             @default(0)
  status             ThreadStatus    @default(OPEN)
  snoozedUntil       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  messages Message[]

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, status])
}

// Per-event/-channel message body with {{var}} placeholders (+ Meta WA template ref).
model MessageTemplate {
  id               String            @id @default(uuid())
  tenantId         String?
  eventKey         NotificationEvent
  channel          MessageChannel
  body             String
  variables        String[]          @default([])
  waTemplateName   String?
  waApprovalStatus WaApprovalStatus  @default(NONE)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, eventKey, channel])
  @@index([tenantId])
}

// The Settings → Notifications matrix cell state (event × channel → on/off).
model NotificationRule {
  id        String            @id @default(uuid())
  tenantId  String?
  eventKey  NotificationEvent
  channel   MessageChannel
  enabled   Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, eventKey, channel])
  @@index([tenantId])
}

// STOP-reply / manual opt-out state for the metered, STOP-capable channels.
model MessageOptOut {
  id         String         @id @default(uuid())
  tenantId   String?
  customerId String?
  phone      String?
  channel    MessageChannel
  optedOutAt DateTime       @default(now())
  reason     String?
  source     String? // e.g. "STOP"

  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@unique([tenantId, customerId, channel])
  @@index([tenantId])
  @@index([tenantId, phone])
}

// Per-tenant messaging config singleton. Provider credentials (Meta WA / Twilio)
// are deferred to P6-3 (encrypted via EncryptionService when the adapters land).
model MessagingSettings {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  quietHoursEnabled Boolean  @default(true)
  quietHoursStart   String   @default("21:00")
  quietHoursEnd     String   @default("07:00")
  timezone          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// Inbound message from an unknown number → operator triage queue (link/dismiss).
model InboundTriage {
  id                 String         @id @default(uuid())
  tenantId           String?
  channel            MessageChannel
  fromNumber         String
  body               String
  providerMsgId      String?
  status             TriageStatus   @default(PENDING)
  resolvedCustomerId String?
  resolvedById       String?
  resolvedAt         DateTime?
  receivedAt         DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
}

// ─── Audit Logging ────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(uuid())
  tenantId       String?
  userId         String?
  // F01/B165: when a platform operator acts under impersonation, the acting
  // operator's user id — so the tenant-visible trail names who really wrote.
  // F14 wires the guard that stamps it.
  impersonatedBy String?
  action         String
  entityType     String
  entityId       String?
  ip             String?
  meta           Json?
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Migration & Batch Import (Phase 1: numbering continuity) ─────────────────

/// Per-tenant, per-document-type numbering sequence. Set during migration from
/// the source's last number ("last Zoho invoice INV-08841 → RouteFlow starts at
/// INV-08842"); editable later in Settings → Invoicing. `NumberingService` owns
/// the collision-guarded `reserveNext(docType)` that formats `prefix +
/// nextNumber.padStart(padding)`. Wiring that into LIVE document minting is a
/// deferred cross-module change (invoices/orders own those call sites); this
/// table + service is the contract they consume. Imported documents keep their
/// ORIGINAL numbers and do NOT consume this sequence. `tenantId` is a plain
/// scalar (tenant-scoped via `forTenant()`), no FK — keeps this an append-only
/// addition that never edits the shared Tenant model.
model NumberingSequence {
  id         String             @id @default(uuid())
  tenantId   String
  docType    DocumentNumberType
  prefix     String             @default("")
  nextNumber Int                @default(1)
  padding    Int                @default(4)
  // F01/B100: per-year series (INV-2026-0001 restarts each January). 0 = the
  // year-agnostic series, which is what every pre-existing row means — so the
  // default keeps them valid and the widened unique key cannot collide them.
  year       Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([tenantId, docType, year])
  @@index([tenantId])
}

enum DocumentNumberType {
  INVOICE
  ESTIMATE
  CREDIT_NOTE
  PAYMENT
  // F01/G6: the two remaining findFirst-max minters the register names get
  // routed through NumberingService by F16 — their series need a docType.
  RETURN
  ORDER
}

// ─── Migration & Batch Import (Phase 2: idempotency substrate) ────────────────

/// Generic external-source reference for migrated/imported records (spec §2). A
/// side table keyed by (source, externalId) so a re-run UPSERTS one local row and
/// never duplicates — WITHOUT adding columns to off-limits finance models
/// (Invoice/Payment/CreditNote/VendorBill). External value format: "zoho:inv_884412"
/// (stored split as externalSource="zoho", externalId="inv_884412"). Pointers are
/// plain scalars (no FK) so this stays an append-only addition.
model ImportExternalRef {
  id             String           @id @default(uuid())
  tenantId       String
  entityType     ImportEntityType
  entityId       String
  externalSource String
  externalId     String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([tenantId, externalSource, externalId, entityType])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, entityType])
}

enum ImportEntityType {
  CUSTOMER
  INVOICE
  PAYMENT
  PRODUCT
  SUPPLIER
  CREDIT_NOTE
  VENDOR_BILL
}

// ─── Migration & Batch Import (Phase 4: migration staging + jobs + 24h undo) ──

enum MigrationSource {
  ZOHO
  QUICKBOOKS
  CSV
  PAPER
}

enum MigrationJobStatus {
  FETCHING
  STAGED
  CONFIRMED
  UNDONE
  FAILED
}

enum StagingRecordStatus {
  PENDING // staged, awaiting confirm
  DUPLICATE // matched an existing record; skipped on confirm, linked
  COMMITTED // written live on confirm
  SKIPPED // committer not wired for this type yet, or user-skipped
  REVERSED // removed by a 24h undo
}

/// A migration run: fetch a source into a staging area, review, then confirm to
/// live with a 24h undo window (spec §3). NOTHING is live until CONFIRMED.
model MigrationJob {
  id           String             @id @default(uuid())
  tenantId     String
  source       MigrationSource
  status       MigrationJobStatus @default(FETCHING)
  scopeCounts  Json               @default("{}") // {customers, products, invoices, ...}
  createdById  String?
  confirmedAt  DateTime?
  undoDeadline DateTime? // confirmedAt + 24h
  undoneAt     DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  records MigrationStagingRecord[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

/// One staged record (not live) of a MigrationJob. Carries the raw source payload,
/// a dedup verdict, and — after confirm — the id of the live row it created (so a
/// 24h undo reverses exactly what it added, and re-runs upsert by external id).
model MigrationStagingRecord {
  id              String              @id @default(uuid())
  tenantId        String
  jobId           String
  entityType      ImportEntityType
  externalId      String?
  rawPayload      Json
  status          StagingRecordStatus @default(PENDING)
  flags           Json                @default("[]") // ["duplicate","unmatched-tax",...]
  matchedEntityId String? // existing row this duplicates (for linking)
  createdEntityId String? // live row created on confirm
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  job MigrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([tenantId, jobId])
  @@index([jobId, status])
}

// ─── Migration & Batch Import (Phase 5: batch invoice import queue) ───────────

enum ImportFileStatus {
  QUEUED
  PROCESSING
  CLEAN // all lines matched, no dup — auto-ready to post
  NEEDS_REVIEW // an unmatched line or low-confidence totals
  DUPLICATE // matched an existing bill/invoice — skipped, linked
  FAILED // extraction error; queue keeps the file
  POSTED
}

enum ImportBatchStatus {
  PROCESSING
  READY
  POSTED
  PARTIALLY_POSTED
}

/// A batch of scanned invoices/bills processed in the background (spec §4):
/// upload many, review later, "Finish: post N bills". Posting reuses the
/// vendor-bill receive path (stock + costing). meteredScans feeds the AI-scan
/// meter; the cap check integrates with billing (off-limits) as a follow-up.
model ImportBatch {
  id           String            @id @default(uuid())
  tenantId     String
  kind         String            @default("BATCH_BILLS")
  status       ImportBatchStatus @default(PROCESSING)
  totalFiles   Int               @default(0)
  cleanCount   Int               @default(0)
  reviewCount  Int               @default(0)
  dupeCount    Int               @default(0)
  postedCount  Int               @default(0)
  meteredScans Int               @default(0)
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  postedAt     DateTime?

  items ImportQueueItem[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

/// One file in a batch, with its per-file status + extracted payload. The
/// duplicate pointer is a denormalized scalar (indexed, no FK) so this never
/// edits the off-limits Invoice/VendorBill models.
model ImportQueueItem {
  id                   String           @id @default(uuid())
  tenantId             String
  batchId              String
  filename             String?
  mimeType             String?
  status               ImportFileStatus @default(QUEUED)
  extractedPayload     Json?
  supplierMatchId      String?
  supplierName         String?
  invoiceNumber        String?
  total                Decimal?         @db.Decimal(12, 2)
  duplicateOfInvoiceId String?
  confidence           Decimal?         @db.Decimal(5, 4)
  unmatchedLines       Int              @default(0)
  errorMessage         String?
  vendorBillId         String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([tenantId, batchId])
  @@index([batchId, status])
  @@index([duplicateOfInvoiceId])
}

// ─── Formerly runtime-provisioned tables ─────────────────────────────────────
// AiUsageEvent and IdempotencyKey are ORDINARY MIGRATED MODELS: both are created by
// `prisma/migrations/0_init/migration.sql` like every other table here, and nothing
// creates them at boot any more.
//
// History, so the shapes below are not "cleaned up" by mistake: they were once created
// at boot via raw `CREATE TABLE IF NOT EXISTS` (PlatformConfigService and RoutesService)
// so those features could ship without a migration. Declaring them here is what stopped
// Prisma from treating them as drift and emitting `DROP TABLE`. The database-side
// defaults below mirror that original DDL exactly, which is why `migrate diff` sees no
// change against a live database — keep them byte-for-byte unless a real migration
// changes them.

/// AI usage / metering log — written by PlatformConfigService.recordAiUsage.
model AiUsageEvent {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenantId     String?
  feature      String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  success      Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// Replay guard for order submission — written by RoutesService's idempotency
/// helpers, which read and write it with raw SQL and degrade silently if absent.
model IdempotencyKey {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  keyHash   String   @unique
  response  String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
}

enum CrmConnectionStatus {
  CONNECTED
  NEEDS_ATTENTION
  DISCONNECTED
}

enum CrmTriggerMode {
  STAGE
  WON
}

enum CrmHandoffStatus {
  PENDING
  CREATED
  LINKED
  WRITEBACK_PENDING
  NEEDS_REVIEW
  DRY_RUN
  SKIPPED
  FAILED
}

model CrmConnection {
  id                  String              @id @default(uuid())
  tenantId            String              @unique
  provider            String              @default("gohighlevel")
  locationId          String
  locationName        String?
  secretCipher        String?
  tokenLast4          String?
  status              CrmConnectionStatus @default(DISCONNECTED)
  enabled             Boolean             @default(false)
  dryRun              Boolean             @default(true)
  triggerMode         CrmTriggerMode      @default(STAGE)
  pipelineId          String?
  stageId             String?
  stageName           String?
  startFrom           DateTime            @default(now())
  writeBackFields     Boolean             @default(true)
  writeBackTag        Boolean             @default(true)
  writeBackNote       Boolean             @default(true)
  markWon             Boolean             @default(false)
  customFieldIds      Json?
  defaultRegion       String              @default("US")
  lastPollAt          DateTime?
  lastSuccessAt       DateTime?
  nextPollAt          DateTime?
  lastError           String?
  attentionNotifiedAt DateTime?
  connectedById       String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([enabled, status])
