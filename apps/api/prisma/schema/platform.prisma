// RouteFlow Prisma schema — domain file: platform (SaaS billing/plans, messaging, audit, import/migration, config, AI usage, numbering).
// Generated by apps/api/scripts/split-prisma-schema.mjs — run it with --check to prove the split is lossless.

// ─── Billing / plans-as-data (Phase: Plans & Billing) ─────────────────────────
// Plans are versioned reference data (PlanVersion → PlanDefinition + AddonSku);
// entitlement logic is driven off the string `planKey`, NOT the TenantPlan enum
// (kept as a legacy shadow). See docs/design-package/project/specs/pricing-plans.md.

enum PlanVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum MeterKey {
  SEATS
  ROUTES
  SCANS
  MSGS
  CUSTOMERS
}

enum AddonUnit {
  FLAT
  PER_USER
  PER_ROUTE
}

model TenantSubscription {
  id                    String       @id @default(uuid())
  tenantId              String       @unique
  stripeCustomerId      String?
  stripeSubId           String?
  currentPlan           TenantPlan   @default(STARTER)
  periodStart           DateTime?
  periodEnd             DateTime?
  cancelAtPeriodEnd     Boolean      @default(false)
  // Plans-as-data + lifecycle (Plans & Billing). All nullable/defaulted so
  // existing rows are untouched; `planKey`/`planVersionId` are the new source of truth.
  planVersionId         String?
  planKey               String? // STARTER | TEAM | BUSINESS | ENTERPRISE
  cycle                 BillingCycle @default(MONTHLY)
  basePriceSnapshot     Decimal?     @db.Decimal(10, 2)
  discount              Decimal      @default(0) @db.Decimal(10, 2)
  downgradeToPlanKey    String?
  downgradeEffectiveAt  DateTime?
  retainedUserIds       String[]
  graceStartedAt        DateTime?
  graceMeter            MeterKey?
  trialConvertedAt      DateTime?
  nextChargeAt          DateTime?
  failedPaymentCount    Int          @default(0)
  // External (non-Stripe) payment tracking
  externalPayment       Boolean      @default(false)
  externalPaymentMethod String? // ZELLE | BANK_TRANSFER | CHECK | CASH | WIRE | OTHER
  externalPaymentRef    String? // transaction ID or confirmation number
  externalPaymentNotes  String?
  // Platform billing — catalog-driven Stripe prices (Plans & Billing pricing batch).
  // Per-tenant custom fee overrides; null = fall back to the catalog (PlanDefinition).
  priceOverrideMonthly  Decimal?     @db.Decimal(10, 2)
  priceOverrideAnnual   Decimal?     @db.Decimal(10, 2)
  billingInterval       String? // "month" | "year", stamped at checkout completion
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planVersion PlanVersion? @relation(fields: [planVersionId], references: [id])

  @@index([planVersionId])
  @@index([downgradeEffectiveAt])
}

// N3 (2026-09-16): idempotency log for billing-lifecycle emails to the tenant admin
// (trial ending, downgrade scheduled/applied, upgrade confirmed, cancelled, suspended).
// `key` is a milestone-specific disambiguator (e.g. the scheduled downgrade's effective
// date) so a genuinely NEW occurrence of a repeatable milestone still sends, while a
// retry/re-run of the SAME occurrence is blocked by the unique constraint below — the
// create() call is the atomic claim (a caught unique-violation means "already sent").
model BillingNotificationLog {
  id        String   @id @default(uuid())
  tenantId  String
  milestone String
  key       String   @default("")
  sentAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, milestone, key])
  @@index([tenantId])
}

model TenantAddon {
  id            String   @id @default(uuid())
  tenantId      String
  addonKey      String // e.g. "ai_scanning", "advanced_routes", "api_access"
  // Plans-as-data bridge: canonical SKU code (SEAT_EXTRA, BUYER_PORTAL, …). The
  // legacy free-text `addonKey` stays authoritative for existing consumers
  // (e.g. "tobacco_dealer") and is mapped to `sku="REGULATED_ITEMS"` additively.
  sku           String?
  quantity      Int      @default(1) // SEAT_EXTRA per-user, OCR_PACK_250 stacks
  priceSnapshot Decimal? @db.Decimal(10, 2)
  stripePriceId String? // Stripe price for this add-on
  stripeItemId  String? // Stripe subscription item ID
  active        Boolean  @default(true)
  // SA-693: granted free ON PURPOSE by the platform. Never billed, never blocks a checkout, never
  // booked as revenue. Written only by the admin comp/uncomp paths; self-serve always writes false.
  isComp        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, addonKey])
  @@index([tenantId])
  @@index([tenantId, sku])
}

enum FeatureOverrideEffect {
  GRANT
  DENY
}

/// Feature grants v2 (design 2026-09-17 §2 PR-3): why an override exists, for MRR-truth
/// (only ADDON_SKU charges; every override kind here is a comp, never billed) and for the
/// console's "why" popover. DEFAULT 'COMP' for #795's existing rows and any caller that
/// doesn't set one explicitly.
enum FeatureOverrideKind {
  PILOT
  SUPPORT
  COMP
  TRIAL
  GRANDFATHER
}

/// Per-tenant, per-key entitlement override. When a non-revoked row exists for
/// (tenantId, featureKey) it decides the gate outright — GRANT allows, DENY denies —
/// regardless of plan/addon state or dark/enforced gate mode (FeatureOverrideService).
/// featureKey must name a row in FEATURE_REGISTRY (feature-registry.ts), validated at
/// write time. Partial unique index (raw SQL in the migration): one non-revoked row
/// per (tenantId, featureKey) — revoking closes it and a new row may be created.
model TenantFeatureOverride {
  id          String                @id @default(uuid())
  tenantId    String
  featureKey  String
  effect      FeatureOverrideEffect
  kind        FeatureOverrideKind   @default(COMP)
  reason      String
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime              @default(now())
  revokedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, featureKey])
  @@index([featureKey])
}

/// Feature grants v2 §2 "Explain trace": OVERRIDE_DENY/OVERRIDE_GRANT/ADDON_SKU/PRESET take
/// priority in that order over NONE; UNKNOWN is the resolver's own fail-open verdict on a DB
/// error, never a real source. Mirrors packages/types/api/features.ts's FEATURE_SOURCE_VALUES.
enum FeatureSource {
  OVERRIDE_DENY
  OVERRIDE_GRANT
  ADDON_SKU
  PRESET
  NONE
  UNKNOWN
}

/// Feature grants v2 §2 "Effective"/PR-0a: shadow-mode disagreement between the old
/// enforcement path and FeatureResolverService, one row per (tenantId, featureKey, before,
/// after) pair — a recurrence upserts count/lastSeenAt rather than inserting again. Explained
/// rows unblock `PUT entitlements.mode=live`; an unexplained row keeps it refused.
model FeatureResolverDiff {
  id          String        @id @default(uuid())
  tenantId    String
  featureKey  String
  before      Boolean
  after       Boolean
  source      FeatureSource
  firstSeenAt DateTime      @default(now())
  lastSeenAt  DateTime      @default(now())
  count       Int           @default(1)
  explainedAt DateTime?
  explanation String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey, before, after])
  @@index([tenantId])
  @@index([explainedAt])
}

/// Feature grants v2 §2 "Modes"/PR-4: per-tenant override of a `config`-bearing feature's mode
/// (e.g. routes_dispatch: scheduled|adhoc|mixed). `mode` is a plain string, not a Prisma enum —
/// different features have different mode vocabularies, validated against the registry at the
/// application level, not DB-constrained. Absence means `mode.source: REGISTRY_DEFAULT`.
model TenantFeatureConfig {
  id          String   @id @default(uuid())
  tenantId    String
  featureKey  String
  mode        String
  settings    Json?
  reason      String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@index([tenantId])
}

/// Why a TenantFeatureConfigSnapshot was taken. DOWNGRADE = automatic, in the same transaction as
/// a plan change to a lower rank; MANUAL = a platform admin archived the config on demand.
enum SnapshotReason {
  DOWNGRADE
  MANUAL
}

/// Entitlement config that survives downgrade -> re-upgrade (owner ruling 2026-09-18): the tenant's
/// full effective config (TenantFeatureConfig rows + active TenantFeatureOverride rows), archived as
/// ONE jsonb document at the state-changing event and rehydrated as-was on a same-or-higher plan.
/// A snapshot is data — never deleted by a sweep. `payload` is written and read only by
/// serializeTenantFeatureConfig / restore in tenant-config-snapshot.ts. `planKey` is the plan being LEFT.
model TenantFeatureConfigSnapshot {
  id                String         @id @default(uuid())
  tenantId          String
  planKey           String
  takenAt           DateTime       @default(now())
  reason            SnapshotReason
  payload           Json
  restoredAt        DateTime?
  restoredToPlanKey String?
  createdById       String?
  createdByName     String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, takenAt])
}

// ─── Billing plan catalog (GLOBAL reference data — not tenant-scoped) ─────────

model PlanVersion {
  id          String            @id @default(uuid())
  version     Int               @unique
  status      PlanVersionStatus @default(DRAFT)
  effectiveAt DateTime?
  publishedAt DateTime?
  publishedBy String?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  definitions   PlanDefinition[]
  addonSkus     AddonSku[]
  tenants       Tenant[]
  subscriptions TenantSubscription[]

  @@index([status])
}

model PlanDefinition {
  id                String   @id @default(uuid())
  planVersionId     String
  planKey           String // STARTER | TEAM | BUSINESS | ENTERPRISE
  name              String
  monthlyPrice      Decimal? @db.Decimal(10, 2) // null = custom (Enterprise)
  annualPrice       Decimal? @db.Decimal(10, 2) // = monthlyPrice * 10
  isCustom          Boolean  @default(false)
  seatsIncluded     Int? // null = unlimited
  routesConcurrent  Int? // null = unlimited
  scansIncluded     Int? // null = unlimited (Enterprise)
  msgsIncluded      Int      @default(200)
  customersIncluded Int? // null = unlimited (Enterprise)
  featureFlags      String[] // subset of the 16 flag keys granted at this plan
  sortOrder         Int      @default(0)

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, planKey])
  @@index([planVersionId])
}

model AddonSku {
  id              String    @id @default(uuid())
  planVersionId   String
  sku             String // SEAT_EXTRA | BUYER_PORTAL | REGULATED_ITEMS | OCR_PACK_250 | FORECASTING | ROUTE_EXTRA | MSG_BUNDLE_500
  name            String
  monthlyPrice    Decimal   @db.Decimal(10, 2)
  unit            AddonUnit @default(FLAT)
  includedAtPlan  String? // planKey at/above which this addon is bundled free
  meteredKey      MeterKey? // capacity-adding: OCR_PACK→SCANS, MSG_BUNDLE→MSGS, SEAT_EXTRA→SEATS, ROUTE_EXTRA→ROUTES
  capacityPerUnit Int? // meter capacity added per active quantity
  stackable       Boolean   @default(false)
  grantsFlags     String[] // flag keys this addon grants while active
  sortOrder       Int       @default(0)

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, sku])
  @@index([planVersionId])
}

// ─── Per-tenant metering (tenant-scoped) ──────────────────────────────────────

model MeterUsage {
  id          String   @id @default(uuid())
  tenantId    String
  meter       MeterKey
  periodStart DateTime // billing-cycle bucket start
  periodEnd   DateTime
  used        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, meter, periodStart])
  @@index([tenantId, meter])
}

// ─── Billing audit / MRR source of truth (tenant-scoped) ──────────────────────

model BillingEvent {
  id          String   @id @default(uuid())
  tenantId    String
  type        String // plan.changed | addon.enabled/disabled | seat.added/freed | grace.started/expired | trial.converted/expired
  payload     Json
  amountDelta Decimal? @db.Decimal(10, 2) // MRR run-rate delta for reconciliation
  actorId     String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([type])
}

// #2442: the platform billing webhook's event ledger — one row per Stripe event id, inserted BEFORE
// the event is handled (as StripeConnectEvent does for Connect). A redelivery collides on the id; it
// is skipped only when `outcome` shows the first delivery completed (non-null, not "error:…").
// Platform-level, not tenant-scoped: the tenant is resolved from the event inside the handler.
model StripeBillingEvent {
  id          String   @id
  type        String
  createdAt   DateTime
  processedAt DateTime @default(now())
  outcome     String?

  @@index([type, createdAt])
}

// ─── RouteFlow's own invoices to the tenant (platform billing) ────────────────

model RfInvoice {
  id       String       @id @default(uuid())
  tenantId String
  number   String       @unique // RF-YYYY-NNNN
  amount   Decimal      @db.Decimal(10, 2)
  status   String // PAID | OPEN | FAILED
  cycle    BillingCycle @default(MONTHLY)
  pdfKey   String?
  issuedAt DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, issuedAt])
}

model SystemConfig {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

/// SA-138 phase 1: which layer a tenant POLICY value applies to. Resolution order is
/// registry default → TENANT → CATEGORY → CUSTOMER (the most specific active row wins).
/// Mirrored by packages/types/api/enums.ts POLICY_SCOPE_TYPE_VALUES (enum-parity.spec.ts).
enum PolicyScopeType {
  TENANT
  CATEGORY
  CUSTOMER
}

/// SA-138 phase 1: a tenant's own policy value for one `apps/api/src/policy/policy-registry.ts`
/// key at one scope. APPEND-ONLY: a write supersedes the active row (`supersededAt`/`supersededById`)
/// and inserts the new one in one transaction under the `policy-write` advisory lock (key
/// `${tenantId}:${key}`), which is what keeps one active row per (tenant, key, scope) — Prisma
/// cannot express the partial unique index. Nothing is updated except the supersede stamps and
/// nothing is deleted. `scopeId` is a soft pointer (TrackedCategory / Customer id; null for TENANT).
model PolicyValue {
  id             String          @id @default(uuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key            String
  scopeType      PolicyScopeType
  scopeId        String?
  value          Json
  reason         String
  setById        String?
  setByName      String?
  createdAt      DateTime        @default(now())
  supersededAt   DateTime?
  supersededById String?

  @@index([tenantId, key, scopeType, scopeId, supersededAt])
  @@index([tenantId])
}

// ─── Driver-to-Dispatcher Messaging ──────────────────────────────────────────

model Message {
  id         String   @id @default(uuid())
  runId      String?
  text       String
  senderId   String
  senderRole String // "DRIVER" | "OPERATOR"
  createdAt  DateTime @default(now())
  tenantId   String?

  // P6-1 (F0): additively generalize the run-chat Message into a channel-aware,
  // thread-attachable message. Existing driver run-chat rows keep threadId=NULL
  // and channel=INTERNAL (both defaulted), so the create/read paths are unchanged.
  threadId String?
  channel  MessageChannel @default(INTERNAL)

  sender User           @relation(fields: [senderId], references: [id])
  tenant Tenant?        @relation(fields: [tenantId], references: [id])
  thread MessageThread? @relation(fields: [threadId], references: [id])

  @@index([runId])
  @@index([senderId])
  @@index([tenantId])
  @@index([threadId])
}

// ─── P6-1 (F0): Unified messaging — threads, templates, rules, consent ────────
// Additive foundation for the P6 messaging phase. NOTHING here is wired to a
// provider yet (StubProvider + real adapters land in P6-3/P6-4); this is the
// schema substrate the engine/inbox/settings build on. All tenant-scoped.

enum MessageChannel {
  INTERNAL // driver ↔ operator run-chat (default; never metered, never STOP-gated)
  WHATSAPP // metered (MSGS), STOP-gated, consent-gated
  SMS // metered (MSGS), STOP-gated, consent-gated
  EMAIL // never metered
  PORTAL // buyer-portal chat; never metered
}

enum ThreadStatus {
  OPEN
  SNOOZED
  CLOSED
}

enum WaApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum TriageStatus {
  PENDING
  LINKED
  DISMISSED
}

// Catalogue of notification triggers the rules matrix + templates key off.
enum NotificationEvent {
  ORDER_CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  // N1 (2026-09-16): buyer-facing order-status email/messaging events, added
  // alongside the real EMAIL channel provider — CONFIRMED/OUT_FOR_DELIVERY/
  // DELIVERED already existed; CANCELLED did not (only the older, separate
  // push-notification path in orders.service.ts's `notifMap` covered it).
  CANCELLED
  ORDER_CHANGED_AT_DOOR
  INVOICE_SENT // email/portal only; WA/SMS cells render disabled
  PAYMENT_REMINDER
  LICENSE_EXPIRING
  URGENT_ORDER_PLACED // internal alert
  LOW_STOCK // internal alert
  FAILED_DELIVERY // internal alert
  PAYMENT_FAILED_NSF // internal alert
  // Post-dated check payments PR-1 (additive-only): a later PR's check-lifecycle
  // transition wiring fires this on a CHECK bounce (bounceReason set). Distinct
  // from PAYMENT_FAILED_NSF (which stays as-is, unused by this PR either). No
  // firing site exists yet — messaging-config.service.ts's EVENT_CHANNELS/
  // DEFAULT_TEMPLATES gain an entry for exhaustiveness only (Record<NotificationEvent, ...>
  // requires one), and it is NOT added to DEFAULT_ON (default-on-is-wired.spec.ts
  // would fail otherwise).
  CHECK_RETURNED // internal alert
  // SA-603c (additive-only, appended at the END): salvage's staff/buyer order emails.
  // The schema bundle never USES these values; only app code after the commit does
  // (ADD VALUE cannot be used in its own transaction). Urgent orders will REUSE
  // STAFF_NEW_ORDER with a subject prefix; URGENT_ORDER_PLACED stays untouched.
  // messaging-config.service.ts gains exhaustiveness-only entries; NOT in DEFAULT_ON.
  STAFF_NEW_ORDER // internal alert
  BUYER_ORDER_EDITED // internal alert
  BUYER_ORDER_CANCELLED // internal alert
}

// One conversation with a customer across all channels (the inbox row).
model MessageThread {
  id                 String          @id @default(uuid())
  tenantId           String?
  customerId         String?
  lastChannel        MessageChannel?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  unreadCount        Int             @default(0)
  status             ThreadStatus    @default(OPEN)
  snoozedUntil       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  messages Message[]

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, status])
}

// Per-event/-channel message body with {{var}} placeholders (+ Meta WA template ref).
model MessageTemplate {
  id               String            @id @default(uuid())
  tenantId         String?
  eventKey         NotificationEvent
  channel          MessageChannel
  body             String
  variables        String[]          @default([])
  waTemplateName   String?
  waApprovalStatus WaApprovalStatus  @default(NONE)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, eventKey, channel])
  @@index([tenantId])
}

// The Settings → Notifications matrix cell state (event × channel → on/off).
model NotificationRule {
  id        String            @id @default(uuid())
  tenantId  String?
  eventKey  NotificationEvent
  channel   MessageChannel
  enabled   Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, eventKey, channel])
  @@index([tenantId])
}

// STOP-reply / manual opt-out state for the metered, STOP-capable channels.
model MessageOptOut {
  id         String         @id @default(uuid())
  tenantId   String?
  customerId String?
  phone      String?
  channel    MessageChannel
  optedOutAt DateTime       @default(now())
  reason     String?
  source     String? // e.g. "STOP"

  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@unique([tenantId, customerId, channel])
  @@index([tenantId])
  @@index([tenantId, phone])
}

// Per-tenant messaging config singleton. Provider credentials (Meta WA / Twilio)
// are deferred to P6-3 (encrypted via EncryptionService when the adapters land).
model MessagingSettings {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  quietHoursEnabled Boolean  @default(true)
  quietHoursStart   String   @default("21:00")
  quietHoursEnd     String   @default("07:00")
  timezone          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

