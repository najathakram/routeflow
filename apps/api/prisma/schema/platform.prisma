// ─── Audit Logging ────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(uuid())
  tenantId       String?
  userId         String?
  // F01/B165: when a platform operator acts under impersonation, the acting
  // operator's user id — so the tenant-visible trail names who really wrote.
  // F14 wires the guard that stamps it.
  impersonatedBy String?
  action         String
  entityType     String
  entityId       String?
  ip             String?
  meta           Json?
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Migration & Batch Import (Phase 1: numbering continuity) ─────────────────

/// Per-tenant, per-document-type numbering sequence. Set during migration from
/// the source's last number ("last Zoho invoice INV-08841 → RouteFlow starts at
/// INV-08842"); editable later in Settings → Invoicing. `NumberingService` owns
/// the collision-guarded `reserveNext(docType)` that formats `prefix +
/// nextNumber.padStart(padding)`. Wiring that into LIVE document minting is a
/// deferred cross-module change (invoices/orders own those call sites); this
/// table + service is the contract they consume. Imported documents keep their
/// ORIGINAL numbers and do NOT consume this sequence. `tenantId` is a plain
/// scalar (tenant-scoped via `forTenant()`), no FK — keeps this an append-only
/// addition that never edits the shared Tenant model.
model NumberingSequence {
  id         String             @id @default(uuid())
  tenantId   String
  docType    DocumentNumberType
  prefix     String             @default("")
  nextNumber Int                @default(1)
  padding    Int                @default(4)
  // F01/B100: per-year series (INV-2026-0001 restarts each January). 0 = the
  // year-agnostic series, which is what every pre-existing row means — so the
  // default keeps them valid and the widened unique key cannot collide them.
  year       Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([tenantId, docType, year])
  @@index([tenantId])
}

enum DocumentNumberType {
  INVOICE
  ESTIMATE
  CREDIT_NOTE
  PAYMENT
  // F01/G6: the two remaining findFirst-max minters the register names get
  // routed through NumberingService by F16 — their series need a docType.
  RETURN
  ORDER
}

// ─── Migration & Batch Import (Phase 2: idempotency substrate) ────────────────

/// Generic external-source reference for migrated/imported records (spec §2). A
/// side table keyed by (source, externalId) so a re-run UPSERTS one local row and
/// never duplicates — WITHOUT adding columns to off-limits finance models
/// (Invoice/Payment/CreditNote/VendorBill). External value format: "zoho:inv_884412"
/// (stored split as externalSource="zoho", externalId="inv_884412"). Pointers are
/// plain scalars (no FK) so this stays an append-only addition.
model ImportExternalRef {
  id             String           @id @default(uuid())
  tenantId       String
  entityType     ImportEntityType
  entityId       String
  externalSource String
  externalId     String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([tenantId, externalSource, externalId, entityType])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, entityType])
}

enum ImportEntityType {
  CUSTOMER
  INVOICE
  PAYMENT
  PRODUCT
  SUPPLIER
  CREDIT_NOTE
  VENDOR_BILL
}

// ─── Migration & Batch Import (Phase 4: migration staging + jobs + 24h undo) ──

enum MigrationSource {
  ZOHO
  QUICKBOOKS
  CSV
  PAPER
}

enum MigrationJobStatus {
  FETCHING
  STAGED
  CONFIRMED
  UNDONE
  FAILED
}

enum StagingRecordStatus {
  PENDING // staged, awaiting confirm
  DUPLICATE // matched an existing record; skipped on confirm, linked
  COMMITTED // written live on confirm
  SKIPPED // committer not wired for this type yet, or user-skipped
  REVERSED // removed by a 24h undo
}

/// A migration run: fetch a source into a staging area, review, then confirm to
/// live with a 24h undo window (spec §3). NOTHING is live until CONFIRMED.
model MigrationJob {
  id           String             @id @default(uuid())
  tenantId     String
  source       MigrationSource
  status       MigrationJobStatus @default(FETCHING)
  scopeCounts  Json               @default("{}") // {customers, products, invoices, ...}
  createdById  String?
  confirmedAt  DateTime?
  undoDeadline DateTime? // confirmedAt + 24h
  undoneAt     DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  records MigrationStagingRecord[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

/// One staged record (not live) of a MigrationJob. Carries the raw source payload,
/// a dedup verdict, and — after confirm — the id of the live row it created (so a
/// 24h undo reverses exactly what it added, and re-runs upsert by external id).
model MigrationStagingRecord {
  id              String              @id @default(uuid())
  tenantId        String
  jobId           String
  entityType      ImportEntityType
  externalId      String?
  rawPayload      Json
  status          StagingRecordStatus @default(PENDING)
  flags           Json                @default("[]") // ["duplicate","unmatched-tax",...]
  matchedEntityId String? // existing row this duplicates (for linking)
  createdEntityId String? // live row created on confirm
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  job MigrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([tenantId, jobId])
  @@index([jobId, status])
}

// ─── Migration & Batch Import (Phase 5: batch invoice import queue) ───────────

enum ImportFileStatus {
  QUEUED
  PROCESSING
  CLEAN // all lines matched, no dup — auto-ready to post
  NEEDS_REVIEW // an unmatched line or low-confidence totals
  DUPLICATE // matched an existing bill/invoice — skipped, linked
  FAILED // extraction error; queue keeps the file
  POSTED
}

enum ImportBatchStatus {
  PROCESSING
  READY
  POSTED
  PARTIALLY_POSTED
}

/// A batch of scanned invoices/bills processed in the background (spec §4):
/// upload many, review later, "Finish: post N bills". Posting reuses the
/// vendor-bill receive path (stock + costing). meteredScans feeds the AI-scan
/// meter; the cap check integrates with billing (off-limits) as a follow-up.
model ImportBatch {
  id           String            @id @default(uuid())
  tenantId     String
  kind         String            @default("BATCH_BILLS")
  status       ImportBatchStatus @default(PROCESSING)
  totalFiles   Int               @default(0)
  cleanCount   Int               @default(0)
  reviewCount  Int               @default(0)
  dupeCount    Int               @default(0)
  postedCount  Int               @default(0)
  meteredScans Int               @default(0)
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  postedAt     DateTime?

  items ImportQueueItem[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

/// One file in a batch, with its per-file status + extracted payload. The
/// duplicate pointer is a denormalized scalar (indexed, no FK) so this never
/// edits the off-limits Invoice/VendorBill models.
model ImportQueueItem {
  id                   String           @id @default(uuid())
  tenantId             String
  batchId              String
  filename             String?
  mimeType             String?
  status               ImportFileStatus @default(QUEUED)
  extractedPayload     Json?
  supplierMatchId      String?
  supplierName         String?
  invoiceNumber        String?
  total                Decimal?         @db.Decimal(12, 2)
  duplicateOfInvoiceId String?
  confidence           Decimal?         @db.Decimal(5, 4)
  unmatchedLines       Int              @default(0)
  errorMessage         String?
  vendorBillId         String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([tenantId, batchId])
  @@index([batchId, status])
  @@index([duplicateOfInvoiceId])
}

// ─── Formerly runtime-provisioned tables ─────────────────────────────────────
// AiUsageEvent and IdempotencyKey are ORDINARY MIGRATED MODELS: both are created by
// `prisma/migrations/0_init/migration.sql` like every other table here, and nothing
// creates them at boot any more.
//
// History, so the shapes below are not "cleaned up" by mistake: they were once created
// at boot via raw `CREATE TABLE IF NOT EXISTS` (PlatformConfigService and RoutesService)
// so those features could ship without a migration. Declaring them here is what stopped
// Prisma from treating them as drift and emitting `DROP TABLE`. The database-side
// defaults below mirror that original DDL exactly, which is why `migrate diff` sees no
// change against a live database — keep them byte-for-byte unless a real migration
// changes them.

/// AI usage / metering log — written by PlatformConfigService.recordAiUsage.
model AiUsageEvent {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenantId     String?
  feature      String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  success      Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// Replay guard for order submission — written by RoutesService's idempotency
/// helpers, which read and write it with raw SQL and degrade silently if absent.
model IdempotencyKey {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  keyHash   String   @unique
  response  String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
}

enum CrmConnectionStatus {
  CONNECTED
  NEEDS_ATTENTION
  DISCONNECTED
}

enum CrmTriggerMode {
  STAGE
  WON
}

enum CrmHandoffStatus {
  PENDING
  CREATED
  LINKED
  WRITEBACK_PENDING
  NEEDS_REVIEW
  DRY_RUN
  SKIPPED
  FAILED
}

model CrmConnection {
  id                  String              @id @default(uuid())
  tenantId            String              @unique
  provider            String              @default("gohighlevel")
  locationId          String
  locationName        String?
  secretCipher        String?
  tokenLast4          String?
  status              CrmConnectionStatus @default(DISCONNECTED)
  enabled             Boolean             @default(false)
  dryRun              Boolean             @default(true)
  triggerMode         CrmTriggerMode      @default(STAGE)
  pipelineId          String?
  stageId             String?
  stageName           String?
  startFrom           DateTime            @default(now())
  writeBackFields     Boolean             @default(true)
  writeBackTag        Boolean             @default(true)
  writeBackNote       Boolean             @default(true)
  markWon             Boolean             @default(false)
  customFieldIds      Json?
  defaultRegion       String              @default("US")
  lastPollAt          DateTime?
  lastSuccessAt       DateTime?
  nextPollAt          DateTime?
  lastError           String?
  attentionNotifiedAt DateTime?
  connectedById       String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([enabled, status])
}

model CrmHandoff {
  id              String           @id @default(uuid())
  tenantId        String
  provider        String           @default("gohighlevel")
  opportunityId   String
  contactId       String
  opportunityName String?
  contactName     String?
  status          CrmHandoffStatus @default(PENDING)
  customerId      String?
  matchedBy       String?
  reason          String?
  payload         Json?
  attempts        Int              @default(0)
  nextAttemptAt   DateTime?
  noteWritten     Boolean          @default(false)
  createdAt       DateTime         @default(now())
  processedAt     DateTime?

  @@unique([tenantId, provider, opportunityId])
  @@index([tenantId, status, createdAt])
}

// ─── Connected mailbox (email-connect-google, PR-2/PR-3) ──────────────────────
// A tenant-owned Google or Microsoft mailbox used to SEND tenant-branded mail
// (Gmail API users.messages.send scope gmail.send / Graph me.sendMail scope
// Mail.Send — never a read scope). One connection per tenant, either provider
// (reconnect replaces it, including switching provider); the platform-level row
// (ownerKey="platform", PR-5) is not built yet — this PR is tenant-only, mirrors
// `CrmConnection`'s `tenantId @unique` shape rather than the design's ownerKey
// scheme, since there is no second owner kind to disambiguate here yet.

enum MailboxProvider {
  GOOGLE
  MICROSOFT
}

enum MailboxConnectionStatus {
  CONNECTED
  REVOKED
  THROTTLED
}

model MailboxConnection {
  id                   String                  @id @default(uuid())
  tenantId             String                  @unique
  provider             MailboxProvider         @default(GOOGLE)
  accountEmail         String
  /// Google `sub` (id-token subject) — identifies the connected Google account,
  /// independent of `accountEmail` (which can theoretically change upstream).
  externalSubject      String
  scopesGranted        String[]
  /// EncryptionService AES-256-GCM ciphertext (IV_HEX:TAG_HEX:CIPHERTEXT_B64).
  /// Decrypted ONLY by MailboxSendService's single decrypt helper, at send/refresh
  /// time — never logged, never serialized in a DTO/response.
  refreshTokenCipher   String
  accessTokenCipher    String?
  accessTokenExpiresAt DateTime?
  status               MailboxConnectionStatus @default(CONNECTED)
  throttledUntil       DateTime?
  lastError            String?
  lastErrorAt          DateTime?
  lastSentAt           DateTime?
  /// #2113 (SA-528) — durable admin alert. Set in the SAME transaction as an automatic
  /// REVOKED/THROTTLED transition that warrants an alert; null = nothing owed. A deliverer claims
  /// it by CAS (value → a lease ≥ 3× the sweep cadence ahead), delivers, then clears it by CAS on
  /// the lease. A value <= now is due: a fresh transition, or a lease whose deliverer died.
  alertPendingAt       DateTime?
  connectedByUserId    String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ─── Marketing demo bookings (NOT tenant-scoped — prospects, not customers) ───
// A visitor on the public marketing site books a product walkthrough against the
// admin@routeflow.info Google Calendar. These rows are the RouteFlow-side record
// of that booking: Google owns the event, we own the lead. No `tenantId` — the
// person booking does not have a workspace yet, which is the whole point.

enum DemoBookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

/// RACE GUARD: migration `20260916031500_demo_booking_race_guard` adds a
/// PARTIAL unique index — `CREATE UNIQUE INDEX ... ON "DemoBooking"("startsAt")
/// WHERE status = 'CONFIRMED'` — that Prisma's schema language cannot express
/// (no `WHERE` on `@@index`/`@@unique`), so it exists ONLY in that migration
/// file; `prisma migrate dev` will not see it as drift because nothing here
/// declares a conflicting full unique constraint on `startsAt`. Application
/// code also serializes create/reschedule through a `demo-booking` advisory
/// lock (`common/db-locks.ts`) keyed on the slot's start instant — the index
/// is the second, database-level line of defence for the same invariant.
model DemoBooking {
  id      String  @id @default(uuid())
  name    String
  email   String
  company String
  phone   String?
  notes   String?

  /// Slot boundaries, always stored in UTC. `timeZone` is the IANA zone the
  /// visitor booked in — kept so confirmation emails and the manage page can
  /// echo the time back in the zone they actually chose.
  startsAt DateTime
  endsAt   DateTime
  timeZone String

  status       DemoBookingStatus @default(CONFIRMED)
  cancelledAt  DateTime?
  cancelReason String?

  /// The Google Calendar event this row mirrors, and its generated Meet link.
  /// Null when the calendar write failed — the lead is still captured.
  googleEventId String?
  meetUrl       String?

  /// SHA-256 of the signed manage token handed out in the confirmation email.
  /// The raw token is never stored, so a database read cannot cancel a booking.
  manageTokenHash String @unique

  /// Set when this booking replaced an earlier slot, for support context.
  rescheduledFrom DateTime?
  rescheduleCount Int       @default(0)

  sourcePage String?
  createdIp  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  onboardingCase OnboardingCase?

  @@index([startsAt, status])
  @@index([email, createdAt])
}

// ─── Wholesaler onboarding (#2159 S1 — NOT tenant-scoped) ─────────────────────
// One OnboardingCase per wholesaler we are bringing live, from the demo follow-up
// to LIVE. Platform-level (super-admin only): a case exists before its workspace
// does, so `tenantId` is null until Activate. Steps are COPIED from the code
// catalog (`src/onboarding/onboarding-catalog.ts`) when the case is created and
// stamped with `catalogVersion`, so a later catalog change never rewrites an
// in-flight case. Read and written through the BASE Prisma client only — the
// tenant extension (`forTenant()`) would inject a `tenantId` filter.

enum OnboardingStage {
  FOLLOW_UP
  AGREE
  ACTIVATE
  COLLECT
  CONFIGURE
  VERIFY_TRAIN
  GO_LIVE
  HYPERCARE
}

enum OnboardingCaseStatus {
  OPEN
  ON_HOLD
  LIVE
  LOST
}

enum OnboardingStepStatus {
  PENDING
  DONE
  WAIVED
}

enum OnboardingActorType {
  ADMIN
  CUSTOMER
  SYSTEM
}

model OnboardingCase {
  id String @id @default(uuid())

  /// Set at Activate (S3a); unique — one case per workspace.
  tenantId      String?      @unique
  tenant        Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  /// The demo booking this case was opened from, if any.
  demoBookingId String?      @unique
  demoBooking   DemoBooking? @relation(fields: [demoBookingId], references: [id], onDelete: SetNull)

  companyName  String
  contactName  String
  contactEmail String
  contactPhone String?

  stage          OnboardingStage      @default(FOLLOW_UP)
  status         OnboardingCaseStatus @default(OPEN)
  /// The step catalog version this case's rows were materialised from.
  catalogVersion Int
  /// Super-admin user id owning the case (no FK: platform admins are Users of
  /// the house tenant, and the case must outlive a deleted admin).
  ownerAdminId   String?
  targetGoLiveOn DateTime?            @db.Date
  cutoverAt      DateTime?

  fitNotes  Json?
  /// { planKey?, addonSkus?, interval?, setupFeeCents?, note? } — S3b reads setupFeeCents.
  dealTerms Json  @default("{}")

  lostReason  String?
  closedAt    DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  steps       OnboardingStep[]
  events      OnboardingEvent[]
  sections    IntakeSection[]
  files       IntakeFile[]
  tokens      IntakeAccessToken[]
  acceptances OrderAcceptance[]

  @@index([stage, status])
  @@index([ownerAdminId])
}

model OnboardingStep {
  id     String         @id @default(uuid())
  caseId String
  case   OnboardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  /// Catalog key, copied at materialisation together with the fields below, so the
  /// case keeps the rules it was created under.
  key       String
  stage     OnboardingStage
  title     String
  required  Boolean
  autoCheck String?

  status     OnboardingStepStatus @default(PENDING)
  /// { ok, detail, checkedAt } from the latest auto-check run.
  autoResult Json?
  evidence   Json?

  doneById     String?
  doneAt       DateTime?
  waivedReason String?
  waivedById   String?
  waivedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([caseId, key])
  @@index([caseId, stage])
}

/// Append-only activity feed for a case.
model OnboardingEvent {
  id        String              @id @default(uuid())
  caseId    String
  case      OnboardingCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type      String
  actorType OnboardingActorType
  actorId   String?
  payload   Json?
  createdAt DateTime            @default(now())

  @@index([caseId, createdAt])
}

// ─── Wholesaler onboarding intake (#2159 S2) ──────────────────────────────────
// The secure intake link: the wholesaler fills the questionnaire (playbook Appendix A,
// sections B–H → the seven IntakeSectionKeys), uploads their data files, and click-accepts
// the order summary. Platform-level like OnboardingCase; the link's token is the only
// credential and only its SHA-256 is stored.

enum IntakeSectionKey {
  ACCOUNT
  TAX_COMPLIANCE
  INVOICING
  TEAM
  OPERATIONS
  DATA_FILES
  GO_LIVE_PREFS
}

enum IntakeSectionStatus {
  EMPTY
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  APPLIED
  WAIVED
}

model IntakeSection {
  id            String              @id @default(uuid())
  caseId        String
  case          OnboardingCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  key           IntakeSectionKey
  /// The answers schema version the DTOs validated (bump when a section's fields change).
  schemaVersion Int
  status        IntakeSectionStatus @default(EMPTY)
  answers       Json                @default("{}")
  submittedAt   DateTime?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  /// S3a — set when an approved section is applied to the workspace.
  appliedAt     DateTime?
  appliedDiff   Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([caseId, key])
}

/// A file the wholesaler (or an admin) uploaded for the case. Read only through signed URLs.
model IntakeFile {
  id           String           @id @default(uuid())
  caseId       String
  case         OnboardingCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sectionKey   IntakeSectionKey
  /// products · customers · suppliers · stock · ar_aging · open_docs · tax_cert · licence · logo · other
  kind         String
  /// onboarding/<caseId>/<uuid>-<safeName>
  storageKey   String           @unique
  originalName String
  contentType  String
  sizeBytes    Int
  sha256       String
  containsPii  Boolean
  /// "customer" or the uploading admin's user id.
  uploadedBy   String
  /// S5 purges raw files 30 days after LIVE; the row stays as the record.
  purgedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())

  @@index([caseId, sectionKey])
}

/// One ACTIVE token per case (issuing revokes the prior one). Only the SHA-256 is stored.
model IntakeAccessToken {
  id          String         @id @default(uuid())
  caseId      String
  case        OnboardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  tokenHash   String         @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdById String
  createdAt   DateTime       @default(now())

  @@index([caseId])
}

/// APPEND-ONLY click-acceptance of the order summary + Terms/Privacy. The snapshot is computed
/// server-side at acceptance time and frozen: a re-quote means a new acceptance, which sets
/// `supersededAt` on the prior row. Migration 20260927070000 adds a trigger that refuses any
/// UPDATE except setting `supersededAt` once (Prisma cannot model triggers).
model OrderAcceptance {
  id             String         @id @default(uuid())
  caseId         String
  case           OnboardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  tenantId       String?
  orderSnapshot  Json
  termsVersion   String
  privacyVersion String
  acceptedName   String
  acceptedEmail  String
  acceptedAt     DateTime       @default(now())
  ip             String?
  userAgent      String?
  tokenId        String
  supersededAt   DateTime?

  @@index([caseId, acceptedAt])
}

enum EmailDeliveryStatus {
  QUEUED
  SENT
  FAILED
  BOUNCED
  // WOULD_SEND = dark-week record (nothing sent), OPTED_OUT = recipient opted out.
  WOULD_SEND
  OPTED_OUT
}

/// One outbound transactional email attempt (SA-603). PII minimal: NO subject/body columns, the
/// content is re-derivable from `kind` + `entityType`/`entityId`. Retention 90 days (purge in app).
model EmailDelivery {
  id                String              @id @default(uuid())
  tenantId          String
  // An app allow-list of template keys, no enum churn.
  kind              String
  toAddress         String
  entityType        String?
  entityId          String?
  status            EmailDeliveryStatus @default(QUEUED)
  providerMessageId String?
  // Provider text, truncated to 500 in the app.
  error             String?
  attempts          Int                 @default(0)
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  // SHA-256 of the rendered subject+body computed in the app, stored as a hash never the content; no index yet.
  contentFingerprint String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([providerMessageId])
}
