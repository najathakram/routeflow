// RouteFlow Prisma schema — domain file: finance (AR/AP — transactions, invoices, credit notes, vendor bills, estimates, expenses, payments).
// Generated by apps/api/scripts/split-prisma-schema.mjs — run it with --check to prove the split is lossless.

enum TxnStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  CHECK
  ACH
  OTHER
  CREDIT_NOTE
  ADVANCE
  CREDIT_CARD
  ZELLE
}

// PENDING (post-dated check payments PR-1, additive-only): a CHECK payment
// recorded and held but not yet clearable/bankable — neither a draft awaiting
// operator confirmation (DRAFT) nor confirmed-and-collectable (PAID). No
// read/write path sets or interprets this value yet (that wiring is a later
// PR in the design's §3.4 table); this PR only adds the value and the shared
// HELD_STATUSES/isHeldPayment/sumHeld helpers in @routeflow/pricing.
enum PaymentStatus {
  DRAFT
  PAID
  VOID
  PENDING
}

// P5-12: lifecycle of a CHECK InvoicePayment. Always null on non-check payments.
enum CheckStatus {
  RECORDED
  DEPOSITED
  CLEARED
  BOUNCED
}

// Post-dated check payments PR-1 (additive-only, schema + shared helpers): why a
// CHECK bounced. Only ever set via a later PR's transition wiring; unused by any
// read/write path in this PR.
enum CheckReturnReason {
  NSF
  ACCOUNT_CLOSED
  STOP_PAYMENT
  OTHER
}

// ─── New Enums (Zoho-parity) ──────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIAL
  PAID
  OVERDUE
  VOID
  WRITTEN_OFF
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  CONVERTED
}

enum CreditNoteStatus {
  ISSUED
  APPLIED
  VOID
}

enum VendorBillStatus {
  DRAFT
  RECEIVED
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum InvoiceScanStatus {
  SCANNED // extracted, not yet turned into a bill (an abandoned review stops here)
  POSTED // became `vendorBillId`
  DISCARDED // operator threw it away on purpose
  DUPLICATE // repeats `duplicateOfId`; never posted
}

enum SupplierStatementScanStatus {
  SCANNED
  APPLIED
  DISCARDED
}

model Transaction {
  id         String    @id @default(uuid())
  customerId String
  orderId    String?   @unique
  status     TxnStatus @default(UNPAID)
  totalOwed  Decimal   @db.Decimal(10, 2)
  totalPaid  Decimal   @default(0) @db.Decimal(10, 2)
  dueDate    DateTime?
  paidAt     DateTime?
  notes      String?
  pdfUrl     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenantId   String?

  customer Customer          @relation(fields: [customerId], references: [id])
  tenant   Tenant?           @relation(fields: [tenantId], references: [id])
  order    Order?            @relation(fields: [orderId], references: [id])
  items    TransactionItem[]
  payments Payment[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([tenantId])
}

model TransactionItem {
  id            String   @id @default(uuid())
  transactionId String
  orderItemId   String?
  description   String
  qty           Decimal  @db.Decimal(10, 3)
  unitPrice     Decimal  @db.Decimal(10, 2)
  subtotal      Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenantId      String?

  transaction Transaction @relation(fields: [transactionId], references: [id])
  tenant      Tenant?     @relation(fields: [tenantId], references: [id])
  orderItem   OrderItem?  @relation(fields: [orderItemId], references: [id])

  @@index([transactionId])
  @@index([orderItemId])
  @@index([tenantId])
}

model Payment {
  id            String        @id @default(uuid())
  transactionId String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)
  reference     String?
  notes         String?
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenantId      String?

  transaction Transaction @relation(fields: [transactionId], references: [id])
  tenant      Tenant?     @relation(fields: [tenantId], references: [id])

  @@index([transactionId])
  @@index([method])
  @@index([paidAt])
  @@index([tenantId])
}

// ─── Standalone invoicing ──────────────────────────────────────────

model Invoice {
  id                     String        @id @default(uuid())
  invoiceNumber          String
  customerId             String
  status                 InvoiceStatus @default(DRAFT)
  subtotal               Decimal       @db.Decimal(10, 2)
  taxAmount              Decimal       @default(0) @db.Decimal(10, 2)
  discount               Decimal       @default(0) @db.Decimal(10, 2)
  shippingFee            Decimal       @default(0) @db.Decimal(10, 2)
  total                  Decimal       @db.Decimal(10, 2)
  dueDate                DateTime?
  sentAt                 DateTime?
  viewedAt               DateTime?
  paidAt                 DateTime?
  notes                  String?
  internalNotes          String?
  referenceNumber        String?
  subject                String?
  terms                  String?
  // Structured "Net 30"-style label that must always agree with `dueDate` — every
  // code path that derives dueDate from a terms string persists that SAME string
  // here. Distinct from `terms` above, which is the long-form Terms & Conditions
  // text; conflating the two was the documented historical bug
  // (invoices/new/page.tsx ~L995).
  paymentTermsLabel      String?
  // Deliberately minimal deposit schedule (Tier 1): the deposit AMOUNT is always
  // derived from depositPercent * total at read time (see InvoicesService), never
  // stored. No InvoiceInstallment table / deposit-aware statuses in this phase.
  depositPercent         Decimal?      @db.Decimal(5, 2)
  depositDueDate         DateTime?
  issueDate              DateTime      @default(now())
  pdfUrl                 String?
  // Carrier shipment tracking — copied from the linked order on invoice generation,
  // and editable on the invoice itself. Carrier is a label (UPS/FedEx/USPS/DHL/Other);
  // the clickable tracking URL is derived from carrier + number, never stored.
  shippingCarrier        String?
  shippingTrackingNumber String?
  shippedAt              DateTime?
  writeOffReason         String?
  writtenOffAt           DateTime?
  orderId                String?
  deliveryBatchId        String?
  recurringInvoiceId     String?
  // Phase 4: links the sibling invoices produced when a mixed order is split by
  // regulated category (INV-1919 / INV-1919-R1 …). Null for un-split invoices.
  invoiceGroupId         String?
  // Post-dated check payments PR-1 (additive-only): set when this invoice IS an
  // NSF-fee invoice generated FOR a bounced InvoicePayment (a later PR's
  // transition wiring creates these). Plain id string, no FK relation — mirrors
  // InvoicePayment.nsfFeeInvoiceId's own no-FK rationale. Null on every
  // ordinary invoice.
  feeForPaymentId        String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  tenantId               String?

  customer           Customer              @relation(fields: [customerId], references: [id])
  tenant             Tenant?               @relation(fields: [tenantId], references: [id])
  order              Order?                @relation(fields: [orderId], references: [id])
  deliveryBatch      DeliveryBatch?        @relation(fields: [deliveryBatchId], references: [id])
  items              InvoiceItem[]
  payments           InvoicePayment[]
  creditNotes        CreditNote[]
  recurringInvoice   RecurringInvoice?     @relation(fields: [recurringInvoiceId], references: [id])
  paymentRequests    BuyerPaymentRequest[]
  commissionAccruals CommissionAccrual[]
  // F01/B17+B70: back-relation of Estimate.invoiceId (the converted-from estimate).
  estimate           Estimate?             @relation("EstimateInvoice")

  @@unique([tenantId, invoiceNumber])
  @@index([customerId])
  @@index([orderId])
  @@index([deliveryBatchId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
  @@index([tenantId])
  @@index([invoiceGroupId])
  // issueDate is the canonical analytics date (revenue trend, gross margin, AOV,
  // sales-by-item, tobacco monthly, per-product demand) but was unindexed — every one
  // of those filtered tenantId + issueDate on a heap scan. Mirrors RfInvoice's
  // @@index([tenantId, issuedAt]).
  @@index([tenantId, issueDate])
}

model InvoiceItem {
  id                   String    @id @default(uuid())
  invoiceId            String
  description          String
  productId            String?
  qty                  Decimal   @db.Decimal(10, 3)
  unitPrice            Decimal   @db.Decimal(10, 2)
  discount             Decimal   @default(0) @db.Decimal(10, 2)
  originalPrice        Decimal?  @db.Decimal(10, 2)
  // MSRP snapshot taken at line-creation time (customer override, else product default —
  // see common/msrp.ts resolveMsrp). Display-only, never money math. An issued invoice
  // must never change when the product's MSRP is later edited, so this is never re-read
  // from the live product at render time. Null when unset or flag.msrp is off.
  msrp                 Decimal?  @db.Decimal(10, 2)
  priceType            PriceType @default(STANDARD)
  taxRate              Decimal   @default(0) @db.Decimal(5, 4)
  subtotal             Decimal   @db.Decimal(10, 2)
  boxes                Int?
  pieces               Int?
  // Sale-time snapshot of the product's box size, carried from the order line.
  // Any recompute of this invoice line (edit form, PDF) must use THIS value, not
  // the live product. Null for lines created before the snapshot shipped.
  unitsPerBox          Int?
  // BUY_N_GET_M snapshot carried from OrderItem.promoFreeUnits: whole free
  // SELLING units billed on this line (boxes for a boxed line; loose pieces never
  // count). Prorated the same telescoping way as `subtotal` on a partial bill. The
  // DRAFT edit path delete-and-recreates every line, so this MUST round-trip —
  // without it a $350 (12 boxes, 2 free) line silently re-prices to $420 on save.
  // Feeds computeLineSubtotal's freeUnits param; null for every non-BOGO line.
  promoFreeUnits       Int?
  // Per-line note carried verbatim from OrderItem.notes (or entered on a manual
  // invoice line). Buyer-visible: renders under the description on the invoice
  // detail and the PDF.
  notes                String?
  // Provenance: the OrderItem this invoice line was billed from (null for manual
  // / freeform lines). Enables exact partial-billing bookkeeping and precise
  // invoicedQty release on void. SetNull so an order-line hard-delete (order edit
  // replaces line items) never blocks on this FK.
  orderItemId          String?
  // Phase 4: regulated-category snapshot carried from the order line onto the
  // (possibly split) invoice; `categoryTaxAmount` is this line's category tax.
  trackedCategoryId    String?
  trackedSubcategoryId String?
  categoryTaxAmount    Decimal   @default(0) @db.Decimal(10, 2)
  // Units/PO minimal (2026-09-19): the line's own unit name, carried verbatim
  // from OrderItem.unitLabel on invoice-from-order copy. Null = today's
  // behaviour byte-for-byte.
  unitLabel            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  tenantId             String?

  invoice            Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant             Tenant?             @relation(fields: [tenantId], references: [id])
  product            Product?            @relation(fields: [productId], references: [id])
  orderItem          OrderItem?          @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  trackedCategory    TrackedCategory?    @relation(fields: [trackedCategoryId], references: [id], onDelete: SetNull)
  trackedSubcategory TrackedSubcategory? @relation(fields: [trackedSubcategoryId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
  @@index([orderItemId])
  @@index([tenantId])
  @@index([trackedCategoryId])
  @@index([trackedSubcategoryId])
}

model InvoicePayment {
  id               String        @id @default(uuid())
  invoiceId        String
  amount           Decimal       @db.Decimal(10, 2)
  method           PaymentMethod
  reference        String?
  notes            String?
  paidAt           DateTime      @default(now())
  // When the money actually LANDED in the bank, as opposed to `paidAt` (when the
  // payment instrument was received/recorded). A post-dated check is paidAt=today,
  // settledAt=the clearing date — so this MAY legitimately be in the future.
  // Cash-basis reporting uses `settledAt ?? paidAt`; null on every legacy row, so
  // those keep reporting on paidAt unchanged. Distinct from `clearedAt` below,
  // which is a server-stamped audit mark of the CHECK-lifecycle transition.
  settledAt        DateTime?
  createdAt        DateTime      @default(now())
  creditNoteId     String?
  advancePaymentId String?
  paymentNumber    String?       @unique
  bankCharges      Decimal?      @db.Decimal(10, 2)
  status           PaymentStatus @default(PAID)
  paymentGroupId   String?
  tenantId         String?

  // P5-12 check lifecycle — only ever set when method = CHECK. BOUNCED (NSF)
  // also flips `status` to VOID so every existing non-VOID paid-sum /
  // status:PAID aggregation excludes the bounced check automatically.
  checkStatus  CheckStatus?
  depositedAt  DateTime?
  clearedAt    DateTime?
  bouncedAt    DateTime?
  nsfFeeAmount Decimal?     @db.Decimal(10, 2)

  // Payment image (receipt / slip / check photo). One image per payment EVENT:
  // grouped standalone rows share one object keyed by paymentGroupId, so these
  // three columns are identical across a group.
  imageKey          String?
  imageOriginalName String?
  imageMimeType     String?

  // Post-dated check payments PR-1 (additive-only; a later PR wires reads/writes
  // — see design §3.4/§10). checkNumber/bankName/checkDate describe the check
  // instrument itself; checkDate is the date PRINTED on the check (distinct
  // from paidAt/settledAt above). appliedAt is set at a later PR's transition
  // — null means "applied on receipt" (today's implicit behavior for every
  // existing row). bounceReason is only ever set alongside checkStatus =
  // BOUNCED. replacesPaymentId/nsfFeeInvoiceId are plain id strings (no FK
  // relation) so a bounced-check replacement/fee-invoice chain never blocks
  // on referential integrity before the row it points at exists.
  checkNumber       String?
  bankName          String?
  checkDate         DateTime?          @db.Date
  appliedAt         DateTime?
  bounceReason      CheckReturnReason?
  replacesPaymentId String?
  nsfFeeInvoiceId   String?

  invoice        Invoice         @relation(fields: [invoiceId], references: [id])
  tenant         Tenant?         @relation(fields: [tenantId], references: [id])
  creditNote     CreditNote?     @relation(fields: [creditNoteId], references: [id])
  advancePayment AdvancePayment? @relation(fields: [advancePaymentId], references: [id])

  @@index([invoiceId])
  @@index([paymentGroupId])
  @@index([status])
  @@index([tenantId])
  @@index([tenantId, settledAt])
  @@index([tenantId, checkDate])
  @@index([tenantId, checkStatus])
}

model PaymentCounter {
  id       String  @id @default("singleton")
  next     Int     @default(1)
  tenantId String?

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// ─── Expense tracking ───────────────────────────────────────────────

model ExpenseCategory {
  id       String  @id @default(uuid())
  name     String
  code     String
  isCustom Boolean @default(false)
  tenantId String?

  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  expenses Expense[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
}

enum ExpenseStatus {
  PENDING
  RECEIVED
  PAID
  VOID
}

model Expense {
  id                  String        @id @default(uuid())
  categoryId          String?
  supplierId          String?
  customerId          String?
  amount              Decimal       @db.Decimal(10, 2)
  date                DateTime
  description         String?
  paymentMethod       String?
  receiptKey          String?
  receiptOriginalName String?
  receiptMimeType     String?
  vendorBillId        String?       @unique
  notes               String?
  referenceNumber     String?
  importBatchId       String? // UUID set for all rows in one CSV import; null for manually-created expenses
  performedById       String?
  isItemized          Boolean       @default(false)
  isMileage           Boolean       @default(false)
  isBillable          Boolean       @default(false)
  employeeName        String?
  mileageUnit         String?
  distance            Decimal?      @db.Decimal(10, 2)
  mileageRateSnapshot Decimal?      @db.Decimal(10, 4)
  status              ExpenseStatus @default(PENDING)
  receivedAt          DateTime?
  paidAt              DateTime?
  deletedAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  tenantId            String?

  category         ExpenseCategory?  @relation(fields: [categoryId], references: [id])
  tenant           Tenant?           @relation(fields: [tenantId], references: [id])
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  customer         Customer?         @relation(fields: [customerId], references: [id])
  performedBy      User?             @relation(fields: [performedById], references: [id])
  lineItems        ExpenseLineItem[]
  // The commission payout this Expense books — how a payout reaches P&L/cash
  // reports with zero bookkeeping.service changes.
  commissionPayout CommissionPayout?

  @@index([categoryId])
  @@index([supplierId])
  @@index([customerId])
  @@index([date])
  @@index([deletedAt])
  @@index([tenantId])
  @@index([importBatchId])
  @@index([tenantId, status])
}

model ExpenseLineItem {
  id        String   @id @default(uuid())
  expenseId String
  account   String
  notes     String?
  amount    Decimal  @db.Decimal(10, 2)
  productId String?
  unitCost  Decimal? @db.Decimal(10, 4)
  qty       Decimal? @db.Decimal(10, 3)
  createdAt DateTime @default(now())
  tenantId  String?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  tenant  Tenant? @relation(fields: [tenantId], references: [id])

  @@index([expenseId])
  @@index([tenantId])
}

model MileageRate {
  id          String   @id @default(uuid())
  startDate   DateTime
  ratePerUnit Decimal  @db.Decimal(10, 4)
  unit        String   @default("MILE")
  createdAt   DateTime @default(now())
  tenantId    String?

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([startDate])
  @@index([tenantId])
}

// ─── Credit notes & estimates ──────────────────────────────────────

model CreditNote {
  id                 String           @id @default(uuid())
  creditNoteNumber   String
  customerId         String
  invoiceId          String?
  amount             Decimal          @db.Decimal(10, 2)
  amountUsed         Decimal          @default(0) @db.Decimal(10, 2)
  reason             String?
  status             CreditNoteStatus @default(ISSUED)
  appliedToInvoiceId String?

  // P5-13 credits wallet: optional expiry, first-application stamp, and whether any
  // application was automatic. "Expired" is a COMPUTED FILTER in code (excluded from
  // the wallet, never auto-applies) — NEVER a status flip; an expired note keeps its
  // amountUsed / already-issued InvoicePayments untouched.
  expiresAt   DateTime?
  appliedAt   DateTime?
  autoApplied Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenantId    String?

  customer        Customer          @relation(fields: [customerId], references: [id])
  tenant          Tenant?           @relation(fields: [tenantId], references: [id])
  invoice         Invoice?          @relation(fields: [invoiceId], references: [id])
  invoicePayments InvoicePayment[]
  items           CreditNoteItem[]
  orderLinks      OrderCreditNote[]

  @@unique([tenantId, creditNoteNumber])
  @@index([customerId])
  @@index([status])
  @@index([tenantId])
}

/// Phase 4 (W5c): per-line breakdown of a credit note, derived from the SOURCE
/// invoice's lines by allocating the credit `amount` proportionally. Carries each
/// line's regulated category snapshot so the credit can faithfully reverse the
/// regulated sales ledger per category (the credit note header is a single lump sum
/// and can't). Only lines with a `trackedCategoryId` drive a ledger reversal.
model CreditNoteItem {
  id                String   @id @default(uuid())
  tenantId          String
  creditNoteId      String
  invoiceItemId     String?
  trackedCategoryId String?
  amount            Decimal  @default(0) @db.Decimal(12, 2) // credited net (pre-tax) portion
  qty               Decimal  @default(0) @db.Decimal(12, 3)
  categoryTax       Decimal  @default(0) @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([creditNoteId])
}

/// Order↔credit-note INTENT: "apply this credit (up to `amount`, or its remaining
/// balance when null) to this order's invoice(s)". Pure selection state — the MONEY
/// only ever moves through CreditNotesService.applyCreditInTx (an InvoicePayment with
/// method CREDIT_NOTE), and settleOrderCreditsInTx re-applies intents idempotently
/// whenever the order's invoice picture changes. Survives every destructive invoice
/// line rebuild because it never references invoice rows. `amount` is a REQUEST,
/// never a balance — CreditNote.amountUsed stays the single wallet truth.
model OrderCreditNote {
  id           String   @id @default(uuid())
  tenantId     String?
  orderId      String
  creditNoteId String
  amount       Decimal? @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  creditNote CreditNote @relation(fields: [creditNoteId], references: [id])
  tenant     Tenant?    @relation(fields: [tenantId], references: [id])

  @@unique([orderId, creditNoteId])
  @@index([creditNoteId])
  @@index([tenantId])
}

model Estimate {
  id             String         @id @default(uuid())
  estimateNumber String
  customerId     String
  status         EstimateStatus @default(DRAFT)
  subtotal       Decimal        @db.Decimal(10, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(10, 2)
  discount       Decimal        @default(0) @db.Decimal(10, 2)
  total          Decimal        @db.Decimal(10, 2)
  // F01/B79: the operator-picked issue date (backdatable). Nullable: existing
  // rows keep reading as createdAt until edited; F27 wires the write path.
  issueDate      DateTime?
  expiresAt      DateTime?
  notes          String?
  terms          String?
  // F01/B17+B70: the invoice a CONVERTED estimate produced. One estimate, one
  // invoice; a second conversion attempt has this non-null to trip over. F27
  // wires the write; SetNull so deleting an invoice never deletes the estimate.
  invoiceId      String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenantId       String?

  customer Customer       @relation(fields: [customerId], references: [id])
  tenant   Tenant?        @relation(fields: [tenantId], references: [id])
  items    EstimateItem[]
  invoice  Invoice?       @relation("EstimateInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([tenantId, estimateNumber])
  @@index([customerId])
  @@index([status])
  @@index([tenantId])
}

model EstimateItem {
  id            String    @id @default(uuid())
  estimateId    String
  description   String
  productId     String?
  qty           Decimal   @db.Decimal(10, 3)
  unitPrice     Decimal   @db.Decimal(10, 2)
  subtotal      Decimal   @db.Decimal(10, 2)
  priceType     PriceType @default(STANDARD)
  originalPrice Decimal?  @db.Decimal(10, 2)
  boxes         Int?
  pieces        Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenantId      String?

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  product  Product? @relation(fields: [productId], references: [id])

  @@index([estimateId])
  @@index([productId])
  @@index([tenantId])
}

// ─── Vendor bills (accounts payable) ───────────────────────────────

model VendorBill {
  id                    String           @id @default(uuid())
  billNumber            String
  supplierId            String?
  status                VendorBillStatus @default(RECEIVED)
  totalOwed             Decimal          @db.Decimal(10, 2)
  totalPaid             Decimal          @default(0) @db.Decimal(10, 2)
  billDate              DateTime?
  dueDate               DateTime?
  receivedDate          DateTime?
  notes                 String?
  // The SUPPLIER's own invoice number, stored NORMALIZED (uppercase, whitespace
  // stripped — see DuplicateMatchService.normalizeNumber). `billNumber` above is
  // OUR generated BILL-YYYY-NNNN, so this is the only field that identifies the
  // vendor's document. Deliberately NOT unique: prod predates the column, the
  // same number legitimately recurs across suppliers, and VOID bills must never
  // block a re-scan — dedup is an app-level guard (VendorBillsService.create).
  // Null on legacy rows the backfill could not parse and on old mobile builds.
  supplierInvoiceNumber String?
  // Net-terms label as entered on the bill ("Net 30", "Due on Receipt", …),
  // prefillable from Supplier.defaultTerms. Persisted verbatim; the server does
  // NOT compute dueDate from it — the client derives Due Date = Bill Date + days.
  termsLabel            String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  tenantId              String?

  // Sales tax as printed on the supplier's invoice. `totalOwed` already includes
  // it, but without its own column an edit recomputes totalOwed from line items
  // and silently drops the tax.
  taxAmount Decimal? @db.Decimal(12, 2)
  subtotal  Decimal? @db.Decimal(12, 2)

  // Units/PO minimal (2026-09-19): the PO this bill was raised from/linked to
  // (units-po plan §1, D1/D2). Linked ⇒ the PO is the stock mover and this bill
  // is money-only (receive/revertToDraft/voidBill skip the inventory block).
  // @unique because one bill links to at most one PO in v1 (no line matching).
  // SetNull so deleting a PO (rare, DRAFT-only path) never blocks on this FK.
  purchaseOrderId String? @unique

  supplier      Supplier?        @relation(fields: [supplierId], references: [id])
  tenant        Tenant?          @relation(fields: [tenantId], references: [id])
  payments      BillPayment[]
  items         VendorBillItem[]
  scans         InvoiceScan[]
  purchaseOrder PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@unique([tenantId, billNumber])
  @@index([supplierId])
  @@index([status])
  @@index([dueDate])
  @@index([tenantId])
  @@index([tenantId, supplierInvoiceNumber])
}

/// Durable record of every purchase-invoice scan, written when the document is
/// read rather than when a bill is created — so an abandoned review still leaves
/// the extraction (and the AI spend) recoverable, and so a document can be
/// recognised on sight the next time someone uploads it.
///
/// Carries three duplicate keys, strongest first:
///   1. `fileHash`        — same bytes. Checked BEFORE the AI call, so a re-run of
///                          the same PDF costs nothing and answers instantly.
///   2. `lineFingerprint` — same numbers (sorted qty@unitCost + total). Survives
///                          re-photographing and OCR wording drift, which is what
///                          defeated text comparison on the 2026-08 duplicates.
///   3. `supplierInvoiceNumber` + supplier — the printed identity, when readable.
/// `extractedPayload` keeps the FULL model output (per-line sku, packSize,
/// lineTotal, confidence, candidates) that the VendorBill columns cannot hold.
model InvoiceScan {
  id       String  @id @default(uuid())
  tenantId String?

  // The document exactly as received.
  fileKey   String? // storage key; null once the file is pruned
  fileName  String?
  mimeType  String?
  byteSize  Int?
  pageCount Int?
  fileHash  String

  // What the model read, verbatim and lossless.
  extractedPayload Json
  model            String?
  scanDurationMs   Int?

  // Key parameters promoted out of the payload so they can be queried and indexed.
  supplierNameRaw       String?
  supplierId            String?
  supplierInvoiceNumber String? // NORMALIZED, same rule as VendorBill
  invoiceDate           DateTime?
  subtotal              Decimal?  @db.Decimal(12, 2)
  tax                   Decimal?  @db.Decimal(12, 2)
  total                 Decimal?  @db.Decimal(12, 2)
  lineCount             Int?
  lineFingerprint       String?

  status        InvoiceScanStatus @default(SCANNED)
  vendorBillId  String?
  duplicateOfId String?
  scannedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant?       @relation(fields: [tenantId], references: [id])
  supplier    Supplier?     @relation(fields: [supplierId], references: [id])
  vendorBill  VendorBill?   @relation(fields: [vendorBillId], references: [id])
  duplicateOf InvoiceScan?  @relation("ScanDuplicate", fields: [duplicateOfId], references: [id])
  duplicates  InvoiceScan[] @relation("ScanDuplicate")

  @@index([tenantId, fileHash])
  @@index([tenantId, lineFingerprint])
  @@index([tenantId, supplierInvoiceNumber])
  @@index([tenantId, status])
  @@index([vendorBillId])
  @@index([supplierId])
}

/// A parsed supplier statement awaiting reconciliation. Mirrors InvoiceScan:
/// fileHash dedups a re-upload without re-calling the model, extractedPayload
/// keeps the model's verbatim output for audit, and status records whether the
/// operator applied it.
model SupplierStatementScan {
  id       String  @id @default(uuid())
  tenantId String?

  // The document exactly as received.
  fileKey   String? // storage key; null once the file is pruned
  fileName  String?
  mimeType  String?
  byteSize  Int?
  pageCount Int?
  fileHash  String

  // What the model read, verbatim and lossless.
  extractedPayload Json
  model            String?
  scanDurationMs   Int?

  // Key parameters promoted out of the payload so they can be queried and indexed.
  supplierNameRaw String?
  supplierId      String?
  periodStart     DateTime?
  periodEnd       DateTime?
  openingBalance  Decimal?  @db.Decimal(12, 2)
  closingBalance  Decimal?  @db.Decimal(12, 2)
  lineCount       Int?

  status SupplierStatementScanStatus @default(SCANNED)

  /// Set once applied — the paymentGroupId of the payments this scan wrote,
  /// so the whole apply can be traced (and undone by voiding that group).
  appliedPaymentGroupId String?
  appliedAt             DateTime?
  appliedById           String?
  scannedById           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([tenantId, fileHash])
  @@index([tenantId, supplierId])
  @@index([tenantId, status])
}

model VendorBillItem {
  id           String   @id @default(uuid())
  vendorBillId String
  productId    String?
  description  String
  qty          Decimal  @db.Decimal(10, 3)
  unitCost     Decimal  @db.Decimal(10, 4)
  // Read off the invoice line and previously discarded at the create boundary.
  // `sku` is the supplier's own item code — the strongest signal for matching a
  // line to a catalog product on the NEXT scan from the same supplier.
  sku          String?
  packSize     Int?
  lineTotal    Decimal? @db.Decimal(12, 2)
  // Cumulative quantity actually received on this line, in BILL denomination
  // (cases when packSize > 1). Null = receipt predates per-line tracking; a
  // bill whose receivedDate is set while EVERY line is null was fully received.
  qtyReceived  Decimal? @db.Decimal(10, 3)
  createdAt    DateTime @default(now())
  tenantId     String?

  vendorBill VendorBill @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  tenant     Tenant?    @relation(fields: [tenantId], references: [id])
  product    Product?   @relation(fields: [productId], references: [id])

  @@index([vendorBillId])
  @@index([productId])
  @@index([tenantId])
}

model BillPayment {
  id               String        @id @default(uuid())
  vendorBillId     String
  amount           Decimal       @db.Decimal(10, 2)
  method           PaymentMethod
  reference        String?
  notes            String?
  paidAt           DateTime      @default(now())
  createdAt        DateTime      @default(now())
  // Stamped once per supplier-level allocation event, so N BillPayment rows created
  // from one lump-sum supplier payment (recordSupplierPayment) are recognisable as
  // one group. Mirrors InvoicePayment.paymentGroupId on the AR side. Null on every
  // pre-existing row and on payments made through the single-bill recordPayment route.
  paymentGroupId   String?
  // Set ONLY when this row is a draw-down of on-account SupplierCredit
  // (auto-applied when a bill is created). This link — not the free-text
  // `reference`, which any caller can type — is what identifies a draw, so a
  // statement can exclude it and a void/delete can hand the money back.
  // Mirrors InvoicePayment.advancePaymentId on the AR side.
  supplierCreditId String?
  tenantId         String?

  vendorBill     VendorBill      @relation(fields: [vendorBillId], references: [id])
  tenant         Tenant?         @relation(fields: [tenantId], references: [id])
  supplierCredit SupplierCredit? @relation(fields: [supplierCreditId], references: [id])

  @@index([vendorBillId])
  @@index([paymentGroupId])
  @@index([supplierCreditId])
  @@index([tenantId])
}

// ─── Advance Payments ─────────────────────────────────────────────────────────

model AdvancePayment {
  id              String        @id @default(uuid())
  customerId      String
  amount          Decimal       @db.Decimal(10, 2)
  balance         Decimal       @db.Decimal(10, 2)
  method          PaymentMethod
  reference       String?
  notes           String?
  receivedAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenantId        String?
  // Post-dated check payments PR-1 (additive-only): the InvoicePayment id this
  // advance was created FROM (e.g. a bounced-check replacement flow in a later
  // PR). Plain id string, no FK relation, so it never blocks on the source
  // payment's own lifecycle. Null for every advance created the existing way.
  sourcePaymentId String?

  customer     Customer         @relation(fields: [customerId], references: [id])
  tenant       Tenant?          @relation(fields: [tenantId], references: [id])
  applications InvoicePayment[]

  @@index([customerId])
  @@index([tenantId])
  @@index([sourcePaymentId])
}

// ─── Supplier Credits ─────────────────────────────────────────────────────────

/// On-account credit held for a supplier — the AP mirror of AdvancePayment.
/// Created when a supplier payment exceeds everything currently owed; drawn
/// down automatically against the next bill. No status machine: fully drawn
/// is simply balance = 0.
model SupplierCredit {
  id         String        @id @default(uuid())
  supplierId String
  amount     Decimal       @db.Decimal(10, 2) // original, immutable
  balance    Decimal       @db.Decimal(10, 2) // remaining drawable
  method     PaymentMethod
  reference  String?
  notes      String?
  receivedAt DateTime      @default(now())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  tenantId   String?

  supplier     Supplier      @relation(fields: [supplierId], references: [id])
  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
  applications BillPayment[]

  @@index([supplierId])
  @@index([tenantId])
}

// ─── Recurring Invoices ───────────────────────────────────────────────────────

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model RecurringInvoice {
  id            String             @id @default(uuid())
  customerId    String
  frequency     RecurringFrequency
  dayOfWeek     Int?
  dayOfMonth    Int?
  isActive      Boolean            @default(true)
  autoSend      Boolean            @default(false)
  notes         String?
  terms         String?
  discount      Decimal            @default(0) @db.Decimal(10, 2)
  shippingFee   Decimal            @default(0) @db.Decimal(10, 2)
  nextRunAt     DateTime
  lastRunAt     DateTime?
  // F01/B106: outcome of the last cron cycle. The claim stamps lastRunAt before
  // creating the invoice, so on a create failure lastRunAt alone reads as
  // success — these two make the failure visible. F13 wires the writes.
  // Values (F13): "SUCCESS" | "FAILED".
  lastRunStatus String?
  lastError     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tenantId      String?

  customer Customer               @relation(fields: [customerId], references: [id])
  tenant   Tenant?                @relation(fields: [tenantId], references: [id])
  items    RecurringInvoiceItem[]
  invoices Invoice[]

  @@index([customerId])
  @@index([isActive, nextRunAt])
  @@index([tenantId])
}

model RecurringInvoiceItem {
  id                 String  @id @default(uuid())
  recurringInvoiceId String
  productId          String?
  description        String
  qty                Decimal @db.Decimal(10, 3)
  unitPrice          Decimal @db.Decimal(10, 2)
  discount           Decimal @default(0) @db.Decimal(10, 2)
  taxRate            Decimal @default(0) @db.Decimal(5, 4)
  tenantId           String?

  recurringInvoice RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  tenant           Tenant?          @relation(fields: [tenantId], references: [id])
  product          Product?         @relation(fields: [productId], references: [id])

  @@index([recurringInvoiceId])
  @@index([tenantId])
}

/// A tenant's own Stripe account, linked via Connect OAuth (Standard account,
/// direct charges, no platform fee). Kept off Tenant so the link can be revoked
/// and re-established without touching the tenant row, and so `account.updated`
/// webhooks have an obvious landing place. `chargesEnabled` gates the buyer's
/// card button — a linked-but-unverified account must not accept payments.
/// `stripeAccountId` is nullable because the row now exists BEFORE the OAuth
/// callback completes: `buildAuthorizeUrl` upserts a "link started" shell to
/// stash `pendingJti` (invariant 12's single-use OAuth state) — reads that
/// treat the row as "connected" (`getStatus`, `chargeableAccount`) require
/// `stripeAccountId` to be set, not just row-existence.
model TenantStripeConnect {
  id                 String    @id @default(uuid())
  tenantId           String    @unique
  stripeAccountId    String?
  livemode           Boolean   @default(false)
  chargesEnabled     Boolean   @default(false)
  detailsSubmitted   Boolean   @default(false)
  connectedAt        DateTime  @default(now())
  disconnectedAt     DateTime?
  connectedByName    String?
  /// Single-use OAuth `state` jti (invariant 12): set when the authorize URL
  /// is built, cleared atomically the moment `completeOAuth` consumes it. A
  /// second exchange of the same `state` token finds no match and is
  /// rejected — closes the OAuth-state replay window.
  pendingJti         String?
  pendingJtiIssuedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Non-unique on purpose: one business may run two tenants off one Stripe
  // account. Payment webhooks resolve by session id, never by account id.
  @@index([stripeAccountId])
}

/// Insert-first ledger for every Stripe Connect webhook delivery (invariant
/// 3). The controller writes this row — raw client, before any tenant
/// resolution or anti-spoof check — BEFORE doing anything else with the
/// event; `id` is the Stripe event id, so a redelivery collides on the unique
/// constraint and is a no-op ack. `accountRef` + `type` + `createdAt` (Stripe's
/// `event.created`, NOT when we received it) let `account.updated` handling
/// find the last-APPLIED delivery for an account and ignore a stale one that
/// arrives out of order. `outcome` is filled in after routing (e.g. "settled",
/// "duplicate", "account_mismatch", "stale", "ignored:<type>").
model StripeConnectEvent {
  id          String   @id
  accountRef  String
  type        String
  createdAt   DateTime
  processedAt DateTime @default(now())
  outcome     String?

  @@index([accountRef, type, createdAt])
}

enum BuyerPaymentRequestKind {
  CARD
  CASH
}

enum BuyerPaymentRequestStatus {
  PENDING
  /// Claimed by a webhook delivery that is writing the InvoicePayment right
  /// now (invariant 7) — the non-reopening intermediate state between PENDING
  /// and SETTLED that makes a crash-then-redeliver safe.
  SETTLING
  /// Card payment settled (money written). Cash approvals stay on APPROVED —
  /// SETTLED is specific to the webhook-driven card lifecycle.
  SETTLED
  APPROVED
  REJECTED
  FAILED
  EXPIRED
  CANCELLED
}

/// A buyer-initiated payment BEFORE it becomes money. Deliberately a separate
/// table rather than a PaymentStatus member: `recomputeStatus` sums
/// InvoicePayment rows, so a pending declaration inside that table would mark
/// invoices paid on the buyer's say-so (the DRAFT-payment trap). InvoicePayment
/// rows are written only on approval (cash) or a verified webhook (card), via
/// recordStandalonePayment with an oldest-first allocation; `paymentGroupId`
/// then joins this request to the rows it produced.
///
/// RACE-PROOF OPEN-REQUEST RULE (invariant 8): migration
/// `20260826000000_stripe_connect_event_ledger` adds a PARTIAL unique index
/// — `CREATE UNIQUE INDEX ... ON "BuyerPaymentRequest"("tenantId","customerId")
/// WHERE status IN ('PENDING','SETTLING')` — that Prisma's schema language
/// cannot express (no `WHERE` on `@@index`/`@@unique`), so it exists ONLY in
/// that migration file; `prisma migrate dev` will not see it as drift because
/// nothing here declares a conflicting full unique constraint on the same
/// columns. EXPIRED is deliberately excluded so an abandoned request doesn't
/// block the buyer from starting a new one.
model BuyerPaymentRequest {
  id                    String                    @id @default(uuid())
  tenantId              String
  customerId            String
  buyerAccountId        String?
  /// Provenance only — the invoice screen the buyer started from. Allocation
  /// is strictly oldest-first across the account and ignores this field.
  invoiceId             String?
  kind                  BuyerPaymentRequestKind
  status                BuyerPaymentRequestStatus @default(PENDING)
  amount                Decimal                   @db.Decimal(10, 2)
  note                  String?
  reference             String?
  stripeSessionId       String?                   @unique
  /// DEPRECATED (2026-08-22) — read `providerPaymentId` instead. Written only
  /// by the pre-#399 settle path; rows from that era were backfilled into
  /// providerPaymentId by 20260828000000_unify_provider_payment_id, so this
  /// column is now redundant and NOTHING should read or write it. Kept only
  /// until a cleanup migration drops it. Same concept in two columns split by
  /// deploy date = silent NULLs for whichever a reader picks wrong.
  stripePaymentIntentId String?
  /// The settled PaymentIntent id (invariant 7/9) — provider-agnostic name,
  /// set once `settleByPaymentIntent` claims/completes the row. The ONE
  /// column for "which processor payment settled this request".
  providerPaymentId     String?
  /// Free-text note for an anomalous settle (e.g. money arrived for a row
  /// that was CANCELLED/REJECTED/FAILED/EXPIRED, or the charged amount
  /// disagreed with the requested amount) — never blocks the write, just
  /// flags it for operator review.
  outcome               String?
  paymentGroupId        String?
  failureReason         String?
  decidedById           String?
  decidedByName         String?
  decidedAt             DateTime?
  expiresAt             DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  buyerAccount BuyerAccount? @relation(fields: [buyerAccountId], references: [id])

  @@index([tenantId, status])
  @@index([customerId])
  @@index([tenantId, createdAt])
  @@index([paymentGroupId])
}
