/// Seller merchandising promotion (P5-01): evaluated at cart time (in pricing.ts) and
/// shown on tiles + a checkout savings line. Tenant-managed. Typed rules — no JSON DSL:
/// PERCENT / FIXED / QTY_BREAK / BUY_N_GET_M, scoped to all products, one category, or an
/// explicit product set, within a time window. Money math lives in pricing.ts, never here.
/// BUY_N_GET_M ("buy 5, get the 6th free") reuses minQty/value — NO dedicated columns:
/// minQty = N (buy quantity), value = M (free quantity), both required positive integers
/// for this type (PromotionsService.validateRule). Applies to whole SELLING units of the
/// line (boxes for a boxed product; loose pieces never count) — see OrderItem.promoFreeUnits.
model Promotion {
  id         String         @id @default(uuid())
  tenantId   String
  name       String
  bannerText String?
  type       PromotionType  @default(PERCENT)
  value      Decimal        @default(0) @db.Decimal(10, 2) // PERCENT/QTY_BREAK: % off. FIXED: $ off/selling unit. BUY_N_GET_M: M (free qty, integer >= 1).
  minQty     Int? // QTY_BREAK: threshold in pieces. BUY_N_GET_M: N (buy qty, integer >= 1, selling units).
  scope      PromotionScope @default(ALL)
  category   String? // when scope = CATEGORY
  startsAt   DateTime
  endsAt     DateTime
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products PromotionProduct[]

  @@index([tenantId])
  @@index([tenantId, isActive, startsAt, endsAt])
}

/// Join row when a Promotion scopes to an explicit product set (scope = PRODUCTS).
model PromotionProduct {
  id          String @id @default(uuid())
  tenantId    String
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([tenantId])
  @@index([productId])
}

enum PromotionType {
  PERCENT
  FIXED
  QTY_BREAK
  BUY_N_GET_M
}

enum PromotionScope {
  ALL
  CATEGORY
  PRODUCTS
}

model Route {
