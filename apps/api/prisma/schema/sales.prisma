enum PriceType {
  STANDARD
  SPECIAL
  DISCOUNTED
  MANUAL
  PROMO // P5-04: line priced by an active buyer promotion (net unitPrice + originalPrice strikethrough)
}

model Customer {
  id                    String      @id @default(uuid())
  userId                String      @unique
  businessName          String
  contactName           String
  phone                 String?
  notes                 String?
  zohoContactId         String?     @unique
  // Set only for Customer rows on the routeflow-hq house tenant: the platform Tenant this
  // row represents. Null for every ordinary tenant's own customers. Written by
  // TenantMirrorService (see tenant-mirror.service.ts); no writer exists before Phase 0's
  // HQ bootstrap task runs.
  representsTenantId   String?     @unique
  fulfillPath           FulfillPath @default(ROUTE)
  deliveryWindowStart   String?
  deliveryWindowEnd     String?
  email                 String?
  mobile                String?
  customerType          String      @default("BUSINESS")
  supplierOnly          Boolean     @default(false) // true = this contact is a vendor/supplier; hide from Customers list
  displayName           String?
  salutation            String?
  firstName             String?
  lastName              String?
  taxId                 String?
  isTaxExempt           Boolean     @default(false)
  taxExemptDocumentKeys String[]    @default([])
  // Retail tobacco license of the buying customer — surfaced (warn-only in
  // v1) when invoicing tobacco items to unlicensed/expired customers
  tobaccoLicenseNo      String?
  tobaccoLicenseExpiry  DateTime?
  creditLimit           Decimal?    @db.Decimal(10, 2)
  currency              String      @default("USD")
  pricingTier           Int         @default(1)
  // Per-customer default payment terms label ("this customer is always Net 60").
  // Empty string clears an override; null means "use the tenant default". Wins
  // over the tenant SystemConfig default in resolveDefaultTerms().
  defaultPaymentTerms   String?
  // Per-customer default deposit percent ("50% upfront, remainder on terms").
  // null = no deposit default. Auto-applied (depositDueDate = issueDate) to
  // invoices generated from orders that don't already carry an explicit
  // depositPercent — see resolveDefaultTerms()/createInvoiceFromOrder* in
  // invoices.service.ts. computeDepositFields still does the read-time math.
  defaultDepositPercent Decimal?    @db.Decimal(5, 2)
  // P6-1 (F0): per-channel messaging consent (only the STOP-gated SMS/WA channels
  // carry consent; EMAIL/PORTAL don't). Additive — existing rows backfill to false.
  smsConsent            Boolean     @default(false)
  waConsent             Boolean     @default(false)
  consentUpdatedAt      DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  // RF-197: soft-delete timestamp; set instead of physically deleting when
  // the customer has financial records (orders / invoices / returns).
  deletedAt             DateTime?
  // Post-dated check payments PR-1 (additive-only): a later PR's credit-hold
  // flow (e.g. triggered by a bounced check) sets all three together —
  // creditHoldAt null means "not on hold" and is the only field any future
  // read/write path should branch on; reason/byId are display-only context.
  // No read/write path sets or checks these yet.
  creditHoldAt          DateTime?
  creditHoldReason      String?
  creditHoldById        String?
  tenantId              String?

  user                 User                     @relation(fields: [userId], references: [id])
  tenant               Tenant?                  @relation(fields: [tenantId], references: [id])
  messageThreads       MessageThread[]
  messageOptOuts       MessageOptOut[]
  addresses            CustomerAddress[]
  routes               RouteCustomer[]
  routeStops           RouteStop[]
  orders               Order[]
  transactions         Transaction[]
  routeRunStops        RouteRunStop[]
  orderTemplates       OrderTemplate[]
  invoices             Invoice[]
  estimates            Estimate[]
  creditNotes          CreditNote[]
  returns              Return[]
  advancePayments      AdvancePayment[]
  recurringInvoices    RecurringInvoice[]
  prices               CustomerPrice[]
  expenses             Expense[]
  contactPersons       ContactPerson[]
  tagAssignments       CustomerTagAssignment[]
  comments             CustomerComment[]
  customerLink         CustomerLink?
  buyerPaymentRequests BuyerPaymentRequest[]
  buyerFavorites       BuyerFavorite[]
  deliveryBatches      DeliveryBatch[]
  documents            CustomerDocument[]
  authorizations       CustomerAuthorization[]
  authOverrides        AuthorizationOverride[]
  replenishmentSnoozes ReplenishmentSnooze[]
  stockAlerts          StockAlert[]
  agentAssignments     AgentAssignment[]
  commissionRates      CustomerCommissionRate[]
  commissionAccruals   CommissionAccrual[]

  @@index([zohoContactId])
  @@index([businessName])
  @@index([customerType])
  @@index([tenantId])
  // Present in production but absent from this model, so Prisma treated it as
  // drift and a generated migration would have DROPped it.
  @@index([deletedAt])
}

