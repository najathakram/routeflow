  isActive        Boolean             @default(true)
  depotLat        Float?
  depotLng        Float?
  depotAddress    String?
  originKind      RouteOriginKind? // how depot* was chosen; null = legacy rows
  endKind         RouteEndKind        @default(NONE)
  endLat          Float?
  endLng          Float?
  endAddress      String?
  avoidTolls      Boolean             @default(false)
  optimizeBy      RouteOptimizeMetric @default(TIME)
  plannedPolyline String? // encoded road polyline of the chosen route (scale: map views
  // render this instead of re-calling Google)
  kind            RouteKind           @default(SCHEDULED)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenantId        String?

  driver    Driver?         @relation(fields: [driverId], references: [id])
  tenant    Tenant?         @relation(fields: [tenantId], references: [id])
  stops     RouteStop[]
  customers RouteCustomer[]
  runs      RouteRun[]

  @@index([driverId])
  @@index([isActive])
  @@index([tenantId])
  @@index([tenantId, kind])
