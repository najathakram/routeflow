model RouteRun {
  id                 String         @id @default(uuid())
  routeId            String
  driverId           String?
  status             RouteRunStatus @default(SCHEDULED)
  scheduledDate      DateTime
  startTime          String?
  depotLat           Float?
  depotLng           Float?
  depotAddress       String?
  startedAt          DateTime?
  completedAt        DateTime?
  manuallyReordered  Boolean        @default(false)
  notes              String?
  // F01/B167: the run-close settlement result, in dedicated surfaced fields —
  // today the variance note is appended to free-text `notes`, whose only
  // reader (EditRunModal) is hidden once the run completes. F05 wires the
  // driver settlement write and the run-detail read.
  settlementVariance Decimal?       @db.Decimal(10, 2)
  settlementNote     String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  tenantId           String?

  route     Route            @relation(fields: [routeId], references: [id])
  tenant    Tenant?          @relation(fields: [tenantId], references: [id])
  driver    Driver?          @relation(fields: [driverId], references: [id])
  stops     RouteRunStop[]
  orders    Order[]
  locations DriverLocation[]

  @@index([routeId])
  @@index([driverId])
  @@index([status])
  @@index([scheduledDate])
  @@index([tenantId])
}

model RouteRunStop {
  id                    String             @id @default(uuid())
  routeRunId            String
  routeStopId           String
  customerId            String?
  customerAddressId     String?
  stopNumber            Int
  status                RouteRunStopStatus @default(PENDING)
  driverNote            String?
  arrivedAt             DateTime?
  completedAt           DateTime?
  notes                 String?
  // F01/B34: why the driver skipped this stop (written with status=SKIPPED).
  // F11 wires the driver screen; nothing writes it before then.
  skipReason            String?
  podPhotoUrls          String[]
  signatureUrl          String?
  // F01/B120: append-only archive of POD pointers displaced by reopenStop —
  // entries {archivedAt, signatureUrl, podPhotoUrls, reason}. The columns above
  // are the SOLE pointers to stored objects (#477), so nulling them without
  // archiving destroys regulated-delivery evidence. F10 wires the write.
  podHistory            Json?
  safeDropEnabled       Boolean            @default(false)
  // Phase 4: per-stop regulated-delivery flags surfaced on the driver stop card
  // (set when the stop contains a category demanding age / identity verification).
  ageCheckRequired      Boolean            @default(false)
  identityCheckRequired Boolean            @default(false)
  // Phase 4 (W7b): what the driver actually captured at a regulated delivery.
  // ageVerified/identityVerified are the affirmative check-offs; identityType is
  // the kind of ID inspected (DRIVERS_LICENSE, PASSPORT, STATE_ID, MILITARY_ID,
  // OTHER); identityVerifiedAt is stamped server-side when identity is confirmed.
  ageVerified           Boolean            @default(false)
  identityVerified      Boolean            @default(false)
  identityType          String?
  identityVerifiedAt    DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  tenantId              String?

  routeRun          RouteRun           @relation(fields: [routeRunId], references: [id])
  tenant            Tenant?            @relation(fields: [tenantId], references: [id])
  routeStop         RouteStop          @relation(fields: [routeStopId], references: [id])
  customer          Customer?          @relation(fields: [customerId], references: [id])
  customerAddress   CustomerAddress?   @relation(fields: [customerAddressId], references: [id])
  orders            Order[]
  deliveryMutations DeliveryMutation[]
  deliveryBatches   DeliveryBatch[]
  changeRequests    ChangeRequest[]

  @@unique([routeRunId, stopNumber])
  @@index([routeRunId])
  @@index([routeStopId])
  @@index([customerId])
  @@index([customerAddressId])
  @@index([tenantId])
}

model Order {
  id                     String      @id @default(uuid())
  customerId             String
  routeRunId             String?
  routeRunStopId         String?
  templateId             String?
  orderNumber            String?
  status                 OrderStatus @default(PENDING)
  source                 OrderSource @default(APP)
  urgent                 Boolean     @default(false)
  notes                  String?
  driverNote             String?
  subtotal               Decimal     @default(0) @db.Decimal(10, 2)
  tax                    Decimal     @default(0) @db.Decimal(10, 2)
  total                  Decimal     @default(0) @db.Decimal(10, 2)
  discountAmount         Decimal     @default(0) @db.Decimal(10, 2)
  // Optional per-order shipping fee (never taxed; added after tax like the
  // invoice-side shippingFee). Invariant: equals Σ shippingFee of this order's
  // non-VOID invoices — recomputeOrderFromInvoices maintains the back-sync.
  shippingFee            Decimal     @default(0) @db.Decimal(10, 2)
  requestedDeliveryDate  DateTime?
  // BUSINESS date of the order — the day it actually happened, which is NOT
  // `createdAt` (the entry timestamp) when an operator enters a forgotten order
  // days later. Staff-settable only (OPERATOR/TENANT_ADMIN). When set it drives
  // `deliveredAt` on the already-delivered sale path and the issueDate/dueDate of
  // every invoice generated from this order — which in turn moves the regulated
  // ledger's period bucket into that past month.
  orderDate              DateTime?
  deliveredAt            DateTime?
  // Carrier shipment tracking — set when goods ship via a carrier instead of being
  // delivered on our own route. Copied onto the Invoice(s) generated from this order.
  shippingCarrier        String?
  shippingTrackingNumber String?
  shippedAt              DateTime?
  // When true, the auto-merge cron + on-create merge will skip this order entirely.
  // Set when an operator explicitly chose "Create as separate order" despite an active draft existing.
  skipAutoMerge          Boolean     @default(false)
  // Phase 4: denormalized flag — true when any line's product is in a tracked
  // (regulated) category. Drives the split preview + signature-POD requirement.
  hasRegulated           Boolean     @default(false)
  // Sales agents & commissions (flag.sales_agents): staff-set per-order override of
  // the commission rate, resolved ahead of any customer/agent default. `0` is a valid
  // value meaning "exempt"; `null` means no override (fall through to rate resolution).
  commissionRatePct      Decimal?    @db.Decimal(5, 2)
  fulfillPath            FulfillPath @default(ROUTE)
  // F30/R8: client-generated key (uuid per cart session) for POST /orders replay
  // semantics. A duplicate submit under the same (tenantId, idempotencyKey) —
  // queue self-duplication, a timed-out-but-completed request retried — returns
  // the ORIGINAL order instead of creating a second one. NULL is untouched by
  // the unique constraint (Postgres treats NULLs as distinct, mirroring the
  // orderNumber unique below), so old clients that never send a key are unaffected.
  idempotencyKey         String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  tenantId               String?

  customer          Customer           @relation(fields: [customerId], references: [id])
  tenant            Tenant?            @relation(fields: [tenantId], references: [id])
  routeRun          RouteRun?          @relation(fields: [routeRunId], references: [id])
  routeRunStop      RouteRunStop?      @relation(fields: [routeRunStopId], references: [id])
  orderTemplate     OrderTemplate?     @relation(fields: [templateId], references: [id])
  lineItems         OrderItem[]
  deliveryMutations DeliveryMutation[]
  transaction       Transaction?
  invoices          Invoice[]
  returns           Return[]
  revisions         OrderRevision[]
  changeRequests    ChangeRequest[]
  orderCreditNotes  OrderCreditNote[]
  mergeIdempotencyKeys OrderIdempotencyKey[]

  // RF-014: prevent duplicate order numbers within the same tenant.
  // NULL values are treated as distinct by PostgreSQL, so rows with
  // orderNumber=null remain unrestricted (legacy/draft orders).
  @@unique([tenantId, orderNumber])
  // F30/R8: per-tenant idempotency store — see column comment above.
  @@unique([tenantId, idempotencyKey])
  @@index([customerId])
  @@index([routeRunId])
  @@index([routeRunStopId])
  @@index([templateId])
  @@index([status])
  @@index([urgent])
  @@index([createdAt])
  @@index([requestedDeliveryDate])
  @@index([orderDate])
  @@index([tenantId])
}

/// B215: one row per staff-merge Idempotency-Key. Written by
/// OrdersService.recordMergeIdempotencyKey INSIDE updateOrderItems' own transaction, so the key
/// commits or rolls back together with the fold it guards. An order may hold many keys (every
/// merge wave keeps its own); a key belongs to exactly one order per tenant. `responseHash` is the
/// SHA-256 fingerprint (merge-idempotency.ts mergeRequestHash) of the request whose result this
/// row replays — a same-key retry with a different cart is refused (409). The consolidation
/// sweeps re-point a loser's rows onto the winner before deleting the loser.
/// NOT the global `IdempotencyKey` model (platform.prisma — RoutesService stop replay).
model OrderIdempotencyKey {
  id           String   @id @default(uuid())
  tenantId     String
  key          String
  orderId      String
  responseHash String
  createdAt    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([orderId])
}

/// Append-only version history of an order's editable state (P5-08). One row is
/// APPENDED on every autosaved pre-dispatch edit of a PLACED/CONFIRMED order —
/// never mutated. `snapshot` is the point-in-time line set + money totals AFTER
/// the edit; the web timeline renders vN and diffs consecutive rows client-side.
/// Actor is an immutable FK-less snapshot (mirrors CustomerAuthorization.verifiedById/Name).
model OrderRevision {
  id             String   @id @default(uuid())
  tenantId       String?
  orderId        String
  revisionNumber Int
  editedById     String?
  editedByName   String?
  editedByRole   String?
  source         String   @default("EDIT")
  reason         String?
  snapshot       Json
  createdAt      DateTime @default(now())

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([orderId, revisionNumber])
  @@index([tenantId])
  @@index([orderId])
  @@index([createdAt])
}

/// P5-09: post-dispatch change request. Created when the G7 edit window is
/// closed (order's RouteRun dispatched) and a buyer/driver wants a change.
/// Resolution authority (G6): driver-at-stop primary; office only while
/// PENDING; FIRST resolution wins and locks (atomic conditional update).
/// `payload` is the typed delta:
///   ADD_ITEM   { productId, qty, boxes?, pieces?, productName }
///   CHANGE_QTY { orderItemId, newQty, productName }
///   REMOVE_ITEM{ orderItemId, productName }
///   NOTE       { text }
/// Actor fields are immutable FK-less snapshots (mirror OrderRevision).
/// `resolution` = MERGED_AT_STOP | NEXT_DELIVERY | DECLINED;
/// `nextOrderId` = plain pointer (no FK) to the next-delivery draft order.
model ChangeRequest {
  id               String              @id @default(uuid())
  tenantId         String?
  orderId          String
  orderItemId      String?
  productId        String?
  routeRunStopId   String?
  type             ChangeRequestType
  status           ChangeRequestStatus @default(PENDING)
  payload          Json
  note             String?
  requestedById    String?
  requestedByName  String?
  requestedByRole  String?
  resolvedById     String?
  resolvedByName   String?
  resolvedByRole   String?
  resolution       String?
  resolutionReason String?
  nextOrderId      String?
  resolvedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
  orderItem    OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  routeRunStop RouteRunStop? @relation(fields: [routeRunStopId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([orderId])
  @@index([status])
  @@index([routeRunStopId])
  @@index([createdAt])
}

model OrderItem {
  id                   String     @id @default(uuid())
  orderId              String
  // Nullable so an order can carry "unlisted" ad-hoc lines that are not in the
  // product catalog. When null, `name` holds the free-text item label.
  productId            String?
  // Free-text label for unlisted items (productId == null). Catalog lines leave
  // this null and read the name from the related product.
  name                 String?
  status               ItemStatus @default(PENDING)
  qty                  Decimal    @db.Decimal(10, 3)
  deliveredQty         Decimal    @default(0) @db.Decimal(10, 3)
  // Cumulative qty already covered by issued invoices (full or partial). Capped at qty.
  invoicedQty          Decimal    @default(0) @db.Decimal(10, 3)
  unitPrice            Decimal    @db.Decimal(10, 2)
  subtotal             Decimal    @default(0) @db.Decimal(10, 2)
  priceType            PriceType  @default(STANDARD)
  originalPrice        Decimal?   @db.Decimal(10, 2)
  overrideReason       String?
  overriddenBy         String?
  boxes                Int?
  pieces               Int?
  // Sale-time snapshot of the product's box size (Product.unitsPerBox). Boxed
  // line math (price proration, box/piece split) must use THIS value, never the
  // live product — a later packaging change must not re-interpret past lines.
  // Null for lines created before the snapshot shipped (fall back to live upb).
  unitsPerBox          Int?
  // BUY_N_GET_M sale-time snapshot: whole free selling units this line received,
  // floor(qtyUnits / (N+M)) * M (N=Promotion.minQty, M=Promotion.value). 0/null for
  // every non-BOGO line (PERCENT/FIXED/QTY_BREAK/no promo — unaffected). Recomputed
  // whenever the line is re-priced via applyBestPromotion (create, buyer edit, at-door
  // add) AND whenever the QUANTITY changes under a kept (agreed) price — a pending
  // merge or a stored-price qty edit re-derives it for the new whole-unit count, so
  // the column can never contradict the subtotal. Feeds computeLineSubtotal's freeUnits param —
  // the SUBTOTAL is exact, never a rounded net-unit-price. Nullable, no backfill.
  promoFreeUnits       Int?
  notes                String?
  // Phase 4: regulated-category snapshot at sale time; `categoryTaxAmount` is the
  // computed category tax for this line (0 until the W3 calculator populates it).
  // Snapshots are never rewritten by later category edits.
  trackedCategoryId    String?
  trackedSubcategoryId String?
  categoryTaxAmount    Decimal    @default(0) @db.Decimal(10, 2)
  // Scan/insertion order within the order (0-based). Set from the client's item
  // array index at create and preserved/appended on edit, so line display matches
  // the order items were scanned/added (the invoice already reads in insertion
  // order). Nullable: legacy rows (pre-migration) and merge/change-request appends
  // leave it null and sort LAST (Postgres NULLS LAST for ASC).
  position             Int?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  tenantId             String?

  order              Order               @relation(fields: [orderId], references: [id])
  tenant             Tenant?             @relation(fields: [tenantId], references: [id])
  // Restrict, stated explicitly: production has always enforced RESTRICT here, while
  // an un-annotated optional relation means SetNull to Prisma — so the schema quietly
  // disagreed with the database. Nothing relies on SetNull: remove() soft-deletes,
  // bulkDelete() clears dependants first, and clearAll() delegates to bulkDelete, so
  // no path reaches this FK. Keeping RESTRICT preserves the backstop that stops a
  // stray hard-delete silently orphaning order history.
  product            Product?            @relation(fields: [productId], references: [id], onDelete: Restrict)
  trackedCategory    TrackedCategory?    @relation(fields: [trackedCategoryId], references: [id], onDelete: SetNull)
  trackedSubcategory TrackedSubcategory? @relation(fields: [trackedSubcategoryId], references: [id], onDelete: SetNull)
  deliveryMutations  DeliveryMutation[]
  transactionItems   TransactionItem[]
  invoiceItems       InvoiceItem[]
  changeRequests     ChangeRequest[]

  @@index([orderId])
  @@index([productId])
  @@index([status])
  @@index([tenantId])
  @@index([trackedCategoryId])
  @@index([trackedSubcategoryId])
}

model DeliveryMutation {
  id                String       @id @default(uuid())
  orderId           String
  orderItemId       String?
  productId         String?
  routeRunStopId    String?
  driverId          String?
  deliveryBatchId   String?
  type              MutationType
  qty               Decimal?     @db.Decimal(10, 3)
  quantityDelivered Decimal?     @db.Decimal(10, 3)
  unitPrice         Decimal?     @db.Decimal(10, 2)
  note              String?
  driverNote        String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  tenantId          String?

  order         Order          @relation(fields: [orderId], references: [id])
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  orderItem     OrderItem?     @relation(fields: [orderItemId], references: [id])
  product       Product?       @relation(fields: [productId], references: [id])
  routeRunStop  RouteRunStop?  @relation(fields: [routeRunStopId], references: [id])
  driver        Driver?        @relation(fields: [driverId], references: [id])
  deliveryBatch DeliveryBatch? @relation(fields: [deliveryBatchId], references: [id])

  @@index([orderId])
  @@index([orderItemId])
  @@index([productId])
  @@index([routeRunStopId])
  @@index([driverId])
  @@index([deliveryBatchId])
  @@index([type])
  @@index([tenantId])
}

model DeliveryBatch {
  id             String   @id @default(uuid())
  customerId     String
  routeRunStopId String?
  driverId       String?
  deliveredAt    DateTime @default(now())
  notes          String?
  createdAt      DateTime @default(now())
  tenantId       String?

  customer     Customer           @relation(fields: [customerId], references: [id])
  routeRunStop RouteRunStop?      @relation(fields: [routeRunStopId], references: [id])
  driver       Driver?            @relation(fields: [driverId], references: [id])
  tenant       Tenant?            @relation(fields: [tenantId], references: [id])
  mutations    DeliveryMutation[]
  invoices     Invoice[]

  @@index([customerId])
  @@index([routeRunStopId])
  @@index([tenantId])
}

model OrderTemplate {
  id         String   @id @default(uuid())
  customerId String
  name       String
  isActive   Boolean  @default(true)
  daysOfWeek Int[]
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenantId   String?

  customer Customer            @relation(fields: [customerId], references: [id])
  tenant   Tenant?             @relation(fields: [tenantId], references: [id])
  items    OrderTemplateItem[]
  orders   Order[]

  @@index([customerId])
  @@index([isActive])
  @@index([tenantId])
}

model OrderTemplateItem {
  id         String   @id @default(uuid())
  templateId String
  productId  String
  qty        Int
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenantId   String?

  template OrderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tenant   Tenant?       @relation(fields: [tenantId], references: [id])
  product  Product       @relation(fields: [productId], references: [id])

  @@index([templateId])
  @@index([tenantId])
}

