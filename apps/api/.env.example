# ══════════════════════════════════════════════════════════════════════════════
# .env.example — copy to .env.local for local development
#
# THREE ENVIRONMENTS — THREE SEPARATE FILES (all gitignored):
#
#   .env.local      ← LOCAL dev   — local Postgres / Docker — reset freely
#   .env.staging    ← STAGING     — Railway staging service — seed allowed
#   .env.production ← PRODUCTION  ← ████ REAL TENANT DATA ████
#                                    Seed scripts BLOCKED by production guard
#                                    Never copy this file anywhere
#                                    Never commit this file
#
# The production DATABASE_URL lives ONLY in Railway dashboard + your password
# manager.  If you need to inspect production data: railway connect postgres
# ══════════════════════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────────────────────
# Matches docker-compose.yml defaults — change for staging/prod
DATABASE_URL="postgresql://user:pass@localhost:5432/routeflow_dev"
POSTGRES_USER="user"
POSTGRES_PASSWORD="pass"
POSTGRES_DB="routeflow_dev"

# ─── Cache ────────────────────────────────────────────────────────────────────
# REDIS_PASSWORD must match docker-compose.yml REDIS_PASSWORD (leave blank for local dev)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-32-char-secret"
JWT_REFRESH_SECRET="replace-with-different-32-char-secret"
JWT_EXPIRES_IN="15m"
# 30-day idle cutoff — refresh rotation slides the window on every use, so only
# 30 days of inactivity forces a re-login.
JWT_REFRESH_EXPIRES_IN="30d"

# ─── Login throttle (RF-160) ──────────────────────────────────────────────────
# Optional override for POST /auth/login rate limiting. Unset = production
# defaults (10 attempts / 300000 ms = 5 min per IP). Only for local stacks
# (Playwright etc. sharing 127.0.0.1) — never raise these in production.
# Read once, at the first login request after boot (so a value set here in
# apps/api/.env works — ConfigModule has loaded it by then); changing it
# afterwards needs a restart.
# AUTH_LOGIN_THROTTLE_LIMIT=10
# AUTH_LOGIN_THROTTLE_TTL_MS=300000

# ─── Encryption (secrets at rest) ─────────────────────────────────────────────
# 32-byte key as 64 hex chars: `openssl rand -hex 32`
# REQUIRED in production. Encrypts TenantConfig.smtpPassword and per-tenant
# Google OAuth client secrets at rest. Without it, encrypt() is DISABLED in
# production (F5-002). Rotating this value makes previously-encrypted data
# undecryptable — re-encrypt existing rows before rotating.
ENCRYPTION_KEY=""

# ─── Storage URL signing ──────────────────────────────────────────────────────
# HMAC secret for local-disk presigned upload URLs. REQUIRED in production (the
# API refuses to boot without it — F5-001). In dev/test it may be left blank, in
# which case it is derived from JWT_SECRET via HKDF. Use a long random value,
# independent of JWT_SECRET, so a JWT leak can't forge storage signatures.
STORAGE_URL_SIGNING_SECRET=""
# Lifetime in seconds for signed local-disk URLs (default 3600 = 1 hour)
# STORAGE_URL_EXPIRY_SECONDS=3600

# ─── Zoho CRM ─────────────────────────────────────────────────────────────────
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""

# ─── Email delivery ──────────────────────────────────────────────────────────
# Sends are tried in order: PER-TENANT SMTP configured in-app under Settings → Email
# (stored in SystemConfig `email.*`, password encrypted with ENCRYPTION_KEY) takes
# precedence; otherwise the PLATFORM transport below is used. If NOTHING is set,
# emails are NOT delivered — the API returns an honest failure (EMAIL_NOT_CONFIGURED)
# instead of silently claiming "sent" (R5). Leave everything blank locally to disable
# platform email (per-tenant SMTP still works if a tenant configures it).
#
# The PLATFORM transport is Google Workspace SMTP (owner ruling 2026-09-16 — RouteFlow's
# mail is on Google, not a third-party ESP). Set SMTP_HOST to select it. It requires a
# REAL Workspace mailbox (an alias can't authenticate) with a Google App Password — see
# docs/runbooks/transactional-email-setup.md for the full setup (Workspace user, 2-Step
# Verification, App Password, SPF/DKIM/DMARC). Google caps a single mailbox at roughly
# 2,000 sends/day; if RouteFlow's transactional volume approaches that, this needs a
# dedicated ESP (Resend) or Google Workspace's higher-volume relay instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# From-address for platform sends — with platform SMTP this MUST be the authenticated
# mailbox above (SPF/DKIM alignment); with Resend it must be on a domain verified in
# Resend. Per-tenant SMTP sends use the tenant's own From (Settings → Email) and fall
# back to this. Format: "Name <addr@domain>".
EMAIL_FROM="RouteFlow <noreply@routeflow.info>"
# ALTERNATIVE platform transport — used only when SMTP_HOST above is blank. Never set
# both; platform SMTP always wins when configured.
RESEND_API_KEY=""

# ─── Cloudflare R2 (object storage) ──────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="routeflow-assets"

# ─── OpenRouteService (routing engine) ───────────────────────────────────────
ORS_API_KEY=""

# ─── Firebase Cloud Messaging (push notifications) ───────────────────────────
FCM_PROJECT_ID=""

# ─── Google OAuth 2.0 (Sign-In) ──────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URIs must include GOOGLE_REDIRECT_URI_TENANT and
# GOOGLE_REDIRECT_URI_PLATFORM exactly as set below (https in production).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Tenant staff + buyer portal callback — path: /api/v1/auth/google/callback
GOOGLE_REDIRECT_URI_TENANT=""
# Platform admin (SUPER_ADMIN) callback — path: /api/v1/platform-admin/auth/google/callback
GOOGLE_REDIRECT_URI_PLATFORM=""
# Legacy single-redirect URI used by the per-slug tenant flow (/auth/google/:slug)
GOOGLE_CALLBACK_URL=""
# Frontend base URL (for post-auth redirects and web password-reset links)
WEB_URL="http://localhost:3001"
# Mobile-web base URL (for mobile password-reset links). Defaults to the
# production mobile-web domain when unset.
MOBILE_WEB_URL=""

# ─── Google mailbox connect (email-connect-google, tenant-owned Gmail send) ──
# A SEPARATE OAuth client from GOOGLE_CLIENT_ID above (design D3) — verification is
# per-consent-screen, and sign-in/mailbox must never share one client. Scope requested:
# gmail.send ONLY (Sensitive, not Restricted — no CASA needed, see design.md §1).
# Redirect path: /api/v1/settings/email/mailbox/google/callback
GOOGLE_MAILBOX_CLIENT_ID=""
GOOGLE_MAILBOX_CLIENT_SECRET=""
GOOGLE_MAILBOX_REDIRECT_URI=""

# ─── Microsoft mailbox connect (email-connect-microsoft, tenant-owned Outlook send) ──
# Entra app registration "RouteFlow Mail", accounts = any org directory AND personal
# (tenant `common`). Delegated scopes: Mail.Send, User.Read, offline_access — never a
# mail-read scope (design.md §1/§3). Redirect path:
# /api/v1/settings/email/mailbox/microsoft/callback
MICROSOFT_MAILBOX_CLIENT_ID=""
MICROSOFT_MAILBOX_CLIENT_SECRET=""
MICROSOFT_MAILBOX_REDIRECT_URI=""

# ─── Google Calendar (public demo booking) ──────────────────────────────────
# Service account with domain-wide delegation, impersonating a Workspace user.
# Full setup: docs/runbooks/google-calendar-demo-booking-setup.md
# Verify with: node apps/api/scripts/check-calendar-access.mjs
# Absent = the booking page reports no availability and refuses bookings
# (fail-closed by design — it never invents slots).
GOOGLE_CALENDAR_SA_EMAIL=""
# The JSON key's private_key VERBATIM, including the literal 
 escapes.
GOOGLE_CALENDAR_SA_PRIVATE_KEY=""
# The Workspace mailbox whose calendar is read and written.
GOOGLE_CALENDAR_IMPERSONATE="admin@routeflow.info"
# "primary" (that user's own calendar) or a specific calendar ID.
GOOGLE_CALENDAR_ID="primary"
# Signs the cancel/reschedule links in the confirmation email. 32+ random bytes.
DEMO_BOOKING_TOKEN_SECRET=""
# Booking window. Defaults shown; all optional.
DEMO_BOOKING_TIMEZONE="America/Chicago"
DEMO_BOOKING_OPEN="09:00"
DEMO_BOOKING_CLOSE="17:00"
# Bookable weekdays, 0 = Sunday. Default Mon-Fri.
DEMO_BOOKING_WEEKDAYS="1,2,3,4,5"
DEMO_BOOKING_DURATION_MINUTES="30"
DEMO_BOOKING_SLOT_INTERVAL_MINUTES="30"
DEMO_BOOKING_MIN_NOTICE_HOURS="12"
DEMO_BOOKING_MAX_ADVANCE_DAYS="60"

# ─── Google Maps ────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=""

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000

# ─── CORS (comma-separated origins, defaults to localhost dev ports) ─────────
# CORS_ORIGINS="http://localhost:3001,http://localhost:8081"

# ─── Stripe Billing ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PROFESSIONAL=""
STRIPE_PRICE_ENTERPRISE=""

# ─── Tax Rate (decimal, default 0.1 = 10%) ──────────────────────────────────
# TAX_RATE=0.1

# ─── Sentry (error monitoring) ───────────────────────────────────────────────
# optional — error monitoring activates only when set
SENTRY_DSN=

