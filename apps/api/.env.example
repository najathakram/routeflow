# ══════════════════════════════════════════════════════════════════════════════
# .env.example — copy to .env.local for local development
#
# THREE ENVIRONMENTS — THREE SEPARATE FILES (all gitignored):
#
#   .env.local      ← LOCAL dev   — local Postgres / Docker — reset freely
#   .env.staging    ← STAGING     — Railway staging service — seed allowed
#   .env.production ← PRODUCTION  ← ████ REAL TENANT DATA ████
#                                    Seed scripts BLOCKED by production guard
#                                    Never copy this file anywhere
#                                    Never commit this file
#
# The production DATABASE_URL lives ONLY in Railway dashboard + your password
# manager.  If you need to inspect production data: railway connect postgres
# ══════════════════════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────────────────────
# Matches docker-compose.yml defaults — change for staging/prod
DATABASE_URL="postgresql://user:pass@localhost:5432/routeflow_dev"
POSTGRES_USER="user"
POSTGRES_PASSWORD="pass"
POSTGRES_DB="routeflow_dev"

# ─── Cache ────────────────────────────────────────────────────────────────────
# REDIS_PASSWORD must match docker-compose.yml REDIS_PASSWORD (leave blank for local dev)
REDIS_URL="redis://localhost:6379"
# W3 route hit counter (apps/api/src/route-hits): counts calls per API route template in Redis
# (tenant-agnostic). ON by default; set to "false" to switch it off.
# ROUTE_HITS_ENABLED="true"
REDIS_PASSWORD=""

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
# JWT_SECRET: ≥ 32 random characters (a shorter value fails API boot).
JWT_SECRET="replace-with-at-least-32-random-characters-secret"
# JWT_REFRESH_SECRET: ≥ 32 random characters, different from JWT_SECRET.
JWT_REFRESH_SECRET="replace-with-a-different-32-plus-random-chars-secret"
JWT_EXPIRES_IN="15m"
# 30-day idle cutoff — refresh rotation slides the window on every use, so only
# 30 days of inactivity forces a re-login.
JWT_REFRESH_EXPIRES_IN="30d"

# ─── Login throttle (RF-160) ──────────────────────────────────────────────────
# Optional override for POST /auth/login rate limiting. Unset = production
# defaults (10 attempts / 300000 ms = 5 min per IP). Only for local stacks
# (Playwright etc. sharing 127.0.0.1) — never raise these in production.
# Read once, at the first login request after boot (so a value set here in
# apps/api/.env works — ConfigModule has loaded it by then); changing it
# afterwards needs a restart.
# AUTH_LOGIN_THROTTLE_LIMIT=10
# AUTH_LOGIN_THROTTLE_TTL_MS=300000
# Per-IP ceiling (requests / 60 s) for GET /uploads/*, which is exempt from the
# global 100 / 60 s throttle because one catalog page loads more images than
# that (#2091). Positive whole number; anything else falls back to the default.
# UPLOADS_THROTTLE_LIMIT=1200

# ─── Encryption (secrets at rest) ─────────────────────────────────────────────
# 32-byte key as 64 hex chars: `openssl rand -hex 32`
# REQUIRED in production. Encrypts TenantConfig.smtpPassword and per-tenant
# Google OAuth client secrets at rest. Without it, encrypt() is DISABLED in
# production (F5-002). Rotating this value makes previously-encrypted data
# undecryptable — re-encrypt existing rows before rotating.
ENCRYPTION_KEY=""

# ─── Storage URL signing ──────────────────────────────────────────────────────
# HMAC secret for local-disk presigned upload URLs. REQUIRED in production (the
# API refuses to boot without it — F5-001). In dev/test it may be left blank, in
# which case it is derived from JWT_SECRET via HKDF. Use a long random value,
# independent of JWT_SECRET, so a JWT leak can't forge storage signatures.
STORAGE_URL_SIGNING_SECRET=""
# Lifetime in seconds for signed local-disk URLs (default 3600 = 1 hour)
# STORAGE_URL_EXPIRY_SECONDS=3600
# Window in seconds that stable product-image URLs are bucketed to (default
# 43200 = 12 hours): every mint of one write-once product key inside a window
# returns the identical URL, so the browser cache hits (#2091). Positive whole
# number (anything else falls back to the default), clamped to 60 s .. 3 days.
# STORAGE_URL_STABLE_WINDOW_SECONDS=43200

# ─── Zoho CRM ─────────────────────────────────────────────────────────────────
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""

# ─── Email delivery ──────────────────────────────────────────────────────────
# Sends are tried in order: PER-TENANT SMTP configured in-app under Settings → Email
# (stored in SystemConfig `email.*`, password encrypted with ENCRYPTION_KEY) takes
# precedence; otherwise the PLATFORM transport below is used. If NOTHING is set,
# emails are NOT delivered — the API returns an honest failure (EMAIL_NOT_CONFIGURED)
# instead of silently claiming "sent" (R5). Leave everything blank locally to disable
# platform email (per-tenant SMTP still works if a tenant configures it).
#
# The PLATFORM transport is Google Workspace SMTP (owner ruling 2026-09-16 — RouteFlow's
# mail is on Google, not a third-party ESP). Set SMTP_HOST to select it. It requires a
# REAL Workspace mailbox (an alias can't authenticate) with a Google App Password — see
# docs/runbooks/transactional-email-setup.md for the full setup (Workspace user, 2-Step
# Verification, App Password, SPF/DKIM/DMARC). Google caps a single mailbox at roughly
# 2,000 sends/day; if RouteFlow's transactional volume approaches that, this needs a
# dedicated ESP (Resend) or Google Workspace's higher-volume relay instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# From-address for platform sends — with platform SMTP this MUST be the authenticated
# mailbox above (SPF/DKIM alignment); with Resend it must be on a domain verified in
# Resend. Per-tenant SMTP sends use the tenant's own From (Settings → Email) and fall
# back to this. Format: "Name <addr@domain>".
EMAIL_FROM="RouteFlow <noreply@routeflow.info>"
# ALTERNATIVE platform transport — used only when SMTP_HOST above is blank. Never set
# both; platform SMTP always wins when configured.
RESEND_API_KEY=""
# WS4 staff order emails (new buyer order / buyer edit / buyer cancel) - platform ceiling:
# off | dark | on. A platform CEILING: unset or any other value = dark until explicitly set to on.
# The effective mode is min(this, the policy), and the policy is currently fixed dark: dark
# records WOULD_SEND delivery rows and sends nothing.
STAFF_ORDER_EMAIL="dark"

# ─── Cloudflare R2 (object storage) ──────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="routeflow-assets"

# ─── OpenRouteService (routing engine) ───────────────────────────────────────
ORS_API_KEY=""

# ─── Firebase Cloud Messaging (push notifications) ───────────────────────────
FCM_PROJECT_ID=""

# ─── Google OAuth 2.0 (Sign-In) ──────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URIs must include GOOGLE_REDIRECT_URI_TENANT and
# GOOGLE_REDIRECT_URI_PLATFORM exactly as set below (https in production).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Tenant staff + buyer portal callback — path: /api/v1/auth/google/callback
GOOGLE_REDIRECT_URI_TENANT=""
# Platform admin (SUPER_ADMIN) callback — path: /api/v1/platform-admin/auth/google/callback
GOOGLE_REDIRECT_URI_PLATFORM=""
# Unused: the legacy per-tenant sign-in routes it served are retired (410 Gone)
GOOGLE_CALLBACK_URL=""
# Frontend base URL (for post-auth redirects and web password-reset links)
WEB_URL="http://localhost:3001"
# Mobile-web base URL: used for mobile password-reset links (defaults to the
# production mobile-web domain when unset) AND, since B825/SA-132, as the
# second allowed return_origin for the Google-sign-in redirect allow-list —
# THAT usage has NO hardcoded default: prod must set this on the api service,
# or a mobile-web Google sign-in falls back to landing on the Next web app.
MOBILE_WEB_URL=""

# ─── Google mailbox connect (email-connect-google, tenant-owned Gmail send) ──
# A SEPARATE OAuth client from GOOGLE_CLIENT_ID above (design D3) — verification is
# per-consent-screen, and sign-in/mailbox must never share one client. Scope requested:
# gmail.send ONLY (Sensitive, not Restricted — no CASA needed, see design.md §1).
# Redirect path: /api/v1/settings/email/mailbox/google/callback
GOOGLE_MAILBOX_CLIENT_ID=""
GOOGLE_MAILBOX_CLIENT_SECRET=""
GOOGLE_MAILBOX_REDIRECT_URI=""

# ─── Microsoft mailbox connect (email-connect-microsoft, tenant-owned Outlook send) ──
# Entra app registration "RouteFlow Mail", accounts = any org directory AND personal
# (tenant `common`). Delegated scopes: Mail.Send, User.Read, offline_access — never a
# mail-read scope (design.md §1/§3). Redirect path:
# /api/v1/settings/email/mailbox/microsoft/callback
MICROSOFT_MAILBOX_CLIENT_ID=""
MICROSOFT_MAILBOX_CLIENT_SECRET=""
MICROSOFT_MAILBOX_REDIRECT_URI=""

# ─── Google Calendar (public demo booking) ──────────────────────────────────
# Service account with domain-wide delegation, impersonating a Workspace user.
# Full setup: docs/runbooks/google-calendar-demo-booking-setup.md
# Verify with: node apps/api/scripts/check-calendar-access.mjs
# Absent = the booking page reports no availability and refuses bookings
# (fail-closed by design — it never invents slots).
GOOGLE_CALENDAR_SA_EMAIL=""
# The JSON key's private_key VERBATIM, including the literal 
 escapes.
GOOGLE_CALENDAR_SA_PRIVATE_KEY=""
# The Workspace mailbox whose calendar is read and written.
GOOGLE_CALENDAR_IMPERSONATE="admin@routeflow.info"
# "primary" (that user's own calendar) or a specific calendar ID.
GOOGLE_CALENDAR_ID="primary"
# Signs the cancel/reschedule links in the confirmation email. 32+ random bytes.
DEMO_BOOKING_TOKEN_SECRET=""
# Signs the wholesaler onboarding intake links (#2159). 32+ random bytes; REQUIRED in production
# (the API refuses to boot without it). Never reuse another secret here.
ONBOARDING_TOKEN_SECRET=""
# Signs the one-time in-app sign-in handoff codes (#2653). 32+ random bytes, its own secret.
# Optional: unset/short disables the handoff (mint answers 409 HANDOFF_NOT_CONFIGURED and the app
# falls back to the web login); set it on Railway before the deploy that should enable it.
HANDOFF_TOKEN_SECRET=""
# Where the internal "someone booked/cancelled/rescheduled a demo" notification goes.
# Comma-separated list of addresses (trimmed, de-duplicated; an invalid entry is skipped
# with a logged error rather than dropping the rest). Defaults to admin@routeflow.info
# when unset or when nothing in the list is a valid address.
DEMO_BOOKING_ADMIN_EMAIL=""
# Booking window. Defaults shown; all optional.
DEMO_BOOKING_TIMEZONE="America/Chicago"
DEMO_BOOKING_OPEN="09:00"
DEMO_BOOKING_CLOSE="17:00"
# Bookable weekdays, 0 = Sunday. Default Mon-Fri.
DEMO_BOOKING_WEEKDAYS="1,2,3,4,5"
DEMO_BOOKING_DURATION_MINUTES="30"
DEMO_BOOKING_SLOT_INTERVAL_MINUTES="30"
DEMO_BOOKING_MIN_NOTICE_HOURS="12"
DEMO_BOOKING_MAX_ADVANCE_DAYS="60"

# ─── Google Maps ────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=""

# ─── Sign in with Apple (#2309, SA-418 — native iOS only) ──────────────────
# Your app's bundle identifier — the `aud` Apple's identity token must match exactly.
APPLE_BUNDLE_ID=""
# Apple Developer Team ID — used to build the client_secret JWT for token/revoke calls.
APPLE_TEAM_ID=""
# The Sign in with Apple private key's Key ID (from the Apple Developer portal).
APPLE_KEY_ID=""
# The .p8 private key contents on ONE line, newlines written as literal \n escapes.
APPLE_PRIVATE_KEY=""

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000

# ─── CORS (comma-separated origins, defaults to localhost dev ports) ─────────
# CORS_ORIGINS="http://localhost:3001,http://localhost:8081"

# ─── Stripe Billing ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripe Connect (tenant payment links): the platform's Connect client id (ca_…)
# and the signing secret of the Connect webhook endpoint
# (/api/v1/billing/webhook/connect). Test and live modes have DIFFERENT values
# for all four Stripe secrets — see docs/runbooks/stripe-live-cutover.md.
STRIPE_CONNECT_CLIENT_ID=""
STRIPE_CONNECT_WEBHOOK_SECRET=""
# Web base URL for Stripe Checkout success/cancel and billing-portal return
# URLs. Defaults to http://localhost:3001 when unset — prod MUST set it.
FRONTEND_URL="http://localhost:3001"
# Public API base URL: builds the Stripe Connect OAuth redirect URI
# ({API_PUBLIC_URL}/api/v1/settings/stripe-connect/callback), which must be
# registered in the Stripe Connect settings of BOTH test and live mode.
API_PUBLIC_URL="http://localhost:3000"

# ─── Overdue sweep (#2520/#2556, SA-506a) ───────────────────────────────────
# The hourly cron that flips past-due SENT/VIEWED invoices to OVERDUE in each
# tenant's own zone. One of:
#   off       the sweep runs no query (logs that it is off)
#   dark      emergency dark-back: counts what it would flip, logs one line (aggregate +
#             per-tenant counts by tenant id), writes nothing
#   enforced  DEFAULT when unset (owner 2026-10-10): writes the flip, status only
# Any other set value (blank included) runs dark with a warning.
# OVERDUE_SWEEP_MODE=enforced

# ─── Tax Rate (decimal, default 0.1 = 10%) ──────────────────────────────────
# TAX_RATE=0.1

# ─── Entitlement config snapshot/restore (Lane B A2) ─────────────────────────
# NOT an env var — this switch is live, in the database, flipped without a redeploy.
# "on" archives a tenant's feature config when a plan change downgrades it and restores it as-was
# on a re-upgrade. Default off: the plan-change sites call the hook but it does nothing.
# The owner flips it via PUT /platform-admin/entitlements/config-snapshot (super-admin only,
# audited, reason required) — never by editing this file. The live value is a `PlatformConfig`
# row (key `entitlements.configSnapshot`), read by ConfigSnapshotFlagService, cached ~5 s.

# ─── Sentry (error monitoring) ───────────────────────────────────────────────
# optional — error monitoring activates only when set
SENTRY_DSN=
# Release-health tagging needs no config here: apps/api/src/instrument.ts tags
# every Sentry event's `release` with RAILWAY_GIT_COMMIT_SHA, a Railway system
# var already injected into the running container at runtime (no build-arg
# wiring needed for the API — unlike apps/web, this is a server-only read).

# 2026-08-12: no-op retrigger — private flip raced the Railway builder clone (#331).

# deploy retrigger 2026-08-12 (snapshot race)

# Manual invoices due. RF_INVOICING_MODE: off (default, the daily crons write and send nothing) | silent (issues
# invoices; only a super-admin's manual Resend emails) | live (adds the issue email and the d0/d7/d14 reminders).
# RF_INVOICE_TEST_TENANT_SLUGS: comma list of approved TEST tenants (qa-*, e2e-*, ux-audit-*, test) that the
# platform-admin queue (list, summary, issue-now) treats as eligible though they are not PRODUCTION. Default empty.
# A slug that is not an approved test tenant stops the API at boot. The cron never issues for these.
RF_INVOICING_MODE=
RF_INVOICE_TEST_TENANT_SLUGS=
# Invoice emails (PR3). PLATFORM_BILLING_REPLY_TO: Reply-To on RouteFlow invoice emails (unset = no Reply-To).
# RF_INVOICE_PAY_INSTRUCTIONS: optional plain text added under "how to pay" in the invoice email (default none).
PLATFORM_BILLING_REPLY_TO=
RF_INVOICE_PAY_INSTRUCTIONS=

# Dunning (SA-733r7 PR-B3). BILLING_PAUSE_MODE: off (nothing is stamped, mailed or paused) | dark (the default and the
# fallback for any other value: stamps the overdue clock, sends the d0/d3/d6 reminders and logs, but NEVER changes a
# status) | enforced (adds the final notice and pauses a tenant read-only after 7 days; flip only after reading
# apps/api/scripts/report-billing-pause-blast-radius.mjs).
BILLING_PAUSE_MODE=
# Buyer-side READ_ONLY seller gate (SA ruling 10-11 A3, row 390 flip). enforced (the default for an unset or unknown value:
# a buyer write to a READ_ONLY seller is refused 403 SELLER_UNAVAILABLE) | dark (the explicit rollback: allowed, and
# logged as `seller_read_only.would_deny`). Separate from BILLING_PAUSE_MODE. Rollback without a deploy: set to dark.
SELLER_READ_ONLY_BUYER_GATE=

# Daily add-on invariant (SA-788 b, 07:00 UTC). ADDON_INVARIANT_EMAIL: log (the default and the fallback for any other
# value: findings are logged and shown as in-app notices only) | email (adds ONE email per run to PLATFORM_ALERT_EMAILS).
# Flip it on its own deploy day, after a week of in-app findings. PLATFORM_ALERT_EMAILS: comma-separated recipients.
ADDON_INVARIANT_EMAIL=
PLATFORM_ALERT_EMAILS=
