{
  "name": "@routeflow/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "check-types": "node scripts/check-types-ratchet.mjs",
    "test": "node scripts/run-unit-tests.mjs",
    "test:scripts": "jest -c jest.scripts.config.js",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:db": "node scripts/run-db-tests.mjs",
    "test:smtp": "jest --config jest.smtp.config.js",
    "test:repo-truth": "jest -c jest.repo-truth.config.js",
    "db:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "db:publish:catalog": "ts-node -r tsconfig-paths/register prisma/publish-plan-catalog-v8.ts",
    "db:publish:catalog:v9": "ts-node -r tsconfig-paths/register prisma/publish-plan-catalog-v9.ts",
    "db:publish:catalog:v10": "ts-node -r tsconfig-paths/register prisma/publish-plan-catalog-v10.ts",
    "db:publish:catalog:v11": "ts-node -r tsconfig-paths/register prisma/publish-plan-catalog-v11.ts",
    "db:publish:catalog:v12": "ts-node -r tsconfig-paths/register prisma/publish-plan-catalog-v12.ts",
    "db:publish:catalog:v13": "ts-node -r tsconfig-paths/register prisma/publish-plan-catalog-v13.ts",
    "db:backfill:catalog-rows": "ts-node -r tsconfig-paths/register prisma/backfill-product-catalog-rows.ts",
    "db:report:barcode-conflicts": "ts-node -r tsconfig-paths/register prisma/report-product-barcode-conflicts.ts",
    "db:report:variant-tier-drift": "ts-node -r tsconfig-paths/register prisma/report-variant-tier-drift.ts",
    "db:drift": "node scripts/schema-drift.mjs",
    "smoke:pdf": "node scripts/pdf-render-smoke.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@nestjs/bull": "^11.0.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.7",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "@routeflow/pricing": "*",
    "@routeflow/scanning": "*",
    "@routeflow/types": "*",
    "@sentry/node": "^10.76.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "bwip-js": "^4.11.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron": "^4.4.0",
    "csv-parse": "^6.2.1",
    "expo-server-sdk": "^6.1.0",
    "firebase-admin": "^13.7.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jose": "^4.15.9",
    "libphonenumber-js": "^1.13.15",
    "mime-types": "^2.1.35",
    "multer": "^2.4.0",
    "nodemailer": "^8.0.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.0",
    "react": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.33.0",
    "rxjs": "^7.8.2",
    "sanitize-html": "2.17.5",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "stripe": "^22.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "jest": {
    "reporters": [
      "default",
      [
        "<rootDir>/../../../scripts/jest-campaign-reporter.cjs",
        {
          "artifact": "api"
        }
      ]
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "cacheDirectory": "<rootDir>/../.jest-cache",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.db\\.spec\\.ts$",
      "\\.smtp\\.spec\\.ts$",
      "docs-truth\\.spec\\.ts$",
      "no-dead-deps\\.spec\\.ts$",
      "no-single-schema-path\\.spec\\.ts$",
      "client-page-params\\.spec\\.ts$",
      "no-react-skew-hacks\\.spec\\.ts$",
      "next-version\\.spec\\.ts$",
      "audit-allowlist-retired\\.spec\\.ts$",
      "bugs-self-test-script\\.spec\\.ts$",
      "-script\\.spec\\.ts$",
      "size-ratchet\\.spec\\.ts$",
      "owner-report-db-url\\.spec\\.ts$",
      "no-collection-time-clock-fuse\\.spec\\.ts$",
      "graph-core\\.spec\\.ts$"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@routeflow/pricing$": "<rootDir>/../../../packages/pricing/src/index.ts",
      "^@routeflow/scanning$": "<rootDir>/../../../packages/scanning/src/index.ts",
      "^ioredis$": "<rootDir>/../test/__mocks__/ioredis.js",
      "^expo-server-sdk$": "<rootDir>/../test/__mocks__/expo-server-sdk.js",
      "^@react-pdf/renderer$": "<rootDir>/../test/__mocks__/react-pdf-renderer.js",
      "^../invoices/invoice-pdf-template$": "<rootDir>/../test/__mocks__/invoice-pdf-template.js",
      "^./invoice-pdf-template$": "<rootDir>/../test/__mocks__/invoice-pdf-template.js",
      "^./packing-slip-pdf-template$": "<rootDir>/../test/__mocks__/packing-slip-pdf-template.js",
      "^./invoice-template$": "<rootDir>/../test/__mocks__/invoice-template.js",
      "^../tobacco/tobacco-report-pdf$": "<rootDir>/../test/__mocks__/tobacco-report-pdf.js",
      "^./tobacco-report-pdf$": "<rootDir>/../test/__mocks__/tobacco-report-pdf.js",
      "^../buyer/statement-pdf-template$": "<rootDir>/../test/__mocks__/statement-pdf-template.js",
      "^./statement-pdf-template$": "<rootDir>/../test/__mocks__/statement-pdf-template.js"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
