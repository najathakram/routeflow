# ─── API ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# ─── Maps ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# ─── Auth ─────────────────────────────────────────────────────────────────────
# JWT tokens are issued by apps/api. Store the access token in an httpOnly cookie.
# This secret is used to sign the cookie on the Next.js side (not NextAuth).
COOKIE_SECRET="replace-with-32-char-secret"

# ─── Sentry (error monitoring) ───────────────────────────────────────────────
# optional — error monitoring activates only when set
NEXT_PUBLIC_SENTRY_DSN=
# Release-health tagging: the git sha to tag every browser Sentry event with,
# baked into the JS bundle at build time (see apps/web/Dockerfile's
# NEXT_PUBLIC_RELEASE_SHA build arg). In Railway, set this SERVICE variable to
# the reference `${{RAILWAY_GIT_COMMIT_SHA}}` so Railway's existing "pass every
# service env var as a matching Docker build ARG" behavior forwards the
# deployed commit into the build. Leave unset locally — SentryInit.tsx treats
# an unset/empty value as "untagged", never a boot failure.
NEXT_PUBLIC_RELEASE_SHA=

# 2026-08-12: no-op retrigger — private flip raced the Railway builder clone (#331).

# deploy retrigger 2026-08-12 (snapshot race)

# ─── Visitor counts (Umami) ──────────────────────────────────────────────────
# The site ID from Umami's Tracking code section, baked into the JS bundle at build time (see the
# NEXT_PUBLIC_UMAMI_WEBSITE_ID build arg in apps/web/Dockerfile). In Railway, set it as a SERVICE
# variable on the web service. Leave it empty (or unset) locally: with no value there is no script
# on any page. Never commit a value.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
