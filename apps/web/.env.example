# ─── API ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# ─── Maps ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# ─── Auth ─────────────────────────────────────────────────────────────────────
# JWT tokens are issued by apps/api. Store the access token in an httpOnly cookie.
# This secret is used to sign the cookie on the Next.js side (not NextAuth).
COOKIE_SECRET="replace-with-32-char-secret"

# ─── Sentry (error monitoring) ───────────────────────────────────────────────
# optional — error monitoring activates only when set
NEXT_PUBLIC_SENTRY_DSN=

