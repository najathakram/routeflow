# ─── API ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# ─── Maps ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# ─── Tenant ───────────────────────────────────────────────────────────────────
# Default tenant slug for single-tenant deployments (e.g. Railway without custom
# domains). Set this so the app knows which tenant to load branding for.
# Server-side (Next.js middleware):
DEFAULT_TENANT="legacy"
# Client-side fallback (if middleware cookie is not set):
NEXT_PUBLIC_DEFAULT_TENANT="legacy"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# JWT tokens are issued by apps/api. Store the access token in an httpOnly cookie.
# This secret is used to sign the cookie on the Next.js side (not NextAuth).
COOKIE_SECRET="replace-with-32-char-secret"
