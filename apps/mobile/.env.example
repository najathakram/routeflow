# ─── API ──────────────────────────────────────────────────────────────────────
# EXPO_PUBLIC_* variables are inlined at build time and visible in the bundle.
# Never put secrets here.
EXPO_PUBLIC_API_URL="http://localhost:3000"

# ─── Maps ─────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_GOOGLE_MAPS_KEY=""
