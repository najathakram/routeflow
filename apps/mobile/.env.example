# Copy this file to .env and fill in your values
# Replace with your machine's LAN IP (run `ipconfig` on Windows or `ifconfig` on Mac/Linux)
EXPO_PUBLIC_API_URL=http://192.168.x.x:3000

# Google Maps API key — required for native Android/iOS builds (not needed for web)
# Get your key at: https://console.cloud.google.com/google/maps-apis/credentials
# For EAS Build: add as an EAS secret instead of putting it here
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# #2653 hybrid shell — the NEW web shown inside the app for operators, admins and buyers
# (drivers stay native). Unset or unusable URL = shell OFF (old native screens), never a
# hardcoded fallback. Store builds need https; http only works for localhost / a private LAN IP.
EXPO_PUBLIC_WEB_URL=http://192.168.x.x:3001
# "off" turns the shell off without a rebuild of the URL (e.g. an OTA flip back to native).
EXPO_PUBLIC_WEB_SHELL=on

# Sentry error monitoring — optional — error monitoring activates only when set
EXPO_PUBLIC_SENTRY_DSN=

# Native parity rebuild (#2337) — DEV BUILDS ONLY: show the new (Ledger kit) screens for these
# roles ("all", or a comma list of customer,driver,operator). A release build ignores it.
EXPO_PUBLIC_NEW_UI=

