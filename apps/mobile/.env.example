# Copy this file to .env and fill in your values
# Replace with your machine's LAN IP (run `ipconfig` on Windows or `ifconfig` on Mac/Linux)
EXPO_PUBLIC_API_URL=http://192.168.x.x:3000

# Google Maps API key — required for native Android/iOS builds (not needed for web)
# Get your key at: https://console.cloud.google.com/google/maps-apis/credentials
# For EAS Build: add as an EAS secret instead of putting it here
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

